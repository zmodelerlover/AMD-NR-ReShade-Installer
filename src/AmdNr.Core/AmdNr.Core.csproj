<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The engine is Windows-only on purpose: reparse points, MoveFileEx write-through and the
         PE machine check are the whole point of it. Tests run on Windows too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AmdNr.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The last resort when neither the network nor the copies beside the executable answer: the
         executable on its own, moved to the desktop, still knows what every file has to hash to. -->
    <EmbeddedResource Include="..\..\payload\payload.json" LogicalName="payload.json" />
    <EmbeddedResource Include="..\..\payload\api-db.json" LogicalName="api-db.json" Condition="Exists('..\..\payload\api-db.json')" />
  </ItemGroup>

</Project>
