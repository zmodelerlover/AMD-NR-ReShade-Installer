<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AmdNr.App"
             x:Class="AmdNr.App.GameSheet"
             IsVisible="False">

  <!-- A large sheet over the library, the game's own art behind its header. The choice it exists for
       comes first: which of the two routes, then what that route needs to know, then the evidence. -->
  <Panel x:Name="Drawer">
    <Border x:Name="Backdrop" Background="#C2080505" PointerPressed="OnBackdropPressed" />
    <!-- Its size and place are in Styles/Sheet.axaml, where the list view's docked page overrides them. -->
    <Border x:Name="DrawerPanel" Background="{DynamicResource Surface}" BorderThickness="1" ClipToBounds="True">
      <Panel x:Name="DrawerHeader" x:DataType="local:GameCard">
        <Panel x:Name="BlurBand" Height="240" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
          <Image Source="{Binding Cover}" Stretch="UniformToFill" Opacity="0.5" Effect="blur(48)" />
          <Border Background="{DynamicResource HeroFade}" />
        </Panel>
        <!-- Docked in the list view: the game's own wide banner across the top, as Steam's library has it,
             or its cover blurred behind when Steam has no banner for it. -->
        <Panel x:Name="HeroBand" Height="320" VerticalAlignment="Top" ClipToBounds="True" IsHitTestVisible="False">
          <Image Source="{Binding Cover}" Stretch="UniformToFill" Opacity="0.55" Effect="blur(40)" IsVisible="{Binding !HasHero}" />
          <Image Source="{Binding Hero}" Stretch="UniformToFill" IsVisible="{Binding HasHero}" />
          <Border Background="{DynamicResource BannerFade}" />
        </Panel>
        <!-- Docked, the cover is not on the page, so its art is changed from here: the cover (the list's
             icon too) and the banner, each with the way back to the one found online. -->
        <Button x:Name="ArtButton" Classes="artEdit" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                AutomationProperties.Name="{DynamicResource Str.Customize}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconImage}" Width="14" Height="14" />
            <TextBlock Text="{DynamicResource Str.Customize}" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{DynamicResource Str.CoverPick}" Click="OnPickCover">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconFolder}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="ArtCoverResetItem" Header="{DynamicResource Str.CoverReset}" Click="OnResetCover">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="{DynamicResource Str.HeroPick}" Click="OnPickHero">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconImage}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="HeroResetItem" Header="{DynamicResource Str.HeroReset}" Click="OnResetHero">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Grid x:Name="ContentGrid" ColumnDefinitions="Auto,*">
          <local:SheetSide x:Name="Side" Grid.Column="0" />

          <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="28,0,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="10" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="tag">
                    <Panel>
                      <TextBlock Text="{Binding Platform}" IsVisible="{Binding IsLauncher}" />
                      <TextBlock Text="{DynamicResource Str.Folder}" IsVisible="{Binding IsManual}" />
                    </Panel>
                  </Border>
                  <Border Classes="tag"><TextBlock x:Name="ApiTag" /></Border>
                  <!-- What the check found, in one badge: ready, installed, an update, or how many notes.
                       Its sentence is the tooltip; a click opens the details. -->
                  <Button x:Name="VerdictPill" Classes="pill" IsVisible="False" Click="OnShowDetails"
                          ToolTip.ShowDelay="200">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <PathIcon x:Name="VerdictGlyph" />
                      <Arc x:Name="VerdictSpin" Classes="spin" Width="11" Height="11" StrokeThickness="1.5"
                           Stroke="{DynamicResource Muted}" IsVisible="False" />
                      <TextBlock x:Name="VerdictTitle" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <!-- The name, and the pencil that renames it here, in this app only. -->
                <Grid x:Name="NameView" ColumnDefinitions="Auto,Auto">
                  <TextBlock Text="{Binding Name}" Classes="page" TextWrapping="Wrap" MaxLines="2"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost icon" Width="30" Height="30" Margin="10,0,0,0"
                          VerticalAlignment="Center" Click="OnRename"
                          ToolTip.Tip="{DynamicResource Str.Rename}" AutomationProperties.Name="{DynamicResource Str.Rename}">
                    <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13" />
                  </Button>
                </Grid>
                <StackPanel x:Name="NameEdit" Orientation="Horizontal" Spacing="8" IsVisible="False">
                  <TextBox x:Name="NameBox" Width="360" FontSize="18" KeyDown="OnNameKey"
                           AutomationProperties.Name="{DynamicResource Str.Rename}" />
                  <Button Classes="primary" Content="{DynamicResource Str.Save}" Click="OnNameSave" />
                  <Button Classes="ghost" Content="{DynamicResource Str.Cancel}" Click="OnNameCancel" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" x:Name="CloseButton" Classes="ghost icon" Click="OnClose"
                      VerticalAlignment="Top" Margin="12,0,0,0"
                      AutomationProperties.Name="{DynamicResource Str.Close}"
                      ToolTip.Tip="{DynamicResource Str.CloseHint}">
                <PathIcon Data="{StaticResource IconClose}" />
              </Button>
            </Grid>

            <!-- The gutter for the scrollbar is the content's margin, not the scroller's padding. -->
            <ScrollViewer Grid.Row="1" x:Name="ReportScroll" Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="18" Margin="0,0,14,4">
                <!-- The verdict, or what the running action is doing. -->
                <StackPanel Spacing="12">
                  <Border x:Name="ReportEmpty" Classes="result" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Arc Classes="spin" Stroke="{DynamicResource Muted}" />
                      <TextBlock Text="{DynamicResource Str.Checking}" Foreground="{DynamicResource Muted}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border x:Name="ResultBanner" Classes="result" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Grid.Column="0" x:Name="ResultDot" Classes="iconTile" Margin="0,0,14,0">
                        <Panel>
                          <PathIcon x:Name="ResultGlyph" Width="20" Height="20" />
                          <Arc x:Name="ResultSpin" Classes="spin" Width="18" Height="18"
                               Stroke="{DynamicResource AccentText}" IsVisible="False" HorizontalAlignment="Center" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultTitle" Classes="subtitle" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultDetail" Classes="muted" TextWrapping="Wrap" />
                        <Button x:Name="ShowDetailsButton" Classes="link" Click="OnShowDetails" IsVisible="False"
                                Content="{DynamicResource Str.ShowDetails}" />
                        <Button x:Name="DnsRetryButton" Classes="link" Click="OnFlushDns" IsVisible="False"
                                Content="{DynamicResource Str.DnsRetry}" />
                        <Button x:Name="CloseGameButton" Classes="link" Click="OnCloseGame" IsVisible="False" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Grid x:Name="Steps" ColumnDefinitions="*,*,*,*" IsVisible="False" Margin="2,0">
                    <Border Grid.Column="0" Classes="step" Margin="0,0,6,0">
                      <StackPanel Spacing="6"><Border Classes="seg" /><TextBlock Text="{DynamicResource Str.StepDownload}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="step" Margin="0,0,6,0">
                      <StackPanel Spacing="6"><Border Classes="seg" /><TextBlock Text="{DynamicResource Str.StepVerify}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="step" Margin="0,0,6,0">
                      <StackPanel Spacing="6"><Border Classes="seg" /><TextBlock Text="{DynamicResource Str.StepInstall}" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="step">
                      <StackPanel Spacing="6"><Border Classes="seg" /><TextBlock Text="{DynamicResource Str.StepDone}" /></StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>

                <!-- How the last session went: SessionBox.axaml, filled by GameSheet.Session.cs. -->
                <local:SessionBox x:Name="LastSession" IsVisible="False" />

                <!-- Everything the person can change, locked as one while something is running. -->
                <StackPanel x:Name="Options" Spacing="18">
                  <!-- What the route is read off. Detection picks the file out of the folder and can
                       pick a launcher instead of the game, so it is shown and it can be changed. -->
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource Str.DetectedSection}" Classes="section" />
                      <Border Classes="info" ToolTip.Tip="{Binding #ExeNote.Text}" IsVisible="{Binding #ExeNote.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                    </StackPanel>
                    <Border Classes="detect">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                          <TextBlock x:Name="ExeLine" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <WrapPanel>
                            <TextBlock x:Name="DetectedHow" Classes="muted" TextWrapping="Wrap" Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Button Classes="link" Click="OnOpenWiki" ToolTip.Tip="{DynamicResource Str.CheckApiTip}"
                                    AutomationProperties.Name="{DynamicResource Str.CheckWiki}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{DynamicResource Str.CheckWiki}" />
                                <PathIcon Data="{StaticResource IconExternal}" Width="12" Height="12" />
                              </StackPanel>
                            </Button>
                          </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ExeButton" Classes="ghost" Click="OnChooseExecutable"
                                VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <!-- Where the files go: a launcher's build, FiveM and Unreal write outside the card's folder. -->
                    <Grid ColumnDefinitions="Auto,*" Margin="2,0,0,0">
                      <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,2,8,0" />
                      <SelectableTextBlock Grid.Column="1" x:Name="InstallsInto" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource TextSoft}" />
                    </Grid>
                    <Border x:Name="ElsewhereBox" Classes="callout" IsVisible="False">
                      <TextBlock x:Name="Elsewhere" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource WarnText}" />
                    </Border>
                    <!-- Read by the (i) above: this sheet explains itself in tooltips, not paragraphs. -->
                    <TextBlock x:Name="ExeNote" IsVisible="False" />
                    <Border x:Name="ApiHintBox" Classes="callout" IsVisible="False">
                      <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconWarn}" Width="16" Height="16"
                                  Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock Grid.Column="1" x:Name="ApiHint" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource WarnText}" />
                      </Grid>
                    </Border>
                  </StackPanel>

                  <!-- The two ways in. They are alternatives, so the choice is two cards, not one list. -->
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource Str.InstallWith}" Classes="section" />
                    <Grid ColumnDefinitions="*,12,*">
                      <RadioButton Grid.Column="0" x:Name="RouteReShade" Classes="route" GroupName="route"
                                   IsCheckedChanged="OnRouteChanged" AutomationProperties.Name="ReShade">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                          <Border Classes="iconTile small" Margin="0,0,10,0"><PathIcon Data="{StaticResource IconLayers}" /></Border>
                          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{DynamicResource Str.RouteReShade}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <Border Classes="info" ToolTip.Tip="{Binding #ReShadeSummary.Text}" IsVisible="{Binding #ReShadeSummary.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </StackPanel>
                            <WrapPanel ItemSpacing="4" LineSpacing="4">
                              <Border x:Name="ReShadeRecommended" Classes="status ok"><TextBlock Text="{DynamicResource Str.Recommended}" /></Border>
                              <Border x:Name="ReShadeInstalled" Classes="status ok">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <PathIcon Data="{StaticResource IconCheck}" />
                                  <TextBlock Text="{DynamicResource Str.InstalledBadge}" />
                                </StackPanel>
                              </Border>
                            </WrapPanel>
                          </StackPanel>
                          <TextBlock Grid.Row="1" x:Name="ReShadeSummary" IsVisible="False" />
                        </Grid>
                      </RadioButton>
                      <RadioButton Grid.Column="2" x:Name="RouteOpti" Classes="route" GroupName="route"
                                   IsCheckedChanged="OnRouteChanged" AutomationProperties.Name="OptiScaler">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                          <Border Classes="iconTile small" Margin="0,0,10,0"><PathIcon Data="{StaticResource IconSparkle}" /></Border>
                          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{DynamicResource Str.RouteOpti}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <Border Classes="info" ToolTip.Tip="{Binding #OptiSummary.Text}" IsVisible="{Binding #OptiSummary.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </StackPanel>
                            <WrapPanel ItemSpacing="4" LineSpacing="4">
                              <Border x:Name="OptiRecommended" Classes="status ok"><TextBlock Text="{DynamicResource Str.Recommended}" /></Border>
                              <Border x:Name="OptiInstalled" Classes="status ok">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <PathIcon Data="{StaticResource IconCheck}" />
                                  <TextBlock Text="{DynamicResource Str.InstalledBadge}" />
                                </StackPanel>
                              </Border>
                            </WrapPanel>
                          </StackPanel>
                          <TextBlock Grid.Row="1" x:Name="OptiSummary" IsVisible="False" />
                        </Grid>
                      </RadioButton>
                    </Grid>

                    <!-- No route guessed for a game whose API could not be read: the person picks one. -->
                    <Border x:Name="PickRouteBox" Classes="callout" IsVisible="False">
                      <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="{StaticResource IconWarn}" Width="16" Height="16"
                                  Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{DynamicResource Str.PickRouteTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                     Foreground="{DynamicResource WarnText}" />
                          <TextBlock x:Name="PickRouteText" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource WarnText}" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <!-- ReShade: which API, the name it loads as, and the add-on version. -->
                    <Border x:Name="ReShadePanel" Classes="routePanel">
                      <StackPanel Spacing="12">
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.ApiSection}" Classes="section" />
                            <Border Classes="info" ToolTip.Tip="{Binding #PresetNote.Text}" IsVisible="{Binding #PresetNote.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                          </StackPanel>
                          <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" SelectionChanged="OnPresetChanged"
                                    AutomationProperties.Name="{DynamicResource Str.ApiSection}" />
                          <TextBlock x:Name="PresetNote" IsVisible="False" />
                        </StackPanel>
                        <Border x:Name="MismatchBox" Classes="callout" IsVisible="False">
                          <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="{StaticResource IconWarn}" Width="16" Height="16"
                                      Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Grid.Column="1" x:Name="MismatchText" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{DynamicResource WarnText}" />
                          </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,12,*">
                          <StackPanel Grid.Column="0" x:Name="ProxySection" Spacing="6">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{DynamicResource Str.ProxySection}" Classes="section" />
                              <Border Classes="info" ToolTip.Tip="{DynamicResource Str.ProxyNote}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </StackPanel>
                            <ComboBox x:Name="ProxyBox" HorizontalAlignment="Stretch" SelectionChanged="OnProxyChanged"
                                      AutomationProperties.Name="{DynamicResource Str.ProxySection}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" x:Name="VersionSection" Spacing="6">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{DynamicResource Str.VersionSection}" Classes="section" />
                              <Border Classes="info" ToolTip.Tip="{Binding #VersionNote.Text}" IsVisible="{Binding #VersionNote.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </StackPanel>
                            <ComboBox x:Name="AddonVersionBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnAddonVersionChanged"
                                      AutomationProperties.Name="{DynamicResource Str.VersionSection}" />
                            <TextBlock x:Name="VersionNote" IsVisible="False" />
                            <Button Classes="link" Click="OnWhatsNew" HorizontalAlignment="Left"
                                    Content="{DynamicResource Str.WhatsNew}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- OptiScaler: the name it loads as, and the three things to do in the game. -->
                    <Border x:Name="OptiPanel" Classes="routePanel" IsVisible="False">
                      <StackPanel Spacing="12">
                        <Border x:Name="OptiMismatchBox" Classes="callout" IsVisible="False">
                          <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="{StaticResource IconWarn}" Width="16" Height="16"
                                      Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Grid.Column="1" x:Name="OptiMismatchText" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{DynamicResource WarnText}" />
                          </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,12,*">
                          <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{DynamicResource Str.ProxySectionOpti}" Classes="section" />
                              <Border Classes="info" ToolTip.Tip="{DynamicResource Str.ProxyNoteOpti}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </StackPanel>
                            <ComboBox x:Name="OptiProxyBox" HorizontalAlignment="Stretch" SelectionChanged="OnProxyChanged"
                                      AutomationProperties.Name="{DynamicResource Str.ProxySectionOpti}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" x:Name="OptiVersionSection" Spacing="6">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{DynamicResource Str.VersionSectionOpti}" Classes="section" />
                              <Border Classes="info" ToolTip.Tip="{Binding #OptiVersionNote.Text}" IsVisible="{Binding #OptiVersionNote.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </StackPanel>
                            <ComboBox x:Name="OptiVersionBox" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnAddonVersionChanged"
                                      AutomationProperties.Name="{DynamicResource Str.VersionSectionOpti}" />
                            <TextBlock x:Name="OptiVersionNote" IsVisible="False" />
                            <Button Classes="link" Click="OnWhatsNew" HorizontalAlignment="Left"
                                    Content="{DynamicResource Str.WhatsNew}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Which danielblnc runtime goes in: the download, or the supporter build the person supplies,
                         which this app never distributes. Two cards like the route's above, so it reads as the
                         choice it is and the one in use is the one lit; where the files come from sits under the
                         supporter card only once it is chosen. -->
                    <Border x:Name="RuntimeSection" Classes="routePanel" IsVisible="False">
                      <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{DynamicResource Str.SupporterTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <Border Classes="info" ToolTip.Tip="{DynamicResource Str.SupporterChoose}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                          <RadioButton x:Name="RuntimeDownloadChoice" Classes="route" GroupName="runtime"
                                       IsCheckedChanged="OnRuntimeChoice"
                                       AutomationProperties.Name="{DynamicResource Str.SupporterUseDownload}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Classes="iconTile small" Margin="0,0,10,0"><PathIcon Data="{StaticResource IconDownload}" /></Border>
                              <TextBlock Grid.Column="1" x:Name="RuntimeDownloadTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="2" Classes="info" ToolTip.Tip="{DynamicResource Str.SupporterDownloadBody}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                            </Grid>
                          </RadioButton>
                          <RadioButton Grid.Column="2" x:Name="RuntimeSupporterChoice" Classes="route" GroupName="runtime"
                                       IsCheckedChanged="OnRuntimeChoice"
                                       AutomationProperties.Name="{DynamicResource Str.SupporterUse}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Classes="iconTile small" Margin="0,0,10,0"><PathIcon Data="{StaticResource IconHeart}" /></Border>
                              <TextBlock Grid.Column="1" x:Name="RuntimeSupporterTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                                         VerticalAlignment="Center" />
                              <!-- What the supporter build is, and that this app never hands it out. -->
                              <Border Grid.Column="2" Classes="info">
                                <ToolTip.Tip>
                                  <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding #RuntimePitch.Text}" />
                                    <TextBlock Text="{DynamicResource Str.SupporterNotDistributed}" Foreground="{DynamicResource Muted}" />
                                  </StackPanel>
                                </ToolTip.Tip>
                                <PathIcon Data="{StaticResource IconInfo}" />
                              </Border>
                              <TextBlock x:Name="RuntimePitch" IsVisible="False" />
                            </Grid>
                          </RadioButton>
                        </Grid>
                        <StackPanel x:Name="RuntimeSupporterPanel" Spacing="8" IsVisible="False">
                          <Grid ColumnDefinitions="Auto,*">
                            <PathIcon x:Name="RuntimeNoteIcon" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Grid.Column="1" x:Name="RuntimeNote" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18" />
                          </Grid>
                          <Button x:Name="RuntimeFileButton" Classes="ghost" Click="OnChooseRuntimeFile" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{DynamicResource Str.SupporterPick}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <PathIcon Data="{StaticResource IconFolderOpen}" />
                              <TextBlock x:Name="RuntimeFileLabel" Text="{DynamicResource Str.SupporterPick}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- The danielblnc version, and on RX 9000 what goes in beside it and runs by default. -->
                    <StackPanel x:Name="MochizukiSection" Spacing="6" IsVisible="False">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str.MochizukiSection}" Classes="section" />
                        <Border Classes="info" ToolTip.Tip="{Binding #MochizukiNote.Text}" IsVisible="{Binding #MochizukiNote.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                      </StackPanel>
                      <Grid x:Name="DanielVersionRow" ColumnDefinitions="Auto,Auto,12,*">
                        <TextBlock Text="{DynamicResource Str.DanielVersion}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="info" ToolTip.Tip="{DynamicResource Str.DanielVersionTip}"><PathIcon Data="{StaticResource IconInfo}" /></Border>
                        <ComboBox Grid.Column="3" x:Name="DanielVersionBox" HorizontalAlignment="Stretch" SelectionChanged="OnDanielVersionChanged"
                                  AutomationProperties.Name="{DynamicResource Str.DanielVersion}" />
                      </Grid>
                      <TextBlock x:Name="MochizukiNote" IsVisible="False" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <!-- The raw pre-flight, for whoever wants to see why. -->
                <Expander x:Name="DetailsExpander" Classes="details">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{DynamicResource Str.Details}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock x:Name="DetailsCount" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel Spacing="8">
                    <SelectableTextBlock x:Name="DetectedLine" Classes="muted" TextWrapping="Wrap" />
                    <ItemsControl x:Name="ReportList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ReportLine">
                          <Grid Classes="line" ColumnDefinitions="22,*" Margin="0,4">
                            <PathIcon Grid.Column="0" Data="{Binding Glyph}" Foreground="{Binding Brush}"
                                      Width="13" Height="13" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      Margin="0,2,0,0" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                                 Foreground="{DynamicResource TextSoft}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Expander>

              </StackPanel>
            </ScrollViewer>

            <!-- Action bar, pinned -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                    Padding="0,16,0,0" Margin="0,12,0,0">
              <StackPanel Spacing="10">
                <ProgressBar x:Name="Progress" Height="4" MinHeight="4" IsVisible="False" CornerRadius="2"
                             Foreground="{DynamicResource AccentHover}" Background="{DynamicResource SurfaceTop}" />
                <!-- The sentence gets the full width above the buttons: beside them it was cut
                     mid-word as soon as the window narrowed. -->
                <TextBlock x:Name="StatusText" Classes="muted" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <!-- The install can say "done" and the game still show nothing: that is the most common
                       failure this project has, so the report sits beside Install, whatever the result. -->
                  <Button Grid.Column="0" x:Name="ReportButton" Classes="ghost large" Click="OnReport"
                          AutomationProperties.Name="{DynamicResource Str.Report}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Str.ReportTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Str.ReportBody}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconReport}" />
                      <TextBlock Text="{DynamicResource Str.Report}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" HorizontalAlignment="Right" x:Name="UninstallButton" Classes="ghost danger large"
                          Click="OnUninstall" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource Str.Uninstall}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon x:Name="UninstallIcon" Data="{StaticResource IconDelete}" />
                      <Arc x:Name="UninstallSpin" Classes="spin" Stroke="{DynamicResource Text}" IsVisible="False" />
                      <TextBlock x:Name="UninstallLabel" Text="{DynamicResource Str.Uninstall}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" x:Name="InstallButton" Classes="primary large" Click="OnInstall" MinWidth="168"
                          HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Str.Install}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon x:Name="InstallIcon" Data="{StaticResource IconDownload}" />
                      <Arc x:Name="InstallSpin" Classes="spin" Stroke="White" IsVisible="False" />
                      <TextBlock x:Name="InstallLabel" Text="{DynamicResource Str.Install}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Panel>
    </Border>
  </Panel>
</UserControl>
