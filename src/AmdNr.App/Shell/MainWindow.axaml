<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmdNr.App"
        x:Class="AmdNr.App.MainWindow"
        Title="AMD-NR ReShade Installer"
        Icon="avares://AMD-NR-ReShade-Installer/Assets/app.ico"
        Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="{DynamicResource Bg}">

  <!-- The frame: the rail, the update banner, whichever page is open, the game sheet over them all,
       and the toast. Each page is its own control and does its own work. -->
  <!-- The title bar is the app's own, in the rail's colour, so the frame is one dark L rather than a
       system-coloured strip over it. Windows still draws the three buttons on the right. -->
  <!-- Maximized, Windows puts the frame past the screen edge by OffScreenMargin; without this the
       title bar lost its top to it and the logo sat against the edge of the screen. -->
  <Grid RowDefinitions="32,*" Margin="{Binding $parent[Window].OffScreenMargin}">
  <Border Grid.Row="0" Background="{DynamicResource Rail}" IsHitTestVisible="False">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="avares://AMD-NR-ReShade-Installer/Assets/titlebar.png" Height="16" Stretch="Uniform"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <TextBlock Text="{Binding $parent[Window].Title}" FontSize="12" Foreground="{DynamicResource Muted}"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Border>

  <Grid Grid.Row="1" ColumnDefinitions="72,*" Background="{DynamicResource Rail}">

    <Border Grid.Column="0" Background="{DynamicResource Rail}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Width="40" Height="40" Margin="0,14,0,22" CornerRadius="11" ClipToBounds="True"
                BoxShadow="0 6 18 0 #59A61C22" ToolTip.Tip="{DynamicResource Str.AppTitle}">
          <Image Source="avares://AMD-NR-ReShade-Installer/Assets/logo.png" Stretch="UniformToFill"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>

        <StackPanel Grid.Row="1" Spacing="4">
          <RadioButton x:Name="TabGames" Classes="rail" GroupName="nav" IsChecked="True"
                       ToolTip.Tip="{DynamicResource Str.Games}" ToolTip.Placement="Right"
                       AutomationProperties.Name="{DynamicResource Str.Games}" Checked="OnTabChanged">
            <PathIcon Data="{StaticResource IconGames}" />
          </RadioButton>
          <RadioButton x:Name="TabSystem" Classes="rail" GroupName="nav"
                       ToolTip.Tip="{DynamicResource Str.System}" ToolTip.Placement="Right"
                       AutomationProperties.Name="{DynamicResource Str.System}" Checked="OnTabChanged">
            <PathIcon Data="{StaticResource IconChip}" />
          </RadioButton>
          <RadioButton x:Name="TabSettings" Classes="rail" GroupName="nav"
                       ToolTip.Tip="{DynamicResource Str.Settings}" ToolTip.Placement="Right"
                       AutomationProperties.Name="{DynamicResource Str.Settings}" Checked="OnTabChanged">
            <Panel>
              <PathIcon Data="{StaticResource IconSettings}" />
              <!-- A newer release is out: the page that says so is marked, so it is found. -->
              <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="{DynamicResource Warn}" IsVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
            </Panel>
          </RadioButton>
        </StackPanel>

        <!-- Support, one click from every page: a grey coffee above the version, quiet like the rest of
             the rail. It opens a card that says why support matters and where it goes. -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,14">
          <Button x:Name="SupportButton" Classes="ghost icon" Click="OnSupport" HorizontalAlignment="Center"
                  ToolTip.Tip="{DynamicResource Str.SupportRail}" ToolTip.Placement="Right"
                  AutomationProperties.Name="{DynamicResource Str.SupportRail}">
            <PathIcon Data="{StaticResource IconCoffee}" Foreground="{DynamicResource Faint}" />
          </Button>
          <TextBlock x:Name="VersionText" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The pages sit in their own frame: a line under the title bar and one along the rail, meeting
         in a rounded corner, with the rail's colour showing around it. -->
    <Border Grid.Column="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1,1,0,0" CornerRadius="12,0,0,0" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border x:Name="UpdateBanner" Grid.Row="0" IsVisible="False" Margin="24,16,24,0"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Chrome}"
              BorderThickness="1" CornerRadius="12" Padding="12,10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Border Grid.Column="0" Classes="iconTile warn" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconDownload}" Width="16" Height="16" />
          </Border>
          <TextBlock Grid.Column="1" x:Name="UpdateText" Margin="12,0" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="2" x:Name="UpdateButton" Classes="primary" Click="OnUpdate" />
          <Button Grid.Column="3" Classes="ghost" Margin="8,0,0,0" Content="{DynamicResource Str.Dismiss}" Click="OnDismissUpdate" />
        </Grid>
      </Border>

      <Panel Grid.Row="1" x:Name="Pages">
        <local:LibraryPage x:Name="GamesPage" />
        <local:MachinePage x:Name="SystemPage" IsVisible="False" />
        <local:SettingsPage x:Name="SettingsPage" IsVisible="False" />
        <local:GameSheet x:Name="Sheet" />

        <!-- Toast: a one-line summary at the bottom, for results that happen away from the sheet. -->
        <Border x:Name="ToastBox" Classes="toast" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" MaxWidth="520">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon x:Name="ToastIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460" />
          </StackPanel>
        </Border>

        <!-- "What's new": over everything on the page, the game's sheet included. -->
        <local:NotesSheet x:Name="Notes" />
        <local:SupportSheet x:Name="Support" />
      </Panel>
    </Grid>
    </Border>
  </Grid>
  </Grid>
</Window>
