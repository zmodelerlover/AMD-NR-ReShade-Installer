<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmdNr.App"
        x:Class="AmdNr.App.SetupWindow"
        Title="AMD-NR ReShade Installer"
        Icon="avares://AMD-NR-ReShade-Installer/Assets/app.ico"
        Width="820" Height="900" MinWidth="560" MinHeight="470"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header: the mark, what this is, and where in the four steps we are. -->
    <Border Grid.Row="0" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1" Padding="28,22">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                Background="{DynamicResource LogoFill}" BoxShadow="0 6 18 0 #59A61C22">
          <Image Source="avares://AMD-NR-ReShade-Installer/Assets/logo.png" Width="28" Height="28"
                 Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Str.AppTitle}" Classes="subtitle" />
          <TextBlock x:Name="StepOf" Classes="caption" />
        </StackPanel>
        <StackPanel Grid.Column="2" x:Name="Pips" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Border Classes="pip" /><Border Classes="pip" /><Border Classes="pip" /><Border Classes="pip" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The page gutter is a margin on the content, not padding on the ScrollViewer: padding here
         is subtracted when the content is arranged but not when it is measured, so anything that
         wraps measures against the full width, overflows to the right, and reports a height short
         of what it needs, which is what stopped the scrollbar before the end of the page. -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
      <Panel Margin="28,22">

        <!-- 1. Language -->
        <StackPanel x:Name="PageLanguage" Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Str.SetupWelcome}" Classes="page" />
            <TextBlock Text="{DynamicResource Str.SetupWelcomeBody}" Classes="muted"
                       TextWrapping="Wrap" LineHeight="20" MaxWidth="560" HorizontalAlignment="Left" />
          </StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Str.Language}" Classes="section" />
              <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged"
                        AutomationProperties.Name="{DynamicResource Str.Language}" />
            </StackPanel>
          </Border>

          <!-- Here because this is the screen everyone sees first, and by the time someone has been
               charged for this they have already been had. -->
          <local:CreditsPanel />
        </StackPanel>

        <!-- 2. This machine -->
        <StackPanel x:Name="PageMachine" Spacing="18" IsVisible="False">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Str.SetupStepMachine}" Classes="page" />
            <TextBlock Text="{DynamicResource Str.SetupMachineBody}" Classes="muted"
                       TextWrapping="Wrap" LineHeight="20" MaxWidth="560" HorizontalAlignment="Left" />
          </StackPanel>

          <Border x:Name="MachineVerdict" Classes="card">
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" x:Name="MachineVerdictTile" Classes="iconTile" Margin="0,0,14,0">
                <PathIcon x:Name="MachineVerdictIcon" Width="20" Height="20" />
              </Border>
              <TextBlock Grid.Column="1" x:Name="MachineVerdictText" Classes="subtitle" TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="iconTile" Margin="0,0,12,0">
                  <PathIcon Data="{StaticResource IconChip}" Width="18" Height="18" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Str.Gpu}" Classes="section" />
                  <TextBlock x:Name="GpuText" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" x:Name="GpuStatus" Classes="status" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon x:Name="GpuStatusIcon" />
                    <TextBlock x:Name="GpuStatusText" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Classes="iconTile" Margin="0,0,12,0">
                  <PathIcon Data="{StaticResource IconBolt}" Width="18" Height="18" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Str.Hip}" Classes="section" />
                  <TextBlock x:Name="DriverText" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" x:Name="HipStatus" Classes="status" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon x:Name="HipStatusIcon" />
                    <TextBlock x:Name="HipText" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <Border x:Name="MachineWarningBox" Classes="callout" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Grid.Column="0" Data="{StaticResource IconWarn}" Width="16" Height="16"
                        Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
              <TextBlock Grid.Column="1" x:Name="MachineWarning" TextWrapping="Wrap" LineHeight="19"
                         Foreground="{DynamicResource WarnText}" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- 3. Files: the same panel "This machine" shows, with its retry, manual links and import. -->
        <StackPanel x:Name="PageFiles" Spacing="18" IsVisible="False">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Str.SetupStepFiles}" Classes="page" />
            <TextBlock Text="{DynamicResource Str.SetupFilesBody}" Classes="muted"
                       TextWrapping="Wrap" LineHeight="20" MaxWidth="560" HorizontalAlignment="Left" />
            <TextBlock Text="{DynamicResource Str.SetupFilesLater}" Classes="muted"
                       TextWrapping="Wrap" LineHeight="20" MaxWidth="560" HorizontalAlignment="Left" />
          </StackPanel>
          <local:PayloadPanel x:Name="Payloads" />
        </StackPanel>

        <!-- 4. Games -->
        <StackPanel x:Name="PageGames" Spacing="18" IsVisible="False">
          <StackPanel Spacing="6">
            <TextBlock Text="{DynamicResource Str.SetupStepGames}" Classes="page" />
            <TextBlock Text="{DynamicResource Str.SetupGamesBody}" Classes="muted"
                       TextWrapping="Wrap" LineHeight="20" MaxWidth="560" HorizontalAlignment="Left" />
          </StackPanel>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Button x:Name="ScanButton" Classes="primary large" Click="OnScan" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon x:Name="ScanIcon" Data="{StaticResource IconRefresh}" />
                  <Arc x:Name="ScanSpin" Classes="spin" Stroke="White" IsVisible="False" />
                  <TextBlock x:Name="ScanLabel" Text="{DynamicResource Str.Scan}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <TextBlock x:Name="ScanStatus" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource Str.SetupGamesApi}" Classes="muted" TextWrapping="Wrap"
                         LineHeight="19" />
              <ItemsControl x:Name="FoundList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FoundGameRow">
                    <Grid Classes="line" ColumnDefinitions="*,Auto" Margin="0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="badge">
                        <TextBlock Text="{Binding Platform}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

      </Panel>
    </ScrollViewer>

    <!-- Footer -->
    <Border Grid.Row="2" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0" Padding="28,16">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" x:Name="BackButton" Classes="ghost" Click="OnBack"
                Content="{DynamicResource Str.SetupBack}" />
        <Button Grid.Column="1" x:Name="SkipButton" Classes="ghost" Click="OnNext" HorizontalAlignment="Right"
                Margin="0,0,10,0" Content="{DynamicResource Str.SetupSkip}" IsVisible="False" />
        <Button Grid.Column="2" x:Name="NextButton" Classes="primary large" Click="OnNext" MinWidth="150"
                HorizontalContentAlignment="Center">
          <TextBlock x:Name="NextLabel" Text="{DynamicResource Str.SetupNext}" VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
