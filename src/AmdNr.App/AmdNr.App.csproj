<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AMD-NR-ReShade-Installer</AssemblyName>
    <RootNamespace>AmdNr.App</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- One file to hand out, like the add-on's own installer. Trimming stays off: Avalonia's XAML
         loader resolves types by name, and the reference manager this follows disables it too. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Skia and the GL loader are native, and without this they sit beside the exe instead of
         inside it. One file is the point: people drop this next to a game. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tmds.DBus.Protocol is a Linux-only transitive dependency of Avalonia. It is never loaded on
         Windows, which is the only platform this ships for. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xrw6-gwf8-vvr9" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Languages\**" />
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The same manifest the content repository publishes, shipped so the app works offline and
         before that repository exists. The remote copy wins when it can be reached. -->
    <None Include="..\..\payload\payload.json" Link="payload.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Which API each game supports, so detection is right offline and on a first run. -->
    <None Include="..\..\payload\api-db.json" Link="api-db.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\payload\api-db.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmdNr.Core\AmdNr.Core.csproj" />
  </ItemGroup>

</Project>
