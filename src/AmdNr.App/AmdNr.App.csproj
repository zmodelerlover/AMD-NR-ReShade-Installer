<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AMD-NR-ReShade-Installer</AssemblyName>
    <RootNamespace>AmdNr.App</RootNamespace>
    <Version>0.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- One file to hand out, like the add-on's own installer. Trimmed, which is what takes it from
         49 MB to about 23: everything that used to need reflection no longer does. The JSON is
         generated at compile time, the bindings are compiled, the languages are classes, and the
         GPU is read through DXGI instead of WMI. Partial, so only the libraries that declare
         themselves safe to trim are trimmed; this app's own code is kept whole. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- What the file says about itself. An executable with no publisher, no description and no
         version reads to an antivirus the way a dropped payload does. -->
    <Company>AMD-NR community</Company>
    <Product>AMD-NR ReShade Installer</Product>
    <Description>Installs the AMD-NR neural rendering add-on into PC games</Description>
    <Copyright>MIT License</Copyright>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Skia and the GL loader are native, and without this they sit beside the exe instead of
         inside it. One file is the point: people drop this next to a game. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tmds.DBus.Protocol is a Linux-only transitive dependency of Avalonia. It is never loaded on
         Windows, which is the only platform this ships for. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xrw6-gwf8-vvr9" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The same manifest the content repository publishes, shipped so the app works offline and
         before that repository exists. The remote copy wins when it can be reached. -->
    <None Include="..\..\payload\payload.json" Link="payload.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Which API each game supports, so detection is right offline and on a first run. -->
    <None Include="..\..\payload\api-db.json" Link="api-db.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\payload\api-db.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AmdNr.Core\AmdNr.Core.csproj" />
  </ItemGroup>

</Project>
