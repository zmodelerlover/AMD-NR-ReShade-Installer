<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmdNr.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is the language, swapped at run time by App.ChangeLanguage. Nothing else may
             be inserted in front of it. -->
        <ResourceInclude Source="/Languages/Strings.en.axaml" />
        <ResourceInclude Source="/Styles/Palette.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Base.axaml" />
    <StyleInclude Source="/Styles/Library.axaml" />
    <StyleInclude Source="/Styles/Sheet.axaml" />
  </Application.Styles>
</Application>
