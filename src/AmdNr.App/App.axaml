<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmdNr.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is the language, swapped at run time by App.ChangeLanguage. Nothing else may
             be inserted in front of it. -->
        <ResourceInclude Source="avares://AMD-NR-ReShade-Installer/Languages/Strings.en.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- The add-on's own palette: the contained red, not the one that glows on a dark terminal.
           Surfaces step up in lightness a few percent at a time, warm rather than blue-grey. -->
      <Color x:Key="AccentColor">#A61C22</Color>
      <SolidColorBrush x:Key="Accent" Color="#A61C22" />
      <SolidColorBrush x:Key="AccentHover" Color="#C4242C" />
      <SolidColorBrush x:Key="AccentPressed" Color="#8A171C" />
      <SolidColorBrush x:Key="AccentSoft" Color="#2EA61C22" />
      <SolidColorBrush x:Key="AccentText" Color="#FF7A7E" />
      <SolidColorBrush x:Key="Chrome" Color="#601E1E" />
      <SolidColorBrush x:Key="Bg" Color="#110D0D" />
      <SolidColorBrush x:Key="Rail" Color="#0B0808" />
      <SolidColorBrush x:Key="Surface" Color="#1A1514" />
      <SolidColorBrush x:Key="SurfaceHigh" Color="#241D1C" />
      <SolidColorBrush x:Key="SurfaceTop" Color="#2E2524" />
      <SolidColorBrush x:Key="Border" Color="#2F2524" />
      <SolidColorBrush x:Key="BorderStrong" Color="#4A3A38" />
      <SolidColorBrush x:Key="Text" Color="#F0EAE8" />
      <SolidColorBrush x:Key="Muted" Color="#A89A95" />
      <SolidColorBrush x:Key="Faint" Color="#7C706C" />
      <SolidColorBrush x:Key="Ok" Color="#5CB37E" />
      <SolidColorBrush x:Key="OkSoft" Color="#1F5CB37E" />
      <SolidColorBrush x:Key="Warn" Color="#DDA13A" />
      <SolidColorBrush x:Key="WarnSoft" Color="#1FDDA13A" />
      <SolidColorBrush x:Key="Err" Color="#E05B4C" />
      <SolidColorBrush x:Key="ErrSoft" Color="#24E05B4C" />

      <!-- The Fluent theme's own accent follows ours, so combo boxes, focus and the expander agree. -->
      <Color x:Key="SystemAccentColor">#A61C22</Color>
      <Color x:Key="SystemAccentColorLight1">#C4242C</Color>
      <Color x:Key="SystemAccentColorLight2">#D9464C</Color>
      <Color x:Key="SystemAccentColorDark1">#8A171C</Color>

      <!-- Icons: 24-unit paths drawn with PathIcon, so they take the colour of the text around them. -->
      <StreamGeometry x:Key="IconGames">M21.58 16.09l-1.09-7.66A4 4 0 0 0 16.53 5H7.47C5.48 5 3.79 6.46 3.51 8.43l-1.09 7.66A2.55 2.55 0 0 0 4.94 19c.68 0 1.32-.27 1.8-.75L9 16h6l2.25 2.25c.48.48 1.13.75 1.8.75 1.56 0 2.75-1.37 2.53-2.91zM11 11H9v2H8v-2H6v-1h2V8h1v2h2v1zm4-1a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm2 3a1 1 0 1 1 0-2 1 1 0 0 1 0 2z</StreamGeometry>
      <StreamGeometry x:Key="IconChip">F0 M9 2h2v3h2V2h2v3h2a2 2 0 0 1 2 2v2h3v2h-3v2h3v2h-3v2a2 2 0 0 1-2 2h-2v3h-2v-3h-2v3H9v-3H7a2 2 0 0 1-2-2v-2H2v-2h3v-2H2V9h3V7a2 2 0 0 1 2-2h2V2zM7 7v10h10V7H7zm2 2h6v6H9V9z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
      <StreamGeometry x:Key="IconWarn">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
      <StreamGeometry x:Key="IconErr">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z</StreamGeometry>
      <StreamGeometry x:Key="IconInfo">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</StreamGeometry>
      <StreamGeometry x:Key="IconOk">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</StreamGeometry>
      <StreamGeometry x:Key="IconDot">M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M6 19a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
      <StreamGeometry x:Key="IconDriver">M20 6h-8l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zm-8 11-4-4h3V9h2v4h3l-4 4z</StreamGeometry>
      <StreamGeometry x:Key="IconBolt">M7 2v11h3v9l7-12h-4l4-8z</StreamGeometry>
      <StreamGeometry x:Key="IconGlobe">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.93 6h-2.95a15.65 15.65 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14A8.2 8.2 0 0 1 4 12c0-.69.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.99 7.99 0 0 1 5.08 16zm2.95-8H5.08a7.99 7.99 0 0 1 4.33-3.56A15.65 15.65 0 0 0 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z</StreamGeometry>
      <StreamGeometry x:Key="IconReport">M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zM8 13h8v2H8v-2zm0 4h8v2H8v-2z</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
      <StreamGeometry x:Key="IconEmulator">M21 6H3a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zM8.5 13.5h-1.5v1.5h-1.5v-1.5h-1.5v-1.5h1.5v-1.5h1.5v1.5h1.5v1.5zm5 1a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm2.5-2.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm2.5 2.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z</StreamGeometry>
      <!-- Brand marks, drawn as they are published, so that a logo is what leads to its own site. -->
      <StreamGeometry x:Key="IconGitHub">M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z</StreamGeometry>
      <StreamGeometry x:Key="IconDiscord">M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.198.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z</StreamGeometry>
      <StreamGeometry x:Key="IconExternal">M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>
      <StreamGeometry x:Key="IconCoffee">M20 3H4v10a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-3h2a3 3 0 0 0 0-6zm0 5h-2V5h2a1 1 0 0 1 0 3zM4 19h16v2H4z</StreamGeometry>
      <StreamGeometry x:Key="IconHeart">M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z</StreamGeometry>

      <!-- The shade under anything laid over cover art, so a badge reads on any cover. -->
      <LinearGradientBrush x:Key="CoverScrim" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#A6000000" />
        <GradientStop Offset="0.25" Color="#00000000" />
        <GradientStop Offset="0.6" Color="#00000000" />
        <GradientStop Offset="1" Color="#CC000000" />
      </LinearGradientBrush>
      <!-- The detail panel's blurred cover fades into the panel instead of ending on an edge. -->
      <LinearGradientBrush x:Key="HeroFade" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#661A1514" />
        <GradientStop Offset="1" Color="#FF1A1514" />
      </LinearGradientBrush>
      <!-- The mark is a red logo with transparency, so the tile behind it is white: red on red
           would not read at 40px. -->
      <SolidColorBrush x:Key="LogoFill" Color="#FFFFFF" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Type scale: 11 caption, 12 small, 13 body, 15 subtitle, 20 title, 26 page. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{DynamicResource Faint}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.page">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- The label over each group in the detail panel and on the pages. -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <!-- The first-run step indicator: a dot per step, the one you are on drawn as a bar. -->
    <Style Selector="Border.pip">
      <Setter Property="Height" Value="6" />
      <Setter Property="Width" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.pip.done">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.pip.here">
      <Setter Property="Width" Value="22" />
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- A tinted square behind an icon: the tint says whether the row is fine or needs something. -->
    <Style Selector="Border.iconTile">
      <Setter Property="Width" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.iconTile > PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <!-- Descendant, not direct child: the tiles that can also show a spinner wrap their icon in a
         Panel, and a child selector left those icons the default colour on a tinted tile. -->
    <Style Selector="Border.iconTile.ok"><Setter Property="Background" Value="{DynamicResource OkSoft}" /></Style>
    <Style Selector="Border.iconTile.ok PathIcon"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></Style>
    <Style Selector="Border.iconTile.warn"><Setter Property="Background" Value="{DynamicResource WarnSoft}" /></Style>
    <Style Selector="Border.iconTile.warn PathIcon"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></Style>
    <Style Selector="Border.iconTile.err"><Setter Property="Background" Value="{DynamicResource ErrSoft}" /></Style>
    <Style Selector="Border.iconTile.err PathIcon"><Setter Property="Foreground" Value="{DynamicResource Err}" /></Style>

    <!-- Status pill: an icon and a word. -->
    <Style Selector="Border.status">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="7,3,9,3" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status PathIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status.ok"><Setter Property="Background" Value="{DynamicResource OkSoft}" /></Style>
    <Style Selector="Border.status.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></Style>
    <Style Selector="Border.status.ok PathIcon"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></Style>
    <Style Selector="Border.status.err"><Setter Property="Background" Value="{DynamicResource ErrSoft}" /></Style>
    <Style Selector="Border.status.err TextBlock"><Setter Property="Foreground" Value="{DynamicResource Err}" /></Style>
    <Style Selector="Border.status.err PathIcon"><Setter Property="Foreground" Value="{DynamicResource Err}" /></Style>

    <!-- Every button eases between states instead of snapping, and gives a little on press, so a
         click is felt even when the work behind it takes a moment to show. -->
    <Style Selector="Button">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#2EFFFFFF" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="BorderBrush" Value="#4DFFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <!-- A busy primary button keeps its colour, dimmed: grey reads as "not allowed" rather than
         "working on it". -->
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Button.large">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Uninstall is calm until pointed at, then says that it removes things. -->
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ErrSoft}" />
      <Setter Property="BorderBrush" Value="#99E05B4C" />
      <Setter Property="Foreground" Value="{DynamicResource Err}" />
    </Style>
    <!-- A choice in a picker: the ghost look without its fixed 36px height, because these carry a
         title over a wrapped sentence and that height clipped the sentence away entirely. -->
    <Style Selector="Button.pick">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pick:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="Button.pick:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Keyboard focus on our own buttons: a white ring, which reads on red and on dark alike. -->
    <Style Selector="Button.primary:focus-visible /template/ ContentPresenter, Button.ghost:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
    </Style>

    <!-- The spinner only turns while it is shown, so a hidden one costs no frames. -->
    <Style Selector="Arc.spin">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="StartAngle" Value="0" />
      <Setter Property="SweepAngle" Value="270" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Arc.spin[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The rail: one icon per page; the checked one gets a lit tile and an accent bar at the edge. -->
    <Style Selector="RadioButton.rail">
      <Setter Property="Width" Value="72" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Foreground" Value="{DynamicResource Faint}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Border Name="bar" Width="3" Height="22" CornerRadius="0,3,3,0" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentHover}" Opacity="0">
              <Border.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="bg" Width="44" Height="44" Background="Transparent" CornerRadius="10"
                    BorderBrush="Transparent" BorderThickness="1.5">
              <Border.Transitions>
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
              </Border.Transitions>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
            </Border>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.rail PathIcon">
      <Setter Property="Width" Value="21" />
      <Setter Property="Height" Value="21" />
    </Style>
    <Style Selector="RadioButton.rail:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
    </Style>
    <Style Selector="RadioButton.rail:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="RadioButton.rail:checked /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="RadioButton.rail:checked /template/ Border#bar">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="RadioButton.rail:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
    <Style Selector="RadioButton.rail:focus-visible /template/ Border#bg">
      <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
    </Style>

    <!-- A game tile: the picture is the button, so the whole thing is one target. It lifts on hover
         and gains a shadow, which is what says "this opens something". -->
    <Style Selector="Button.card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter, Button.card:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.card:pointerover, Button.card:focus-visible">
      <Setter Property="RenderTransform" Value="translateY(-4px)" />
    </Style>
    <Style Selector="Button.card:pressed">
      <Setter Property="RenderTransform" Value="translateY(-1px) scale(0.98)" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #50000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
          <BrushTransition Property="Background" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.card:pointerover Border.tile">
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="BoxShadow" Value="0 14 30 0 #A0000000" />
    </Style>
    <!-- Keyboard focus outlines the tile in white; the open one keeps the accent. -->
    <Style Selector="Button.card:focus-visible Border.tile">
      <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
      <Setter Property="BoxShadow" Value="0 14 30 0 #A0000000" />
    </Style>
    <Style Selector="Button.card.selected Border.tile, Button.card.selected:focus-visible Border.tile">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
      <Setter Property="BoxShadow" Value="0 0 0 2 #C4242C" />
    </Style>

    <!-- Small label over a cover: dark glass, so it reads on any artwork. -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#B80D0A0A" />
      <Setter Property="BorderBrush" Value="#24FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="7,2,7,3" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
    </Style>

    <!-- Installed: green, because it is good news; red on a red-branded app reads as an error. -->
    <Style Selector="Border.state">
      <Setter Property="Background" Value="#E6123A24" />
      <Setter Property="BorderBrush" Value="#995CB37E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="5,2,8,3" />
    </Style>
    <Style Selector="Border.state TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#E3F6EA" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.state PathIcon">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Ok}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Once, right after an install lands, so the tile that changed is the one the eye goes to. -->
    <Style Selector="Border.state.pulse">
      <Style.Animations>
        <Animation Duration="0:0:0.7" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="ScaleTransform.ScaleX" Value="0.6" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.6" />
          </KeyFrame>
          <KeyFrame Cue="45%">
            <Setter Property="ScaleTransform.ScaleX" Value="1.25" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.25" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- What a game renders with. The API reads first; the architecture is quieter. -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,1,6,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#DDD3D0" />
    </Style>
    <Style Selector="Border.tag.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style Selector="Border.tag.quiet TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Border.tag.bad">
      <Setter Property="Background" Value="{DynamicResource ErrSoft}" />
      <Setter Property="BorderBrush" Value="#80E05B4C" />
    </Style>
    <Style Selector="Border.tag.bad TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Err}" />
    </Style>

    <!-- Callout: an icon and a paragraph on a tinted ground. -->
    <Style Selector="Border.callout">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
      <Setter Property="BorderBrush" Value="#59DDA13A" />
    </Style>

    <!-- Report lines arrive with a short rise instead of appearing all at once. -->
    <Style Selector="Grid.line">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="6" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- The detail panel fades its backdrop in and rises into place; closing plays it backwards
         before it is hidden. -->
    <Style Selector="Panel#Drawer">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#Drawer.open">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel#Drawer Border#DrawerPanel">
      <Setter Property="RenderTransform" Value="translateY(16px) scale(0.98)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.24" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel#Drawer.open Border#DrawerPanel">
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- Install steps as a segmented bar: pending, the one running, the ones done, the one that failed. -->
    <Style Selector="Border.step Border.seg">
      <Setter Property="Height" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.25" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.step TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Faint}" />
    </Style>
    <Style Selector="Border.step.active Border.seg">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.step.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.step.done Border.seg">
      <Setter Property="Background" Value="{DynamicResource Ok}" />
    </Style>
    <Style Selector="Border.step.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ok}" />
    </Style>
    <Style Selector="Border.step.failed Border.seg">
      <Setter Property="Background" Value="{DynamicResource Err}" />
    </Style>
    <Style Selector="Border.step.failed TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Err}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The verdict: what an action did, or what the pre-flight found, where it cannot be missed. -->
    <Style Selector="Border.result">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    </Style>
    <Style Selector="Border.result[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Backward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-6" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.result.ok">
      <Setter Property="Background" Value="#175CB37E" />
      <Setter Property="BorderBrush" Value="#665CB37E" />
    </Style>
    <Style Selector="Border.result.warn">
      <Setter Property="Background" Value="#17DDA13A" />
      <Setter Property="BorderBrush" Value="#66DDA13A" />
    </Style>
    <Style Selector="Border.result.err">
      <Setter Property="Background" Value="#1FE05B4C" />
      <Setter Property="BorderBrush" Value="#80E05B4C" />
    </Style>

    <Style Selector="Border.toast">
      <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,10,18,10" />
      <Setter Property="BoxShadow" Value="0 12 36 0 #B0000000" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(12px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.toast.show">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="4,0,12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    </Style>

    <Style Selector="Expander.details">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Expander.details /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="Expander.details /template/ Border#ExpanderContent">
      <Setter Property="Background" Value="{DynamicResource Bg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
  </Application.Styles>
</Application>
