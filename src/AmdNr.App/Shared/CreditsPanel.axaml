<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmdNr.App.CreditsPanel">

  <!-- The same block on the first screen and in Settings: who made the network, where every piece
       lives, and that none of it is for sale. Each row is one target, so the logo is the link. -->
  <StackPanel Spacing="10">

    <!-- Discord's own blue, because a logo in the wrong colour reads as a screenshot of a logo. -->
    <Button x:Name="DiscordLink" Classes="pick" Padding="14,13" Click="OnOpen"
            HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="iconTile" Margin="0,0,13,0" Background="#5865F2">
          <PathIcon Data="{StaticResource IconDiscord}" Foreground="White" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{DynamicResource Str.CreditDiscordTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource Str.CreditDiscordBody}" Classes="muted" TextWrapping="Wrap"
                     LineHeight="18" />
        </StackPanel>
        <PathIcon Grid.Column="2" Data="{StaticResource IconExternal}" Width="13" Height="13"
                  Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Button>

    <Border Classes="callout">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Grid.Column="0" Data="{StaticResource IconWarn}" Width="17" Height="17"
                  Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,11,0" />
        <StackPanel Grid.Column="1" Spacing="5">
          <TextBlock Text="{DynamicResource Str.FreeTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{DynamicResource Warn}" />
          <TextBlock Text="{DynamicResource Str.FreeBody}" TextWrapping="Wrap" LineHeight="19"
                     Foreground="#F2D7A6" />
          <TextBlock Text="{DynamicResource Str.OpenSourceBody}" TextWrapping="Wrap" LineHeight="19"
                     Foreground="#F2D7A6" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Text="{DynamicResource Str.CreditsSection}" Classes="section" Margin="2,4,0,0" />

    <!-- The network first, because without it there is nothing here to install. -->
    <Button x:Name="RuntimeLink" Classes="pick" Padding="14,13" Click="OnOpen"
            HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="iconTile neutral" Margin="0,0,13,0">
          <PathIcon Data="{StaticResource IconGitHub}" Foreground="{DynamicResource Text}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{DynamicResource Str.CreditRuntimeTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource Str.CreditRuntimeBody}" Classes="muted" TextWrapping="Wrap"
                     LineHeight="18" />
        </StackPanel>
        <PathIcon Grid.Column="2" Data="{StaticResource IconExternal}" Width="13" Height="13"
                  Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Button>

    <Button x:Name="AddonLink" Classes="pick" Padding="14,13" Click="OnOpen"
            HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Classes="iconTile neutral" Margin="0,0,13,0">
          <PathIcon Data="{StaticResource IconGitHub}" Foreground="{DynamicResource Text}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{DynamicResource Str.CreditAddonTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource Str.CreditAddonBody}" Classes="muted" TextWrapping="Wrap"
                     LineHeight="18" />
        </StackPanel>
        <PathIcon Grid.Column="2" Data="{StaticResource IconExternal}" Width="13" Height="13"
                  Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
    </Button>

    <StackPanel Orientation="Horizontal" Spacing="9" Margin="2,4,0,0">
      <TextBlock Text="{DynamicResource Str.SupportSection}" Classes="section" VerticalAlignment="Center" />
      <TextBlock Text="{DynamicResource Str.SupportNote}" Classes="muted" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Side by side: two short links do not each need a line of their own. -->
    <Grid ColumnDefinitions="*,*">
      <Button x:Name="KofiLink" Grid.Column="0" Classes="pick" Padding="12,11" Click="OnOpen"
              Margin="0,0,6,0" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="32" Height="32" CornerRadius="9" Background="#00B9FE" Margin="0,0,11,0">
            <PathIcon Data="{StaticResource IconCoffee}" Width="17" Height="17" Foreground="White" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str.SupportKofiTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Str.SupportKofiBody}" Classes="muted" TextWrapping="Wrap"
                       LineHeight="17" />
          </StackPanel>
        </Grid>
      </Button>
      <Button x:Name="VakinhaLink" Grid.Column="1" Classes="pick" Padding="12,11" Click="OnOpen"
              Margin="6,0,0,0" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="32" Height="32" CornerRadius="9" Background="#12A150" Margin="0,0,11,0">
            <PathIcon Data="{StaticResource IconHeart}" Width="17" Height="17" Foreground="White" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str.SupportVakinhaTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Str.SupportVakinhaBody}" Classes="muted" TextWrapping="Wrap"
                       LineHeight="17" />
          </StackPanel>
        </Grid>
      </Button>
    </Grid>

  </StackPanel>
</UserControl>
