<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Type, surfaces, buttons and inputs: everything a page is built out of. -->

  <!-- Type scale: 11 caption, 12 small, 13 body, 15 subtitle, 20 title, 26 page. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource Faint}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.page">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The label over each group in the detail panel and on the pages. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- The first-run step indicator: a dot per step, the one you are on drawn as a bar. -->
  <Style Selector="Border.pip">
    <Setter Property="Height" Value="6" />
    <Setter Property="Width" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.pip.done">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.pip.here">
    <Setter Property="Width" Value="22" />
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- A tinted square behind an icon: the tint says whether the row is fine or needs something. -->
  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.iconTile > PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <!-- Descendant, not direct child: the tiles that can also show a spinner wrap their icon in a
       Panel, and a child selector left those icons the default colour on a tinted tile. -->
  <Style Selector="Border.iconTile.ok"><Setter Property="Background" Value="{DynamicResource OkSoft}" /></Style>
  <Style Selector="Border.iconTile.ok PathIcon"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></Style>
  <Style Selector="Border.iconTile.warn"><Setter Property="Background" Value="{DynamicResource WarnSoft}" /></Style>
  <Style Selector="Border.iconTile.warn PathIcon"><Setter Property="Foreground" Value="{DynamicResource Warn}" /></Style>
  <Style Selector="Border.iconTile.err"><Setter Property="Background" Value="{DynamicResource ErrSoft}" /></Style>
  <Style Selector="Border.iconTile.err PathIcon"><Setter Property="Foreground" Value="{DynamicResource Err}" /></Style>

  <!-- Status pill: an icon and a word. -->
  <Style Selector="Border.status">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="7,3,9,3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status.ok"><Setter Property="Background" Value="{DynamicResource OkSoft}" /></Style>
  <Style Selector="Border.status.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></Style>
  <Style Selector="Border.status.ok PathIcon"><Setter Property="Foreground" Value="{DynamicResource Ok}" /></Style>
  <Style Selector="Border.status.err"><Setter Property="Background" Value="{DynamicResource ErrSoft}" /></Style>
  <Style Selector="Border.status.err TextBlock"><Setter Property="Foreground" Value="{DynamicResource Err}" /></Style>
  <Style Selector="Border.status.err PathIcon"><Setter Property="Foreground" Value="{DynamicResource Err}" /></Style>

  <!-- Every button eases between states instead of snapping, and gives a little on press, so a
       click is felt even when the work behind it takes a moment to show. -->
  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="#4DFFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <!-- A busy primary button keeps its colour, dimmed: grey reads as "not allowed" rather than
       "working on it". -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="Button.large">
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- Uninstall is calm until pointed at, then says that it removes things. -->
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ErrSoft}" />
    <Setter Property="BorderBrush" Value="#99E05B4C" />
    <Setter Property="Foreground" Value="{DynamicResource Err}" />
  </Style>
  <!-- A choice in a picker: the ghost look without its fixed 36px height, because these carry a
       title over a wrapped sentence and that height clipped the sentence away entirely. -->
  <Style Selector="Button.pick">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pick:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="Button.pick:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
  </Style>
  <!-- The choice a dialog recommends: the primary look, keeping the picker's height. -->
  <Style Selector="Button.pick.main">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.pick.main:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="#4DFFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.pick.main:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Keyboard focus on our own buttons: a white ring, which reads on red and on dark alike. -->
  <Style Selector="Button.primary:focus-visible /template/ ContentPresenter, Button.ghost:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
  </Style>

  <!-- The spinner only turns while it is shown, so a hidden one costs no frames. -->
  <Style Selector="Arc.spin">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="StartAngle" Value="0" />
    <Setter Property="SweepAngle" Value="270" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Arc.spin[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.8" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Callout: an icon and a paragraph on a tinted ground. -->
  <Style Selector="Border.callout">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
    <Setter Property="BorderBrush" Value="#59DDA13A" />
  </Style>

  <!-- The API check rides on every game rather than on a problem with one, so it keeps the
       callout's shape and gives up its amber. Two amber boxes stacked and both read as neither. -->
  <Style Selector="Border.callout.check">
    <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>

  <!-- The verdict: what an action did, or what the pre-flight found, where it cannot be missed. -->
  <Style Selector="Border.result">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="Border.result[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Backward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="-6" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.result.ok">
    <Setter Property="Background" Value="#175CB37E" />
    <Setter Property="BorderBrush" Value="#665CB37E" />
  </Style>
  <Style Selector="Border.result.warn">
    <Setter Property="Background" Value="#17DDA13A" />
    <Setter Property="BorderBrush" Value="#66DDA13A" />
  </Style>
  <Style Selector="Border.result.err">
    <Setter Property="Background" Value="#1FE05B4C" />
    <Setter Property="BorderBrush" Value="#80E05B4C" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10,18,10" />
    <Setter Property="BoxShadow" Value="0 12 36 0 #B0000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translateY(12px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.toast.show">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="4,0,12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>

  <Style Selector="Expander.details">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Expander.details /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="Expander.details /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

</Styles>
