<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The rail and the library: game tiles, what is written over their covers, and the tags under them. -->

  <!-- The rail: one icon per page; the checked one gets a lit tile and an accent bar at the edge. -->
  <Style Selector="RadioButton.rail">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource Faint}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="bar" Width="3" Height="22" CornerRadius="0,3,3,0" HorizontalAlignment="Left"
                  Background="{DynamicResource AccentHover}" Opacity="0">
            <Border.Transitions>
              <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions>
            </Border.Transitions>
          </Border>
          <Border Name="bg" Width="44" Height="44" Background="Transparent" CornerRadius="10"
                  BorderBrush="Transparent" BorderThickness="1.5">
            <Border.Transitions>
              <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" /></Transitions>
            </Border.Transitions>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.rail PathIcon">
    <Setter Property="Width" Value="21" />
    <Setter Property="Height" Value="21" />
  </Style>
  <Style Selector="RadioButton.rail:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
  <Style Selector="RadioButton.rail:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="RadioButton.rail:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="RadioButton.rail:checked /template/ Border#bar">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="RadioButton.rail:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="RadioButton.rail:focus-visible /template/ Border#bg">
    <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
  </Style>

  <!-- A game tile: the picture is the button, so the whole thing is one target. It lifts on hover
       and gains a shadow, which is what says "this opens something". -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter, Button.card:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pointerover, Button.card:focus-visible">
    <Setter Property="RenderTransform" Value="translateY(-4px)" />
  </Style>
  <Style Selector="Button.card:pressed">
    <Setter Property="RenderTransform" Value="translateY(-1px) scale(0.98)" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #50000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        <BrushTransition Property="Background" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover Border.tile">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BoxShadow" Value="0 14 30 0 #A0000000" />
  </Style>
  <!-- Keyboard focus outlines the tile in white; the open one keeps the accent. -->
  <Style Selector="Button.card:focus-visible Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
    <Setter Property="BoxShadow" Value="0 14 30 0 #A0000000" />
  </Style>
  <Style Selector="Button.card.selected Border.tile, Button.card.selected:focus-visible Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    <Setter Property="BoxShadow" Value="0 0 0 2 #C4242C" />
  </Style>

  <!-- Grid or list: two icon buttons in one pill, the one in use lit. -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.seg.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceTop}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <!-- The filter button while it hides some games. -->
  <Style Selector="Button#FilterButton.on /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button#FilterButton.on PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.seg PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- The list view's game list: one card down the left, a row per game, the open one lit in the accent. -->
  <Style Selector="Border.gameList">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.gameList ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Border.gameList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
  </Style>
  <Style Selector="Border.gameList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="Border.gameList ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.gameList Ellipse.update">
    <Setter Property="Fill" Value="{DynamicResource Warn}" />
  </Style>

  <!-- The tile's buttons, over a darkened cover, only while the pointer is on it. Not hit-testable
       while hidden, so a click on a tile at rest still opens the sheet. -->
  <Style Selector="Border.hoverActions">
    <Setter Property="Background" Value="#B8000000" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover Border.hoverActions">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <!-- The sheet's cover button: there when the cover is pointed at or the button has focus. -->
  <Style Selector="Button.coverEdit">
    <Setter Property="Background" Value="#CC0B0808" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border#CoverBox:pointerover Button.coverEdit, Button.coverEdit:focus-visible, Button.coverEdit:flyout-open">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Small label over a cover: dark glass, so it reads on any artwork. -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#B80D0A0A" />
    <Setter Property="BorderBrush" Value="#24FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2,7,3" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#E6FFFFFF" />
  </Style>

  <!-- Installed: green, because it is good news; red on a red-branded app reads as an error. -->
  <Style Selector="Border.state">
    <Setter Property="Background" Value="#E6123A24" />
    <Setter Property="BorderBrush" Value="#995CB37E" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="5,2,8,3" />
  </Style>
  <Style Selector="Border.state TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#E3F6EA" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.state PathIcon">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Once, right after an install lands, so the tile that changed is the one the eye goes to. -->
  <Style Selector="Border.state.pulse">
    <Style.Animations>
      <Animation Duration="0:0:0.7" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0.6" />
          <Setter Property="ScaleTransform.ScaleY" Value="0.6" />
        </KeyFrame>
        <KeyFrame Cue="45%">
          <Setter Property="ScaleTransform.ScaleX" Value="1.25" />
          <Setter Property="ScaleTransform.ScaleY" Value="1.25" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- What a game renders with. The API reads first; the architecture is quieter. -->
  <Style Selector="Border.tag">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1,6,2" />
    <Setter Property="Margin" Value="0,0,4,0" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#DDD3D0" />
  </Style>
  <Style Selector="Border.tag.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>
  <Style Selector="Border.tag.quiet TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.tag.bad">
    <Setter Property="Background" Value="{DynamicResource ErrSoft}" />
    <Setter Property="BorderBrush" Value="#80E05B4C" />
  </Style>
  <Style Selector="Border.tag.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Err}" />
  </Style>

</Styles>
