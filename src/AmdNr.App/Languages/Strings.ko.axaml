<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Korean">

  <!-- 한국어. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Radeon에서 DLSS 5 뉴럴 렌더링을, 설치는 대신 해 드립니다</sys:String>
  <sys:String x:Key="Str.Games">게임</sys:String>
  <sys:String x:Key="Str.RemoveGame">목록에서 제거</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">게임을 목록에서 제거하고, "게임 검색"에서도 제외합니다. 게임 폴더의 파일은 전혀 건드리지 않으며, 설정에서 다시 되돌릴 수 있습니다.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0}을(를) 목록에서 제거했으며, "게임 검색"에서도 제외됩니다. 폴더 안의 파일은 건드리지 않았습니다. "설정 &gt; 제외한 게임"에서 되돌릴 수 있습니다.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0}을(를) 목록에서 제거했지만, 애드온은 아직 그 폴더에 설치되어 있습니다. 제거하려면 "설정 &gt; 제외한 게임"에서 게임을 되돌리세요.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">제외한 게임</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">목록에서 제거한 게임입니다. "게임 검색"이 이 게임들을 건너뛰므로, 여기서 되돌리기 전까지는 목록에 나타나지 않습니다.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">제외한 게임이 없습니다.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">목록으로 되돌리기</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0}이(가) 다시 목록에 추가되었습니다.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">{0}의 폴더가 더 이상 없으므로, 제외한 게임에서만 빠졌습니다.</sys:String>
  <sys:String x:Key="Str.NoGames">아직 아무것도 없습니다. 게임이나 에뮬레이터가 실행되는 폴더를 추가하세요.</sys:String>
  <sys:String x:Key="Str.PickFolder">게임이 실행되는 폴더를 선택하세요</sys:String>
  <sys:String x:Key="Str.AddGameMany">폴더 검색</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">게임을 보관하는 폴더를 선택하세요</sys:String>
  <sys:String x:Key="Str.AddGameNone">"{0}"에서 게임으로 보이는 것을 찾지 못했습니다.</sys:String>
  <sys:String x:Key="Str.Preset">설치 방식</sys:String>
  <sys:String x:Key="Str.Install">설치</sys:String>
  <sys:String x:Key="Str.Uninstall">제거</sys:String>
  <sys:String x:Key="Str.OpenFolder">폴더 열기</sys:String>
  <sys:String x:Key="Str.System">이 PC</sys:String>
  <sys:String x:Key="Str.Gpu">그래픽</sys:String>
  <sys:String x:Key="Str.Driver">드라이버</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 런타임</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll을 찾을 수 없습니다. 최신 Adrenalin 드라이버에 포함되어 있으며, HIP 6으로는 안 됩니다.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Radeon이 아닌 것 같습니다. 신경망은 RDNA3와 RDNA4에서만 동작합니다.</sys:String>
  <sys:String x:Key="Str.Ready">준비됨</sys:String>
  <sys:String x:Key="Str.Payloads">파일</sys:String>
  <sys:String x:Key="Str.Downloading">다운로드 중</sys:String>
  <sys:String x:Key="Str.Verifying">이미 있는 파일을 확인하는 중…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">다운로드 및 검증 완료.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">공개된 다운로드 목록을 읽을 수 없어, 이 앱에 포함된 사본을 사용합니다.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">다운로드 목록을 읽을 수 없습니다. 인터넷 연결을 확인한 뒤 다시 시도하세요.</sys:String>
  <sys:String x:Key="Str.Language">언어</sys:String>
  <sys:String x:Key="Str.UpdateWorking">업데이트를 다운로드하는 중…</sys:String>
  <sys:String x:Key="Str.Dismiss">나중에</sys:String>
  <sys:String x:Key="Str.LogSaved">전체 로그를 이 앱 옆에 저장했습니다.</sys:String>
  <sys:String x:Key="Str.Working">작업 중…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">게임 목록을 읽을 수 없었습니다. 기존 목록은 옆에 {0}(으)로 보관하고 새 목록을 만들었습니다.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">아직 게임 폴더에 쓰는 중입니다. 몇 초면 끝나니, 완료된 뒤에 창을 닫으세요.</sys:String>
  <sys:String x:Key="Str.FreeTitle">이것은 무료입니다. 돈을 냈다면 사기를 당한 것입니다.</sys:String>
  <sys:String x:Key="Str.FreeBody">이 중 어느 것도 판매하지 않습니다. 설치 프로그램도, 애드온도, 런타임도, 가중치도요. 이것에 대해, 혹은 "키"나 "프로 버전"에 대해 돈을 요구받았다면 환불을 요청하세요. 여러분이 산 것은 이 페이지에서 무료로 제공됩니다.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">오픈 소스이며 앞으로도 그렇습니다. 읽고, 수정하고, 직접 빌드하고, 친구에게 나눠 주세요. 저희가 부탁드리는 것은 단 하나, 누구도 이것을 유료 버전으로 만들지 않는 것입니다.</sys:String>
  <sys:String x:Key="Str.SupportSection">후원</sys:String>
  <sys:String x:Key="Str.SupportNote">선택 사항이며, 무언가를 사는 것이 아닙니다</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">커피 한 잔, 한 번만.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">프로젝트의 브라질 모금.</sys:String>
  <sys:String x:Key="Str.SupportRail">AMD-NR 후원</sys:String>
  <sys:String x:Key="Str.SupportTitle">AMD-NR이 계속되도록</sys:String>
  <sys:String x:Key="Str.SupportBody">이 프로젝트는 사용하는 분들의 후원으로만 이어집니다. 두 사람, 그래픽카드 두 장, 그리고 오후의 작업 시간뿐입니다. 회사도 후원사도 없습니다. 여기 있는 모든 것은 무료이며 앞으로도 무료입니다. 후원으로 잠금 해제되는 것은 없고, 작업을 이어가게 해 줍니다.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">브라질에 계신가요? Vakinha는 Pix, 카드, boleto를 받습니다.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD, 제작: danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">신경망 그 자체이자 이 모든 것이 존재하는 이유입니다. DLSS 5의 뉴럴 렌더링을 처음으로 Radeon에서 돌아가게 만든 것이 바로 이것입니다. 이 앱이 다운로드하는 런타임과 가중치는 저희가 아니라 그의 작업입니다. 고마워요, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd, 애드온</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">그 신경망을 ReShade를 통해 게임에 연결하는 부분입니다. 이 앱이 설치하는 애드온과, 선택할 수 있는 릴리스들입니다. MIT 라이선스이며, 이 설치 프로그램과는 별도의 저장소입니다.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord, 모두가 모이는 곳</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">새 빌드, 어떤 게임에서 무엇이 되는지, 그리고 문제가 생겼을 때 물어볼 곳입니다.</sys:String>
  <sys:String x:Key="Str.CreditsSection">크레딧</sys:String>
  <sys:String x:Key="Str.Scan">게임 검색</sys:String>
  <sys:String x:Key="Str.Scanning">Steam, Epic, GOG, EA, Ubisoft, Battle.net, Xbox를 읽는 중…</sys:String>
  <sys:String x:Key="Str.Search">게임 검색…</sys:String>
  <sys:String x:Key="Str.Settings">설정</sys:String>
  <sys:String x:Key="Str.WillDownload">파일은 설치할 때 다운로드되고 검증됩니다.</sys:String>
  <sys:String x:Key="Str.NoRoute">이 게임이 렌더링에 쓰는 방식 중 설치 방식이 있는 것이 없습니다. 애드온은 D3D11, D3D12, Vulkan, OpenGL에서 동작하며, 32비트 게임에서는 D3D8, D3D9, D3D11에서 동작합니다. 32비트 OpenGL 게임, 64비트 D3D9 게임, 소프트웨어 렌더러는 설치 방식이 없습니다.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">이 게임은 {1}에서 실행할 수 있습니다. 게임 자체의 그래픽 설정에서 {0}(으)로 바꾸세요. 여기서 고른 설치 방식이 그것이며, 다른 API에서는 애드온에게 전혀 다른 게임이 됩니다.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">언리얼 엔진 게임입니다. 실행 옵션에 -{0}을(를) 추가하세요.</sys:String>
  <sys:String x:Key="Str.CheckWiki">PCGamingWiki에서 이 게임 찾아보기</sys:String>
  <sys:String x:Key="Str.EmptyTitle">아직 게임이 없습니다</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">일치하는 항목 없음</sys:String>
  <sys:String x:Key="Str.NoMatch">목록에 "{0}"과(와) 일치하는 게임이 없습니다.</sys:String>
  <sys:String x:Key="Str.ScanningShort">검색 중…</sys:String>
  <sys:String x:Key="Str.ScanDone">검색 완료: 게임 {0}개를 찾았으며, 그중 {1}개가 새 게임입니다.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">설치됨</sys:String>
  <sys:String x:Key="Str.Close">닫기</sys:String>
  <sys:String x:Key="Str.CloseHint">닫기(Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">게임 실행 파일</sys:String>
  <sys:String x:Key="Str.ExeChoose">선택…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">감지된 파일 사용</sys:String>
  <sys:String x:Key="Str.ExeNone">이 폴더에서 실행 파일을 찾지 못했습니다.</sys:String>
  <sys:String x:Key="Str.ExeNote">설치 방식은 이 파일을 보고 판단합니다. 비트 수가 이상해 보이면(루트에는 런처, 게임 본체는 Bin64에 있는 경우) 올바른 .exe를 지정하세요.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">직접 고른 파일이므로, 다시 검색해도 감지 과정이 이 파일을 바꾸지 않습니다.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">그 파일은 이 게임의 폴더 안에 있지 않습니다.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">그 파일은 읽을 수 있는 Windows 실행 파일이 아닙니다.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">이 설치 방식은 {0} 게임용인데, 위의 실행 파일은 {1}입니다. 그대로 진행할 수는 있지만(감지가 잘못된 파일을 읽었을 수도 있습니다), 올바른 파일을 읽은 것이라면 로드되지 않습니다.</sys:String>
  <sys:String x:Key="Str.VersionSection">애드온 버전</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade 로드 이름</sys:String>
  <sys:String x:Key="Str.ProxyNote">"자동"은 모든 Direct3D에 쓸 수 있는 dxgi.dll을 사용합니다. 게임이 이를 로드하지 않을 때만 바꾸세요.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler 로드 이름</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">'자동'은 OptiScaler 위키가 이 게임에 제시하는 첫 번째 파일 이름을 사용하고, 없으면 여기서 이미 쓰는 이름을, 그것도 없으면 dxgi.dll을 사용합니다. 다른 프로그램의 dxgi.dll을 유지하려면 winmm.dll을 선택하세요.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">자동</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">자동(위키: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">지금 모두 다운로드</sys:String>
  <sys:String x:Key="Str.ClearCache">캐시 비우기</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">다운로드한 파일, 커버, 버전 목록을 삭제합니다. 게임에 설치된 것은 건드리지 않으며, 다음 설치 때 필요한 것을 다시 다운로드합니다.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">비우기</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">다음에 설치할 때 안의 모든 것을 다시 다운로드합니다.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">캐시를 그대로 둡니다.</sys:String>
  <sys:String x:Key="Str.CacheCleared">캐시를 비웠습니다. {0}를 확보했습니다.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">모든 파일이 이미 있었고, 방금 모든 바이트를 검증했습니다.</sys:String>
  <sys:String x:Key="Str.VersionShipped">기본 포함</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">이 설치 프로그램이 배포될 때 함께 포함된 버전입니다.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">GitHub의 v{0} 릴리스에서 가져와, 해당 해시로 검증했습니다.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler 버전</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}. GitHub 릴리스에서 가져왔으며, 모든 파일을 해시로 검증했습니다.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">lmxxf의 가중치를 포함합니다(약 590 MB, RDNA4 전용).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">mochizuki도 함께 설치할 수 있습니다. "NR 런타임"을 참고하세요.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR 런타임</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">두 번째 NR 런타임으로 mochizuki도 설치(실험적)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">mochizuki0323이 Vulkan으로 포팅한 DLSS 5 신경망입니다. RDNA4 전용: RX 9000 시리즈, AMD 드라이버 25.10 이상. MochizukiNrRuntime.dll과 모델이 든 dlssnr-amd 폴더를 추가하며, 다운로드는 약 141 MB입니다. NR 런타임은 계속 danielblnc의 것입니다. mochizuki를 쓰려면 OptiScaler의 Neural 탭에 있는 "NR runtime"에서 선택한 뒤 게임을 다시 시작하세요. 게임마다 처음 실행할 때 몇 초 동안 신경망을 컴파일합니다. 체크를 해제하면 다음 설치 때 이 앱이 넣은 부분을 제거합니다.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">두 번째 NR 런타임으로 mochizuki도 설치(실험적)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">mochizuki0323이 Vulkan으로 포팅한 DLSS 5 신경망으로, 애드온은 v0.6.8부터 danielblnc의 신경망 대신 이것을 실행할 수 있습니다. RDNA4 전용: RX 9000 시리즈, AMD 드라이버 25.10 이상. MochizukiNrRuntime.dll과 모델이 든 dlssnr-amd 폴더를 추가하며, 다운로드는 약 141 MB입니다. 사용하려면 애드온 패널의 "NR runtime"에서 mochizuki (Vulkan)를 선택한 뒤 게임을 다시 시작하세요. 게임마다 처음 실행할 때 최대 1분 동안 신경망을 컴파일합니다. 체크를 해제하면 다음 설치 때 이 앱이 넣은 부분을 제거합니다.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">이 그래픽 카드({0})에서는 제공되지 않습니다. mochizuki에는 RDNA4(RX 9000 시리즈)의 FP8 행렬 명령어가 필요합니다.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">이 앱이 그래픽 카드를 식별하지 못했습니다. RX 9000 시리즈가 아닌 카드에서는 게임 안에서 mochizuki가 꺼진 상태로 유지됩니다.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">설치 방식을 선택하세요</sys:String>
  <sys:String x:Key="Str.PickRouteBody">{0}이(가) 어떤 그래픽 API로 렌더링하는지 이 앱이 알아내지 못해, 설치 방식을 대신 고르지 않습니다. 설정에서 DLSS, FSR, XeSS를 제공하는 D3D12 게임에는 OptiScaler가, 그 밖의 게임에는 D3D11 또는 D3D12의 ReShade가 맞습니다. 선택할 때까지 "설치"는 대기합니다.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">그래픽 API를 알 수 없으므로, 아래에서 설치 방식을 직접 고르세요.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc의 런타임</sys:String>
  <sys:String x:Key="Str.SupporterChoose">이 게임에 어떤 런타임 빌드를 넣을지 고릅니다. 강조 표시된 카드가 사용됩니다.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">이 앱이 다운로드하고 검증합니다.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">내 version.dll 또는 설치 파일 선택…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">다른 파일 선택…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Public Release보다 새로운 빌드로, 직접 가진 version.dll 또는 danielblnc의 설치 파일에서 가져옵니다.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0에는 RDNA3 그래픽 카드용 커널이 추가되었습니다.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">이 앱은 절대 다운로드하거나 공유하지 않습니다. 사용자의 파일은 SHA-256으로 검증한 뒤 보관하므로, 다른 게임에서 다시 묻지 않습니다.</sys:String>
  <sys:String x:Key="Str.SupporterUse">내 서포터 파일 사용…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">사용자의 version.dll 또는 dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">모든 DLL 또는 설치 파일</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">사용 중: 이 앱이 다운로드하는 런타임.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">사용자의 파일에서 가져온 {0}을(를) 사용 중입니다.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">{0}을(를) 사용 중입니다. 이전에 선택했을 때 이 앱이 보관해 둔 검증된 사본입니다.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">{0}이(가) 선택되어 있지만, 이 PC에는 아직 사본이 없습니다. version.dll 또는 설치 파일을 선택하세요.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0}에는 애드온 v{1} 이상이 필요합니다. "애드온 버전"에서 선택하세요. 그때까지는 다운로드한 버전이 설치됩니다.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0}에는 OptiScaler {1} 이상이 필요합니다. "OptiScaler 버전"에서 선택하세요. 그때까지는 다운로드한 버전이 설치됩니다.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">애드온은 아직 {0}을(를) 실행할 수 없습니다. 다운로드 목록에 해당 패치가 없기 때문입니다. 패치가 들어오기 전까지 여기에는 다운로드한 버전이 설치되며, OptiScaler 설치 방식은 그대로 실행할 수 있습니다.</sys:String>
  <sys:String x:Key="Str.SupporterKept">검증 후 보관함: danielblnc의 런타임 {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">그 파일은 사용할 수 없습니다. {0}</sys:String>
  <sys:String x:Key="Str.Checking">이 폴더를 확인하는 중…</sys:String>
  <sys:String x:Key="Str.StepDownload">다운로드</sys:String>
  <sys:String x:Key="Str.StepVerify">검증</sys:String>
  <sys:String x:Key="Str.StepInstall">설치</sys:String>
  <sys:String x:Key="Str.StepDone">완료</sys:String>
  <sys:String x:Key="Str.Installing">설치 중…</sys:String>
  <sys:String x:Key="Str.Removing">제거 중…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} 설정이 끝났습니다. 게임을 실행해 사용하세요.</sys:String>
  <sys:String x:Key="Str.InstallWarn">{0}에 설치했습니다. 아래에서 확인할 경고가 {1}개 있습니다.</sys:String>
  <sys:String x:Key="Str.InstallFail">{0}에 대한 설치가 끝나지 않았습니다.</sys:String>
  <sys:String x:Key="Str.UninstallOk">{0}에서 제거했습니다.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">{0}에서 제거했습니다. 아래에서 확인할 경고가 {1}개 있습니다.</sys:String>
  <sys:String x:Key="Str.UninstallFail">{0}에서 모든 것을 제거하지 못했습니다.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0}은(는) 여전히 설치된 것으로 간주됩니다. 이 앱의 파일 하나를 제거하지 못했습니다. 게임을 닫고 다시 제거하세요.</sys:String>
  <sys:String x:Key="Str.UninstallClean">{0}에서 제거했습니다. 폴더에 이 앱의 것은 아무것도 남아 있지 않습니다.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">{0}에서 제거했습니다. 사용자 설정만 남았습니다: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">설정도 삭제할까요?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">이 앱이 {0}에 설치한 것은 모두 사라졌습니다. 다음 설정 파일은 남아 있으며, 오버레이에서 설정한 내용이 들어 있습니다:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">이것들도 삭제</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">폴더가 설치 전 상태로 돌아갑니다.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">내 설정 유지</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">다음에 설치할 때를 위해 남겨 둡니다.</sys:String>
  <sys:String x:Key="Str.ResultErrors">아래에 문제가 {0}개 있습니다.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">파일을 다운로드할 수 없어, 아무것도 설치하지 않았습니다.</sys:String>
  <sys:String x:Key="Str.Folder">폴더</sys:String>
  <sys:String x:Key="Str.GameCount">게임 {0}개</sys:String>
  <sys:String x:Key="Str.UnknownApi">알 수 없는 API</sys:String>
  <sys:String x:Key="Str.Location">위치</sys:String>
  <sys:String x:Key="Str.Details">세부 정보</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0}줄</sys:String>
  <sys:String x:Key="Str.PreflightOk">설치 준비 완료</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">문제가 없습니다. 아래에서 설치 방식을 고르고 "설치"를 누르세요.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">설치 준비 완료, 확인할 내용 {0}개</sys:String>
  <sys:String x:Key="Str.PreflightErr">이 폴더에서 문제 {0}개를 발견했습니다</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">이 게임에 설치됨</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">게임을 실행해 사용하세요. 다시 설치하면 파일을 새로 고치고, 제거하면 파일을 지웁니다.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">설치됨, 업데이트 있음</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">이 게임의 파일은 이 앱이 지금 설치하는 것보다 오래되었습니다. 업데이트하면 교체되며, 설정은 그대로 남습니다.</sys:String>
  <sys:String x:Key="Str.SeeDetails">아래의 "세부 정보"를 열어 발견된 내용을 확인하세요.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">애드온이 이 PC에 요구하는 것으로, 앱이 시작될 때 확인합니다.</sys:String>
  <sys:String x:Key="Str.SystemReady">이 PC는 애드온에 필요한 것을 갖추고 있습니다</sys:String>
  <sys:String x:Key="Str.SystemNotReady">이 PC에 애드온에 필요한 것이 빠져 있습니다</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon 감지됨</sys:String>
  <sys:String x:Key="Str.GpuBad">Radeon 아님</sys:String>
  <sys:String x:Key="Str.Missing">없음</sys:String>
  <sys:String x:Key="Str.DriverHint">Windows가 보고하는 그래픽 드라이버 버전입니다.</sys:String>
  <sys:String x:Key="Str.FilesHint">한 번만 다운로드하고, 고정된 해시로 검증한 뒤, 모든 게임에서 다시 사용합니다.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">검증됨</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">다운로드 안 됨</sys:String>
  <sys:String x:Key="Str.DownloadingShort">다운로드 중…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">다운로드 중 {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">언어, 업데이트, 이 앱 정보.</sys:String>
  <sys:String x:Key="Str.LanguageHint">모든 문구가 바로 바뀝니다. 다시 시작할 필요가 없습니다.</sys:String>
  <sys:String x:Key="Str.DataFolder">데이터 폴더</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D11 게임</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12 게임</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan 게임</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL 게임</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D11 게임, 32비트</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9 게임, 32비트</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8 게임, 32비트</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: DLSS, FSR 또는 XeSS가 있는 D3D12 게임</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">에뮬레이터를 Direct3D 11로 설정하세요. 신경망이 가장 많은 정보를 받는 렌더러로, 에뮬레이터의 깊이 정보와, 보조 효과가 설치되어 있다면 그 움직임 정보까지 받습니다. 게임별 설정에 주의하세요. 전체 설정을 알리지 않고 덮어씁니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">실험적. Vulkan에서 ReShade는 프록시 DLL이 아니라 레이어입니다. 설치 시 사용자의 Windows 계정에 등록하고, ReShade.ini로 rpcs3.exe에 대해 켭니다. Vulkan에는 깊이 정보가 없고, 색과 추정한 움직임만 있습니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">가장 좋은 설치 방식입니다. 게임 자체의 모션 벡터가 깊이 정보와 함께 신경망에 전달되는 것은 D3D11뿐입니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">기능이 제한됩니다. D3D12에서 애드온은 게임의 깊이 정보는 찾지만 모션 벡터는 찾지 못하므로, 신경망은 색과 깊이를 받고 움직임은 추정합니다. 동작은 하지만 효과는 덜합니다. 설정에 DLSS, FSR, XeSS가 있는 게임이라면 OptiScaler 설치 방식이 더 잘 맞습니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">D3D12 게임에 권장. ReShade 대신 OptiScaler를 설치합니다. OptiScaler는 게임의 DLSS, FSR 또는 XeSS를 넘겨받아 그 안에서 신경망을 실행하며, 게임 자체의 깊이 정보와 모션 벡터를 사용합니다. 게임이 이 업스케일러 중 하나를 지원하고, 설정에서 켜져 있어야 합니다. 게임 안에서 Insert 키를 누르고 Neural 탭을 열어 "Enable NR"을 켜세요. 레이 리컨스트럭션(Ray Reconstruction)을 쓰는 게임은 처리 지점을 "After the finished frame"으로 설정해야 합니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">실험적. Vulkan에서 ReShade는 레이어입니다. 설치 시 사용자의 Windows 계정에 등록하고, .exe 옆의 ReShade.ini로 이 프로그램에 대해 켭니다. Vulkan에는 깊이 정보가 없습니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">실험적. Vulkan과 달리 여기서는 일반적인 프록시 DLL입니다. ReShade가 opengl32.dll로 게임 옆에 들어가며, 별도의 설치 프로그램은 실행하지 않습니다. 색과 추정한 움직임만 있으며, 이 API에서 게임의 깊이 정보에 접근할 수는 있지만 아직 연결되지 않았습니다. 32비트 OpenGL 게임은 설치 방식이 없습니다.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">실험적. 32비트 게임은 64비트 런타임을 로드할 수 없으므로, 애드온은 하나의 어댑터에서 프레임을 공유하는 두 개의 프로세스로 동작합니다. 애드온을 지원하는 ReShade를 32비트 dxgi.dll로 설치하세요.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">실험적. D3D11과 같은 32비트 프로세스 쌍을, 별도의 D3D9/D3D11 중계 단계를 거쳐 사용합니다. 일반 D3D9는 프레임마다 몇 밀리초의 고정 비용이 들지만, D3D9Ex는 그렇지 않습니다. ReShade를 32비트 d3d9.dll로 설치하세요.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">실험적. D3D8은 D3D9로 변환된 뒤, 같은 32비트 프로세스 쌍으로 위의 D3D9 설치 방식을 따릅니다. ReShade를 32비트 d3d9.dll로 설치하세요.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM에는 자체 안티치트가 있습니다. 본인 책임이며, 서버 규칙을 확인하세요. 애드온과 ReShade는 FiveM.app\plugins에, 런타임과 가중치는 게임 프로세스 옆 data\cache\subprocess에 들어갑니다. plugins에 이미 있는 것(ReShade.ini, 프리셋, 셰이더, 다른 애드온, ENB)은 그대로 둡니다.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">환영합니다</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Radeon 그래픽 카드에서 ReShade 또는 OptiScaler를 통해 DLSS 5 Neural Rendering 신경망을 사용합니다. 간단한 4단계입니다.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">이 PC</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">파일</sys:String>
  <sys:String x:Key="Str.SetupStepGames">내 게임</sys:String>
  <sys:String x:Key="Str.SetupBack">뒤로</sys:String>
  <sys:String x:Key="Str.SetupNext">계속</sys:String>
  <sys:String x:Key="Str.SetupFinish">사용 시작</sys:String>
  <sys:String x:Key="Str.SetupSkip">지금은 건너뛰기</sys:String>
  <sys:String x:Key="Str.SetupStepOf">{1}단계 중 {0}단계</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">애드온이 동작하지 못하게 하는 두 가지가 있으며, 둘 다 여기서 확인할 수 있습니다. 어느 쪽도 계속 진행하는 것을 막지는 않으며, 게임 안에서 동작하지 않을 뿐입니다.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">이 PC는 애드온에 필요한 것을 모두 갖추고 있습니다.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">빠진 것이 있습니다. 계속 진행하고 나중에 고쳐도 되지만, 고치기 전까지는 게임 안에서 동작하지 않습니다.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">모든 게임이 같은 파일을 사용합니다. 한 번만 다운로드하고, 고정된 해시로 검증한 뒤 다시 사용합니다.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">다시 시도</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">건너뛰면 첫 설치 때 다운로드됩니다.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">런처 정보는 읽기만 합니다. 살펴보는 것만으로는 아무것도 설치되거나 바뀌지 않습니다. 폴더는 나중에 직접 추가할 수 있습니다.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">각 게임을 분석해 어떤 그래픽 API를 쓰는지 판단하며, 대개는 맞지만 항상 그렇지는 않습니다. 한 폴더에 D3D11과 D3D12 실행 파일이 함께 있을 수 있고, 실행 파일이 예전 API도 지원하더라도 게임은 기본적으로 다른 API를 쓸 수 있습니다. 설치하기 전에 pcgamingwiki.com에서 게임을 확인해 보는 것이 좋습니다. 게임 카드마다 바로 가는 링크가 있습니다.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">게임을 찾지 못했습니다. 메인 창에서 폴더를 직접 추가할 수 있습니다.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">게임 {0}개를 찾았습니다.</sys:String>
  <sys:String x:Key="Str.Unexpected">예상치 못한 문제가 발생했습니다. 전체 로그를 저장했습니다.</sys:String>
  <sys:String x:Key="Str.Play">플레이</sys:String>
  <sys:String x:Key="Str.Launch">열기</sys:String>
  <sys:String x:Key="Str.Configure">설정</sys:String>
  <sys:String x:Key="Str.ViewGrid">커버 그리드</sys:String>
  <sys:String x:Key="Str.ViewList">목록과 옆에 게임 페이지</sys:String>
  <sys:String x:Key="Str.AutoUpdate">자동 업데이트</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">새 빌드가 나오면, 앱을 열 때 이 게임을 자동으로 업데이트합니다.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">게임 {0}개를 자동으로 업데이트했습니다.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">게임 {0}개를 자동으로 업데이트했습니다.</sys:String>
  <sys:String x:Key="Str.Rename">이름 바꾸기</sys:String>
  <sys:String x:Key="Str.Save">저장</sys:String>
  <sys:String x:Key="Str.Cancel">취소</sys:String>
  <sys:String x:Key="Str.ChangeCover">커버</sys:String>
  <sys:String x:Key="Str.CoverPick">이미지 선택…</sys:String>
  <sys:String x:Key="Str.CoverReset">온라인에서 찾은 커버 사용</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">이 게임의 커버 선택</sys:String>
  <sys:String x:Key="Str.CoverFiles">이미지</sys:String>
  <sys:String x:Key="Str.CoverFailed">그 파일을 이미지로 읽을 수 없습니다.</sys:String>
  <sys:String x:Key="Str.Customize">사용자 지정</sys:String>
  <sys:String x:Key="Str.HeroPick">배너 선택…</sys:String>
  <sys:String x:Key="Str.HeroReset">온라인에서 찾은 배너 사용</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">이 게임의 배너 선택</sys:String>
  <sys:String x:Key="Str.PlayFailed">실행할 수 없습니다. "폴더 열기"로 실행 파일을 직접 실행하세요.</sys:String>
  <sys:String x:Key="Str.AddEmulator">에뮬레이터 추가</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">에뮬레이터 추가</sys:String>
  <sys:String x:Key="Str.EmulatorBody">어떤 에뮬레이터인지 고른 뒤, 그것이 실행되는 폴더를 지정하세요. ROM 폴더가 아니라 실행 파일이 있는 폴더입니다.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">다른 에뮬레이터</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">폴더를 지정하면, 거기서 알아낼 수 있는 것을 알려 드립니다.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">{0} 폴더 지정</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">에뮬레이터 폴더 지정</sys:String>
  <sys:String x:Key="Str.EmulatorFound">{0} 찾음: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">{0}(으)로 보이지 않습니다. 그 폴더에 {1}이(가) 없습니다. 일단 추가했으니 경로를 확인하세요.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">아는 에뮬레이터가 없습니다. 파일 정보를 바탕으로 추가했습니다: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">에뮬레이터 안에서</sys:String>
  <sys:String x:Key="Str.ReportTitle">게임에서 동작하지 않나요?</sys:String>
  <sys:String x:Key="Str.ReportBody">로그와 게임 폴더의 파일 목록을 PC에 .zip 하나로 묶습니다. 아무것도 전송하지 않습니다.</sys:String>
  <sys:String x:Key="Str.Report">문제 보고</sys:String>
  <sys:String x:Key="Str.ReportSaved">보고서를 저장하고 폴더를 열었습니다: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">보고서를 만들 수 없습니다. 로그는 {0}에 있습니다</sys:String>
  <sys:String x:Key="Str.ReportWorking">수집 중…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">파일이 다운로드되지 않나요?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">각 다운로드가 시도한 내용(각 주소, 이름 확인, 프록시, 응답)을 모으고, 지금 모든 주소를 다시 확인해 .zip 하나로 묶습니다. 아무것도 전송하지 않습니다. 파일은 PC에 남으니 원하는 곳에 공유하세요.</sys:String>
  <sys:String x:Key="Str.DownloadReport">다운로드 로그</sys:String>
  <sys:String x:Key="Str.Add">추가</sys:String>
  <sys:String x:Key="Str.AddMenuMany">폴더에서 게임 검색…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">게임 하나의 폴더…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">에뮬레이터…</sys:String>
  <sys:String x:Key="Str.UpdateShort">업데이트</sys:String>
  <sys:String x:Key="Str.GamesAway">연결되지 않은 드라이브에 {0}개</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">지금 연결되어 있지 않은 드라이브의 게임도, 선택해 둔 설정과 함께 기억해 두었다가 드라이브가 다시 연결되면 돌아옵니다.</sys:String>
  <sys:String x:Key="Str.GameGone">{0}이(가) 더 이상 설치되어 있지 않아 목록에서 빠졌습니다.</sys:String>
  <sys:String x:Key="Str.GamesGone">게임 {0}개가 더 이상 설치되어 있지 않아 목록에서 빠졌습니다.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">게임 {0}개가 더 이상 설치되어 있지 않아 목록에서 빠졌습니다.</sys:String>
  <sys:String x:Key="Str.ShowDetails">세부 정보 보기</sys:String>
  <sys:String x:Key="Str.DetectedSection">감지 결과</sys:String>
  <sys:String x:Key="Str.InstallsInto">설치 위치: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">추가한 폴더 밖입니다. 런처가 실행하는 빌드의 {0}가 여기에 있습니다. 다른 빌드로 플레이한다면 위에서 그 빌드의 {0}를 선택하세요.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">파일로 알 수 있는 것은 게임이 무엇과 링크되어 있는지이지, 실제로 무엇으로 실행되는지가 아닙니다. 한 폴더에 D3D11과 D3D12 실행 파일이 함께 있을 수 있습니다. 게임이 어느 쪽을 쓰는지는 위키에 나와 있습니다.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">게임 자체의 파일에서 읽었습니다.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">PCGamingWiki와 게임 파일에서.</sys:String>
  <sys:String x:Key="Str.InstallWith">설치 방식</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + 애드온</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">권장</sys:String>
  <sys:String x:Key="Str.RecommendedLower">권장</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">ReShade 안의 애드온. D3D11, D3D12, Vulkan, OpenGL, 32비트 게임과 에뮬레이터.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">이 게임이 감지된 방식({0})에 맞는 ReShade 설치 방식이 없습니다.</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">게임의 DLSS, FSR 또는 XeSS 안에서 동작하며, 게임 자체의 깊이와 움직임을 사용합니다. ReShade를 대체합니다.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">게임의 업스케일러 안에서 동작합니다(여기서 {0} 발견). ReShade를 대체합니다.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">64비트 D3D12 게임용입니다. 이 게임은 {0}(으)로 감지됩니다.</sys:String>
  <sys:String x:Key="Str.ApiSection">그래픽 API</sys:String>
  <sys:String x:Key="Str.Group64">64비트 게임</sys:String>
  <sys:String x:Key="Str.Group32">32비트 게임(실험적)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">에뮬레이터</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V 온라인</sys:String>
  <sys:String x:Key="Str.OptiAbout">ReShade 대신 OptiScaler를 설치합니다. OptiScaler는 게임의 DLSS, FSR 또는 XeSS를 넘겨받아 그 안에서 신경망을 실행하며, 게임 자체의 깊이 정보와 모션 벡터를 사용합니다.</sys:String>
  <sys:String x:Key="Str.InGame">게임 안에서</sys:String>
  <sys:String x:Key="Str.OptiStep1">게임의 그래픽 설정에서 DLSS, FSR 또는 XeSS를 켜세요.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Insert 키를 누르고 Neural 탭을 열어 "Enable NR"을 켜세요.</sys:String>
  <sys:String x:Key="Str.OptiStep3">레이 리컨스트럭션(Ray Reconstruction)이 켜져 있다면, 처리 지점을 "After the finished frame"으로 설정하세요.</sys:String>
  <sys:String x:Key="Str.InstallOpti">OptiScaler 설치</sys:String>
  <sys:String x:Key="Str.Update">업데이트</sys:String>
  <sys:String x:Key="Str.Reinstall">다시 설치</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">OptiScaler로 전환</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">ReShade로 전환</sys:String>
  <sys:String x:Key="Str.SwitchTitle">{0}(으)로 전환할까요?</sys:String>
  <sys:String x:Key="Str.SwitchBody">{0}에는 {1} 설치 방식이 설치되어 있으며, 두 방식은 한 폴더에 동시에 있을 수 없습니다. 먼저 {1}을(를) 제거하면서 그것이 바꿔 놓은 것을 모두 되돌린 뒤, {2}을(를) 설치합니다.</sys:String>
  <sys:String x:Key="Str.SwitchYes">{0} 제거, {1} 설치</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">사용자의 설정 파일은 그대로 남습니다.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">아무것도 바꾸지 않습니다. {0}은(는) 설치된 상태로 유지됩니다.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">원인은 "세부 정보"에 있습니다. 아무것도 설치하지 않았습니다.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">브라우저로 파일을 받아서 넘겨줄 수도 있습니다: 이 PC &gt; 파일 &gt; 직접 다운로드, 그다음 "파일 가져오기". 다운로드 폴더에 있는 파일은 자동으로 찾습니다.</sys:String>
  <sys:String x:Key="Str.DnsRetry">DNS 지우고 다시 시도</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">여기서는 Windows의 DNS 캐시를 지울 수 없었습니다. 명령 프롬프트를 열고 ipconfig /flushdns를 실행한 뒤 다시 시도하세요.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">이 폴더에서 문제 {0}개를 발견했습니다</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">설치 준비 완료, 확인할 내용 {0}개</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">{0}에 설치했습니다. 아래에서 확인할 경고가 {1}개 있습니다.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">{0}에서 제거했습니다. 아래에서 확인할 경고가 {1}개 있습니다.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">아래에 문제가 {0}개 있습니다.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">다운로드 목록 없음</sys:String>
  <sys:String x:Key="Str.FailedShort">실패</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">{0}개 모두 준비됨</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">{0}개 없음 · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">다운로드할 수 없습니다: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">직접 다운로드</sys:String>
  <sys:String x:Key="Str.ImportFiles">파일 가져오기…</sys:String>
  <sys:String x:Key="Str.ImportHint">직접 다운로드한 파일이 있는 폴더를 선택하세요. 각 파일은 이름으로 찾으며, 고정된 해시와 일치할 때만 가져옵니다.</sys:String>
  <sys:String x:Key="Str.ManualTitle">파일 직접 다운로드</sys:String>
  <sys:String x:Key="Str.ManualBody">각 링크를 브라우저에서 열고 파일을 원하는 곳에 저장하세요. 다운로드 폴더는 자동으로 검색하며, "파일 가져오기"로 다른 폴더도 가져올 수 있습니다. 이름을 바꿀 필요는 없으며, 고정된 SHA-256과 일치하지 않는 것은 사용하지 않습니다.</sys:String>
  <sys:String x:Key="Str.ImportPick">다운로드한 파일이 있는 폴더 선택</sys:String>
  <sys:String x:Key="Str.ImportAll">모든 파일이 준비되었고 검증도 끝났습니다.</sys:String>
  <sys:String x:Key="Str.ImportNothing">그 폴더에는 필요한 파일과 일치하는 것이 없습니다.</sys:String>
  <sys:String x:Key="Str.ImportSome">가져옴: {0}. 아직 없음: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">애드온</sys:String>
  <sys:String x:Key="Str.Component.runtime">뉴럴 런타임과 가중치</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32비트 브리지</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32비트 추가 파일</sys:String>
  <sys:String x:Key="Str.Component.shader">보조 효과</sys:String>
  <sys:String x:Key="Str.Updates">업데이트</sys:String>
  <sys:String x:Key="Str.UpToDate">최신 상태</sys:String>
  <sys:String x:Key="Str.UpdateChecking">새 버전을 확인하는 중…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0}이(가) 최신 버전입니다. {1}에 확인했습니다.</sys:String>
  <sys:String x:Key="Str.UpdateOut">버전 {0}을(를) 사용할 수 있습니다. 현재 버전은 {1}입니다.</sys:String>
  <sys:String x:Key="Str.HotfixLabel">v{0} 핫픽스 {1}</sys:String>
  <sys:String x:Key="Str.HotfixShort">핫픽스 {0}</sys:String>
  <sys:String x:Key="Str.HotfixOut">v{0}의 핫픽스 {1}이(가) 나왔습니다. 새 버전이 아니라 이 버전의 수정입니다.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">확인할 수 없습니다. GitHub가 응답하지 않았습니다. 어느 쪽이든 앱은 똑같이 동작합니다.</sys:String>
  <sys:String x:Key="Str.UpdateNow">업데이트 다운로드</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">GitHub에서 다운로드</sys:String>
  <sys:String x:Key="Str.UpdateCheck">업데이트 확인</sys:String>
  <sys:String x:Key="Str.SessionSection">마지막 세션</sys:String>
  <sys:String x:Key="Str.SessionTip">애드온과 런타임이 게임 폴더에 기록하는 로그에서 읽어 옵니다. 게임을 마치고 이 창으로 돌아오면 다시 읽습니다.</sys:String>
  <sys:String x:Key="Str.SessionRan">마지막 세션에서 NR이 작동했습니다</sys:String>
  <sys:String x:Key="Str.SessionCrashed">마지막 세션에서 게임이 비정상 종료되었습니다</sys:String>
  <sys:String x:Key="Str.SessionFailed">마지막 세션에서 NR이 시작되지 않았습니다</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade는 시작되었지만 애드온이 로드되지 않았습니다</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">모드는 로드되었지만 NR이 처리한 프레임이 없습니다</sys:String>
  <sys:String x:Key="Str.SessionNever">아직 세션이 없습니다. 게임을 한 번 실행한 뒤 돌아오면 NR이 작동했는지 여기에 표시됩니다.</sys:String>
  <sys:String x:Key="Str.SessionFrames">처리된 프레임: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">네트워크: 프레임당 {0}ms</sys:String>
  <sys:String x:Key="Str.SessionRuntime">런타임 {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">게임에서 Home 키로 ReShade 오버레이를 열고 AMD Neural Rendering 패널에서 NR이 켜져 있는지 확인하세요.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">게임에서 DLSS, FSR 또는 XeSS를 켠 다음 Insert 키를 누르고 Neural 탭을 열어 'Enable NR'을 켜세요.</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">게임 폴더의 ReShade.log에는 ReShade가 어느 폴더에서 애드온을 찾았는지 기록되어 있습니다. '문제 보고'를 누르면 다른 파일과 함께 묶어 줍니다.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">'문제 보고'를 누르면 이 로그들을 파일 하나로 묶어 Discord에 공유할 수 있습니다.</sys:String>
  <sys:String x:Key="Str.SortFilter">정렬 및 필터</sys:String>
  <sys:String x:Key="Str.FilterShow">표시</sys:String>
  <sys:String x:Key="Str.FilterAll">모든 게임</sys:String>
  <sys:String x:Key="Str.FilterInstalled">설치됨</sys:String>
  <sys:String x:Key="Str.FilterUpdates">업데이트 있음</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">설치 안 됨</sys:String>
  <sys:String x:Key="Str.FilterEmulators">에뮬레이터</sys:String>
  <sys:String x:Key="Str.SortBy">정렬 기준</sys:String>
  <sys:String x:Key="Str.SortName">이름</sys:String>
  <sys:String x:Key="Str.SortRecent">최근 플레이</sys:String>
  <sys:String x:Key="Str.SortAdded">최근 추가</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">이 필터에 맞는 게임이 목록에 없습니다.</sys:String>
  <sys:String x:Key="Str.WhatsNew">새로운 기능</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">GitHub에서 열기</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">GitHub에서 릴리스 노트를 읽지 못했습니다. 릴리스 페이지에서 확인할 수 있습니다.</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">이 릴리스는 노트 없이 게시되었습니다.</sys:String>
  <sys:String x:Key="Str.Transfer">NR 설정</sys:String>
  <sys:String x:Key="Str.TransferTip">이 게임의 NR 설정을 파일 하나로 저장하거나 공유하고, 다른 사람의 설정을 가져올 수 있습니다. 먼저 게임을 종료하세요. 게임은 종료할 때 설정을 저장합니다.</sys:String>
  <sys:String x:Key="Str.TransferExport">파일로 내보내기…</sys:String>
  <sys:String x:Key="Str.TransferImport">파일에서 가져오기…</sys:String>
  <sys:String x:Key="Str.TransferNothing">아직 내보낼 설정이 없습니다. 설정은 모드를 설치한 상태로 게임을 처음 실행할 때 기록됩니다.</sys:String>
  <sys:String x:Key="Str.TransferExported">설정을 저장했습니다: {0}</sys:String>
  <sys:String x:Key="Str.TransferImported">{0}의 설정을 적용했습니다. 대체된 설정은 {1}에 보관했습니다.</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">이 설정은 {0} 방식용인데, 이 게임에는 {1}이(가) 설치되어 있습니다.</sys:String>
  <sys:String x:Key="Str.TransferInvalid">이 파일은 AMD-NR 설정 내보내기 파일이 아닙니다.</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. 게임 속성에 있는 게임별 설정에 주의하세요. 전체 설정을 알리지 않고 덮어쓰며, 실제로는 문제가 없는데 고장 난 것처럼 보이는 가장 흔한 원인입니다.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. 여기에는 Direct3D가 전혀 없으므로, 이 설치 방식은 색과 추정한 움직임만 받고 깊이 정보는 없습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">D3D12에서 동작하며, 이는 기능이 제한되는 설치 방식입니다. 애드온에는 완성된 프레임만 보입니다. 동작은 하지만 효과는 덜합니다.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Vulkan에는 깊이 정보가 없고, 색과 추정한 움직임만 있습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Vulkan에는 깊이 정보가 없습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. Vulkan에는 깊이 정보가 없습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan이 기본 백엔드입니다. Vulkan에는 깊이 정보가 없습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Vulkan 전용입니다. Vulkan에는 깊이 정보가 없고, 에뮬레이터 자체도 아직 초기 단계라 문제가 생길 수 있습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">Vulkan 전용. kyty_emulator.exe가 있는 폴더를 지정하세요(launcher.exe는 실행만 합니다). 깊이 정보가 없고 에뮬레이터 자체도 아직 초기 단계라 문제가 있을 수 있습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">게임에서: Home으로 ReShade를 열고, AMD Neural Rendering은 Add-ons에 있습니다. 또는 Ctrl+End. FiveM에는 자체 안티치트가 있으니 먼저 서버 규칙을 확인하세요.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. 이제 OpenGL에도 설치 방식이 있지만, 여기서 더 검증된 것은 Vulkan입니다.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu는 OpenGL로만 렌더링하므로, 여기서는 OpenGL 설치 방식이 유일합니다. 가장 새로운 설치 방식이며 실험적입니다. 색과 추정한 움직임만 있고, 깊이 정보는 없습니다.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. 소프트웨어 렌더러는 CPU에서 그리기 때문에 애드온이 닿을 수 있는 것이 없습니다. 따라서 OpenGL 렌더러여야 하며, 이 설치 방식은 실험적입니다. 색과 추정한 움직임만 있고, 깊이 정보는 없습니다.</sys:String>

</ResourceDictionary>
