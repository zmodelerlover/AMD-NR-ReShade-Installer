<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Croatian">

  <!-- Hrvatski. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Neuronsko renderiranje DLSS 5 na Radeonu, instalirano umjesto vas</sys:String>
  <sys:String x:Key="Str.Games">Igre</sys:String>
  <sys:String x:Key="Str.RemoveGame">Ukloni s popisa</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Uklanja igru s popisa, a „Pretraži igre” je također preskače. Nijedna datoteka u njezinoj mapi ne dira se; vratiti je možete u Postavkama.</sys:String>
  <sys:String x:Key="Str.RemovedGame">Igra {0} uklonjena je s popisa i „Pretraži igre” će je preskakati. Ništa u njezinoj mapi nije dirano; vraćate je u „Postavke” &gt; „Zanemarene igre”.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">Igra {0} uklonjena je s popisa, ali dodatak je još instaliran u njezinoj mapi. Vratite je iz „Postavke” &gt; „Zanemarene igre” da biste ga deinstalirali.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Zanemarene igre</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Igre koje ste uklonili s popisa. „Pretraži igre” ih preskače, pa ostaju izvan popisa dok ih ovdje ne vratite.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Nema zanemarenih igara.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Vrati na popis</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">Igra {0} vraćena je na popis.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Mapa igre {0} više ne postoji, pa je samo uklonjena iz zanemarenih igara.</sys:String>
  <sys:String x:Key="Str.NoGames">Ovdje još nema ničega. Dodajte mapu iz koje se pokreće igra ili emulator.</sys:String>
  <sys:String x:Key="Str.PickFolder">Odaberite mapu iz koje se igra pokreće</sys:String>
  <sys:String x:Key="Str.AddGameMany">Pretraži mapu</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Odaberite mapu u kojoj držite igre</sys:String>
  <sys:String x:Key="Str.AddGameNone">U „{0}” nije pronađeno ništa što izgleda kao igra.</sys:String>
  <sys:String x:Key="Str.Preset">Put</sys:String>
  <sys:String x:Key="Str.Install">Instaliraj</sys:String>
  <sys:String x:Key="Str.Uninstall">Deinstaliraj</sys:String>
  <sys:String x:Key="Str.OpenFolder">Otvori mapu</sys:String>
  <sys:String x:Key="Str.System">Ovo računalo</sys:String>
  <sys:String x:Key="Str.Gpu">Grafička kartica</sys:String>
  <sys:String x:Key="Str.Driver">Upravljački program</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 runtime</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll nije pronađen. Donosi ga aktualni upravljački program Adrenalin; HIP 6 nije dovoljan.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Ovo ne izgleda kao Radeon. Mreža radi samo na RDNA3 i RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Spremno</sys:String>
  <sys:String x:Key="Str.Payloads">Datoteke</sys:String>
  <sys:String x:Key="Str.Downloading">Preuzimanje</sys:String>
  <sys:String x:Key="Str.Verifying">Provjera onoga što već postoji…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Preuzeto i provjereno.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Objavljeni popis preuzimanja nije se mogao pročitati, pa se koristi kopija koja dolazi s aplikacijom.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Popis preuzimanja nije se mogao pročitati. Provjerite vezu i pokušajte ponovno.</sys:String>
  <sys:String x:Key="Str.Language">Jezik</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Preuzimanje ažuriranja…</sys:String>
  <sys:String x:Key="Str.Dismiss">Ne sada</sys:String>
  <sys:String x:Key="Str.LogSaved">Cijeli zapisnik zapisan je pokraj aplikacije.</sys:String>
  <sys:String x:Key="Str.Working">Radi se…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Popis igara nije se mogao pročitati. Sačuvan je pokraj kao {0} i započet je novi popis.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Još se piše u mapu igre. To traje nekoliko sekundi; zatvorite prozor kad završi.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Ovo je besplatno. Ako ste to platili, prevareni ste.</sys:String>
  <sys:String x:Key="Str.FreeBody">Nitko ništa od ovoga ne prodaje — ni instalacijski program, ni dodatak, ni runtime, ni težine. Ako vam je netko naplatio ovo, „ključ” ili „pro verziju”, tražite povrat novca: ono što su vam prodali besplatno je na ovoj stranici.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Otvorenog je koda i tako ostaje: čitajte ga, mijenjajte, izgradite vlastitu verziju, dajte je prijateljima. Molimo samo jedno: da nitko od toga ne napravi plaćenu verziju.</sys:String>
  <sys:String x:Key="Str.SupportSection">Podrška</sys:String>
  <sys:String x:Key="Str.SupportNote">neobavezno i ne otključava ništa</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Jednokratna kava.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">Brazilsko prikupljanje sredstava za projekt.</sys:String>
  <sys:String x:Key="Str.SupportRail">Podrži AMD-NR</sys:String>
  <sys:String x:Key="Str.SupportTitle">Održi AMD-NR na životu</sys:String>
  <sys:String x:Key="Str.SupportBody">Ovaj projekt živi samo od podrške onih koji ga koriste. To su dvije osobe, dvije grafičke kartice i poslijepodneva rada: bez tvrtke i sponzora. Sve je ovdje besplatno i tako će i ostati. Podrška ništa ne otključava; ona omogućuje da se radi dalje.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">U Brazilu ste? Vakinha prima Pix, karticu ili boleto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — autor danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Sama mreža i razlog zašto sve ovo postoji: zahvaljujući njoj neuronsko renderiranje DLSS 5 uopće je pokrenuto na Radeonu. Runtime i težine koje ova aplikacija preuzima njegov su rad, ne naš. Hvala, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — dodatak</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Ono što tu mrežu spaja s igrom preko ReShadea: dodatak koji ovo instalira i izdanja među kojima vam nudi izbor. Licenca MIT, zaseban repozitorij od ovog instalacijskog programa.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — tamo su svi</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Nove verzije, što radi u kojoj igri i gdje pitati kad se nešto pokvari.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Zasluge</sys:String>
  <sys:String x:Key="Str.Scan">Pretraži igre</sys:String>
  <sys:String x:Key="Str.Scanning">Čitanje Steama, Epica, GOG-a, EA-a, Ubisofta, Battle.neta i Xboxa…</sys:String>
  <sys:String x:Key="Str.Search">Traži igre…</sys:String>
  <sys:String x:Key="Str.Settings">Postavke</sys:String>
  <sys:String x:Key="Str.WillDownload">Datoteke se preuzimaju i provjeravaju pri instalaciji.</sys:String>
  <sys:String x:Key="Str.NoRoute">Ništa čime ova igra renderira nema put: dodatak radi na D3D11, D3D12, Vulkanu i OpenGL-u, a za 32-bitne igre na D3D8, D3D9 i D3D11. 32-bitna igra na OpenGL-u, 64-bitna na D3D9 i softverski renderer nemaju nijedan.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Ova igra može raditi na {1}. U njezinim grafičkim postavkama odaberite {0} — to je put odabran ovdje, a na drugom API-ju dodatak vidi drugu igru.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Ovo je igra na Unrealu: dodajte -{0} njezinim opcijama pokretanja.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Potražite ovu igru na PCGamingWikiju</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Još nema igara</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Nema rezultata</sys:String>
  <sys:String x:Key="Str.NoMatch">Nijedna igra na popisu ne odgovara „{0}”.</sys:String>
  <sys:String x:Key="Str.ScanningShort">Pretraživanje…</sys:String>
  <sys:String x:Key="Str.ScanDone">Pretraživanje završeno. Pronađene igre: {0}, nove: {1}.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Instalirano</sys:String>
  <sys:String x:Key="Str.Close">Zatvori</sys:String>
  <sys:String x:Key="Str.CloseHint">Zatvori (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">Izvršna datoteka igre</sys:String>
  <sys:String x:Key="Str.ExeChoose">Odaberi…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Koristi otkrivenu</sys:String>
  <sys:String x:Key="Str.ExeNone">U ovoj mapi nema izvršne datoteke.</sys:String>
  <sys:String x:Key="Str.ExeNote">Put se određuje iz ove datoteke. Ako bitnost izgleda pogrešno (pokretač u korijenu, igra u Bin64), pokažite na pravi .exe.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Ovu ste datoteku odabrali sami, pa je otkrivanje ne mijenja, ni nakon ponovnog pretraživanja.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Ta datoteka nije u mapi ove igre.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Ta datoteka nije izvršna datoteka sustava Windows koja se može pročitati.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Ovaj put je za igre {0}, a izvršna datoteka iznad je {1}. Ništa vas ne sprječava — otkrivanje je možda pročitalo krivu datoteku — ali ako je pročitalo pravu, ovo se neće učitati.</sys:String>
  <sys:String x:Key="Str.VersionSection">Verzija dodatka</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade se učitava kao</sys:String>
  <sys:String x:Key="Str.ProxyNote">Automatski koristi dxgi.dll, koji služi svaki Direct3D. Promijenite samo ako ga igra odbija učitati.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler se učitava kao</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">Automatski koristi prvo ime koje wiki OptiScalera navodi za ovu igru, inače ono koje se ovdje već koristi, inače dxgi.dll. Odaberite winmm.dll da zadržite dxgi.dll drugog programa.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatski</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatski (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Preuzmi sve sada</sys:String>
  <sys:String x:Key="Str.ClearCache">Očisti predmemoriju</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Briše preuzete datoteke, naslovnice i popis verzija. Ništa instalirano u igrama ne dira se; sljedeća instalacija ponovno preuzima ono što joj treba.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Očisti</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Sve u njoj ponovno se preuzima pri sljedećoj instalaciji.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Ostavi predmemoriju kakva jest.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Predmemorija ispražnjena — oslobođeno {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Sve je već bilo ovdje i svaki je bajt upravo prošao provjeru.</sys:String>
  <sys:String x:Key="Str.VersionShipped">priložena</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">Verzija s kojom je objavljen ovaj instalacijski program.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Iz izdanja v{0} na GitHubu, provjereno prema njegovim hashevima.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Verzija OptiScalera</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} iz njegova izdanja na GitHubu, svaka datoteka provjerena prema svom hashu.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Uključuje težine lmxxf (oko 590 MB, samo RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Može donijeti i mochizuki: pogledajte „NR runtime”.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR runtime</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">Instaliraj i mochizuki, kao drugi NR runtime (eksperimentalno)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">Mreža DLSS 5 koju je na Vulkan prenio mochizuki0323. Samo RDNA4: serija RX 9000, AMD upravljački program 25.10 ili noviji. Dodaje MochizukiNrRuntime.dll i mapu dlssnr-amd s modelom, oko 141 MB preuzimanja. danielblnc ostaje NR runtime: za mochizuki ga odaberite pod „NR runtime” na kartici Neural u OptiScaleru i ponovno pokrenite igru. Pri prvom pokretanju u svakoj igri mreža se kompilira nekoliko sekundi. Bez kvačice, sljedeća instalacija uklanja ono što je ova aplikacija od njega instalirala.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">Instaliraj i mochizuki, kao drugi NR runtime (eksperimentalno)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">Mreža DLSS 5 koju je na Vulkan prenio mochizuki0323, a koju dodatak od v0.6.8 može pokretati umjesto danielblncove. Samo RDNA4: serija RX 9000, AMD upravljački program 25.10 ili noviji. Dodaje MochizukiNrRuntime.dll i mapu dlssnr-amd s modelom, oko 141 MB preuzimanja. Da biste je koristili, odaberite mochizuki (Vulkan) pod „NR runtime” na ploči dodatka i ponovno pokrenite igru. Pri prvom pokretanju u svakoj igri mreža se kompilira do minute. Bez kvačice, sljedeća instalacija uklanja ono što je ova aplikacija od njega instalirala.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">Nije ponuđeno na ovoj kartici ({0}): mochizuki treba FP8 matrične instrukcije RDNA4, tj. serije RX 9000.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">Aplikacija nije mogla utvrditi koja je ovo kartica; na svemu osim serije RX 9000 mochizuki ostaje isključen u igri.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Odaberite put instalacije</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Aplikacija nije mogla utvrditi kojim grafičkim API-jem renderira {0}, pa ne bira put umjesto vas. OptiScaler je za igru na D3D12 koja u postavkama nudi DLSS, FSR ili XeSS; ReShade, na D3D11 ili D3D12, za svaku drugu. Instalacija čeka dok ne odaberete.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">Grafički API nije poznat, pa put birate vi ispod.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblncov runtime</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Koja verzija runtimea ide u ovu igru. Koristi se istaknuta kartica.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Javno izdanje ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Preuzela i provjerila ova aplikacija.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Lokalna verzija za podržavatelje ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Odaberi moj version.dll ili instalacijski program…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Odaberi drugu datoteku…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Novija od javnog izdanja, iz vašeg version.dll-a ili danielblncova instalacijskog programa.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 dodaje kernele za kartice RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Ova ga aplikacija nikad ne preuzima niti dijeli. Vaša se datoteka provjerava SHA-256 i čuva, pa druge igre ne pitaju ponovno.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Koristi moje datoteke za podržavatelje…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Javno izdanje</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Vaš version.dll ili dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Bilo koji DLL ili instalacijski program</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">U upotrebi: runtime koji preuzima ova aplikacija.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Koristi se {0} iz vaše datoteke.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Koristi se {0}: provjerena kopija koju je aplikacija sačuvala kad ste ga prije odabrali.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">Odabran je {0}, ali na ovom računalu još nema njegove kopije: odaberite svoj version.dll ili instalacijski program.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} treba dodatak v{1} ili noviji: odaberite ga pod „Verzija dodatka”. Do tada se instalira preuzeta verzija.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} treba OptiScaler {1} ili noviji: odaberite ga pod „Verzija OptiScalera”. Do tada se instalira preuzeta verzija.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">Dodatak još ne može pokrenuti {0}: popis datoteka ne sadrži njegovu zakrpu. Dok ne bude, ovdje se instalira preuzeta verzija; put OptiScaler pokreće ga takvog kakav jest.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Provjereno i sačuvano: danielblncov runtime {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Ta se datoteka ne može koristiti. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Provjera ove mape…</sys:String>
  <sys:String x:Key="Str.StepDownload">Preuzimanje</sys:String>
  <sys:String x:Key="Str.StepVerify">Provjera</sys:String>
  <sys:String x:Key="Str.StepInstall">Instalacija</sys:String>
  <sys:String x:Key="Str.StepDone">Gotovo</sys:String>
  <sys:String x:Key="Str.Installing">Instaliranje…</sys:String>
  <sys:String x:Key="Str.Removing">Uklanjanje…</sys:String>
  <sys:String x:Key="Str.InstallOk">Igra {0} je spremna. Pokrenite je da biste to koristili.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Instalirano u igru {0}; ispod je {1} upozorenje za pročitati.</sys:String>
  <sys:String x:Key="Str.InstallFail">Instalacija u igru {0} nije dovršena.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Uklonjeno iz igre {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Uklonjeno iz igre {0}; ispod je {1} upozorenje za pročitati.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Nije moguće ukloniti sve iz igre {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">Igra {0} i dalje se vodi kao instalirana: jedna datoteka ove aplikacije nije se mogla ukloniti. Zatvorite igru i ponovno deinstalirajte.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Uklonjeno iz igre {0} — u njezinoj mapi nije ostalo ništa od ove aplikacije.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Uklonjeno iz igre {0} — ostale su samo vaše postavke: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Ukloniti i postavke?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Sve što je ova aplikacija instalirala u igru {0} uklonjeno je. Ove datoteke postavki ostale su — u njima je ono što je postavljeno u overlayu:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Ukloni i njih</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">Mapa se vraća u stanje prije instalacije.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Zadrži moje postavke</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Ostaju za sljedeću instalaciju.</sys:String>
  <sys:String x:Key="Str.ResultErrors">Ispod je opisan {0} problem.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Datoteke se nisu mogle preuzeti, pa ništa nije instalirano.</sys:String>
  <sys:String x:Key="Str.Folder">Mapa</sys:String>
  <sys:String x:Key="Str.GameCount">Igre: {0}</sys:String>
  <sys:String x:Key="Str.UnknownApi">Nepoznat API</sys:String>
  <sys:String x:Key="Str.Location">Lokacija</sys:String>
  <sys:String x:Key="Str.Details">Pojedinosti</sys:String>
  <sys:String x:Key="Str.DetailsCount">Redaka: {0}</sys:String>
  <sys:String x:Key="Str.PreflightOk">Spremno za instalaciju</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Ništa ne smeta. Odaberite put ispod i pritisnite „Instaliraj”.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Spremno za instalaciju; {0} napomena za pročitati</sys:String>
  <sys:String x:Key="Str.PreflightErr">U ovoj je mapi pronađen {0} problem</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Instalirano u ovoj igri</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Pokrenite igru da biste to koristili. Instalirajte ponovno da osvježite datoteke ili deinstalirajte da ih uklonite.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Instalirano, a dostupno je ažuriranje</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Datoteke u ovoj igri starije su od onih koje ova aplikacija sada instalira. „Ažuriraj” ih zamjenjuje; vaše postavke ostaju.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Otvorite „Pojedinosti” ispod da vidite što je pronađeno.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Što dodatak treba od ovog računala, provjereno pri pokretanju aplikacije.</sys:String>
  <sys:String x:Key="Str.SystemReady">Ovo računalo ima sve što dodatak treba</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Ovom računalu nedostaje nešto što dodatak treba</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon otkriven</sys:String>
  <sys:String x:Key="Str.GpuBad">Nije Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Nedostaje</sys:String>
  <sys:String x:Key="Str.DriverHint">Verzija grafičkog upravljačkog programa koju prijavljuje Windows.</sys:String>
  <sys:String x:Key="Str.FilesHint">Preuzimaju se jednom, provjeravaju prema fiksnom hashu i ponovno koriste za svaku igru.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Provjereno</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Nije preuzeto</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Preuzimanje…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Preuzimanje {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Jezik, ažuriranja i o ovoj aplikaciji.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Svi se natpisi mijenjaju odmah; ponovno pokretanje nije potrebno.</sys:String>
  <sys:String x:Key="Str.DataFolder">Mapa s podacima</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">Igra na D3D11</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">Igra na D3D12</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Igra na Vulkanu</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">Igra na OpenGL-u</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">Igra na D3D11, 32-bitna</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">Igra na D3D9, 32-bitna</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">Igra na D3D8, 32-bitna</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: igra na D3D12 s DLSS-om, FSR-om ili XeSS-om</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">U emulatoru postavite Direct3D 11: to je renderer na kojem mreža dobiva najviše — dubinu iz emulatora i kretanje iz pratećeg efekta kad je instaliran. Pazite na postavke za pojedinu igru, koje tiho nadjačavaju globalne.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Eksperimentalno. ReShade na Vulkanu je sloj, a ne proxy DLL: instalacija ga registrira za vašeg korisnika sustava Windows i uključuje ga za rpcs3.exe pomoću ReShade.ini. Na Vulkanu nema dubine, samo boja i procijenjeno kretanje.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">Najbolji put: D3D11 jedini je na kojem vlastiti vektori kretanja igre stižu do mreže, zajedno s njezinom dubinom.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Ograničeno. Na D3D12 dodatak pronalazi dubinu igre, ali ne i njezine vektore kretanja, pa mreža dobiva boju i dubinu, a kretanje procjenjuje. Radi, ali očekujte manje. Igri s DLSS-om, FSR-om ili XeSS-om u postavkama bolje odgovara put OptiScaler.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Preporučeno za igre na D3D12. Umjesto ReShadea instalira OptiScaler, koji preuzima DLSS, FSR ili XeSS igre i pokreće mrežu unutar njega, s vlastitom dubinom i vektorima kretanja igre. Igra mora nuditi jedan od tih upscalera, uključen u njezinim postavkama. U igri pritisnite Insert, otvorite karticu Neural i uključite Enable NR; igri s Ray Reconstructionom kao točka obrade treba „After the finished frame”.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Eksperimentalno. ReShade na Vulkanu je sloj: instalacija ga registrira za vašeg korisnika sustava Windows i uključuje ga za ovaj program pomoću ReShade.ini pokraj njegova .exe-a. Na Vulkanu nema dubine.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Eksperimentalno. Za razliku od Vulkana, ovo je običan proxy DLL: ReShade ide pokraj igre kao opengl32.dll, bez zasebnog pokretanja instalacijskog programa. Samo boja i procijenjeno kretanje; vlastita dubina igre na ovom je API-ju dostupna, ali još nije povezana. 32-bitna igra na OpenGL-u nema put.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Eksperimentalno. 32-bitna igra ne može učitati 64-bitni runtime, pa dodatak radi kao par koji dijeli okvire na jednom adapteru. Instalirajte ReShade s podrškom za dodatke kao 32-bitni dxgi.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Eksperimentalno. Isti 32-bitni par kao za D3D11, kroz privatnu fazu D3D9/D3D11. Obični D3D9 stoji nekoliko fiksnih milisekundi po okviru; D3D9Ex ne. Instalirajte ReShade kao 32-bitni d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Eksperimentalno. D3D8 se prevodi u D3D9 i zatim ide gornjim putem D3D9, s istim 32-bitnim parom. Instalirajte ReShade kao 32-bitni d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM ima vlastiti anti-cheat: na vlastitu odgovornost, i provjerite pravila svog poslužitelja. Dodatak i ReShade idu u FiveM.app\plugins, runtime i težine pokraj procesa igre u data\cache\subprocess. Ono što već imate u plugins — ReShade.ini, preseti, shaderi, drugi dodaci, ENB — ostaje kako jest.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Dobro došli</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Mreža DLSS 5 Neural Rendering na karticama Radeon, preko ReShadea ili OptiScalera. Četiri brza koraka.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Ovo računalo</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Datoteke</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Vaše igre</sys:String>
  <sys:String x:Key="Str.SetupBack">Natrag</sys:String>
  <sys:String x:Key="Str.SetupNext">Nastavi</sys:String>
  <sys:String x:Key="Str.SetupFinish">Počni</sys:String>
  <sys:String x:Key="Str.SetupSkip">Preskoči zasad</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Korak {0} od {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Dvije stvari mogu spriječiti rad dodatka i obje se vide odavde. Nijedna vas ne sprječava da nastavite — samo da radi u igri.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Ovo računalo ima sve što dodatak treba.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Nešto nedostaje. Možete nastaviti i to riješiti kasnije, ali u igri neće raditi dok to ne učinite.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Iste datoteke služe svakoj igri: preuzimaju se jednom, provjeravaju prema fiksnom hashu i ponovno koriste.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Pokušaj ponovno</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Preskočite ovo i preuzet će se pri prvoj instalaciji.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">Pokretači se samo čitaju: gledanjem se ništa ne instalira ni mijenja. Mape možete kasnije dodati i ručno.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Svaka se igra čita kako bi se utvrdilo koji grafički API koristi, i to je obično točno, ali ne uvijek: jedna mapa može sadržavati izvršnu datoteku za D3D11 i za D3D12, a igra može zadano koristiti jedan API iako njezina datoteka podržava i stariji. Prije instalacije vrijedi provjeriti igru na pcgamingwiki.com — svaka kartica igre ima izravnu poveznicu.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Nije pronađena nijedna igra. Mapu možete dodati ručno u glavnom prozoru.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">Pronađene igre: {0}.</sys:String>
  <sys:String x:Key="Str.Unexpected">Dogodilo se nešto neočekivano. Cijeli zapisnik je zapisan.</sys:String>
  <sys:String x:Key="Str.Play">Igraj</sys:String>
  <sys:String x:Key="Str.Launch">Otvori</sys:String>
  <sys:String x:Key="Str.Configure">Konfiguriraj</sys:String>
  <sys:String x:Key="Str.ViewGrid">Mreža naslovnica</sys:String>
  <sys:String x:Key="Str.ViewList">Popis, sa stranicom igre pokraj</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Automatsko ažuriranje</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Kad izađe novija verzija, ova se igra sama ažurira pri otvaranju aplikacije.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">{0} igra automatski je ažurirana.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">Automatski ažurirane igre: {0}.</sys:String>
  <sys:String x:Key="Str.Rename">Preimenuj</sys:String>
  <sys:String x:Key="Str.Save">Spremi</sys:String>
  <sys:String x:Key="Str.Cancel">Odustani</sys:String>
  <sys:String x:Key="Str.ChangeCover">Naslovnica</sys:String>
  <sys:String x:Key="Str.CoverPick">Odaberi sliku…</sys:String>
  <sys:String x:Key="Str.CoverReset">Koristi naslovnicu pronađenu na internetu</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Odaberite naslovnicu za ovu igru</sys:String>
  <sys:String x:Key="Str.CoverFiles">Slike</sys:String>
  <sys:String x:Key="Str.CoverFailed">Ta se datoteka nije mogla pročitati kao slika.</sys:String>
  <sys:String x:Key="Str.Customize">Prilagodi</sys:String>
  <sys:String x:Key="Str.HeroPick">Odaberi banner…</sys:String>
  <sys:String x:Key="Str.HeroReset">Koristi banner pronađen na internetu</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Odaberite banner za ovu igru</sys:String>
  <sys:String x:Key="Str.PlayFailed">Pokretanje nije uspjelo. Otvorite mapu i ručno pokrenite izvršnu datoteku.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Dodaj emulator</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Dodajte emulator</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Odaberite koji, a zatim pokažite na mapu iz koje se pokreće — mapu s izvršnom datotekom, ne onu s ROM-ovima.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Drugi emulator</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Pokažite na mapu i reći ću što mogu iz nje zaključiti.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Pokažite na mapu {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Pokažite na mapu emulatora</sys:String>
  <sys:String x:Key="Str.EmulatorFound">Pronađen {0}: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Ovo ne izgleda kao {0}: u toj mapi nema {1}. Ipak dodano — provjerite putanju.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Ovdje nema nijednog emulatora koji poznajem. Dodano prema onome što kažu datoteke: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">U emulatoru</sys:String>
  <sys:String x:Key="Str.ReportTitle">Ne radi u igri?</sys:String>
  <sys:String x:Key="Str.ReportBody">Pakira zapisnike i popis datoteka mape igre u .zip na vašem računalu. Ništa se ne šalje.</sys:String>
  <sys:String x:Key="Str.Report">Prijavi problem</sys:String>
  <sys:String x:Key="Str.ReportSaved">Izvješće je spremljeno i mapa otvorena: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Izvješće se nije moglo izraditi. Zapisnici su u {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Prikupljanje…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Datoteke se ne preuzimaju?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Prikuplja sve što je svako preuzimanje pokušalo — svaku adresu, njezino razrješavanje imena, proxy i odgovor — i sada ponovno provjerava svaku adresu, sve u jedan .zip. Ništa se ne šalje: datoteka ostaje na vašem računalu da je podijelite gdje želite.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Zapisnici preuzimanja</sys:String>
  <sys:String x:Key="Str.Add">Dodaj</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Pretraži mapu za igre…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Mapa jedne igre…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Emulator…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Ažuriraj</sys:String>
  <sys:String x:Key="Str.GamesAway">Na nepovezanom disku: {0}</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Igre na disku koji trenutačno nije priključen ostaju zapamćene, sa svime što je za njih odabrano, i vraćaju se kad se vrati disk.</sys:String>
  <sys:String x:Key="Str.GameGone">Igra {0} više nije instalirana, pa je uklonjena s popisa.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} igra više nije instalirana, pa je uklonjena s popisa.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">Igre koje više nisu instalirane i uklonjene su s popisa: {0}.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Prikaži pojedinosti</sys:String>
  <sys:String x:Key="Str.DetectedSection">Otkriveno</sys:String>
  <sys:String x:Key="Str.InstallsInto">Instalira se u: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">To je izvan mape koju ste dodali: ondje je {0}, verzija koju pokreće launcher. Ako igrate drugu, gore odaberite njezin {0}.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Datoteke govore s čime je igra povezana, a ne na čemu radi: jedna mapa može sadržavati izvršnu datoteku za D3D11 i za D3D12. Wiki kaže što igra koristi.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Pročitano iz vlastitih datoteka igre.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">Iz PCGamingWikija i datoteka igre.</sys:String>
  <sys:String x:Key="Str.InstallWith">Instaliraj putem</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + dodatak</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Preporučeno</sys:String>
  <sys:String x:Key="Str.RecommendedLower">preporučeno</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">Dodatak unutar ReShadea. D3D11, D3D12, Vulkan, OpenGL, 32-bitne igre i emulatori.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Nema puta ReShade za ono kako se ova igra čita ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Radi unutar DLSS-a, FSR-a ili XeSS-a igre, s njezinom dubinom i kretanjem. Zamjenjuje ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Radi unutar upscalera igre (ovdje pronađen {0}). Zamjenjuje ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Napravljeno za 64-bitne igre na D3D12; ova se čita kao {0}.</sys:String>
  <sys:String x:Key="Str.ApiSection">Grafički API</sys:String>
  <sys:String x:Key="Str.Group64">64-bitne igre</sys:String>
  <sys:String x:Key="Str.Group32">32-bitne igre (eksperimentalno)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Emulatori</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V online</sys:String>
  <sys:String x:Key="Str.OptiAbout">Umjesto ReShadea instalira OptiScaler, koji preuzima DLSS, FSR ili XeSS igre i pokreće mrežu unutar njega, s vlastitom dubinom i vektorima kretanja igre.</sys:String>
  <sys:String x:Key="Str.InGame">U igri</sys:String>
  <sys:String x:Key="Str.OptiStep1">Uključite DLSS, FSR ili XeSS u grafičkim postavkama igre.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Pritisnite Insert, otvorite karticu Neural i uključite Enable NR.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Uz uključen Ray Reconstruction postavite točku obrade na „After the finished frame”.</sys:String>
  <sys:String x:Key="Str.InstallOpti">Instaliraj OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">Ažuriraj</sys:String>
  <sys:String x:Key="Str.Reinstall">Ponovno instaliraj</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Prebaci na OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Prebaci na ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Prebaciti na {0}?</sys:String>
  <sys:String x:Key="Str.SwitchBody">Igra {0} ima instaliran put {1}, a oba ne mogu biti u istoj mapi istodobno. Najprije se uklanja {1}, uz vraćanje svega što je zamijenio, a zatim se instalira {2}.</sys:String>
  <sys:String x:Key="Str.SwitchYes">Ukloni {0}, instaliraj {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Vaše datoteke postavki ostaju gdje jesu.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Ništa se ne mijenja; {0} ostaje instaliran.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">Razlog je pod „Pojedinosti”. Ništa nije instalirano.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Datoteke se mogu preuzeti i preglednikom pa predati aplikaciji: „Ovo računalo” &gt; „Datoteke” &gt; „Preuzmi ručno”, zatim „Uvezi datoteke”. Datoteke u mapi Preuzimanja pronalaze se same.</sys:String>
  <sys:String x:Key="Str.DnsRetry">Očisti DNS i pokušaj ponovno</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows odavde nije dopustio čišćenje DNS predmemorije. Otvorite naredbeni redak, pokrenite ipconfig /flushdns i pokušajte ponovno.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">Problemi pronađeni u ovoj mapi: {0}</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Spremno za instalaciju; napomene za pročitati: {0}</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Instalirano u igru {0}; upozorenja za pročitati ispod: {1}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Uklonjeno iz igre {0}; upozorenja za pročitati ispod: {1}.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">Problemi opisani ispod: {0}.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Nema popisa preuzimanja</sys:String>
  <sys:String x:Key="Str.FailedShort">Neuspjelo</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Sve spremno ({0})</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">Nedostaje: {0} · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Nije moguće preuzeti: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Preuzmi ručno</sys:String>
  <sys:String x:Key="Str.ImportFiles">Uvezi datoteke…</sys:String>
  <sys:String x:Key="Str.ImportHint">Odaberite mapu s datotekama koje ste sami preuzeli. Svaka se prepoznaje po imenu i uzima samo ako odgovara svom fiksnom hashu.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Preuzmite datoteke sami</sys:String>
  <sys:String x:Key="Str.ManualBody">Otvorite svaku poveznicu u pregledniku i spremite datoteku bilo gdje: mapa Preuzimanja pretražuje se sama, a „Uvezi datoteke” prihvaća bilo koju drugu mapu. Imena ne treba mijenjati, a ništa što ne odgovara fiksnom SHA-256 ne koristi se.</sys:String>
  <sys:String x:Key="Str.ImportPick">Odaberite mapu s preuzetim datotekama</sys:String>
  <sys:String x:Key="Str.ImportAll">Sve su datoteke sada ovdje i provjerene.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Ništa u toj mapi ne odgovara potrebnoj datoteci.</sys:String>
  <sys:String x:Key="Str.ImportSome">Preuzeto: {0}. Još nedostaje: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">Dodatak</sys:String>
  <sys:String x:Key="Str.Component.runtime">Neuronski runtime i težine</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32-bitni most</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32-bitni dodaci</sys:String>
  <sys:String x:Key="Str.Component.shader">Prateći efekt</sys:String>
  <sys:String x:Key="Str.Updates">Ažuriranja</sys:String>
  <sys:String x:Key="Str.UpToDate">Ažurno</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Provjera novije verzije…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0} je najnovija verzija. Provjereno u {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">Dostupna je verzija {0}. Vi imate {1}.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">Provjera nije uspjela: GitHub nije odgovorio. Aplikacija radi jednako.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Preuzmi ažuriranje</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Preuzmi s GitHuba</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Provjeri ažuriranja</sys:String>
  <sys:String x:Key="Str.SessionSection">Zadnja sesija</sys:String>
  <sys:String x:Key="Str.SessionTip">Pročitano iz zapisnika koje dodatak i runtime pišu u mapu igre. Ponovno se čita kad se nakon igranja vratite u ovaj prozor.</sys:String>
  <sys:String x:Key="Str.SessionRan">NR je radio u zadnjoj sesiji</sys:String>
  <sys:String x:Key="Str.SessionCrashed">Igra se srušila u zadnjoj sesiji</sys:String>
  <sys:String x:Key="Str.SessionFailed">NR se nije pokrenuo u zadnjoj sesiji</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade se pokrenuo, ali dodatak se nije učitao</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">Mod se učitao, ali NR nije obradio nijedan okvir</sys:String>
  <sys:String x:Key="Str.SessionNever">Još nema sesije. Pokrenite igru jednom i vratite se: ovdje će pisati je li NR radio.</sys:String>
  <sys:String x:Key="Str.SessionFrames">Obrađeni okviri: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">Mreža: {0} ms po okviru</sys:String>
  <sys:String x:Key="Str.SessionRuntime">Runtime {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">U igri otvorite ReShade overlay tipkom Home i provjerite je li NR uključen na ploči AMD Neural Rendering.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">U igri uključite DLSS, FSR ili XeSS, zatim pritisnite Insert, otvorite karticu Neural i uključite Enable NR.</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">ReShade.log u mapi igre govori u kojoj je mapi ReShade tražio dodatke. „Prijavi problem” pakira ga s ostalim.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">„Prijavi problem” pakira ove zapisnike u jednu datoteku za dijeljenje na Discordu.</sys:String>
  <sys:String x:Key="Str.SortFilter">Poredaj i filtriraj</sys:String>
  <sys:String x:Key="Str.FilterShow">Prikaži</sys:String>
  <sys:String x:Key="Str.FilterAll">Sve igre</sys:String>
  <sys:String x:Key="Str.FilterInstalled">Instalirane</sys:String>
  <sys:String x:Key="Str.FilterUpdates">Dostupno ažuriranje</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">Nisu instalirane</sys:String>
  <sys:String x:Key="Str.FilterEmulators">Emulatori</sys:String>
  <sys:String x:Key="Str.SortBy">Poredaj po</sys:String>
  <sys:String x:Key="Str.SortName">Ime</sys:String>
  <sys:String x:Key="Str.SortRecent">Nedavno igrane</sys:String>
  <sys:String x:Key="Str.SortAdded">Nedavno dodane</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">Nijedna igra na popisu ne odgovara ovom filtru.</sys:String>
  <sys:String x:Key="Str.WhatsNew">Što je novo</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">Otvori na GitHubu</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">Bilješke se nisu mogle pročitati s GitHuba. Nalaze se na stranici izdanja.</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">Ovo je izdanje objavljeno bez bilješki.</sys:String>
  <sys:String x:Key="Str.Transfer">Postavke NR-a</sys:String>
  <sys:String x:Key="Str.TransferTip">Postavke NR-a ove igre u jednoj datoteci, za čuvanje ili dijeljenje, i način da uvezete tuđe. Najprije zatvorite igru: postavke sprema pri izlasku.</sys:String>
  <sys:String x:Key="Str.TransferExport">Izvezi u datoteku…</sys:String>
  <sys:String x:Key="Str.TransferImport">Uvezi iz datoteke…</sys:String>
  <sys:String x:Key="Str.TransferNothing">Još nema što izvesti: postavke se zapisuju prvi put kad se igra pokrene s modom.</sys:String>
  <sys:String x:Key="Str.TransferExported">Postavke su spremljene u {0}.</sys:String>
  <sys:String x:Key="Str.TransferImported">Postavke iz {0} su primijenjene. Zamijenjene postavke sačuvane su u {1}.</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">Ove su postavke za put {0}, a u ovoj je igri instaliran {1}.</sys:String>
  <sys:String x:Key="Str.TransferInvalid">Ta datoteka nije izvoz postavki AMD-NR.</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. Pazite na postavke za pojedinu igru u svojstvima igre — tiho nadjačavaju globalne i najčešći su razlog zašto izgleda pokvareno kad nije.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. Ovdje uopće nema Direct3D-a, pa ovaj put dobiva samo boju i procijenjeno kretanje — bez dubine.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">Radi na D3D12, dakle na ograničenom putu: dodatak dobiva samo gotov okvir i ništa drugo. Radi, ali očekujte manje.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Na Vulkanu nema dubine: samo boja i procijenjeno kretanje.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Na Vulkanu nema dubine.</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. Na Vulkanu nema dubine.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan je zadani backend. Na Vulkanu nema dubine.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Samo Vulkan. Na Vulkanu nema dubine, a sam je emulator još u ranoj fazi — očekujte probleme.</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">Samo Vulkan. Odaberite mapu kyty_emulator.exe (launcher.exe ga samo pokreće). Bez dubine, a sam emulator je još rani — očekujte probleme.</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">U igri: Home otvara ReShade, a AMD Neural Rendering je pod Add-ons, ili Ctrl+End. FiveM ima vlastiti anti-cheat — prvo provjerite pravila poslužitelja.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. I OpenGL sada ima put, ali Vulkan je ovdje najviše isproban.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu renderira samo s OpenGL-om, pa je put OpenGL ovdje jedini. To je najnoviji put i eksperimentalan je: boja i procijenjeno kretanje, bez dubine.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. Softverski renderer crta na CPU-u i dodatak tamo nema do čega doći, pa mora biti OpenGL — a taj je put eksperimentalan: boja i procijenjeno kretanje, bez dubine.</sys:String>

</ResourceDictionary>
