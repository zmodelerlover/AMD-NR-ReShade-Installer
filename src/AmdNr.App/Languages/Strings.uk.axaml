<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Ukrainian">

  <!-- Українська. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Нейронний рендеринг DLSS 5 на Radeon, встановлений за вас</sys:String>
  <sys:String x:Key="Str.Games">Ігри</sys:String>
  <sys:String x:Key="Str.RemoveGame">Прибрати зі списку</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Прибирає гру зі списку, і «Знайти ігри» теж її пропускатиме. Жоден файл у її папці не змінюється; повернути її можна в налаштуваннях.</sys:String>
  <sys:String x:Key="Str.RemovedGame">Гру {0} прибрано зі списку, і «Знайти ігри» її пропускатиме. У її папці нічого не змінено; повернути її можна в «Налаштування» &gt; «Приховані ігри».</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">Гру {0} прибрано зі списку, але аддон досі встановлено в її папці. Поверніть її з «Налаштування» &gt; «Приховані ігри», щоб видалити його.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Приховані ігри</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Ігри, які ви прибрали зі списку. «Знайти ігри» їх пропускає, тож вони лишаються поза списком, доки ви не повернете їх звідси.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Прихованих ігор немає.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Повернути до списку</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">Гру {0} повернуто до списку.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Папки гри {0} більше немає, тож її лише прибрано з прихованих ігор.</sys:String>
  <sys:String x:Key="Str.NoGames">Тут поки нічого немає. Додайте папку, з якої запускається гра чи емулятор.</sys:String>
  <sys:String x:Key="Str.PickFolder">Виберіть папку, з якої запускається гра</sys:String>
  <sys:String x:Key="Str.AddGameMany">Пошук у папці</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Виберіть папку, де зберігаються ваші ігри</sys:String>
  <sys:String x:Key="Str.AddGameNone">У «{0}» не знайдено нічого схожого на гру.</sys:String>
  <sys:String x:Key="Str.Preset">Маршрут</sys:String>
  <sys:String x:Key="Str.Install">Встановити</sys:String>
  <sys:String x:Key="Str.Uninstall">Видалити</sys:String>
  <sys:String x:Key="Str.OpenFolder">Відкрити папку</sys:String>
  <sys:String x:Key="Str.System">Цей комп’ютер</sys:String>
  <sys:String x:Key="Str.Gpu">Відеокарта</sys:String>
  <sys:String x:Key="Str.Driver">Драйвер</sys:String>
  <sys:String x:Key="Str.Hip">Середовище HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">Не знайдено amdhip64_7.dll. Для RX 7000 і RX 9000 він постачається з актуальним драйвером Adrenalin; картам RX 6000 (RDNA2) потрібен HIP SDK 7.2 від AMD. HIP 6 не підійде.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Це не схоже на Radeon. Мережа працює лише на RDNA2, RDNA3 і RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Готово</sys:String>
  <sys:String x:Key="Str.Payloads">Файли</sys:String>
  <sys:String x:Key="Str.Downloading">Завантаження</sys:String>
  <sys:String x:Key="Str.Verifying">Перевірка того, що вже є…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Завантажено й перевірено.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Не вдалося прочитати опублікований список завантажень, тому використовується копія, що постачається з програмою.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Не вдалося прочитати список завантажень. Перевірте з’єднання й спробуйте ще раз.</sys:String>
  <sys:String x:Key="Str.Language">Мова</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Завантаження оновлення…</sys:String>
  <sys:String x:Key="Str.Dismiss">Не зараз</sys:String>
  <sys:String x:Key="Str.LogSaved">Повний журнал записано поруч із програмою.</sys:String>
  <sys:String x:Key="Str.Working">Виконується…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Не вдалося прочитати список ігор. Його збережено поруч як {0}, і розпочато новий список.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Триває запис у папку гри. Це займе кілька секунд; закрийте вікно, коли все завершиться.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Це безкоштовно. Якщо ви за це заплатили, вас ошукали.</sys:String>
  <sys:String x:Key="Str.FreeBody">Ніхто нічого з цього не продає — ні інсталятор, ні аддон, ні рантайм, ні ваги. Якщо з вас узяли гроші за це, за «ключ» чи за «pro-версію», вимагайте їх назад: те, що вам продали, є на цій сторінці безкоштовно.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Це відкритий код, і так і залишиться: читайте його, змінюйте, збирайте власну версію, діліться з друзями. Просимо лише про одне: щоб ніхто не робив із цього платну версію.</sys:String>
  <sys:String x:Key="Str.SupportSection">Підтримка</sys:String>
  <sys:String x:Key="Str.SupportNote">добровільна, і нічого не відкриває</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Разова кава.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">Бразильський збір коштів проєкту.</sys:String>
  <sys:String x:Key="Str.SupportRail">Підтримати AMD-NR</sys:String>
  <sys:String x:Key="Str.SupportTitle">Допоможіть AMD-NR жити</sys:String>
  <sys:String x:Key="Str.SupportBody">Цей проєкт живе лише завдяки підтримці тих, хто ним користується. Це двоє людей, дві відеокарти й пообідні години роботи: ні компанії, ні спонсора. Усе тут безкоштовне й таким лишиться. Підтримка нічого не відкриває — вона дає змогу працювати далі.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">Ви в Бразилії? Vakinha приймає Pix, картку або boleto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — автор danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Сама мережа і причина, з якої все це існує: саме вона вперше запустила нейронний рендеринг DLSS 5 на Radeon. Рантайм і ваги, які завантажує ця програма, — його робота, не наша. Дякуємо, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — аддон</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Те, що підключає цю мережу до гри через ReShade: аддон, який встановлює ця програма, і випуски, з яких вона пропонує вибрати. Ліцензія MIT, окремий репозиторій від цього інсталятора.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — тут усі</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Нові збірки, що працює в якій грі, і де питати, коли щось ламається.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Подяки</sys:String>
  <sys:String x:Key="Str.Scan">Знайти ігри</sys:String>
  <sys:String x:Key="Str.Scanning">Читання Steam, Epic, GOG, EA, Ubisoft, Battle.net і Xbox…</sys:String>
  <sys:String x:Key="Str.Search">Пошук ігор…</sys:String>
  <sys:String x:Key="Str.Settings">Налаштування</sys:String>
  <sys:String x:Key="Str.WillDownload">Файли буде завантажено й перевірено під час встановлення.</sys:String>
  <sys:String x:Key="Str.NoRoute">Для жодного API, яким рендерить ця гра, немає маршруту: аддон працює на D3D11, D3D12, Vulkan і OpenGL, а в 32-бітних іграх — на D3D8, D3D9 і D3D11. 32-бітна гра на OpenGL, 64-бітна на D3D9 і програмний рендерер маршруту не мають.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Ця гра може працювати на {1}. Виберіть у її графічних налаштуваннях {0} — це маршрут, вибраний тут, а на іншому API аддон бачить зовсім іншу гру.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Це гра на Unreal: додайте -{0} до її параметрів запуску.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Знайти цю гру на PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Ігор поки немає</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Нічого не знайдено</sys:String>
  <sys:String x:Key="Str.NoMatch">Жодна гра в списку не відповідає «{0}».</sys:String>
  <sys:String x:Key="Str.ScanningShort">Пошук…</sys:String>
  <sys:String x:Key="Str.ScanDone">Пошук завершено. Знайдено ігор: {0}, нових: {1}.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Встановлено</sys:String>
  <sys:String x:Key="Str.Close">Закрити</sys:String>
  <sys:String x:Key="Str.CloseHint">Закрити (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">Виконуваний файл гри</sys:String>
  <sys:String x:Key="Str.ExeChoose">Вибрати…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Використати виявлений</sys:String>
  <sys:String x:Key="Str.ExeNone">У цій папці не знайдено виконуваного файлу.</sys:String>
  <sys:String x:Key="Str.ExeNote">Маршрут визначається за цим файлом. Якщо розрядність виглядає неправильною (лаунчер у корені, гра в Bin64), вкажіть правильний .exe.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Цей файл вибрали ви, тож виявлення його не змінює, навіть після повторного пошуку.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Цей файл не в папці цієї гри.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Це не виконуваний файл Windows, який можна прочитати.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Цей маршрут для ігор {0}, а виконуваний файл вище — {1}. Вас ніщо не зупиняє — виявлення могло прочитати не той файл, — але якщо воно прочитало правильний, це не завантажиться.</sys:String>
  <sys:String x:Key="Str.VersionSection">Версія аддона</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade завантажується як</sys:String>
  <sys:String x:Key="Str.ProxyNote">Автоматично використовується dxgi.dll, що обслуговує будь-який Direct3D. Змінюйте, лише якщо гра не хоче його завантажувати.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler завантажується як</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">Автоматично використовується перша назва, яку вікі OptiScaler дає для цієї гри, інакше та, що вже використовується тут, інакше dxgi.dll. Виберіть winmm.dll, щоб зберегти dxgi.dll іншої програми.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Автоматично</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Автоматично (вікі: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Завантажити все зараз</sys:String>
  <sys:String x:Key="Str.ClearCache">Очистити кеш</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Видаляє завантажені файли, обкладинки й список версій. Нічого встановленого в іграх не змінюється; наступне встановлення знову завантажить потрібне.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Очистити</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Усе з нього буде завантажено знову під час наступного встановлення.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Залишити кеш як є.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Кеш очищено — звільнено {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Усе вже було на місці, і кожен байт щойно пройшов перевірку.</sys:String>
  <sys:String x:Key="Str.VersionShipped">вбудована</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">Версія, з якою опубліковано цей інсталятор.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">З випуску v{0} на GitHub, перевірено за його хешами.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Версія OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} з його випуску на GitHub, кожен файл перевірено за хешем.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Містить ваги lmxxf (близько 590 МБ, лише RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Може також додати mochizuki: див. «Рантайм NR».</sys:String>
  <sys:String x:Key="Str.MochizukiSection">Рантайм NR</sys:String>
  <sys:String x:Key="Str.DanielVersion">Версія danielblnc</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">Рекомендовано</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">Нестабільна</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">Яка версія рантайму danielblnc ставиться в цю гру. На картах RX 9000 рекомендовано 0.4.3: новіші спричиняли на них зависання ігор. Інші карти отримують найновішу.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: mochizuki (Vulkan-порт від mochizuki0323, близько 141 МБ) теж встановлюється і запускає мережу. Рантайм danielblnc лишається поруч: оберіть його в NR runtime на панелі аддона. Перший запуск кожної гри компілює мережу до хвилини.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: нове встановлення запускає lmxxf, а mochizuki (близько 141 МБ) ставиться поруч із рантаймом danielblnc. Оберіть інший у NR runtime на вкладці Neural OptiScaler і перезапустіть гру.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Виберіть маршрут встановлення</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Програма не змогла визначити, яким графічним API рендерить {0}, тому не вибирає маршрут за вас. OptiScaler — для гри на D3D12, яка має в налаштуваннях DLSS, FSR або XeSS; ReShade, на D3D11 або D3D12, — для будь-якої іншої. Встановлення чекатиме, доки ви не виберете.</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">Застосунок не зміг визначити, на якому графічному API працює {0}, тому не обирає шлях за вас. OptiScaler працює в 64-бітних іграх на D3D9, D3D11, D3D12, Vulkan і OpenGL, всередині DLSS, FSR або XeSS гри, якщо він є; ReShade також охоплює 32-бітні ігри, емулятори та D3D10. Встановлення чекає на ваш вибір.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">Графічний API невідомий, тож маршрут вибираєте ви нижче.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">Рантайм danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Яка збірка рантайму піде в цю гру. Використовується виділена картка.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Публічний випуск ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Завантажено й перевірено цією програмою.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Локальна збірка для підписників ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Вибрати мій version.dll або інсталятор…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Вибрати інший файл…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Новіша за публічний випуск, з вашого version.dll або інсталятора danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 додає ядра для карт RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 додає відеокарти RX 6000 (RDNA2), яким потрібен рантайм HIP SDK 7.2 від AMD, і прибирає мерехтіння в темних ділянках і на дрібних джерелах світла.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Ця програма ніколи його не завантажує й не поширює. Ваш файл перевіряється за SHA-256 і зберігається, тож інші ігри не питатимуть знову.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Використати мої файли підписника…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Публічний випуск</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Ваш version.dll або dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Будь-яка DLL або інсталятор</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">Використовується: рантайм, який завантажує ця програма.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Використовується {0} з вашого файлу.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Використовується {0}: перевірена копія, яку програма зберегла, коли ви вибрали його раніше.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">Вибрано {0}, але його копії на цьому комп’ютері ще немає: виберіть свій version.dll або інсталятор.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} потребує аддона v{1} або новішого: виберіть його у «Версія аддона». До того встановлюється завантажена версія.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} потребує OptiScaler {1} або новішого: виберіть його у «Версія OptiScaler». До того встановлюється завантажена версія.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">Аддон поки не може запустити {0}: список файлів не містить його патча. Доти тут встановлюється завантажена версія; маршрут OptiScaler запускає його як є.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Перевірено й збережено: рантайм danielblnc {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Цей файл не можна використати. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Перевірка папки…</sys:String>
  <sys:String x:Key="Str.StepDownload">Завантаження</sys:String>
  <sys:String x:Key="Str.StepVerify">Перевірка</sys:String>
  <sys:String x:Key="Str.StepInstall">Встановлення</sys:String>
  <sys:String x:Key="Str.StepDone">Готово</sys:String>
  <sys:String x:Key="Str.Installing">Встановлення…</sys:String>
  <sys:String x:Key="Str.Removing">Видалення…</sys:String>
  <sys:String x:Key="Str.InstallOk">Гру {0} налаштовано. Запустіть її, щоб скористатися.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Встановлено в гру {0}; нижче є {1} попередження.</sys:String>
  <sys:String x:Key="Str.InstallFail">Встановлення в гру {0} не завершилося.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Видалено з гри {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Видалено з гри {0}; нижче є {1} попередження.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Не вдалося видалити все з гри {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">Гра {0} досі вважається встановленою: не вдалося видалити один із файлів цієї програми. Закрийте гру й видаліть ще раз.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Видалено з гри {0} — у її папці не лишилося нічого від цієї програми.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Видалено з гри {0} — лишилися тільки ваші налаштування: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Видалити й налаштування?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Усе, що ця програма встановила в гру {0}, видалено. Ці файли налаштувань лишилися — у них те, що було задано в оверлеї:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Видалити й їх</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">Папка повернеться до стану, який був до встановлення.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Залишити налаштування</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Вони залишаться до наступного встановлення.</sys:String>
  <sys:String x:Key="Str.ResultErrors">Нижче описано {0} проблему.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Не вдалося завантажити файли, тому нічого не встановлено.</sys:String>
  <sys:String x:Key="Str.Folder">Папка</sys:String>
  <sys:String x:Key="Str.GameCount">Ігор: {0}</sys:String>
  <sys:String x:Key="Str.UnknownApi">Невідомий API</sys:String>
  <sys:String x:Key="Str.Location">Розташування</sys:String>
  <sys:String x:Key="Str.Details">Подробиці</sys:String>
  <sys:String x:Key="Str.DetailsCount">Рядків: {0}</sys:String>
  <sys:String x:Key="Str.PreflightOk">Готово до встановлення</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Нічого не заважає. Виберіть маршрут нижче й натисніть «Встановити».</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Готово до встановлення; є {0} примітка</sys:String>
  <sys:String x:Key="Str.PreflightErr">У цій папці знайдено {0} проблему</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Встановлено в цій грі</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Запустіть гру, щоб скористатися. Встановіть ще раз, щоб оновити файли, або видаліть, щоб їх прибрати.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Встановлено, і є оновлення</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Файли в цій грі старіші за ті, що ця програма встановлює зараз. «Оновити» їх замінить; ваші налаштування лишаться.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Відкрийте «Подробиці» нижче, щоб побачити, що знайдено.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Що аддону потрібно від цього комп’ютера; перевіряється під час запуску програми.</sys:String>
  <sys:String x:Key="Str.SystemReady">Цей комп’ютер має все, що потрібно аддону</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Цьому комп’ютеру бракує того, що потрібно аддону</sys:String>
  <sys:String x:Key="Str.GpuOk">Виявлено Radeon</sys:String>
  <sys:String x:Key="Str.GpuBad">Не Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Бракує</sys:String>
  <sys:String x:Key="Str.DriverHint">Версія графічного драйвера, яку повідомляє Windows.</sys:String>
  <sys:String x:Key="Str.FilesHint">Завантажуються один раз, перевіряються за закріпленим хешем і використовуються повторно для кожної гри.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Перевірено</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Не завантажено</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Завантаження…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Завантаження {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Мова, оновлення та про програму.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Усі написи змінюються одразу; перезапуск не потрібен.</sys:String>
  <sys:String x:Key="Str.DataFolder">Папка даних</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">Гра на D3D10/D3D11</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">Гра на D3D12</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Гра на Vulkan</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">Гра на OpenGL</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">Гра на D3D10/D3D11, 32-бітна</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">Гра на D3D9, 32-бітна</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">Гра на D3D8, 32-бітна</sys:String>
  <sys:String x:Key="Str.Preset.X86OpenGL">Гра на OpenGL, 32-бітна</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: гра на D3D12 з DLSS, FSR або XeSS</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Виберіть в емуляторі Direct3D 11: на цьому рендерері мережа отримує найбільше — глибину від емулятора й рух від ефекту-компаньйона, якщо його встановлено. Зважайте на налаштування окремої гри: вони мовчки перекривають загальні.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Експериментально. ReShade на Vulkan — це шар, а не проксі-DLL: встановлення реєструє його для вашого користувача Windows і вмикає для rpcs3.exe через ReShade.ini. На Vulkan немає глибини, лише колір і оцінений рух.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">Найкращий маршрут: D3D11 — єдиний, де власні вектори руху гри доходять до мережі разом із її глибиною. Гра на D3D10 теж іде цим маршрутом, лише з кольором.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Обмежений. На D3D12 аддон знаходить глибину гри, але не її вектори руху, тож мережа отримує колір і глибину, а рух оцінює. Працює, але чекайте від нього меншого. Грі з DLSS, FSR або XeSS у налаштуваннях краще підійде маршрут OptiScaler.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Рекомендовано для ігор на D3D12. Замість ReShade встановлює OptiScaler, який перехоплює DLSS, FSR або XeSS гри й запускає мережу всередині нього, з власною глибиною й векторами руху гри. Гра має пропонувати один із цих апскейлерів, увімкнений у її налаштуваннях. У грі натисніть Insert, відкрийте вкладку Neural і ввімкніть Enable NR; для гри з Ray Reconstruction точкою обробки має бути «After the finished frame».</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Експериментально. ReShade на Vulkan — це шар: встановлення реєструє його для вашого користувача Windows і вмикає для цієї програми через ReShade.ini поруч з її .exe. На Vulkan немає глибини.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Експериментально. На відміну від Vulkan це звичайна проксі-DLL: ReShade лягає поруч із грою як opengl32.dll, без окремого запуску інсталятора. Лише колір і оцінений рух; власна глибина гри на цьому API доступна, але ще не підключена. 32-бітна гра на OpenGL іде 32-бітним маршрутом для OpenGL.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Експериментально. 32-бітна гра не може завантажити 64-бітний рантайм, тож аддон працює як пара, що ділить кадри на одному адаптері. Встановіть ReShade з підтримкою аддонів як 32-бітний dxgi.dll. Гра на D3D10 теж іде цим маршрутом, лише з кольором.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Експериментально. Та сама 32-бітна пара, що й для D3D11, через приватний етап D3D9/D3D11. Звичайний D3D9 коштує кілька фіксованих мілісекунд на кадр; D3D9Ex — ні. Встановіть ReShade як 32-бітний d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Експериментально. D3D8 перекладається на D3D9 і далі йде маршрутом D3D9 вище, з тією самою 32-бітною парою. Встановіть ReShade як 32-бітний d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86OpenGL">Експериментально. Та сама 32-бітна пара, всередині OpenGL-контексту гри: лише колір і оцінений рух. Встановіть ReShade як 32-бітну opengl32.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM має власний античит: на власний ризик, і перевірте правила свого сервера. Аддон і ReShade йдуть у FiveM.app\plugins, рантайм і ваги — поруч із процесом гри в data\cache\subprocess. Те, що вже є в plugins — ReShade.ini, пресети, шейдери, інші аддони, ENB, — лишається як є.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Вітаємо</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Мережа DLSS 5 Neural Rendering на картах Radeon, через ReShade або OptiScaler. Чотири швидкі кроки.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Цей комп’ютер</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Файли</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Ваші ігри</sys:String>
  <sys:String x:Key="Str.SetupBack">Назад</sys:String>
  <sys:String x:Key="Str.SetupNext">Далі</sys:String>
  <sys:String x:Key="Str.SetupFinish">Почати</sys:String>
  <sys:String x:Key="Str.SetupSkip">Поки пропустити</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Крок {0} з {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Дві речі можуть завадити роботі аддона, і обидві видно звідси. Жодна не заважає продовжити — лише роботі в грі.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Цей комп’ютер має все, що потрібно аддону.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Чогось бракує. Можна продовжити й виправити пізніше, але в грі не працюватиме, доки ви цього не зробите.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Ті самі файли служать кожній грі: завантажуються один раз, перевіряються за закріпленим хешем і використовуються повторно.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Спробувати ще раз</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Пропустіть, і їх буде завантажено під час першого встановлення.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">Лаунчери лише читаються: від перегляду нічого не встановлюється й не змінюється. Папки можна додати вручну пізніше.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Кожна гра читається, щоб визначити, який графічний API вона використовує, і зазвичай це вірно, але не завжди: одна папка може містити виконуваний файл D3D11 і D3D12, а гра може за замовчуванням працювати на одному API, хоча її файл підтримує й старіший. Перед встановленням варто перевірити гру на pcgamingwiki.com — кожна картка гри має пряме посилання.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Ігор не знайдено. Папку можна додати вручну в головному вікні.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">Знайдено ігор: {0}.</sys:String>
  <sys:String x:Key="Str.Unexpected">Сталося щось неочікуване. Повний журнал записано.</sys:String>
  <sys:String x:Key="Str.Play">Грати</sys:String>
  <sys:String x:Key="Str.Launch">Відкрити</sys:String>
  <sys:String x:Key="Str.Configure">Налаштувати</sys:String>
  <sys:String x:Key="Str.ViewGrid">Сітка обкладинок</sys:String>
  <sys:String x:Key="Str.ViewList">Список зі сторінкою гри поруч</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Автооновлення</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Коли вийде новіша збірка, ця гра оновиться сама під час відкриття програми.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">{0} гру оновлено автоматично.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">Автоматично оновлено ігор: {0}.</sys:String>
  <sys:String x:Key="Str.Rename">Перейменувати</sys:String>
  <sys:String x:Key="Str.Save">Зберегти</sys:String>
  <sys:String x:Key="Str.Cancel">Скасувати</sys:String>
  <sys:String x:Key="Str.ChangeCover">Обкладинка</sys:String>
  <sys:String x:Key="Str.CoverPick">Вибрати зображення…</sys:String>
  <sys:String x:Key="Str.CoverReset">Використати обкладинку з інтернету</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Виберіть обкладинку для цієї гри</sys:String>
  <sys:String x:Key="Str.CoverFiles">Зображення</sys:String>
  <sys:String x:Key="Str.CoverFailed">Цей файл не вдалося прочитати як зображення.</sys:String>
  <sys:String x:Key="Str.Customize">Оформлення</sys:String>
  <sys:String x:Key="Str.HeroPick">Вибрати банер…</sys:String>
  <sys:String x:Key="Str.HeroReset">Використати банер з інтернету</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Виберіть банер для цієї гри</sys:String>
  <sys:String x:Key="Str.PlayFailed">Не вдалося запустити. Відкрийте папку й запустіть виконуваний файл вручну.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Додати емулятор</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Додати емулятор</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Виберіть який, потім вкажіть папку, з якої він запускається — папку з виконуваним файлом, а не з ROM-ами.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Інший емулятор</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Вкажіть папку, і я скажу, що можна з неї визначити.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Вкажіть папку {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Вкажіть папку емулятора</sys:String>
  <sys:String x:Key="Str.EmulatorFound">Знайдено {0}: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Це не схоже на {0}: у цій папці немає {1}. Все одно додано — перевірте шлях.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Тут немає жодного відомого мені емулятора. Додано за тим, що кажуть файли: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">В емуляторі</sys:String>
  <sys:String x:Key="Str.ReportTitle">Не працює в грі?</sys:String>
  <sys:String x:Key="Str.ReportBody">Пакує журнали й перелік файлів папки гри в .zip на вашому комп’ютері. Нічого не надсилається.</sys:String>
  <sys:String x:Key="Str.Report">Повідомити про проблему</sys:String>
  <sys:String x:Key="Str.ReportSaved">Звіт збережено, папку відкрито: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Не вдалося створити звіт. Журнали в {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Збирання…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Файли не завантажуються?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Збирає все, що пробувало кожне завантаження — кожну адресу, її DNS-запит, проксі й відповідь, — і ще раз перевіряє кожну адресу, усе в один .zip. Нічого не надсилається: файл лишається на вашому комп’ютері, і ви ділитеся ним, де захочете.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Журнали завантажень</sys:String>
  <sys:String x:Key="Str.Add">Додати</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Шукати ігри в папці…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Папка однієї гри…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Емулятор…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Оновити</sys:String>
  <sys:String x:Key="Str.GamesAway">На непідключеному диску: {0}</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Ігри на диску, який зараз не підключено, запам’ятовуються разом з усім, що для них вибрано, і повертаються, коли повертається диск.</sys:String>
  <sys:String x:Key="Str.GameGone">Гру {0} більше не встановлено, тож її прибрано зі списку.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} гру більше не встановлено, тож її прибрано зі списку.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">Більше не встановлені й прибрані зі списку ігри: {0}.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Показати подробиці</sys:String>
  <sys:String x:Key="Str.DetectedSection">Виявлено</sys:String>
  <sys:String x:Key="Str.InstallsInto">Встановлюється в: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">Це поза доданою текою: тут лежить {0} — збірка, яку запускає лаунчер. Якщо ви граєте в іншій збірці, виберіть її {0} вище.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Файли кажуть, з чим гра зв’язана, а не на чому вона працює: одна папка може містити виконуваний файл D3D11 і D3D12. Вікі каже, що саме використовує гра.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Прочитано з власних файлів гри.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">З PCGamingWiki та файлів гри.</sys:String>
  <sys:String x:Key="Str.InstallWith">Встановити через</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + аддон</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Рекомендовано</sys:String>
  <sys:String x:Key="Str.RecommendedLower">рекомендовано</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">Аддон усередині ReShade. D3D11, D3D12, Vulkan, OpenGL, 32-бітні ігри та емулятори.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Немає маршруту ReShade для того, чим визначено цю гру ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Працює всередині DLSS, FSR або XeSS гри, з її власною глибиною й рухом. Замінює ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Працює всередині апскейлера гри (тут знайдено {0}). Замінює ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Зроблено для 64-бітних ігор на D3D12; цю гру визначено як {0}.</sys:String>
  <sys:String x:Key="Str.RouteOptiSummaryAll">Працює всередині DLSS, FSR або XeSS гри, якщо він є, а якщо немає — на готовому кадрі. 64-бітні D3D9, D3D11, D3D12, Vulkan і OpenGL. Замінює ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfitAll">Для 64-бітних ігор на D3D9, D3D11, D3D12, Vulkan і OpenGL; ця гра визначається як {0}.</sys:String>
  <sys:String x:Key="Str.ApiSection">Графічний API</sys:String>
  <sys:String x:Key="Str.Group64">64-бітні ігри</sys:String>
  <sys:String x:Key="Str.Group32">32-бітні ігри (експериментально)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Емулятори</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V online</sys:String>
  <sys:String x:Key="Str.OptiAbout">Замість ReShade встановлює OptiScaler, який перехоплює DLSS, FSR або XeSS гри й запускає мережу всередині нього, з власною глибиною й векторами руху гри.</sys:String>
  <sys:String x:Key="Str.InGame">У грі</sys:String>
  <sys:String x:Key="Str.OptiStep1">Увімкніть DLSS, FSR або XeSS у графічних налаштуваннях гри.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Натисніть Insert, відкрийте вкладку Neural і ввімкніть Enable NR.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Якщо ввімкнено Ray Reconstruction, виберіть точку обробки «After the finished frame».</sys:String>
  <sys:String x:Key="Str.InstallOpti">Встановити OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">Оновити</sys:String>
  <sys:String x:Key="Str.Reinstall">Перевстановити</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Перейти на OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Перейти на ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Перейти на {0}?</sys:String>
  <sys:String x:Key="Str.SwitchBody">У грі {0} встановлено маршрут {1}, а обидва не можуть бути в одній папці одночасно. Спершу {1} видаляється з поверненням усього, що він замінив, а потім встановлюється {2}.</sys:String>
  <sys:String x:Key="Str.SwitchYes">Видалити {0}, встановити {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Ваші файли налаштувань залишаться на місці.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Нічого не змінюється; {0} залишається встановленим.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">Причина — у «Подробицях». Нічого не встановлено.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Файли можна також завантажити браузером і передати програмі: «Цей комп’ютер» &gt; «Файли» &gt; «Завантажити вручну», потім «Імпортувати файли». Файли в папці «Завантаження» знаходяться самі.</sys:String>
  <sys:String x:Key="Str.DnsRetry">Очистити DNS і спробувати ще раз</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows не дозволив очистити кеш DNS звідси. Відкрийте командний рядок, виконайте ipconfig /flushdns і спробуйте ще раз.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">Проблем у цій папці: {0}</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Готово до встановлення; приміток: {0}</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Встановлено в гру {0}; попереджень нижче: {1}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Видалено з гри {0}; попереджень нижче: {1}.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">Проблем нижче: {0}.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Немає списку завантажень</sys:String>
  <sys:String x:Key="Str.FailedShort">Помилка</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Усі готові ({0})</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">Бракує: {0} · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Не вдалося завантажити: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Завантажити вручну</sys:String>
  <sys:String x:Key="Str.ImportFiles">Імпортувати файли…</sys:String>
  <sys:String x:Key="Str.ImportHint">Виберіть папку з файлами, які ви завантажили самі. Кожен файл розпізнається за назвою і береться, лише якщо збігається із закріпленим хешем.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Завантажте файли самі</sys:String>
  <sys:String x:Key="Str.ManualBody">Відкрийте кожне посилання в браузері й збережіть файл будь-де: папка «Завантаження» переглядається сама, а «Імпортувати файли» приймає будь-яку іншу. Назви змінювати не треба, і нічого, що не збігається із закріпленим SHA-256, не використовується.</sys:String>
  <sys:String x:Key="Str.ImportPick">Виберіть папку із завантаженими файлами</sys:String>
  <sys:String x:Key="Str.ImportAll">Усі файли тепер на місці й перевірені.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Ніщо в цій папці не відповідає потрібним файлам.</sys:String>
  <sys:String x:Key="Str.ImportSome">Взято: {0}. Ще бракує: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">Аддон</sys:String>
  <sys:String x:Key="Str.Component.runtime">Нейронний рантайм і ваги</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32-бітний міст</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32-бітні доповнення</sys:String>
  <sys:String x:Key="Str.Component.shader">Ефект-компаньйон</sys:String>
  <sys:String x:Key="Str.Updates">Оновлення</sys:String>
  <sys:String x:Key="Str.UpToDate">Актуальна версія</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Перевірка новішої версії…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0} — найновіша версія. Перевірено о {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">Доступна версія {0}. У вас {1}.</sys:String>
  <sys:String x:Key="Str.HotfixLabel">v{0} хотфікс {1}</sys:String>
  <sys:String x:Key="Str.HotfixShort">хотфікс {0}</sys:String>
  <sys:String x:Key="Str.HotfixOut">Доступний хотфікс {1} для v{0}: виправлення цієї версії, а не нова версія.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">Не вдалося перевірити: GitHub не відповів. Програма працює так само.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Завантажити оновлення</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Завантажити з GitHub</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Перевірити оновлення</sys:String>
  <sys:String x:Key="Str.SessionSection">Останній сеанс</sys:String>
  <sys:String x:Key="Str.SessionTip">Прочитано з журналів, які аддон і рантайм пишуть у папку гри. Читається знову, коли ви повертаєтеся до цього вікна після гри.</sys:String>
  <sys:String x:Key="Str.SessionRan">NR працював в останньому сеансі</sys:String>
  <sys:String x:Key="Str.SessionCrashed">Гра аварійно завершилася в останньому сеансі</sys:String>
  <sys:String x:Key="Str.SessionFailed">NR не запустився в останньому сеансі</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade запустився, але аддон не завантажився</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">Мод завантажився, але NR не обробив жодного кадру</sys:String>
  <sys:String x:Key="Str.SessionNever">Сеансів ще не було. Запустіть гру один раз і поверніться: тут буде видно, чи працював NR.</sys:String>
  <sys:String x:Key="Str.SessionFrames">Оброблено кадрів: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">Мережа: {0} мс на кадр</sys:String>
  <sys:String x:Key="Str.SessionRuntime">Рантайм {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">У грі відкрийте оверлей ReShade клавішею Home і перевірте, що NR увімкнено на панелі AMD Neural Rendering.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">У грі ввімкніть DLSS, FSR або XeSS, потім натисніть Insert, відкрийте вкладку Neural і ввімкніть Enable NR.</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">ReShade.log у папці гри каже, в якій папці ReShade шукав аддони. «Повідомити про проблему» пакує його разом з рештою.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">«Повідомити про проблему» пакує ці журнали в один файл, яким можна поділитися в Discord.</sys:String>
  <sys:String x:Key="Str.SortFilter">Сортування й фільтр</sys:String>
  <sys:String x:Key="Str.FilterShow">Показати</sys:String>
  <sys:String x:Key="Str.FilterAll">Усі ігри</sys:String>
  <sys:String x:Key="Str.FilterInstalled">Встановлені</sys:String>
  <sys:String x:Key="Str.FilterUpdates">Є оновлення</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">Не встановлені</sys:String>
  <sys:String x:Key="Str.FilterEmulators">Емулятори</sys:String>
  <sys:String x:Key="Str.SortBy">Сортувати за</sys:String>
  <sys:String x:Key="Str.SortName">Назва</sys:String>
  <sys:String x:Key="Str.SortRecent">Нещодавно запущені</sys:String>
  <sys:String x:Key="Str.SortAdded">Нещодавно додані</sys:String>
  <sys:String x:Key="Str.FilterFavorites">Обране</sys:String>
  <sys:String x:Key="Str.SortPinnedFirst">Спершу обрані та встановлені</sys:String>
  <sys:String x:Key="Str.Favorite">Обране</sys:String>
  <sys:String x:Key="Str.AddFavorite">Додати до обраного</sys:String>
  <sys:String x:Key="Str.RemoveFavorite">Прибрати з обраного</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">Жодна гра в списку не відповідає цьому фільтру.</sys:String>
  <sys:String x:Key="Str.WhatsNew">Що нового</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">Відкрити на GitHub</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">Не вдалося прочитати нотатки з GitHub. Вони є на сторінці випуску.</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">Цей випуск опубліковано без нотаток.</sys:String>
  <sys:String x:Key="Str.Transfer">Налаштування NR</sys:String>
  <sys:String x:Key="Str.TransferTip">Налаштування NR цієї гри в одному файлі, щоб зберегти чи поділитися, і спосіб завантажити чужі. Спершу закрийте гру: вона зберігає налаштування під час виходу.</sys:String>
  <sys:String x:Key="Str.TransferExport">Експортувати у файл…</sys:String>
  <sys:String x:Key="Str.TransferImport">Імпортувати з файлу…</sys:String>
  <sys:String x:Key="Str.TransferNothing">Поки нічого експортувати: налаштування записуються під час першого запуску гри з модом.</sys:String>
  <sys:String x:Key="Str.TransferExported">Налаштування збережено в {0}.</sys:String>
  <sys:String x:Key="Str.TransferImported">Налаштування з {0} застосовано. Ті, що вони замінили, збережено в {1}.</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">Ці налаштування для маршруту {0}, а в цій грі встановлено {1}.</sys:String>
  <sys:String x:Key="Str.TransferInvalid">Цей файл не є експортом налаштувань AMD-NR.</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. Зважайте на налаштування окремої гри у її властивостях: вони мовчки перекривають загальні, і це найчастіша причина, чому все виглядає зламаним, хоча це не так.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. Direct3D тут немає зовсім, тож цей маршрут отримує лише колір і оцінений рух — без глибини.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">Працює на D3D12, тобто на обмеженому маршруті: аддон бачить лише готовий кадр і більше нічого. Працює, але чекайте від нього меншого.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. На Vulkan немає глибини: лише колір і оцінений рух.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. На Vulkan немає глибини.</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. На Vulkan немає глибини.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan — бекенд за замовчуванням. На Vulkan немає глибини.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Лише Vulkan. На Vulkan немає глибини, а сам емулятор ще на ранній стадії — чекайте проблем.</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">Лише Vulkan. Вкажіть теку kyty_emulator.exe (launcher.exe лише запускає його). Глибини немає, а сам емулятор ще ранній — чекайте проблем.</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">У грі: Home відкриває ReShade, AMD Neural Rendering — у вкладці Add-ons, або Ctrl+End. FiveM має власний античит — спершу перевірте правила сервера.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. Для OpenGL тепер теж є маршрут, але найбільш випробуваний тут Vulkan.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu рендерить лише через OpenGL, тож маршрут OpenGL тут єдиний. Це найновіший із маршрутів, і він експериментальний: колір і оцінений рух, без глибини.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. Програмний рендерер малює на CPU, і аддону там нічого досягти, тож потрібен саме OpenGL — а цей маршрут експериментальний: колір і оцінений рух, без глибини.</sys:String>

</ResourceDictionary>
