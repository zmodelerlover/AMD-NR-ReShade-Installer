<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Turkish">

  <!-- Türkçe. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Radeon üzerinde DLSS 5 nöral işleme, sizin için kurulur</sys:String>
  <sys:String x:Key="Str.Games">Oyunlar</sys:String>
  <sys:String x:Key="Str.RemoveGame">Listeden kaldır</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Oyunu listeden çıkarır; «Oyunları tara» da onu atlar. Klasöründeki hiçbir dosyaya dokunulmaz; Ayarlar'dan geri getirebilirsiniz.</sys:String>
  <sys:String x:Key="Str.RemovedGame">Listeden çıkarıldı ve «Oyunları tara» onu atlayacak: {0}. Klasöründeki hiçbir şeye dokunulmadı; Ayarlar &gt; Yok sayılan oyunlar bölümünden geri getirebilirsiniz.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">Listeden çıkarıldı, ancak eklenti klasöründe hâlâ kurulu: {0}. Kaldırmak için Ayarlar &gt; Yok sayılan oyunlar bölümünden geri getirin.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Yok sayılan oyunlar</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Listeden çıkardığınız oyunlar. «Oyunları tara» bunları atlar; buradan geri getirene kadar liste dışında kalırlar.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Yok sayılan oyun yok.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Listeye geri ekle</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">Listeye geri eklendi: {0}.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Klasörü artık yok, bu yüzden yalnızca yok sayılan oyunlardan çıkarıldı: {0}.</sys:String>
  <sys:String x:Key="Str.NoGames">Burada henüz bir şey yok. Bir oyunun ya da emülatörün çalıştığı klasörü ekleyin.</sys:String>
  <sys:String x:Key="Str.PickFolder">Oyunun çalıştığı klasörü seçin</sys:String>
  <sys:String x:Key="Str.AddGameMany">Bir klasörde ara</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Oyunlarınızın bulunduğu klasörü seçin</sys:String>
  <sys:String x:Key="Str.AddGameNone">Şu klasörde oyuna benzeyen bir şey bulunamadı: «{0}».</sys:String>
  <sys:String x:Key="Str.Preset">Yöntem</sys:String>
  <sys:String x:Key="Str.Install">Kur</sys:String>
  <sys:String x:Key="Str.Uninstall">Kaldır</sys:String>
  <sys:String x:Key="Str.OpenFolder">Klasörü aç</sys:String>
  <sys:String x:Key="Str.System">Bu bilgisayar</sys:String>
  <sys:String x:Key="Str.Gpu">Ekran kartı</sys:String>
  <sys:String x:Key="Str.Driver">Sürücü</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 çalışma zamanı</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll bulunamadı. Güncel bir Adrenalin sürücüsüyle birlikte gelir; HIP 6 yeterli değildir.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Bu bir Radeon gibi görünmüyor. Ağ yalnızca RDNA3 ve RDNA4 üzerinde çalışır.</sys:String>
  <sys:String x:Key="Str.Ready">Hazır</sys:String>
  <sys:String x:Key="Str.Payloads">Dosyalar</sys:String>
  <sys:String x:Key="Str.Downloading">İndiriliyor</sys:String>
  <sys:String x:Key="Str.Verifying">Mevcut dosyalar doğrulanıyor…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">İndirildi ve doğrulandı.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Yayımlanan indirme listesi okunamadı, bu yüzden bu uygulamayla gelen kopya kullanılıyor.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">İndirme listesi okunamadı. Bağlantınızı kontrol edip tekrar deneyin.</sys:String>
  <sys:String x:Key="Str.Language">Dil</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Güncelleme indiriliyor…</sys:String>
  <sys:String x:Key="Str.Dismiss">Şimdi değil</sys:String>
  <sys:String x:Key="Str.LogSaved">Tam günlük bu uygulamanın yanına kaydedildi.</sys:String>
  <sys:String x:Key="Str.Working">Çalışıyor…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Oyun listesi okunamadı. Yanında şu adla saklandı ve yeni bir liste başlatıldı: {0}.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Bir oyun klasörüne hâlâ yazılıyor. Birkaç saniye sürer; bittiğinde pencereyi kapatın.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Bu ücretsizdir. Para ödediyseniz dolandırılıyorsunuz.</sys:String>
  <sys:String x:Key="Str.FreeBody">Bunların hiçbiri satılmaz: ne yükleyici, ne eklenti, ne çalışma zamanı, ne de ağırlıklar. Sizden bunun için, ya da bir «anahtar» veya «pro sürüm» için para alındıysa, paranızı geri isteyin: size satılan şey bu sayfada ücretsiz olarak duruyor.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Açık kaynaklıdır ve öyle kalacak: okuyun, değiştirin, kendi sürümünüzü derleyin, arkadaşlarınıza verin. Tek ricamız, kimsenin onu ücretli bir sürüme dönüştürmemesi.</sys:String>
  <sys:String x:Key="Str.SupportSection">Destek</sys:String>
  <sys:String x:Key="Str.SupportNote">isteğe bağlıdır ve karşılığında bir şey vermez</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Tek seferlik bir kahve.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">Projenin Brezilya'daki bağış kampanyası.</sys:String>
  <sys:String x:Key="Str.SupportRail">AMD-NR'ı destekle</sys:String>
  <sys:String x:Key="Str.SupportTitle">AMD-NR'ı yaşat</sys:String>
  <sys:String x:Key="Str.SupportBody">Bu proje yalnızca kullananların desteğiyle ayakta kalıyor. İki kişi, iki ekran kartı ve öğleden sonraları süren bir emek: şirket yok, sponsor yok. Buradaki her şey ücretsiz ve öyle kalacak. Destek hiçbir şeyin kilidini açmaz; işin sürmesini sağlar.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">Brezilya'da mısın? Vakinha Pix, kart veya boleto kabul eder.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Ağın kendisi ve tüm bunların var olma sebebi: DLSS 5'in nöral işlemesini Radeon'da çalıştırmayı başaran şey odur. Bu uygulamanın indirdiği çalışma zamanı ve ağırlıklar onun emeğidir, bizim değil. Teşekkürler, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — eklenti</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">O ağı ReShade üzerinden bir oyuna bağlayan şey: bu uygulamanın kurduğu eklenti ve aralarından seçim yapmanızı sağladığı sürümler. MIT lisanslıdır ve bu yükleyiciden ayrı bir depodadır.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — herkesin buluştuğu yer</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Yeni sürümler, hangi oyunda neyin çalıştığı ve bir şey bozulduğunda nereye soracağınız.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Emeği geçenler</sys:String>
  <sys:String x:Key="Str.Scan">Oyunları tara</sys:String>
  <sys:String x:Key="Str.Scanning">Steam, Epic, GOG, EA, Ubisoft, Battle.net ve Xbox okunuyor…</sys:String>
  <sys:String x:Key="Str.Search">Oyunlarda ara…</sys:String>
  <sys:String x:Key="Str.Settings">Ayarlar</sys:String>
  <sys:String x:Key="Str.WillDownload">Dosyalar kurulum sırasında indirilir ve doğrulanır.</sys:String>
  <sys:String x:Key="Str.NoRoute">Bu oyunun görüntü oluşturmak için kullandığı hiçbir API için yöntem yok: eklenti D3D11, D3D12, Vulkan ve OpenGL üzerinde, 32 bit oyunlarda ise D3D8, D3D9 ve D3D11 üzerinde çalışır. 32 bit bir OpenGL oyunu, 64 bit bir D3D9 oyunu ve yazılımsal bir işleyici için yöntem yoktur.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Bu oyun şu API ile de çalışabilir: {1}. Oyunun kendi grafik ayarlarından {0} seçeneğini ayarlayın: burada seçilen yöntem odur ve başka bir API'de eklenti farklı bir oyun görür.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Bu bir Unreal oyunu: başlatma seçeneklerine -{0} ekleyin.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Bu oyunu PCGamingWiki'de arayın</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Henüz oyun yok</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Sonuç yok</sys:String>
  <sys:String x:Key="Str.NoMatch">Listede şununla eşleşen oyun yok: «{0}».</sys:String>
  <sys:String x:Key="Str.ScanningShort">Taranıyor…</sys:String>
  <sys:String x:Key="Str.ScanDone">Tarama tamamlandı: {0} oyun bulundu, {1} tanesi yeni.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Kurulu</sys:String>
  <sys:String x:Key="Str.Close">Kapat</sys:String>
  <sys:String x:Key="Str.CloseHint">Kapat (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">Oyunun çalıştırılabilir dosyası</sys:String>
  <sys:String x:Key="Str.ExeChoose">Seç…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Algılananı kullan</sys:String>
  <sys:String x:Key="Str.ExeNone">Bu klasörde çalıştırılabilir dosya bulunamadı.</sys:String>
  <sys:String x:Key="Str.ExeNote">Yöntem bu dosyadan belirlenir. Bit sayısı yanlış görünüyorsa (ana klasörde bir başlatıcı, oyun ise Bin64'te), doğru .exe dosyasını seçin.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Bu dosyayı siz seçtiniz; bu yüzden algılama, yeniden taramadan sonra bile onu değiştirmez.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">O dosya bu oyunun klasöründe değil.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">O dosya okunabilen bir Windows çalıştırılabilir dosyası değil.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Bu yöntem şu oyunlar içindir: {0}. Yukarıdaki çalıştırılabilir dosya ise şu: {1}. Sizi hiçbir şey durdurmaz (algılama yanlış dosyayı okumuş olabilir), ancak doğru dosyayı okuduysa bu yüklenmeyecektir.</sys:String>
  <sys:String x:Key="Str.VersionSection">Eklenti sürümü</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade şu adla yüklenir</sys:String>
  <sys:String x:Key="Str.ProxyNote">«Otomatik», tüm Direct3D sürümlerine hizmet eden dxgi.dll'yi kullanır. Yalnızca oyun onu yüklemeyi reddederse değiştirin.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler şu adla yüklenir</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">«Otomatik», OptiScaler wiki'sinin bu oyun için verdiği ilk adı kullanır; yoksa burada zaten kullanılan adı, o da yoksa dxgi.dll. Başka bir programın dxgi.dll dosyasını korumak için winmm.dll seçin.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Otomatik</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Otomatik (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Hepsini şimdi indir</sys:String>
  <sys:String x:Key="Str.ClearCache">Önbelleği temizle</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">İndirilen dosyaları, kapakları ve sürüm listesini siler. Bir oyuna kurulmuş hiçbir şeye dokunulmaz; sonraki kurulum ihtiyaç duyduğunu yeniden indirir.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Temizle</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">İçindeki her şey bir sonraki kurulumda yeniden indirilir.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Önbelleği olduğu gibi bırakın.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Önbellek boşaltıldı. Açılan alan: {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Her şey zaten buradaydı ve her bayt az önce doğrulandı.</sys:String>
  <sys:String x:Key="Str.VersionShipped">dahili</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">Bu yükleyicinin birlikte yayımlandığı sürüm.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">GitHub'daki v{0} sürümünden, özetleriyle doğrulanmış olarak.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler sürümü</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, GitHub sürümünden; her dosya kendi özetiyle doğrulanır.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">lmxxf ağırlıklarını içerir (yaklaşık 590 MB, yalnızca RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">mochizuki'yi de getirebilir: «NR çalışma zamanı» bölümüne bakın.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR çalışma zamanı</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">mochizuki'yi de ikinci bir NR çalışma zamanı olarak kur (deneysel)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">mochizuki0323 tarafından Vulkan'a taşınan DLSS 5 ağı. Yalnızca RDNA4: RX 9000 serisi, AMD sürücüsü 25.10 veya üzeri. MochizukiNrRuntime.dll dosyasını ve modelini içeren bir dlssnr-amd klasörünü ekler; indirme boyutu yaklaşık 141 MB. NR çalışma zamanı danielblnc olarak kalır: mochizuki'yi kullanmak için OptiScaler'ın Neural sekmesinde «NR runtime» altından onu seçin ve oyunu yeniden başlatın. Her oyundaki ilk açılışta ağ birkaç saniye derlenir. İşaret kaldırılırsa sonraki kurulum, bu uygulamanın ondan eklediklerini kaldırır.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">mochizuki'yi de ikinci bir NR çalışma zamanı olarak kur (deneysel)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">mochizuki0323 tarafından Vulkan'a taşınan DLSS 5 ağı; eklenti v0.6.8'den itibaren danielblnc'nin ağı yerine bunu çalıştırabilir. Yalnızca RDNA4: RX 9000 serisi, AMD sürücüsü 25.10 veya üzeri. MochizukiNrRuntime.dll dosyasını ve modelini içeren bir dlssnr-amd klasörünü ekler; indirme boyutu yaklaşık 141 MB. Kullanmak için eklenti panelinde «NR runtime» altından mochizuki (Vulkan) seçin ve oyunu yeniden başlatın. Her oyundaki ilk açılışta ağ bir dakikaya kadar derlenir. İşaret kaldırılırsa sonraki kurulum, bu uygulamanın ondan eklediklerini kaldırır.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">Bu kartta sunulmuyor ({0}): mochizuki, RDNA4'ün yani RX 9000 serisinin FP8 matris komutlarına ihtiyaç duyar.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">Bu uygulama kartın hangisi olduğunu anlayamadı; RX 9000 serisi dışındaki her kartta mochizuki oyun içinde kapalı kalır.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Kurulum yöntemini seçin</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Bu uygulama oyunun hangi grafik API'siyle görüntü oluşturduğunu anlayamadı ({0}), bu yüzden sizin yerinize yöntem seçmiyor. Ayarlarında DLSS, FSR veya XeSS sunan bir D3D12 oyunu için doğru seçim OptiScaler'dır; diğer tüm oyunlar için D3D11 veya D3D12 üzerinde ReShade. Siz seçene kadar «Kur» bekler.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">Grafik API'si bilinmiyor, bu yüzden yöntemi aşağıdan siz seçin.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc çalışma zamanı</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Bu oyuna hangi çalışma zamanı sürümünün gireceği. Vurgulanan kart kullanılandır.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Bu uygulama tarafından indirilir ve doğrulanır.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">version.dll veya kurulum dosyamı seç…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Başka bir dosya seç…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Public Release'ten daha yeni; kendi version.dll dosyanızdan veya danielblnc'nin kurulum dosyasından.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0, RDNA3 kartlar için çekirdekler ekler.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Bu uygulama onu asla indirmez veya paylaşmaz. Dosyanız SHA-256 ile doğrulanır ve saklanır, böylece diğer oyunlar tekrar sormaz.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Destekçi dosyalarımı kullan…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">version.dll veya dlssnr_on_amd_setup.exe dosyanız</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Herhangi bir DLL veya kurulum dosyası</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">Kullanımda: bu uygulamanın indirdiği çalışma zamanı.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Kullanımda: dosyanızdaki sürüm {0}.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Kullanımda: sürüm {0}, daha önce seçtiğinizde bu uygulamanın sakladığı doğrulanmış kopya.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">Seçilen sürüm {0}, ancak bu bilgisayarda henüz bir kopyası yok: version.dll veya kurulum dosyanızı seçin.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">Sürüm {0}, eklenti v{1} veya üzerini gerektirir: «Eklenti sürümü» altından birini seçin. O zamana kadar indirilen sürüm kurulur.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">Sürüm {0}, OptiScaler {1} veya üzerini gerektirir: «OptiScaler sürümü» altından birini seçin. O zamana kadar indirilen sürüm kurulur.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">Eklenti henüz sürüm {0} çalıştıramıyor: indirme listesinde onun yaması yok. Yama gelene kadar burada indirilen sürüm kurulur; OptiScaler yöntemi ise onu olduğu gibi çalıştırır.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Doğrulandı ve saklandı: danielblnc çalışma zamanı, sürüm {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Bu dosya kullanılamaz. {0}</sys:String>
