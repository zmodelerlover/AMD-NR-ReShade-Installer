  <sys:String x:Key="Str.UninstallOk">Kaldırıldı: {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Kaldırıldı: {0}. Aşağıda okunacak {1} uyarı var.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Her şey kaldırılamadı: {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">Hâlâ kurulu sayılıyor: {0}. Bu uygulamaya ait bir dosya kaldırılamadı. Oyunu kapatıp tekrar kaldırın.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Kaldırıldı: {0}. Klasöründe bu uygulamadan hiçbir şey kalmadı.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Kaldırıldı: {0}. Yalnızca ayarlarınız kaldı: {1}.</sys:String>
