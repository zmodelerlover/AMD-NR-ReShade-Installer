  <sys:String x:Key="Str.FailedShort">失败</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">全部 {0} 个已就绪</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">缺少 {0} 个 · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">无法下载：{0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">手动下载</sys:String>
  <sys:String x:Key="Str.ImportFiles">导入文件…</sys:String>
  <sys:String x:Key="Str.ImportHint">选择一个包含你自己下载的文件的文件夹。每个文件按名称识别，只有与其固定哈希值一致时才会被采用。</sys:String>
  <sys:String x:Key="Str.ManualTitle">自行下载文件</sys:String>
  <sys:String x:Key="Str.ManualBody">在浏览器中打开每个链接，并将文件保存到任意位置：“下载”文件夹会被自动搜索，“导入文件”可以选择其他任何文件夹。无需重命名，与其固定 SHA-256 不一致的文件不会被使用。</sys:String>
  <sys:String x:Key="Str.ImportPick">选择存放已下载文件的文件夹</sys:String>
  <sys:String x:Key="Str.ImportAll">所有文件都已就位并校验通过。</sys:String>
  <sys:String x:Key="Str.ImportNothing">该文件夹中没有任何所需的文件。</sys:String>
  <sys:String x:Key="Str.ImportSome">已采用：{0}。仍然缺少：{1}。</sys:String>
  <sys:String x:Key="Str.Component.addon">插件</sys:String>
  <sys:String x:Key="Str.Component.runtime">神经网络运行时和权重</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32 位桥接</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32 位附加组件</sys:String>
  <sys:String x:Key="Str.Component.shader">配套效果</sys:String>
  <sys:String x:Key="Str.Updates">更新</sys:String>
  <sys:String x:Key="Str.UpToDate">已是最新</sys:String>
  <sys:String x:Key="Str.UpdateChecking">正在检查新版本…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0} 是最新版本。检查时间：{1}。</sys:String>
  <sys:String x:Key="Str.UpdateOut">版本 {0} 已发布。你当前使用的是 {1}。</sys:String>
  <sys:String x:Key="Str.HotfixLabel">v{0} 热修复 {1}</sys:String>
  <sys:String x:Key="Str.HotfixShort">热修复 {0}</sys:String>
  <sys:String x:Key="Str.HotfixOut">v{0} 的热修复 {1} 已发布：这是本版本的修复，不是新版本。</sys:String>
  <sys:String x:Key="Str.UpdateFailed">无法检查：GitHub 没有响应。无论如何，应用都能照常使用。</sys:String>
  <sys:String x:Key="Str.UpdateNow">下载更新</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">从 GitHub 下载</sys:String>
  <sys:String x:Key="Str.UpdateCheck">检查更新</sys:String>
  <sys:String x:Key="Str.SessionSection">上次会话</sys:String>
  <sys:String x:Key="Str.SessionTip">读取自插件和运行时写入游戏文件夹的日志。玩完游戏回到此窗口时会重新读取。</sys:String>
  <sys:String x:Key="Str.SessionRan">上次会话中 NR 已运行</sys:String>
  <sys:String x:Key="Str.SessionCrashed">上次会话中游戏崩溃了</sys:String>
  <sys:String x:Key="Str.SessionFailed">上次会话中 NR 未能启动</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade 已启动，但插件没有加载</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">模组已加载，但 NR 没有处理任何帧</sys:String>
  <sys:String x:Key="Str.SessionNever">还没有会话记录。启动一次游戏后再回来，这里会显示 NR 是否运行。</sys:String>
  <sys:String x:Key="Str.SessionFrames">已处理帧数：{0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">网络：每帧 {0} 毫秒</sys:String>
  <sys:String x:Key="Str.SessionRuntime">运行时 {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">在游戏中按 Home 打开 ReShade 界面，确认 AMD Neural Rendering 面板中的 NR 已开启。</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">在游戏中开启 DLSS、FSR 或 XeSS，然后按 Insert，打开 Neural 选项卡并开启“Enable NR”。</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">游戏文件夹中的 ReShade.log 记录了 ReShade 在哪个文件夹中查找插件。“报告问题”会把它和其他文件一起打包。</sys:String>
  <sys:String x:Key="Str.SessionReportHint">“报告问题”会把这些日志打包成一个文件，方便在 Discord 上分享。</sys:String>
  <sys:String x:Key="Str.SortFilter">排序和筛选</sys:String>
  <sys:String x:Key="Str.FilterShow">显示</sys:String>
  <sys:String x:Key="Str.FilterAll">全部游戏</sys:String>
  <sys:String x:Key="Str.FilterInstalled">已安装</sys:String>
  <sys:String x:Key="Str.FilterUpdates">有可用更新</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">未安装</sys:String>
  <sys:String x:Key="Str.FilterEmulators">模拟器</sys:String>
  <sys:String x:Key="Str.SortBy">排序方式</sys:String>
  <sys:String x:Key="Str.SortName">名称</sys:String>
  <sys:String x:Key="Str.SortRecent">最近游玩</sys:String>
  <sys:String x:Key="Str.SortAdded">最近添加</sys:String>
  <sys:String x:Key="Str.FilterFavorites">收藏</sys:String>
  <sys:String x:Key="Str.SortPinnedFirst">收藏和已安装的优先</sys:String>
  <sys:String x:Key="Str.Favorite">收藏</sys:String>
  <sys:String x:Key="Str.AddFavorite">加入收藏</sys:String>
  <sys:String x:Key="Str.RemoveFavorite">取消收藏</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">列表中没有符合此筛选条件的游戏。</sys:String>
  <sys:String x:Key="Str.WhatsNew">新功能</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">在 GitHub 上打开</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">无法从 GitHub 读取更新说明。请在发布页面查看。</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">此版本发布时没有附带说明。</sys:String>
  <sys:String x:Key="Str.Transfer">NR 设置</sys:String>
  <sys:String x:Key="Str.TransferTip">将此游戏的 NR 设置保存为一个文件，便于备份或分享；也可以导入他人的设置。请先关闭游戏：游戏会在退出时保存设置。</sys:String>
  <sys:String x:Key="Str.TransferExport">导出到文件…</sys:String>
  <sys:String x:Key="Str.TransferImport">从文件导入…</sys:String>
  <sys:String x:Key="Str.TransferNothing">暂时没有可导出的内容：游戏首次带着模组运行时才会写入设置。</sys:String>
  <sys:String x:Key="Str.TransferExported">设置已保存到 {0}。</sys:String>
  <sys:String x:Key="Str.TransferImported">已应用 {0} 中的设置。被替换的设置已保存在 {1}。</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">这些设置适用于 {0} 方式，而此游戏安装的是 {1}。</sys:String>
  <sys:String x:Key="Str.TransferInvalid">该文件不是 AMD-NR 设置导出文件。</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11。注意游戏属性中针对单个游戏的设置：它会在不提示的情况下覆盖全局设置，这是看起来出问题、实际却没问题的最常见原因。</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan。这里完全没有 Direct3D，因此此安装方式只能获得颜色和估算的运动，没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11。</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11。</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">它运行在 D3D12 上，这是效果受限的安装方式：插件只能看到最终完成的画面。可以运行，但效果会差一些。</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan。Vulkan 上没有深度：只有颜色和估算的运动。</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan。Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan。Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan 是默认后端。Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">仅支持 Vulkan。Vulkan 上没有深度，而且这个模拟器本身还处于早期阶段，可能会遇到问题。</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">仅 Vulkan。请选择 kyty_emulator.exe 所在的文件夹（launcher.exe 只负责启动它）。没有深度，而且模拟器本身还很早期，可能会遇到问题。</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">游戏中：按 Home 打开 ReShade，AMD Neural Rendering 在 Add-ons 里，或按 Ctrl+End。FiveM 有自己的反作弊，请先查看服务器规则。</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan。OpenGL 现在也有安装方式了，但这里经过更多实际验证的是 Vulkan。</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu 只使用 OpenGL 渲染，所以这里只有 OpenGL 这一种安装方式。它是最新的安装方式，仍处于实验阶段：只有颜色和估算的运动，没有深度。</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL。软件渲染器在 CPU 上绘制，插件在那里无从介入，所以必须使用 OpenGL 渲染器，而该安装方式仍处于实验阶段：只有颜色和估算的运动，没有深度。</sys:String>

</ResourceDictionary>
