<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.ChineseSimplified">

  <!-- 简体中文. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">在 Radeon 上运行 DLSS 5 神经渲染，一键为你安装</sys:String>
  <sys:String x:Key="Str.Games">游戏</sys:String>
  <sys:String x:Key="Str.RemoveGame">从列表中移除</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">将游戏从列表中移除，“扫描游戏”也会跳过它。不会改动其文件夹中的任何文件；可以在设置中恢复。</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} 已从列表中移除，“扫描游戏”会跳过它。其文件夹中的内容未被改动；可在“设置 &gt; 已忽略的游戏”中恢复。</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} 已从列表中移除，但插件仍安装在其文件夹中。请在“设置 &gt; 已忽略的游戏”中恢复它，然后再卸载。</sys:String>
  <sys:String x:Key="Str.IgnoredGames">已忽略的游戏</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">你从列表中移除的游戏。“扫描游戏”会跳过它们，因此在你从这里恢复之前，它们不会再出现。</sys:String>
  <sys:String x:Key="Str.IgnoredNone">没有已忽略的游戏。</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">恢复到列表</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} 已恢复到列表。</sys:String>
  <sys:String x:Key="Str.IgnoredGone">{0} 的文件夹已不存在，因此只是将它移出了已忽略的游戏。</sys:String>
  <sys:String x:Key="Str.NoGames">这里还什么都没有。请添加游戏或模拟器运行所在的文件夹。</sys:String>
  <sys:String x:Key="Str.PickFolder">选择游戏运行所在的文件夹</sys:String>
  <sys:String x:Key="Str.AddGameMany">搜索文件夹</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">选择存放游戏的文件夹</sys:String>
  <sys:String x:Key="Str.AddGameNone">在“{0}”中没有找到任何像游戏的内容。</sys:String>
  <sys:String x:Key="Str.Preset">安装方式</sys:String>
  <sys:String x:Key="Str.Install">安装</sys:String>
  <sys:String x:Key="Str.Uninstall">卸载</sys:String>
  <sys:String x:Key="Str.OpenFolder">打开文件夹</sys:String>
  <sys:String x:Key="Str.System">本机</sys:String>
  <sys:String x:Key="Str.Gpu">显卡</sys:String>
  <sys:String x:Key="Str.Driver">驱动程序</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 运行时</sys:String>
  <sys:String x:Key="Str.HipMissing">未找到 amdhip64_7.dll。RX 7000 和 RX 9000 的最新 Adrenalin 驱动自带此文件；RX 6000 (RDNA2) 显卡需要 AMD 的 HIP SDK 7.2。HIP 6 不行。</sys:String>
  <sys:String x:Key="Str.NotRadeon">这看起来不是 Radeon 显卡。神经网络只能在 RDNA2、RDNA3 和 RDNA4 上运行。</sys:String>
  <sys:String x:Key="Str.Ready">就绪</sys:String>
  <sys:String x:Key="Str.Payloads">文件</sys:String>
  <sys:String x:Key="Str.Downloading">正在下载</sys:String>
  <sys:String x:Key="Str.Verifying">正在校验已有文件…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">已下载并校验。</sys:String>
  <sys:String x:Key="Str.ManifestLocal">无法读取已发布的下载列表，因此正在使用本应用自带的副本。</sys:String>
  <sys:String x:Key="Str.ManifestFailed">无法读取下载列表。请检查网络连接后重试。</sys:String>
  <sys:String x:Key="Str.Language">语言</sys:String>
  <sys:String x:Key="Str.UpdateWorking">正在下载更新…</sys:String>
  <sys:String x:Key="Str.Dismiss">暂不</sys:String>
  <sys:String x:Key="Str.LogSaved">完整日志已保存在本应用旁边。</sys:String>
  <sys:String x:Key="Str.Working">正在处理…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">无法读取游戏列表。原列表已在旁边保存为 {0}，并已新建一个列表。</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">仍在写入游戏文件夹，需要几秒钟；完成后再关闭窗口。</sys:String>
  <sys:String x:Key="Str.FreeTitle">这是免费的。如果你为此付了钱，那你被骗了。</sys:String>
  <sys:String x:Key="Str.FreeBody">这里的一切都不出售：安装器、插件、运行时、权重都不。如果有人向你收费，或者卖给你所谓的“密钥”或“专业版”，请要求退款：他们卖给你的东西，在这个页面上免费提供。</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">本项目开源，并将一直开源：你可以阅读、修改、自行编译，也可以分享给朋友。我们唯一的请求是：任何人都不要把它变成付费版本。</sys:String>
  <sys:String x:Key="Str.SupportSection">支持</sys:String>
  <sys:String x:Key="Str.SupportNote">完全自愿，不会换来任何东西</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">请喝一杯咖啡。</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">本项目在巴西的众筹。</sys:String>
  <sys:String x:Key="Str.SupportRail">支持 AMD-NR</sys:String>
  <sys:String x:Key="Str.SupportTitle">让 AMD-NR 继续下去</sys:String>
  <sys:String x:Key="Str.SupportBody">这个项目只能靠使用者的支持延续下去。它只是两个人、两张显卡和一个个下午的工作：没有公司，也没有赞助。这里的一切都是免费的，并将一直免费。支持不会解锁任何东西，它让工作得以继续。</sys:String>
  <sys:String x:Key="Str.SupportBrazil">在巴西？Vakinha 支持 Pix、银行卡或 boleto。</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD，作者 danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">神经网络本身，也是这一切得以存在的原因：正是它让 DLSS 5 的神经渲染第一次在 Radeon 上跑了起来。本应用下载的运行时和权重都是他的成果，而不是我们的。谢谢你，danielblnc。</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd，插件</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">通过 ReShade 将该神经网络接入游戏的部分：即本应用安装的插件，以及它让你选择的各个版本。采用 MIT 许可证，与本安装器是不同的代码仓库。</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord：大家都在这里</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">新版本发布、哪些游戏能用，以及出问题时去哪里提问。</sys:String>
  <sys:String x:Key="Str.CreditsSection">致谢</sys:String>
  <sys:String x:Key="Str.Scan">扫描游戏</sys:String>
  <sys:String x:Key="Str.Scanning">正在读取 Steam、Epic、GOG、EA、Ubisoft、Battle.net 和 Xbox…</sys:String>
  <sys:String x:Key="Str.Search">搜索游戏…</sys:String>
  <sys:String x:Key="Str.Settings">设置</sys:String>
  <sys:String x:Key="Str.WillDownload">安装时会下载并校验文件。</sys:String>
  <sys:String x:Key="Str.NoRoute">这款游戏使用的渲染方式都没有对应的安装方式：插件支持 D3D11、D3D12、Vulkan 和 OpenGL，32 位游戏支持 D3D8、D3D9 和 D3D11。32 位 OpenGL 游戏、64 位 D3D9 游戏和软件渲染都不支持。</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">这款游戏可以在 {1} 上运行。请在游戏自己的图形设置中改为 {0}：这里选择的就是这种方式；换成其他 API，对插件来说就相当于另一款游戏。</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">这是一款虚幻引擎游戏：请在其启动选项中加入 -{0}。</sys:String>
  <sys:String x:Key="Str.CheckWiki">在 PCGamingWiki 上查看这款游戏</sys:String>
  <sys:String x:Key="Str.EmptyTitle">还没有游戏</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">没有匹配项</sys:String>
  <sys:String x:Key="Str.NoMatch">列表中没有与“{0}”匹配的游戏。</sys:String>
  <sys:String x:Key="Str.ScanningShort">正在扫描…</sys:String>
  <sys:String x:Key="Str.ScanDone">扫描完成：找到 {0} 款游戏，其中 {1} 款是新的。</sys:String>
  <sys:String x:Key="Str.InstalledBadge">已安装</sys:String>
  <sys:String x:Key="Str.Close">关闭</sys:String>
  <sys:String x:Key="Str.CloseHint">关闭（Esc）</sys:String>
  <sys:String x:Key="Str.ExeSection">游戏的可执行文件</sys:String>
  <sys:String x:Key="Str.ExeChoose">选择…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">使用检测到的文件</sys:String>
  <sys:String x:Key="Str.ExeNone">此文件夹中没有找到可执行文件。</sys:String>
  <sys:String x:Key="Str.ExeNote">安装方式是根据这个文件判断的。如果位数看起来不对（根目录是启动器，游戏本体在 Bin64 中），请指定正确的 .exe。</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">这是你选择的文件，所以检测不会改动它，重新扫描后也不会。</sys:String>
  <sys:String x:Key="Str.ExeNotHere">该文件不在这款游戏的文件夹中。</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">该文件不是可读取的 Windows 可执行文件。</sys:String>
  <sys:String x:Key="Str.RouteMismatch">此安装方式适用于 {0} 游戏，而上面的可执行文件是 {1}。你仍然可以继续（检测可能读错了文件），但如果读的是正确的文件，这将无法加载。</sys:String>
  <sys:String x:Key="Str.VersionSection">插件版本</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade 加载为</sys:String>
  <sys:String x:Key="Str.ProxyNote">“自动”使用 dxgi.dll，适用于所有 Direct3D。只有当游戏拒绝加载它时才需要更改。</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler 加载为</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">“自动”会使用 OptiScaler Wiki 为此游戏给出的第一个文件名；如果没有，则使用此处已在使用的名称；否则使用 dxgi.dll。要保留其他程序的 dxgi.dll，请选择 winmm.dll。</sys:String>
  <sys:String x:Key="Str.ProxyAuto">自动</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">自动（维基：{0}）</sys:String>
  <sys:String x:Key="Str.PrefetchAll">立即全部下载</sys:String>
  <sys:String x:Key="Str.ClearCache">清除缓存</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">删除已下载的文件、封面和版本列表。不会改动任何已安装到游戏中的内容；下次安装时会重新下载所需文件。</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">清除</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">其中的所有内容会在下次安装时重新下载。</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">保留缓存不变。</sys:String>
  <sys:String x:Key="Str.CacheCleared">缓存已清空，释放了 {0}。</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">所有文件都已存在，每个字节都刚刚校验通过。</sys:String>
  <sys:String x:Key="Str.VersionShipped">内置</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">本安装器发布时附带的版本。</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">来自 GitHub 上的 v{0} 发布版，已按其哈希值校验。</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler 版本</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}，来自其 GitHub 发布版，每个文件都已按哈希值校验。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">包含 lmxxf 的权重（约 590 MB，仅限 RDNA4）。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">也可以附带 mochizuki：见“NR 运行时”。</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR 运行时</sys:String>
  <sys:String x:Key="Str.DanielVersion">danielblnc 版本</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">推荐</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">不稳定</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">此游戏安装哪个版本的 danielblnc 运行时。在 RX 9000 显卡上推荐 0.4.3：更新的版本曾在这些显卡上让游戏卡死。其他显卡获得最新版本。</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000：mochizuki（mochizuki0323 的 Vulkan 移植版，约 141 MB）也会装入并运行网络。danielblnc 的运行时留在旁边：可在插件面板的 NR runtime 中选择。每个游戏首次启动会编译网络，最多一分钟。</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000：新安装运行 lmxxf，mochizuki（约 141 MB）装在 danielblnc 运行时旁边。在 OptiScaler 的 Neural 选项卡的 NR runtime 中选择其他运行时，然后重启游戏。</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">选择一种安装方式</sys:String>
  <sys:String x:Key="Str.PickRouteBody">本应用无法判断 {0} 使用哪种图形 API 渲染，因此不会替你选择安装方式。OptiScaler 适用于在设置中提供 DLSS、FSR 或 XeSS 的 D3D12 游戏；ReShade（D3D11 或 D3D12）适用于其他所有游戏。在你选择之前，“安装”会一直等待。</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">图形 API 未知，请在下方自行选择安装方式。</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc 的运行时</sys:String>
  <sys:String x:Key="Str.SupporterChoose">为这款游戏安装哪个运行时版本。高亮的卡片就是正在使用的版本。</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release（{0}）</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">由本应用下载并校验。</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build（{0}）</sys:String>
  <sys:String x:Key="Str.SupporterPick">选择我的 version.dll 或安装程序…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">选择其他文件…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">比 Public Release 更新，来自你自己的 version.dll 或 danielblnc 的安装程序。</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 增加了适用于 RDNA3 显卡的内核。</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 新增对 RX 6000（RDNA2）显卡的支持，这些显卡需要 AMD 的 HIP SDK 7.2 运行时；并修复了暗部和小光源的闪烁。</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">本应用从不下载或分发它。你的文件会经 SHA-256 校验后保存，其他游戏无需再次索取。</sys:String>
  <sys:String x:Key="Str.SupporterUse">使用我的赞助者文件…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">你的 version.dll 或 dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll、dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">任意 DLL 或安装程序</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">当前使用：本应用下载的运行时。</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">正在使用你文件中的 {0}。</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">正在使用 {0}：你之前选择时本应用保存的已校验副本。</sys:String>
  <sys:String x:Key="Str.SupporterMissing">已选择 {0}，但本机上还没有它的副本：请选择你的 version.dll 或安装程序。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} 需要插件 v{1} 或更新版本：请在“插件版本”中选择。在此之前会安装下载的版本。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} 需要 OptiScaler {1} 或更新版本：请在“OptiScaler 版本”中选择。在此之前会安装下载的版本。</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">插件暂时还无法运行 {0}：下载列表中还没有它的补丁。在补丁提供之前，这里会安装下载的版本；OptiScaler 安装方式则可以直接运行它。</sys:String>
  <sys:String x:Key="Str.SupporterKept">已校验并保存：danielblnc 的运行时 {0}。</sys:String>
  <sys:String x:Key="Str.SupporterRefused">该文件无法使用。{0}</sys:String>
  <sys:String x:Key="Str.Checking">正在检查此文件夹…</sys:String>
  <sys:String x:Key="Str.StepDownload">下载</sys:String>
  <sys:String x:Key="Str.StepVerify">校验</sys:String>
  <sys:String x:Key="Str.StepInstall">安装</sys:String>
  <sys:String x:Key="Str.StepDone">完成</sys:String>
  <sys:String x:Key="Str.Installing">正在安装…</sys:String>
  <sys:String x:Key="Str.Removing">正在移除…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} 已设置完成。启动游戏即可使用。</sys:String>
  <sys:String x:Key="Str.InstallWarn">已安装到 {0}，下方有 {1} 条警告需要查看。</sys:String>
  <sys:String x:Key="Str.InstallFail">在 {0} 上的安装未完成。</sys:String>
  <sys:String x:Key="Str.UninstallOk">已从 {0} 移除。</sys:String>
  <sys:String x:Key="Str.UninstallWarn">已从 {0} 移除，下方有 {1} 条警告需要查看。</sys:String>
  <sys:String x:Key="Str.UninstallFail">无法从 {0} 中移除所有内容。</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} 仍被视为已安装：本应用的某个文件无法移除。请关闭游戏后再次卸载。</sys:String>
  <sys:String x:Key="Str.UninstallClean">已从 {0} 移除：其文件夹中不再有本应用的任何内容。</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">已从 {0} 移除，只保留了你的设置：{1}。</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">也要删除你的设置吗？</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">本应用在 {0} 中安装的所有内容都已移除。以下设置文件被保留了下来，其中保存着你在叠加界面中的设置：</sys:String>
  <sys:String x:Key="Str.SettingsRemove">一并删除</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">文件夹会恢复到安装前的状态。</sys:String>
  <sys:String x:Key="Str.SettingsKeep">保留我的设置</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">它们会保留到你下次安装时使用。</sys:String>
  <sys:String x:Key="Str.ResultErrors">下方列出了 {0} 个问题。</sys:String>
  <sys:String x:Key="Str.DownloadFailed">无法下载文件，因此没有安装任何内容。</sys:String>
  <sys:String x:Key="Str.Folder">文件夹</sys:String>
  <sys:String x:Key="Str.GameCount">{0} 款游戏</sys:String>
  <sys:String x:Key="Str.UnknownApi">未知 API</sys:String>
  <sys:String x:Key="Str.Location">位置</sys:String>
  <sys:String x:Key="Str.Details">详细信息</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} 行</sys:String>
  <sys:String x:Key="Str.PreflightOk">可以安装</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">没有任何障碍。在下方选择安装方式，然后点击“安装”。</sys:String>
  <sys:String x:Key="Str.PreflightWarn">可以安装，有 {0} 条提示需要查看</sys:String>
  <sys:String x:Key="Str.PreflightErr">在此文件夹中发现 {0} 个问题</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">已安装到这款游戏</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">启动游戏即可使用。再次安装可刷新文件，卸载则会移除它们。</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">已安装，有可用更新</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">这款游戏中的文件比本应用现在安装的版本旧。“更新”会替换它们，你的设置会保留。</sys:String>
  <sys:String x:Key="Str.SeeDetails">展开下方的“详细信息”查看发现的内容。</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">插件对这台电脑的要求，在应用启动时检查。</sys:String>
  <sys:String x:Key="Str.SystemReady">这台电脑满足插件的要求</sys:String>
  <sys:String x:Key="Str.SystemNotReady">这台电脑缺少插件需要的东西</sys:String>
  <sys:String x:Key="Str.GpuOk">已检测到 Radeon</sys:String>
  <sys:String x:Key="Str.GpuBad">不是 Radeon</sys:String>
  <sys:String x:Key="Str.Missing">缺失</sys:String>
  <sys:String x:Key="Str.DriverHint">Windows 报告的显卡驱动版本。</sys:String>
  <sys:String x:Key="Str.FilesHint">只下载一次，按固定的哈希值校验，并在所有游戏中复用。</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">已校验</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">未下载</sys:String>
  <sys:String x:Key="Str.DownloadingShort">正在下载…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">正在下载 {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">语言、更新以及关于本应用。</sys:String>
  <sys:String x:Key="Str.LanguageHint">所有文字立即切换，无需重启。</sys:String>
  <sys:String x:Key="Str.DataFolder">数据文件夹</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D10/D3D11 游戏</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12 游戏</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan 游戏</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL 游戏</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D10/D3D11 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.X86OpenGL">OpenGL 游戏，32 位</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler：带 DLSS、FSR 或 XeSS 的 D3D12 游戏</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">请将模拟器设为 Direct3D 11：在这个渲染器下，神经网络能获得最多信息，包括模拟器的深度，以及安装了配套效果时的运动信息。注意单个游戏的独立设置，它会在不提示的情况下覆盖全局设置。</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">实验性。在 Vulkan 上，ReShade 是一个层，而不是代理 DLL：安装时会为你的 Windows 用户注册该层，并通过 ReShade.ini 为 rpcs3.exe 启用它。Vulkan 上没有深度，只有颜色和估算的运动。</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">最佳安装方式：只有在 D3D11 上，游戏自身的运动矢量和深度才能一起送达神经网络。D3D10 游戏也使用此方式，仅有颜色。</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">效果受限。在 D3D12 上，插件能找到游戏的深度，但找不到它的运动矢量，因此神经网络获得颜色和深度，运动则靠估算。可以运行，但效果会差一些。设置中带有 DLSS、FSR 或 XeSS 的游戏更适合使用 OptiScaler 安装方式。</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">推荐用于 D3D12 游戏。它不安装 ReShade，而是安装 OptiScaler，接管游戏的 DLSS、FSR 或 XeSS，并在其中运行神经网络，使用游戏自身的深度和运动矢量。游戏必须提供其中一种超分辨率技术，并在设置中启用。在游戏中按 Insert，打开 Neural 标签页并开启“Enable NR”；使用光线重建（Ray Reconstruction）的游戏需要将处理点设为“After the finished frame”。</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">实验性。在 Vulkan 上，ReShade 是一个层：安装时会为你的 Windows 用户注册该层，并通过其 .exe 旁的 ReShade.ini 为这个程序启用它。Vulkan 上没有深度。</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">实验性。与 Vulkan 不同，这里是普通的代理 DLL：ReShade 以 opengl32.dll 的形式放在游戏旁边，无需另外运行安装程序。只有颜色和估算的运动；在此 API 上可以取得游戏自身的深度，但尚未接入。32 位 OpenGL 游戏使用 32 位 OpenGL 安装方式。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">实验性。32 位游戏无法加载 64 位运行时，因此插件以一对进程的形式运行，在同一块显卡上共享画面。请将支持插件的 ReShade 安装为 32 位的 dxgi.dll。D3D10 游戏也使用此方式，仅有颜色。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">实验性。与 D3D11 相同的 32 位进程对，通过一个私有的 D3D9/D3D11 中转阶段。普通 D3D9 每帧会固定多耗几毫秒，D3D9Ex 则不会。请将 ReShade 安装为 32 位的 d3d9.dll。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">实验性。D3D8 会被转换为 D3D9，然后走上面的 D3D9 安装方式，使用同样的 32 位进程对。请将 ReShade 安装为 32 位的 d3d9.dll。</sys:String>
  <sys:String x:Key="Str.PresetNote.X86OpenGL">实验性。同一套 32 位组合，在游戏的 OpenGL 上下文中运行：只有颜色和估算的运动。请将 ReShade 安装为 32 位 opengl32.dll。</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM 有自己的反作弊：风险自负，并请查看你服务器的规则。插件和 ReShade 放在 FiveM.app\plugins，运行时和权重放在游戏进程旁边的 data\cache\subprocess。plugins 里你已有的东西（ReShade.ini、预设、着色器、其他插件、ENB）保持原样。</sys:String>
  <sys:String x:Key="Str.SetupWelcome">欢迎</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">在 Radeon 显卡上通过 ReShade 或 OptiScaler 运行 DLSS 5 神经渲染网络。只需四个简单步骤。</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">本机</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">文件</sys:String>
  <sys:String x:Key="Str.SetupStepGames">你的游戏</sys:String>
  <sys:String x:Key="Str.SetupBack">上一步</sys:String>
  <sys:String x:Key="Str.SetupNext">继续</sys:String>
  <sys:String x:Key="Str.SetupFinish">开始使用</sys:String>
  <sys:String x:Key="Str.SetupSkip">暂时跳过</sys:String>
  <sys:String x:Key="Str.SetupStepOf">第 {0} 步，共 {1} 步</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">有两件事会导致插件无法运行，这里都能看到。它们都不会妨碍你继续，只会影响在游戏中的使用。</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">本机满足插件的全部要求。</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">缺少一些东西。你可以继续，之后再修复，但在修复之前，它无法在游戏中工作。</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">所有游戏共用同一套文件：只下载一次，按固定的哈希值校验后复用。</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">重试</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">跳过此步骤的话，文件会在第一次安装时下载。</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">读取启动器是只读操作：查看不会安装或更改任何东西。之后你也可以手动添加文件夹。</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">每款游戏都会被分析以确定它使用的图形 API，这通常是准确的，但并非总是如此：同一个文件夹里可能同时有 D3D11 和 D3D12 的可执行文件，而且游戏可能默认使用某个 API，但其可执行文件也支持较旧的 API。安装前，最好先在 pcgamingwiki.com 上查一下这款游戏；每张游戏卡片上都有直达链接。</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">没有找到游戏。你可以在主窗口中手动添加文件夹。</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">找到 {0} 款游戏。</sys:String>
  <sys:String x:Key="Str.Unexpected">发生了意外情况。完整日志已保存。</sys:String>
  <sys:String x:Key="Str.Play">开始游戏</sys:String>
  <sys:String x:Key="Str.Launch">打开</sys:String>
  <sys:String x:Key="Str.Configure">配置</sys:String>
  <sys:String x:Key="Str.ViewGrid">封面网格</sys:String>
  <sys:String x:Key="Str.ViewList">列表，旁边显示游戏页面</sys:String>
  <sys:String x:Key="Str.AutoUpdate">自动更新</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">有新版本时，这款游戏会在打开应用时自动更新。</sys:String>
  <sys:String x:Key="Str.AutoUpdated">已自动更新 {0} 款游戏。</sys:String>
