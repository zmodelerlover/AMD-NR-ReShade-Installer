<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Japanese">

  <!-- 日本語. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Radeon で DLSS 5 のニューラルレンダリングを。インストールはおまかせ</sys:String>
  <sys:String x:Key="Str.Games">ゲーム</sys:String>
  <sys:String x:Key="Str.RemoveGame">リストから削除</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">ゲームをリストから削除し、「ゲームをスキャン」でも除外します。フォルダー内のファイルには一切触れません。設定から元に戻せます。</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} をリストから削除しました。「ゲームをスキャン」でも除外されます。フォルダー内には何も触れていません。「設定 &gt; 除外したゲーム」から元に戻せます。</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} をリストから削除しましたが、アドオンはまだそのフォルダーにインストールされています。アンインストールするには「設定 &gt; 除外したゲーム」から元に戻してください。</sys:String>
  <sys:String x:Key="Str.IgnoredGames">除外したゲーム</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">リストから削除したゲームです。「ゲームをスキャン」ではスキップされるので、ここで元に戻すまで表示されません。</sys:String>
  <sys:String x:Key="Str.IgnoredNone">除外したゲームはありません。</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">リストに戻す</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} をリストに戻しました。</sys:String>
  <sys:String x:Key="Str.IgnoredGone">{0} のフォルダーがもう存在しないため、除外リストから外すだけにしました。</sys:String>
  <sys:String x:Key="Str.NoGames">まだ何もありません。ゲームやエミュレーターを実行するフォルダーを追加してください。</sys:String>
  <sys:String x:Key="Str.PickFolder">ゲームを実行するフォルダーを選択してください</sys:String>
  <sys:String x:Key="Str.AddGameMany">フォルダーを検索</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">ゲームを保存しているフォルダーを選択してください</sys:String>
  <sys:String x:Key="Str.AddGameNone">「{0}」内にゲームらしきものは見つかりませんでした。</sys:String>
  <sys:String x:Key="Str.Preset">導入方法</sys:String>
  <sys:String x:Key="Str.Install">インストール</sys:String>
  <sys:String x:Key="Str.Uninstall">アンインストール</sys:String>
  <sys:String x:Key="Str.OpenFolder">フォルダーを開く</sys:String>
  <sys:String x:Key="Str.System">このPC</sys:String>
  <sys:String x:Key="Str.Gpu">グラフィックス</sys:String>
  <sys:String x:Key="Str.Driver">ドライバー</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 ランタイム</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll が見つかりません。RX 7000 と RX 9000 では最新の Adrenalin ドライバーに含まれています。RX 6000 (RDNA2) には AMD の HIP SDK 7.2 が必要です。HIP 6 では動作しません。</sys:String>
  <sys:String x:Key="Str.NotRadeon">Radeon ではないようです。ネットワークは RDNA2、RDNA3、RDNA4 でのみ動作します。</sys:String>
  <sys:String x:Key="Str.Ready">準備完了</sys:String>
  <sys:String x:Key="Str.Payloads">ファイル</sys:String>
  <sys:String x:Key="Str.Downloading">ダウンロード中</sys:String>
  <sys:String x:Key="Str.Verifying">既存のファイルを確認しています…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">ダウンロードと検証が完了しました。</sys:String>
  <sys:String x:Key="Str.ManifestLocal">公開中のダウンロードリストを読み込めなかったため、このアプリに同梱のコピーを使用しています。</sys:String>
  <sys:String x:Key="Str.ManifestFailed">ダウンロードリストを読み込めませんでした。接続を確認して、もう一度お試しください。</sys:String>
  <sys:String x:Key="Str.Language">言語</sys:String>
  <sys:String x:Key="Str.UpdateWorking">アップデートをダウンロードしています…</sys:String>
  <sys:String x:Key="Str.Dismiss">後で</sys:String>
  <sys:String x:Key="Str.LogSaved">完全なログをこのアプリの隣に保存しました。</sys:String>
  <sys:String x:Key="Str.Working">処理中…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">ゲームリストを読み込めませんでした。元のリストは隣に {0} として保存し、新しいリストを作成しました。</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">まだゲームフォルダーに書き込んでいます。数秒で終わるので、完了してからウィンドウを閉じてください。</sys:String>
  <sys:String x:Key="Str.FreeTitle">これは無料です。お金を払ったのなら、それは詐欺です。</sys:String>
  <sys:String x:Key="Str.FreeBody">インストーラーも、アドオンも、ランタイムも、重みも、どれも販売されていません。これに対して、あるいは「キー」や「プロ版」に対してお金を請求されたなら、返金を求めてください。売りつけられたものは、このページで無料で手に入ります。</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">オープンソースであり、これからもそうです。読んで、改造して、自分でビルドして、友達に渡してください。お願いしたいのはただ一つ、誰もこれを有料版にしないことです。</sys:String>
  <sys:String x:Key="Str.SupportSection">支援</sys:String>
  <sys:String x:Key="Str.SupportNote">任意です。何かが買えるわけではありません</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">一度きりのコーヒー代。</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">このプロジェクトのブラジルでの募金。</sys:String>
  <sys:String x:Key="Str.SupportRail">AMD-NR を支援</sys:String>
  <sys:String x:Key="Str.SupportTitle">AMD-NR を続けるために</sys:String>
  <sys:String x:Key="Str.SupportBody">このプロジェクトは、使ってくれる人たちの支援があってこそ続いています。二人の開発者、二枚のグラフィックカード、そして午後の作業時間だけ。会社もスポンサーもありません。ここにあるものはすべて無料で、これからも無料です。支援で何かが解放されることはなく、作業を続ける力になります。</sys:String>
  <sys:String x:Key="Str.SupportBrazil">ブラジルにお住まいですか？ Vakinha は Pix、カード、boleto に対応しています。</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD（作者：danielblnc）</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">ネットワークそのものであり、これらすべてが存在する理由です。DLSS 5 のニューラルレンダリングを初めて Radeon で動かしたのがこれです。このアプリがダウンロードするランタイムと重みは彼の成果で、私たちのものではありません。ありがとう、danielblnc。</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd（アドオン）</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">そのネットワークを ReShade 経由でゲームにつなぐもの。このアプリがインストールするアドオンと、選択できるリリース群です。MIT ライセンスで、このインストーラーとは別のリポジトリです。</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord（みんなが集まる場所）</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">新しいビルド、どのゲームで何が動くか、そして問題が起きたときの質問先です。</sys:String>
  <sys:String x:Key="Str.CreditsSection">クレジット</sys:String>
  <sys:String x:Key="Str.Scan">ゲームをスキャン</sys:String>
  <sys:String x:Key="Str.Scanning">Steam、Epic、GOG、EA、Ubisoft、Battle.net、Xbox を読み込んでいます…</sys:String>
  <sys:String x:Key="Str.Search">ゲームを検索…</sys:String>
  <sys:String x:Key="Str.Settings">設定</sys:String>
  <sys:String x:Key="Str.WillDownload">ファイルはインストール時にダウンロードされ、検証されます。</sys:String>
  <sys:String x:Key="Str.NoRoute">このゲームが描画に使うものには、どれも導入方法がありません。アドオンは D3D11、D3D12、Vulkan、OpenGL で動作し、32 ビットのゲームでは D3D8、D3D9、D3D11 で動作します。32 ビットの OpenGL ゲーム、64 ビットの D3D9 ゲーム、ソフトウェアレンダラーには導入方法がありません。</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">このゲームは {1} で動作できます。ゲーム自身のグラフィック設定で {0} にしてください。ここで選ばれている導入方法はそれで、別の API ではアドオンにとって別のゲームになります。</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Unreal のゲームです。起動オプションに -{0} を追加してください。</sys:String>
  <sys:String x:Key="Str.CheckWiki">このゲームを PCGamingWiki で調べる</sys:String>
  <sys:String x:Key="Str.EmptyTitle">まだゲームがありません</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">一致なし</sys:String>
  <sys:String x:Key="Str.NoMatch">「{0}」に一致するゲームはリストにありません。</sys:String>
  <sys:String x:Key="Str.ScanningShort">スキャン中…</sys:String>
  <sys:String x:Key="Str.ScanDone">スキャン完了：{0} 本のゲームが見つかり、そのうち {1} 本が新規です。</sys:String>
  <sys:String x:Key="Str.InstalledBadge">インストール済み</sys:String>
  <sys:String x:Key="Str.Close">閉じる</sys:String>
  <sys:String x:Key="Str.CloseHint">閉じる (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">ゲームの実行ファイル</sys:String>
  <sys:String x:Key="Str.ExeChoose">選択…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">検出されたものを使う</sys:String>
  <sys:String x:Key="Str.ExeNone">このフォルダーに実行ファイルが見つかりません。</sys:String>
  <sys:String x:Key="Str.ExeNote">導入方法はこのファイルから判断します。ビット数がおかしい場合（ルートにランチャー、ゲーム本体は Bin64 にある場合など）は、正しい .exe を指定してください。</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">このファイルはあなたが選んだので、再スキャンしても検出で変更されることはありません。</sys:String>
  <sys:String x:Key="Str.ExeNotHere">そのファイルはこのゲームのフォルダー内にありません。</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">そのファイルは読み取れる Windows の実行ファイルではありません。</sys:String>
  <sys:String x:Key="Str.RouteMismatch">この導入方法は {0} のゲーム向けですが、上の実行ファイルは {1} です。進めることはできます（検出が違うファイルを読んだのかもしれません）が、正しいファイルを読んでいたなら、これは読み込まれません。</sys:String>
  <sys:String x:Key="Str.VersionSection">アドオンのバージョン</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade の読み込み名</sys:String>
  <sys:String x:Key="Str.ProxyNote">「自動」は dxgi.dll を使います。これはすべての Direct3D に対応します。ゲームがこれを読み込まない場合にだけ変更してください。</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler の読み込み名</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">「自動」は、OptiScaler Wiki がこのゲームに示す最初のファイル名を使います。なければここで既に使われている名前、それもなければ dxgi.dll です。ほかのプログラムの dxgi.dll を残すには winmm.dll を選んでください。</sys:String>
  <sys:String x:Key="Str.ProxyAuto">自動</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">自動（Wiki：{0}）</sys:String>
  <sys:String x:Key="Str.PrefetchAll">今すぐすべてダウンロード</sys:String>
  <sys:String x:Key="Str.ClearCache">キャッシュを消去</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">ダウンロードしたファイル、カバー画像、バージョンリストを削除します。ゲームにインストール済みのものには触れません。次回のインストール時に必要なものを再ダウンロードします。</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">消去する</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">中身はすべて、次回インストールするときに再ダウンロードされます。</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">キャッシュはそのままにします。</sys:String>
  <sys:String x:Key="Str.CacheCleared">キャッシュを消去しました（{0} 解放）。</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">すべて揃っており、全バイトの検証も完了しました。</sys:String>
  <sys:String x:Key="Str.VersionShipped">同梱</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">このインストーラーの公開時に同梱されていたバージョンです。</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">GitHub の v{0} リリースから取得し、そのハッシュで検証済みです。</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler のバージョン</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}。GitHub のリリースから取得し、すべてのファイルをハッシュで検証済みです。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">lmxxf の重みを含みます（約 590 MB、RDNA4 のみ）。</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">mochizuki も導入できます。「NR ランタイム」を参照してください。</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR ランタイム</sys:String>
  <sys:String x:Key="Str.DanielVersion">danielblnc のバージョン</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">推奨</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">不安定</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">このゲームに入れる danielblnc ランタイムのバージョン。RX 9000 では 0.4.3 が推奨です。新しいものはこのカードでゲームをフリーズさせたことがあります。ほかのカードには最新版が入ります。</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: mochizuki（mochizuki0323 による Vulkan 移植、約 141 MB）も入り、ネットワークを実行します。danielblnc のランタイムも横に残り、アドオンのパネルの NR runtime で選べます。各ゲームの初回起動ではネットワークのコンパイルに最大 1 分かかります。</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: 新規インストールでは lmxxf が動き、mochizuki（約 141 MB）が danielblnc のランタイムの横に入ります。OptiScaler の Neural タブの NR runtime で別のものを選び、ゲームを再起動してください。</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">導入方法を選んでください</sys:String>
  <sys:String x:Key="Str.PickRouteBody">{0} がどのグラフィックス API で描画するのか判断できなかったため、このアプリは導入方法を自動では選びません。設定に DLSS、FSR、XeSS がある D3D12 のゲームには OptiScaler、それ以外には D3D11 または D3D12 の ReShade が適しています。選ぶまで「インストール」は待機します。</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">このアプリは {0} が使うグラフィックス API を判別できなかったため、方法を自動では選びません。OptiScaler は 64 ビットの D3D9、D3D11、D3D12、Vulkan、OpenGL のゲームで動き、ゲームに DLSS・FSR・XeSS があればその中で動作します。ReShade は 32 ビットのゲーム、エミュレーター、D3D10 にも対応します。選ぶまでインストールは待機します。</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">グラフィックス API が不明なため、下で導入方法を選んでください。</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc のランタイム</sys:String>
  <sys:String x:Key="Str.SupporterChoose">このゲームに入れるランタイムのビルドです。強調表示されたカードが使われます。</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release（{0}）</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">このアプリがダウンロードし、検証します。</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build（{0}）</sys:String>
  <sys:String x:Key="Str.SupporterPick">自分の version.dll またはセットアップを選択…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">別のファイルを選択…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Public Release より新しいビルドです。自分の version.dll、または danielblnc のセットアップから読み込みます。</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 では RDNA3 カード向けのカーネルが追加されています。</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 は RX 6000（RDNA2）カードに対応します（AMD の HIP SDK 7.2 ランタイムが必要）。暗い部分や小さな光のちらつきも修正されています。</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">このアプリがダウンロードしたり配布したりすることはありません。あなたのファイルは SHA-256 で検証して保存されるので、他のゲームで再度求められることはありません。</sys:String>
  <sys:String x:Key="Str.SupporterUse">自分のサポーター用ファイルを使う…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">あなたの version.dll または dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll、dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">任意の DLL またはセットアップ</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">使用中：このアプリがダウンロードするランタイム。</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">あなたのファイルの {0} を使用しています。</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">{0} を使用しています。以前選んだときにこのアプリが保存した、検証済みのコピーです。</sys:String>
  <sys:String x:Key="Str.SupporterMissing">{0} が選ばれていますが、この PC にはまだそのコピーがありません。version.dll またはセットアップを選んでください。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} にはアドオン v{1} 以降が必要です。「アドオンのバージョン」で選んでください。それまではダウンロード版が入ります。</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} には OptiScaler {1} 以降が必要です。「OptiScaler のバージョン」で選んでください。それまではダウンロード版が入ります。</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">アドオンはまだ {0} を実行できません。ダウンロードリストにそのパッチが含まれていないためです。含まれるまではここにダウンロード版が入ります。OptiScaler の導入方法ならそのまま実行できます。</sys:String>
  <sys:String x:Key="Str.SupporterKept">検証して保存しました：danielblnc のランタイム {0}。</sys:String>
  <sys:String x:Key="Str.SupporterRefused">そのファイルは使用できません。{0}</sys:String>
  <sys:String x:Key="Str.Checking">このフォルダーを確認しています…</sys:String>
  <sys:String x:Key="Str.StepDownload">ダウンロード</sys:String>
  <sys:String x:Key="Str.StepVerify">検証</sys:String>
  <sys:String x:Key="Str.StepInstall">インストール</sys:String>
  <sys:String x:Key="Str.StepDone">完了</sys:String>
  <sys:String x:Key="Str.Installing">インストール中…</sys:String>
  <sys:String x:Key="Str.Removing">削除中…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} の準備ができました。ゲームを起動して使ってください。</sys:String>
  <sys:String x:Key="Str.InstallWarn">{0} にインストールしました。下に確認すべき警告が {1} 件あります。</sys:String>
  <sys:String x:Key="Str.InstallFail">{0} へのインストールは完了しませんでした。</sys:String>
  <sys:String x:Key="Str.UninstallOk">{0} から削除しました。</sys:String>
  <sys:String x:Key="Str.UninstallWarn">{0} から削除しました。下に確認すべき警告が {1} 件あります。</sys:String>
  <sys:String x:Key="Str.UninstallFail">{0} からすべてを削除することはできませんでした。</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} はまだインストール済みの扱いです。このアプリのファイルを 1 つ削除できませんでした。ゲームを閉じて、もう一度アンインストールしてください。</sys:String>
  <sys:String x:Key="Str.UninstallClean">{0} から削除しました。フォルダー内にこのアプリのものは何も残っていません。</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">{0} から削除しました。残っているのはあなたの設定だけです：{1}。</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">設定も削除しますか？</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">このアプリが {0} にインストールしたものはすべて削除しました。次の設定ファイルは残っています。オーバーレイで設定した内容が保存されています：</sys:String>
  <sys:String x:Key="Str.SettingsRemove">これらも削除する</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">フォルダーはインストール前の状態に戻ります。</sys:String>
  <sys:String x:Key="Str.SettingsKeep">設定を残す</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">次回インストールするときのために残しておきます。</sys:String>
  <sys:String x:Key="Str.ResultErrors">下に問題が {0} 件あります。</sys:String>
