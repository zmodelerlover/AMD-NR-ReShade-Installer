<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Italian">

  <!-- Italiano. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Il rendering neurale di DLSS 5 su Radeon, installato per te</sys:String>
  <sys:String x:Key="Str.Games">Giochi</sys:String>
  <sys:String x:Key="Str.RemoveGame">Rimuovi dall'elenco</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Toglie il gioco dall'elenco, e anche «Cerca giochi» lo salterà. Nessun file nella sua cartella viene toccato; lo puoi ripristinare dalle Impostazioni.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} è fuori dall'elenco e «Cerca giochi» lo salterà. Nella sua cartella non è stato toccato nulla; lo puoi ripristinare da Impostazioni &gt; Giochi ignorati.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} è fuori dall'elenco, ma l'add-on è ancora installato nella sua cartella. Ripristinalo da Impostazioni &gt; Giochi ignorati per disinstallarlo.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Giochi ignorati</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">I giochi che hai tolto dall'elenco. «Cerca giochi» li salta, quindi restano fuori finché non li ripristini da qui.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Nessun gioco ignorato.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Rimetti nell'elenco</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} è di nuovo nell'elenco.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">La cartella di {0} non esiste più, quindi è stato tolto solo dai giochi ignorati.</sys:String>
  <sys:String x:Key="Str.NoGames">Qui non c'è ancora niente. Aggiungi la cartella da cui si avvia un gioco o un emulatore.</sys:String>
  <sys:String x:Key="Str.PickFolder">Scegli la cartella da cui si avvia il gioco</sys:String>
  <sys:String x:Key="Str.AddGameMany">Cerca in una cartella</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Scegli la cartella in cui tieni i tuoi giochi</sys:String>
  <sys:String x:Key="Str.AddGameNone">In «{0}» non è stato trovato niente che sembri un gioco.</sys:String>
  <sys:String x:Key="Str.Preset">Metodo</sys:String>
  <sys:String x:Key="Str.Install">Installa</sys:String>
  <sys:String x:Key="Str.Uninstall">Disinstalla</sys:String>
  <sys:String x:Key="Str.OpenFolder">Apri la cartella</sys:String>
  <sys:String x:Key="Str.System">Questo computer</sys:String>
  <sys:String x:Key="Str.Gpu">Scheda grafica</sys:String>
  <sys:String x:Key="Str.Driver">Driver</sys:String>
  <sys:String x:Key="Str.Hip">Runtime HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll non è stato trovato. È incluso in un driver Adrenalin recente; HIP 6 non basta.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Questa non sembra una Radeon. La rete funziona solo su RDNA3 e RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Pronto</sys:String>
  <sys:String x:Key="Str.Payloads">File</sys:String>
  <sys:String x:Key="Str.Downloading">Download in corso</sys:String>
  <sys:String x:Key="Str.Verifying">Verifica dei file già presenti…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Scaricati e verificati.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Non è stato possibile leggere l'elenco dei download pubblicato, quindi si usa la copia inclusa in questa app.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Impossibile leggere l'elenco dei download. Controlla la connessione e riprova.</sys:String>
  <sys:String x:Key="Str.Language">Lingua</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Download dell'aggiornamento…</sys:String>
  <sys:String x:Key="Str.Dismiss">Non ora</sys:String>
  <sys:String x:Key="Str.LogSaved">Il log completo è stato salvato accanto a questa app.</sys:String>
  <sys:String x:Key="Str.Working">Operazione in corso…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Non è stato possibile leggere l'elenco dei giochi. È stato conservato accanto con il nome {0}, e ne è stato iniziato uno nuovo.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Sto ancora scrivendo nella cartella di un gioco. Ci vogliono pochi secondi; chiudi la finestra quando ho finito.</sys:String>
  <sys:String x:Key="Str.FreeTitle">È gratis. Se l'hai pagato, sei stato truffato.</sys:String>
  <sys:String x:Key="Str.FreeBody">Nessuno vende niente di tutto questo: né l'installer, né l'add-on, né il runtime, né i pesi. Se ti hanno fatto pagare, anche per una «chiave» o una «versione pro», chiedi il rimborso: quello che ti hanno venduto è su questa pagina gratis.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">È open source e resterà tale: leggilo, modificalo, compila la tua versione, passalo ai tuoi amici. L'unica cosa che chiediamo è che nessuno lo trasformi in una versione a pagamento.</sys:String>
  <sys:String x:Key="Str.SupportSection">Sostieni il progetto</sys:String>
  <sys:String x:Key="Str.SupportNote">facoltativo, e non si ottiene niente in cambio</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Un caffè, una tantum.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">La raccolta fondi brasiliana del progetto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — di danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">La rete stessa, e il motivo per cui tutto questo esiste: è ciò che ha fatto funzionare il rendering neurale di DLSS 5 su Radeon. Il runtime e i pesi che questa app scarica sono opera sua, non nostra. Grazie, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — l'add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Ciò che collega quella rete a un gioco tramite ReShade: l'add-on che questa app installa, e le release tra cui ti lascia scegliere. Con licenza MIT, in un repository separato da questo installer.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — dove ci sono tutti</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Nuove build, cosa funziona in quale gioco, e dove chiedere quando qualcosa si rompe.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Riconoscimenti</sys:String>
  <sys:String x:Key="Str.Scan">Cerca giochi</sys:String>
  <sys:String x:Key="Str.Scanning">Lettura di Steam, Epic, GOG, EA, Ubisoft, Battle.net e Xbox…</sys:String>
  <sys:String x:Key="Str.Search">Cerca tra i giochi…</sys:String>
  <sys:String x:Key="Str.Settings">Impostazioni</sys:String>
  <sys:String x:Key="Str.WillDownload">I file vengono scaricati e verificati al momento dell'installazione.</sys:String>
  <sys:String x:Key="Str.NoRoute">Nessuna delle API con cui questo gioco esegue il rendering ha un metodo: l'add-on funziona su D3D11, D3D12, Vulkan e OpenGL, e su D3D8, D3D9 e D3D11 per i giochi a 32 bit. Un gioco OpenGL a 32 bit, un gioco D3D9 a 64 bit e un renderer software non ne hanno.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Questo gioco può funzionare con {1}. Impostalo su {0} nelle sue opzioni grafiche: è il metodo scelto qui, e con un'altra API l'add-on vede un gioco diverso.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Questo è un gioco Unreal: aggiungi -{0} alle sue opzioni di avvio.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Cerca questo gioco su PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Ancora nessun gioco</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Nessun risultato</sys:String>
  <sys:String x:Key="Str.NoMatch">Nessun gioco dell'elenco corrisponde a «{0}».</sys:String>
  <sys:String x:Key="Str.ScanningShort">Ricerca…</sys:String>
  <sys:String x:Key="Str.ScanDone">Ricerca completata. Giochi trovati: {0}, nuovi: {1}.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Installato</sys:String>
  <sys:String x:Key="Str.Close">Chiudi</sys:String>
  <sys:String x:Key="Str.CloseHint">Chiudi (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">L'eseguibile del gioco</sys:String>
  <sys:String x:Key="Str.ExeChoose">Scegli…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Usa quello rilevato</sys:String>
  <sys:String x:Key="Str.ExeNone">Nessun eseguibile trovato in questa cartella.</sys:String>
  <sys:String x:Key="Str.ExeNote">Il metodo si ricava da questo file. Se l'architettura sembra sbagliata (un launcher nella cartella principale, il gioco in Bin64), indica il .exe giusto.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Questo file l'hai scelto tu, quindi il rilevamento non lo cambia, nemmeno dopo una nuova ricerca.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Quel file non si trova nella cartella di questo gioco.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Quel file non è un eseguibile Windows leggibile.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Questo metodo è per i giochi {0} e l'eseguibile qui sopra è {1}. Niente te lo impedisce (il rilevamento potrebbe aver letto il file sbagliato), ma se ha letto quello giusto, non verrà caricato.</sys:String>
  <sys:String x:Key="Str.VersionSection">Versione dell'add-on</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade viene caricato come</sys:String>
  <sys:String x:Key="Str.ProxyNote">«Automatico» usa dxgi.dll, che funziona con ogni versione di Direct3D. Cambialo solo se il gioco si rifiuta di caricarlo.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler viene caricato come</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">«Automatico» usa il primo nome indicato dalla wiki di OptiScaler per questo gioco, altrimenti quello già in uso qui, altrimenti dxgi.dll. Scegli winmm.dll per non toccare il dxgi.dll di un altro programma.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatico</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatico (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Scarica tutto ora</sys:String>
  <sys:String x:Key="Str.ClearCache">Svuota la cache</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Elimina i file scaricati, le copertine e l'elenco delle versioni. Niente di ciò che è installato in un gioco viene toccato; la prossima installazione riscaricherà ciò che le serve.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Svuotala</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Tutto il suo contenuto verrà riscaricato alla prossima installazione.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Lascia la cache com'è.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Cache svuotata: liberati {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Era già tutto qui, e ogni byte è appena stato verificato.</sys:String>
  <sys:String x:Key="Str.VersionShipped">incluso</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">La versione con cui è stato pubblicato questo installer.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Dalla release v{0} su GitHub, verificata con i suoi hash.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Versione di OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, dalla sua release su GitHub, con ogni file verificato tramite il suo hash.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Include i pesi di lmxxf (circa 590 MB, solo RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Può installare anche mochizuki: vedi «Runtime NR».</sys:String>
  <sys:String x:Key="Str.MochizukiSection">Runtime NR</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">Installa anche mochizuki, come secondo runtime NR (sperimentale)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">La rete di DLSS 5 portata su Vulkan da mochizuki0323. Solo RDNA4: serie RX 9000, driver AMD 25.10 o successivo. Aggiunge MochizukiNrRuntime.dll e una cartella dlssnr-amd con il suo modello, circa 141 MB da scaricare. Il runtime NR resta quello di danielblnc: per usare mochizuki, selezionalo in «NR runtime» nella scheda Neural di OptiScaler e riavvia il gioco. Al primo avvio in ogni gioco la rete viene compilata per qualche secondo. Se lo deselezioni, la prossima installazione rimuove ciò che questa app ne aveva messo.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">Installa anche mochizuki, come secondo runtime NR (sperimentale)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">La rete di DLSS 5 portata su Vulkan da mochizuki0323, che l'add-on può eseguire al posto di quella di danielblnc a partire dalla v0.6.8. Solo RDNA4: serie RX 9000, driver AMD 25.10 o successivo. Aggiunge MochizukiNrRuntime.dll e una cartella dlssnr-amd con il suo modello, circa 141 MB da scaricare. Per usarlo, seleziona mochizuki (Vulkan) in «NR runtime» nel pannello dell'add-on e riavvia il gioco. Al primo avvio in ogni gioco la rete viene compilata, per un massimo di un minuto. Se lo deselezioni, la prossima installazione rimuove ciò che questa app ne aveva messo.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">Non disponibile su questa scheda ({0}): mochizuki richiede le istruzioni matriciali FP8 di RDNA4, cioè la serie RX 9000.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">Questa app non è riuscita a identificare la scheda; su qualsiasi scheda che non sia della serie RX 9000, mochizuki resta disattivato nel gioco.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Scegli con quale metodo installare</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Questa app non è riuscita a capire con quale API grafica {0} esegue il rendering, quindi non sceglie un metodo al posto tuo. OptiScaler è quello adatto a un gioco D3D12 che offre DLSS, FSR o XeSS nelle impostazioni; ReShade, su D3D11 o D3D12, è quello adatto a tutti gli altri. «Installa» aspetta finché non scegli.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">L'API grafica è sconosciuta, quindi il metodo lo scegli tu qui sotto.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">Il runtime di danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Quale build del runtime va in questo gioco. La scheda evidenziata è quella in uso.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Scaricata e verificata da questa app.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Scegli il mio version.dll o setup…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Scegli un altro file…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Più recente della Public Release, dal tuo version.dll o dal setup di danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">La 0.5.0 aggiunge kernel per le schede RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Mai scaricata né condivisa da questa app. Il tuo file viene verificato con SHA-256 e conservato, così gli altri giochi non te lo richiedono.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Usa i miei file da sostenitore…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Il tuo version.dll o dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Qualsiasi DLL o setup</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">In uso: il runtime che questa app scarica.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">In uso la {0} dal tuo file.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">In uso la {0}: la copia verificata che questa app ha conservato quando l'hai scelta in precedenza.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">È scelta la {0}, ma su questo computer non ce n'è ancora una copia: scegli il tuo version.dll o setup.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">La {0} richiede l'add-on v{1} o successivo: sceglilo in «Versione dell'add-on». Nel frattempo viene installata la versione scaricata.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">La {0} richiede OptiScaler {1} o successivo: sceglilo in «Versione di OptiScaler». Nel frattempo viene installata la versione scaricata.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">L'add-on non può ancora eseguire la {0}: l'elenco dei download non contiene la sua patch. Finché non la contiene, qui viene installata la versione scaricata; il metodo OptiScaler la esegue così com'è.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Verificato e conservato: runtime di danielblnc {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Quel file non si può usare. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Controllo di questa cartella…</sys:String>
