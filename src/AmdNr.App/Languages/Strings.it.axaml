  <sys:String x:Key="Str.StepVerify">Verifica</sys:String>
  <sys:String x:Key="Str.StepInstall">Installazione</sys:String>
  <sys:String x:Key="Str.StepDone">Fatto</sys:String>
  <sys:String x:Key="Str.Installing">Installazione…</sys:String>
  <sys:String x:Key="Str.Removing">Rimozione…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} è pronto. Avvia il gioco per usarlo.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Installato su {0}, con {1} avviso da leggere qui sotto.</sys:String>
  <sys:String x:Key="Str.InstallFail">L'installazione su {0} non è stata completata.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Rimosso da {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Rimosso da {0}, con {1} avviso da leggere qui sotto.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Non è stato possibile rimuovere tutto da {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} risulta ancora installato: non è stato possibile rimuovere un file di questa app. Chiudi il gioco e disinstalla di nuovo.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Rimosso da {0}: nella sua cartella non è rimasto nulla di questa app.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Rimosso da {0}: sono rimaste solo le tue impostazioni: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Rimuovere anche le tue impostazioni?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Tutto ciò che questa app aveva installato in {0} è stato rimosso. Sono rimasti questi file di impostazioni, che contengono ciò che era stato configurato nell'overlay:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Rimuovi anche questi</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">La cartella torna com'era prima dell'installazione.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Tieni le mie impostazioni</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Restano per la prossima volta che installi.</sys:String>
  <sys:String x:Key="Str.ResultErrors">{0} problema elencato qui sotto.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Non è stato possibile scaricare i file, quindi non è stato installato nulla.</sys:String>
  <sys:String x:Key="Str.Folder">Cartella</sys:String>
  <sys:String x:Key="Str.GameCount">Giochi: {0}</sys:String>
  <sys:String x:Key="Str.UnknownApi">API sconosciuta</sys:String>
  <sys:String x:Key="Str.Location">Posizione</sys:String>
  <sys:String x:Key="Str.Details">Dettagli</sys:String>
  <sys:String x:Key="Str.DetailsCount">Righe: {0}</sys:String>
  <sys:String x:Key="Str.PreflightOk">Pronto per l'installazione</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Nessun ostacolo. Scegli un metodo qui sotto e premi «Installa».</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Pronto per l'installazione, con {0} nota da leggere</sys:String>
  <sys:String x:Key="Str.PreflightErr">{0} problema trovato in questa cartella</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Installato in questo gioco</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Avvia il gioco per usarlo. Installa di nuovo per aggiornare i file, oppure disinstalla per rimuoverli.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Installato, ed è disponibile un aggiornamento</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">I file in questo gioco sono più vecchi di quelli che questa app installa ora. «Aggiorna» li sostituisce; le tue impostazioni restano.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Apri «Dettagli» qui sotto per vedere cosa è stato trovato.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Ciò di cui l'add-on ha bisogno da questo PC, controllato all'avvio dell'app.</sys:String>
  <sys:String x:Key="Str.SystemReady">Questo PC ha ciò che serve all'add-on</sys:String>
  <sys:String x:Key="Str.SystemNotReady">A questo PC manca qualcosa che serve all'add-on</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon rilevata</sys:String>
  <sys:String x:Key="Str.GpuBad">Non è una Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Mancante</sys:String>
  <sys:String x:Key="Str.DriverHint">La versione del driver grafico indicata da Windows.</sys:String>
  <sys:String x:Key="Str.FilesHint">Scaricati una volta, verificati con un hash fisso e riutilizzati per ogni gioco.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Verificato</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Non scaricato</sys:String>
