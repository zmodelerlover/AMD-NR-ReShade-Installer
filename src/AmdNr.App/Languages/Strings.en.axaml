  <sys:String x:Key="Str.EmptyTitle">No games yet</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">No matches</sys:String>
  <sys:String x:Key="Str.NoMatch">No game in the list matches "{0}".</sys:String>
