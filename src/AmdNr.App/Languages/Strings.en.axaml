<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.English">

  <!-- The fallback language. Every other Strings.*.axaml carries the same keys; one that is missing
       falls through to whatever this file says. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">DLSS 5 neural rendering on Radeon, installed for you</sys:String>

  <sys:String x:Key="Str.Games">Games</sys:String>
  <sys:String x:Key="Str.AddGame">Add a game…</sys:String>
  <sys:String x:Key="Str.RemoveGame">Remove from list</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Takes the row out of the list. No file in the game folder is touched.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} is off the list. Nothing in its folder was touched.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} is off the list, but the add-on is still installed in its folder. Add the folder back if you want to uninstall it.</sys:String>
  <sys:String x:Key="Str.NoGames">Nothing here yet. Add the folder a game or emulator runs from.</sys:String>
  <sys:String x:Key="Str.PickFolder">Pick the folder the game runs from</sys:String>
  <sys:String x:Key="Str.AddGameTitle">Add games</sys:String>
  <sys:String x:Key="Str.AddGameBody">Either one game, or everything in a folder you keep games in.</sys:String>
  <sys:String x:Key="Str.AddGameMany">Search a folder</sys:String>
  <sys:String x:Key="Str.AddGameManyBody">Point at the folder your games live in — a Games drive, a library copied off another machine — and every game under it is added at once. Only reads; nothing is installed or changed by looking.</sys:String>
  <sys:String x:Key="Str.AddGameOne">Add one game</sys:String>
  <sys:String x:Key="Str.AddGameOneBody">Point straight at the folder that one game runs from.</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Pick the folder your games are kept in</sys:String>
  <sys:String x:Key="Str.AddGameNone">Nothing that looks like a game was found under "{0}".</sys:String>

  <sys:String x:Key="Str.Preset">Route</sys:String>
  <sys:String x:Key="Str.Install">Install</sys:String>
  <sys:String x:Key="Str.Uninstall">Uninstall</sys:String>
  <sys:String x:Key="Str.Recheck">Check again</sys:String>
  <sys:String x:Key="Str.OpenFolder">Open folder</sys:String>

  <sys:String x:Key="Str.System">This machine</sys:String>
  <sys:String x:Key="Str.Gpu">Graphics</sys:String>
  <sys:String x:Key="Str.Driver">Driver</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 runtime</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll was not found. A current Adrenalin driver ships it; HIP 6 will not do.</sys:String>
  <sys:String x:Key="Str.NotRadeon">This does not look like a Radeon. The network runs on RDNA3 and RDNA4 only.</sys:String>
