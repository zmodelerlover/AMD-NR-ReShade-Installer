  <sys:String x:Key="Str.ManifestFailed">Could not read the download list. Check the connection and try again.</sys:String>

  <sys:String x:Key="Str.Language">Language</sys:String>
  <sys:String x:Key="Str.UpdateAvailable">A newer version is out</sys:String>
