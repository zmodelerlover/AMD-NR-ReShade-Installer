<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.English">

  <!-- The fallback language. Every other Strings.*.axaml carries the same keys; one that is missing
       falls through to whatever this file says. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">DLSS 5 neural rendering on Radeon, installed for you</sys:String>

  <sys:String x:Key="Str.Games">Games</sys:String>
  <sys:String x:Key="Str.RemoveGame">Remove from list</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Takes the game out of the list, and Scan games leaves it out too. No file in its folder is touched; Settings brings it back.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} is off the list and Scan games will leave it out. Nothing in its folder was touched; Settings > Ignored games brings it back.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} is off the list, but the add-on is still installed in its folder. Bring it back from Settings > Ignored games to uninstall it.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Ignored games</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Games you took out of the list. Scan games passes over them, so they stay out until you bring them back here.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">No ignored games.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Back to the list</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} is back in the list.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">The folder of {0} is gone, so it only left the ignored games.</sys:String>
  <sys:String x:Key="Str.NoGames">Nothing here yet. Add the folder a game or emulator runs from.</sys:String>
  <sys:String x:Key="Str.PickFolder">Pick the folder the game runs from</sys:String>
  <sys:String x:Key="Str.AddGameMany">Search a folder</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Pick the folder your games are kept in</sys:String>
  <sys:String x:Key="Str.AddGameNone">Nothing that looks like a game was found under "{0}".</sys:String>

  <sys:String x:Key="Str.Preset">Route</sys:String>
  <sys:String x:Key="Str.Install">Install</sys:String>
  <sys:String x:Key="Str.Uninstall">Uninstall</sys:String>
  <sys:String x:Key="Str.OpenFolder">Open folder</sys:String>

  <sys:String x:Key="Str.System">This machine</sys:String>
  <sys:String x:Key="Str.Gpu">Graphics</sys:String>
  <sys:String x:Key="Str.Driver">Driver</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 runtime</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll was not found. On RX 7000 and RX 9000 a current Adrenalin driver ships it; RX 6000 (RDNA2) cards need AMD's HIP SDK 7.2. HIP 6 will not do.</sys:String>
  <sys:String x:Key="Str.NotRadeon">This does not look like a Radeon. The network runs on RDNA2, RDNA3 and RDNA4 only.</sys:String>
