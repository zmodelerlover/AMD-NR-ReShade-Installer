  <sys:String x:Key="Str.SupporterMissing">{0} is chosen, but there is no copy of it on this machine yet: choose your version.dll or setup.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} needs add-on v{1} or newer: pick one under Add-on version. Until then the download goes in.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} needs OptiScaler {1} or newer: pick one under OptiScaler version. Until then the download goes in.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">The add-on cannot run {0} yet: the payload list does not carry its patch. Until it does the download goes in here; the OptiScaler route runs it as it is.</sys:String>
