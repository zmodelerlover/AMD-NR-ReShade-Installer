  <sys:String x:Key="Str.AutoUpdate">อัปเดตอัตโนมัติ</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">เมื่อมีบิลด์ใหม่ เกมนี้จะอัปเดตเองตอนเปิดแอป</sys:String>
  <sys:String x:Key="Str.AutoUpdated">อัปเดตอัตโนมัติ {0} เกม</sys:String>
