<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Thai">

  <!-- ไทย. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">การเรนเดอร์แบบนิวรัลของ DLSS 5 บน Radeon ติดตั้งให้คุณเสร็จสรรพ</sys:String>
  <sys:String x:Key="Str.Games">เกม</sys:String>
  <sys:String x:Key="Str.RemoveGame">นำออกจากรายการ</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">นำเกมออกจากรายการ และ «สแกนหาเกม» จะข้ามเกมนี้ด้วย ไม่มีไฟล์ใดในโฟลเดอร์ของเกมถูกแตะต้อง นำกลับมาได้จากการตั้งค่า</sys:String>
  <sys:String x:Key="Str.RemovedGame">นำ {0} ออกจากรายการแล้ว และ «สแกนหาเกม» จะข้ามเกมนี้ ไม่มีสิ่งใดในโฟลเดอร์ของเกมถูกแตะต้อง นำกลับมาได้จาก การตั้งค่า &gt; เกมที่ละเว้น</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">นำ {0} ออกจากรายการแล้ว แต่ add-on ยังติดตั้งอยู่ในโฟลเดอร์ของเกม นำเกมกลับมาจาก การตั้งค่า &gt; เกมที่ละเว้น เพื่อถอนการติดตั้ง</sys:String>
  <sys:String x:Key="Str.IgnoredGames">เกมที่ละเว้น</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">เกมที่คุณนำออกจากรายการ «สแกนหาเกม» จะข้ามเกมเหล่านี้ จึงไม่กลับเข้ารายการจนกว่าคุณจะนำกลับจากที่นี่</sys:String>
  <sys:String x:Key="Str.IgnoredNone">ไม่มีเกมที่ละเว้น</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">นำกลับเข้ารายการ</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} กลับเข้ารายการแล้ว</sys:String>
  <sys:String x:Key="Str.IgnoredGone">ไม่พบโฟลเดอร์ของ {0} แล้ว จึงนำออกจากเกมที่ละเว้นเท่านั้น</sys:String>
  <sys:String x:Key="Str.NoGames">ยังไม่มีอะไรที่นี่ เพิ่มโฟลเดอร์ที่เกมหรืออีมูเลเตอร์ใช้รัน</sys:String>
  <sys:String x:Key="Str.PickFolder">เลือกโฟลเดอร์ที่เกมใช้รัน</sys:String>
  <sys:String x:Key="Str.AddGameMany">ค้นหาในโฟลเดอร์</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">เลือกโฟลเดอร์ที่คุณเก็บเกมไว้</sys:String>
  <sys:String x:Key="Str.AddGameNone">ไม่พบสิ่งที่ดูเหมือนเกมใน «{0}»</sys:String>
  <sys:String x:Key="Str.Preset">วิธีติดตั้ง</sys:String>
  <sys:String x:Key="Str.Install">ติดตั้ง</sys:String>
  <sys:String x:Key="Str.Uninstall">ถอนการติดตั้ง</sys:String>
  <sys:String x:Key="Str.OpenFolder">เปิดโฟลเดอร์</sys:String>
  <sys:String x:Key="Str.System">เครื่องนี้</sys:String>
  <sys:String x:Key="Str.Gpu">กราฟิก</sys:String>
  <sys:String x:Key="Str.Driver">ไดรเวอร์</sys:String>
  <sys:String x:Key="Str.Hip">รันไทม์ HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">ไม่พบ amdhip64_7.dll สำหรับ RX 7000 และ RX 9000 ไฟล์นี้มากับไดรเวอร์ Adrenalin รุ่นใหม่ ส่วนการ์ด RX 6000 (RDNA2) ต้องใช้ HIP SDK 7.2 ของ AMD HIP 6 ใช้ไม่ได้</sys:String>
  <sys:String x:Key="Str.NotRadeon">การ์ดนี้ดูไม่ใช่ Radeon เครือข่ายนิวรัลทำงานบน RDNA2, RDNA3 และ RDNA4 เท่านั้น</sys:String>
  <sys:String x:Key="Str.Ready">พร้อม</sys:String>
  <sys:String x:Key="Str.Payloads">ไฟล์</sys:String>
  <sys:String x:Key="Str.Downloading">กำลังดาวน์โหลด</sys:String>
  <sys:String x:Key="Str.Verifying">กำลังตรวจสอบไฟล์ที่มีอยู่แล้ว…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">ดาวน์โหลดและตรวจสอบแล้ว</sys:String>
  <sys:String x:Key="Str.ManifestLocal">อ่านรายการดาวน์โหลดที่เผยแพร่ไม่ได้ จึงใช้สำเนาที่มากับแอปนี้แทน</sys:String>
  <sys:String x:Key="Str.ManifestFailed">อ่านรายการดาวน์โหลดไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง</sys:String>
  <sys:String x:Key="Str.Language">ภาษา</sys:String>
  <sys:String x:Key="Str.UpdateWorking">กำลังดาวน์โหลดอัปเดต…</sys:String>
  <sys:String x:Key="Str.Dismiss">ไว้ทีหลัง</sys:String>
  <sys:String x:Key="Str.LogSaved">บันทึก log ฉบับเต็มไว้ข้างแอปนี้แล้ว</sys:String>
  <sys:String x:Key="Str.Working">กำลังทำงาน…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">อ่านรายการเกมไม่ได้ จึงเก็บไว้ข้างกันในชื่อ {0} และเริ่มรายการใหม่</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">ยังเขียนไฟล์ลงโฟลเดอร์เกมอยู่ ใช้เวลาไม่กี่วินาที ปิดหน้าต่างเมื่อเสร็จแล้ว</sys:String>
  <sys:String x:Key="Str.FreeTitle">โปรแกรมนี้ฟรี ถ้าคุณจ่ายเงินซื้อมา แสดงว่าคุณถูกหลอก</sys:String>
  <sys:String x:Key="Str.FreeBody">ไม่มีใครขายสิ่งเหล่านี้ ทั้งตัวติดตั้ง add-on รันไทม์ และน้ำหนักของโมเดล ถ้ามีคนเก็บเงินคุณ ไม่ว่าจะเป็นค่า «คีย์» หรือ «เวอร์ชันโปร» ให้ขอเงินคืน สิ่งที่เขาขายให้คุณมีให้ฟรีอยู่ในหน้านี้</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">เป็นโอเพนซอร์สและจะเป็นแบบนี้ต่อไป อ่านได้ แก้ไขได้ คอมไพล์เองได้ แจกเพื่อนได้ สิ่งเดียวที่เราขอคือ อย่าให้ใครนำไปทำเป็นเวอร์ชันเสียเงิน</sys:String>
  <sys:String x:Key="Str.SupportSection">สนับสนุน</sys:String>
  <sys:String x:Key="Str.SupportNote">ไม่บังคับ และไม่ได้ซื้ออะไร</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">กาแฟหนึ่งแก้ว ครั้งเดียว</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">การระดมทุนของโปรเจกต์ในบราซิล</sys:String>
  <sys:String x:Key="Str.SupportRail">สนับสนุน AMD-NR</sys:String>
  <sys:String x:Key="Str.SupportTitle">ช่วยให้ AMD-NR ไปต่อได้</sys:String>
  <sys:String x:Key="Str.SupportBody">โปรเจกต์นี้อยู่ได้ด้วยการสนับสนุนจากผู้ใช้เท่านั้น เป็นคนสองคน การ์ดจอสองใบ และงานในช่วงบ่าย ไม่มีบริษัท ไม่มีสปอนเซอร์ ทุกอย่างที่นี่ฟรีและจะฟรีต่อไป การสนับสนุนไม่ได้ปลดล็อกอะไร แต่ช่วยให้งานเดินต่อได้</sys:String>
  <sys:String x:Key="Str.SupportBrazil">อยู่บราซิลใช่ไหม Vakinha รับ Pix บัตร หรือ boleto</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — โดย danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">ตัวเครือข่ายนิวรัลเอง และเหตุผลที่ทั้งหมดนี้มีอยู่ เขาคือผู้ทำให้การเรนเดอร์แบบนิวรัลของ DLSS 5 ทำงานบน Radeon ได้ รันไทม์และน้ำหนักที่แอปนี้ดาวน์โหลดเป็นผลงานของเขา ไม่ใช่ของเรา ขอบคุณ danielblnc</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">สิ่งที่เชื่อมเครือข่ายนั้นเข้ากับเกมผ่าน ReShade คือ add-on ที่แอปนี้ติดตั้ง และรุ่นที่ให้คุณเลือก ใช้สัญญาอนุญาต MIT และอยู่ใน repository แยกจากตัวติดตั้งนี้</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — ที่ที่ทุกคนอยู่</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">บิลด์ใหม่ อะไรใช้ได้กับเกมไหน และที่สำหรับถามเมื่อมีอะไรพัง</sys:String>
  <sys:String x:Key="Str.CreditsSection">ขอบคุณ</sys:String>
  <sys:String x:Key="Str.Scan">สแกนหาเกม</sys:String>
  <sys:String x:Key="Str.Scanning">กำลังอ่าน Steam, Epic, GOG, EA, Ubisoft, Battle.net และ Xbox…</sys:String>
  <sys:String x:Key="Str.Search">ค้นหาเกม…</sys:String>
  <sys:String x:Key="Str.Settings">การตั้งค่า</sys:String>
  <sys:String x:Key="Str.WillDownload">ไฟล์จะถูกดาวน์โหลดและตรวจสอบเมื่อคุณติดตั้ง</sys:String>
  <sys:String x:Key="Str.NoRoute">ไม่มีวิธีติดตั้งสำหรับ API ที่เกมนี้ใช้เรนเดอร์ add-on ทำงานบน D3D11, D3D12, Vulkan และ OpenGL และบน D3D8, D3D9 และ D3D11 สำหรับเกม 32 บิต เกม OpenGL 32 บิต เกม D3D9 64 บิต และตัวเรนเดอร์แบบซอฟต์แวร์ ไม่มีวิธีติดตั้ง</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">เกมนี้รันบน {1} ได้ ตั้งเป็น {0} ในการตั้งค่ากราฟิกของเกม นั่นคือวิธีที่เลือกไว้ที่นี่ และบน API อื่น add-on จะเห็นเป็นอีกเกมหนึ่ง</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">นี่คือเกม Unreal ให้เพิ่ม -{0} ในตัวเลือกการเปิดเกม</sys:String>
  <sys:String x:Key="Str.CheckWiki">ค้นหาเกมนี้ใน PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">ยังไม่มีเกม</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">ไม่พบผลลัพธ์</sys:String>
  <sys:String x:Key="Str.NoMatch">ไม่มีเกมในรายการที่ตรงกับ «{0}»</sys:String>
  <sys:String x:Key="Str.ScanningShort">กำลังสแกน…</sys:String>
  <sys:String x:Key="Str.ScanDone">สแกนเสร็จแล้ว พบเกม {0} เกม ใหม่ {1} เกม</sys:String>
  <sys:String x:Key="Str.InstalledBadge">ติดตั้งแล้ว</sys:String>
  <sys:String x:Key="Str.Close">ปิด</sys:String>
  <sys:String x:Key="Str.CloseHint">ปิด (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">ไฟล์ปฏิบัติการของเกม</sys:String>
  <sys:String x:Key="Str.ExeChoose">เลือก…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">ใช้ไฟล์ที่ตรวจพบ</sys:String>
  <sys:String x:Key="Str.ExeNone">ไม่พบไฟล์ปฏิบัติการในโฟลเดอร์นี้</sys:String>
  <sys:String x:Key="Str.ExeNote">วิธีติดตั้งอ่านจากไฟล์นี้ ถ้าจำนวนบิตดูผิด (ตัวเปิดเกมอยู่ที่โฟลเดอร์หลัก ส่วนตัวเกมอยู่ใน Bin64) ให้เลือกไฟล์ .exe ที่ถูกต้อง</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">คุณเลือกไฟล์นี้เอง การตรวจจับจึงไม่เปลี่ยนมัน แม้หลังจากสแกนใหม่</sys:String>
  <sys:String x:Key="Str.ExeNotHere">ไฟล์นั้นไม่ได้อยู่ในโฟลเดอร์ของเกมนี้</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">ไฟล์นั้นไม่ใช่ไฟล์ปฏิบัติการของ Windows ที่อ่านได้</sys:String>
  <sys:String x:Key="Str.RouteMismatch">วิธีนี้สำหรับเกม {0} แต่ไฟล์ปฏิบัติการด้านบนเป็น {1} ไม่มีอะไรห้ามคุณ (การตรวจจับอาจอ่านไฟล์ผิด) แต่ถ้าอ่านถูกไฟล์ สิ่งนี้จะไม่ถูกโหลด</sys:String>
  <sys:String x:Key="Str.VersionSection">เวอร์ชันของ add-on</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade โหลดในชื่อ</sys:String>
  <sys:String x:Key="Str.ProxyNote">«อัตโนมัติ» ใช้ dxgi.dll ซึ่งรองรับ Direct3D ทุกรุ่น เปลี่ยนเฉพาะเมื่อเกมไม่ยอมโหลดเท่านั้น</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler โหลดในชื่อ</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">«อัตโนมัติ» ใช้ชื่อแรกที่วิกิของ OptiScaler ระบุสำหรับเกมนี้ ถ้าไม่มี ใช้ชื่อที่ใช้อยู่แล้วที่นี่ ถ้าไม่มีทั้งสองอย่าง ใช้ dxgi.dll เลือก winmm.dll เพื่อเก็บ dxgi.dll ของโปรแกรมอื่นไว้</sys:String>
  <sys:String x:Key="Str.ProxyAuto">อัตโนมัติ</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">อัตโนมัติ (วิกิ: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">ดาวน์โหลดทั้งหมดตอนนี้</sys:String>
  <sys:String x:Key="Str.ClearCache">ล้างแคช</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">ลบไฟล์ที่ดาวน์โหลดไว้ ภาพปก และรายการเวอร์ชัน ไม่มีสิ่งใดที่ติดตั้งในเกมถูกแตะต้อง การติดตั้งครั้งถัดไปจะดาวน์โหลดสิ่งที่ต้องใช้อีกครั้ง</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">ล้างเลย</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">ทุกอย่างในนั้นจะถูกดาวน์โหลดใหม่ในการติดตั้งครั้งถัดไป</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">เก็บแคชไว้ตามเดิม</sys:String>
  <sys:String x:Key="Str.CacheCleared">ล้างแคชแล้ว ได้พื้นที่คืน {0}</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">ทุกอย่างมีอยู่แล้ว และตรวจสอบครบทุกไบต์เมื่อสักครู่</sys:String>
  <sys:String x:Key="Str.VersionShipped">มาพร้อมแอป</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">เวอร์ชันที่เผยแพร่มาพร้อมตัวติดตั้งนี้</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">จากรุ่น v{0} บน GitHub ตรวจสอบกับค่าแฮชของรุ่นนั้นแล้ว</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">เวอร์ชันของ OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} จากรุ่นบน GitHub ทุกไฟล์ตรวจสอบกับค่าแฮชของตัวเองแล้ว</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">รวมน้ำหนักของ lmxxf (ประมาณ 590 MB เฉพาะ RDNA4)</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">ติดตั้ง mochizuki ด้วยได้ ดูที่ «รันไทม์ NR»</sys:String>
  <sys:String x:Key="Str.MochizukiSection">รันไทม์ NR</sys:String>
  <sys:String x:Key="Str.DanielVersion">เวอร์ชันของ danielblnc</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">แนะนำ</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">ไม่เสถียร</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">เวอร์ชันของรันไทม์ danielblnc ที่จะติดตั้งในเกมนี้ บนการ์ด RX 9000 แนะนำ 0.4.3 เวอร์ชันที่ใหม่กว่าเคยทำให้เกมค้างบนการ์ดเหล่านี้ การ์ดอื่นจะได้เวอร์ชันล่าสุด</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: ติดตั้ง mochizuki (พอร์ต Vulkan ของ mochizuki0323 ประมาณ 141 MB) ด้วยและใช้รันเครือข่าย รันไทม์ของ danielblnc ยังอยู่ข้างกัน เลือกได้ที่ NR runtime ในแผงของแอดออน การเปิดเกมแต่ละเกมครั้งแรกจะคอมไพล์เครือข่ายนานสุดหนึ่งนาที</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: การติดตั้งใหม่ใช้ lmxxf และติดตั้ง mochizuki (ประมาณ 141 MB) ข้างรันไทม์ของ danielblnc เลือกตัวอื่นได้ที่ NR runtime ในแท็บ Neural ของ OptiScaler แล้วเริ่มเกมใหม่</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">เลือกวิธีติดตั้ง</sys:String>
  <sys:String x:Key="Str.PickRouteBody">แอปนี้บอกไม่ได้ว่า {0} ใช้ API กราฟิกใดเรนเดอร์ จึงไม่เลือกวิธีติดตั้งให้ OptiScaler เหมาะกับเกม D3D12 ที่มี DLSS, FSR หรือ XeSS ในการตั้งค่า ส่วน ReShade บน D3D11 หรือ D3D12 เหมาะกับเกมอื่นทั้งหมด ปุ่ม «ติดตั้ง» จะรอจนกว่าคุณจะเลือก</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">แอปนี้ไม่สามารถบอกได้ว่า {0} ใช้ API กราฟิกใด จึงไม่เลือกเส้นทางให้คุณ OptiScaler ทำงานกับเกม 64 บิตที่ใช้ D3D9, D3D11, D3D12, Vulkan และ OpenGL โดยทำงานภายใน DLSS, FSR หรือ XeSS ของเกมเมื่อมี ส่วน ReShade ครอบคลุมเกม 32 บิต อีมูเลเตอร์ และ D3D10 ด้วย การติดตั้งจะรอจนกว่าคุณจะเลือก</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">ไม่ทราบ API กราฟิก คุณจึงต้องเลือกวิธีติดตั้งด้านล่างเอง</sys:String>
  <sys:String x:Key="Str.SupporterTitle">รันไทม์ของ danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">รันไทม์บิลด์ไหนจะถูกใส่ในเกมนี้ การ์ดที่ไฮไลต์คือตัวที่ใช้</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">ดาวน์โหลดและตรวจสอบโดยแอปนี้</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">เลือก version.dll หรือตัวติดตั้งของฉัน…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">เลือกไฟล์อื่น…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">ใหม่กว่า Public Release จาก version.dll ของคุณเอง หรือจากตัวติดตั้งของ danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 เพิ่มเคอร์เนลสำหรับการ์ด RDNA3</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 เพิ่มการรองรับการ์ด RX 6000 (RDNA2) ซึ่งต้องใช้รันไทม์ HIP SDK 7.2 ของ AMD และแก้ภาพกะพริบ ในบริเวณมืดและที่แสงดวงเล็ก</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">แอปนี้ไม่ดาวน์โหลดหรือแจกจ่ายไฟล์นี้เด็ดขาด ไฟล์ของคุณถูกตรวจด้วย SHA-256 แล้วเก็บไว้ เกมอื่นจึงไม่ต้องถามอีก</sys:String>
  <sys:String x:Key="Str.SupporterUse">ใช้ไฟล์ผู้สนับสนุนของฉัน…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">version.dll หรือ dlssnr_on_amd_setup.exe ของคุณ</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">DLL หรือตัวติดตั้งใดก็ได้</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">ใช้อยู่: รันไทม์ที่แอปนี้ดาวน์โหลด</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">ใช้ {0} จากไฟล์ของคุณ</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">ใช้ {0} สำเนาที่ตรวจสอบแล้วซึ่งแอปนี้เก็บไว้ตอนที่คุณเลือกครั้งก่อน</sys:String>
  <sys:String x:Key="Str.SupporterMissing">เลือก {0} ไว้ แต่เครื่องนี้ยังไม่มีสำเนา ให้เลือก version.dll หรือตัวติดตั้งของคุณ</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} ต้องใช้ add-on v{1} ขึ้นไป เลือกได้ที่ «เวอร์ชันของ add-on» ระหว่างนี้จะติดตั้งตัวที่ดาวน์โหลดแทน</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} ต้องใช้ OptiScaler {1} ขึ้นไป เลือกได้ที่ «เวอร์ชันของ OptiScaler» ระหว่างนี้จะติดตั้งตัวที่ดาวน์โหลดแทน</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">add-on ยังรัน {0} ไม่ได้ เพราะรายการดาวน์โหลดยังไม่มีแพตช์ของมัน ระหว่างนี้จะติดตั้งตัวที่ดาวน์โหลดแทน ส่วนวิธี OptiScaler รันได้ตามเดิม</sys:String>
  <sys:String x:Key="Str.SupporterKept">ตรวจสอบและเก็บแล้ว: รันไทม์ของ danielblnc {0}</sys:String>
  <sys:String x:Key="Str.SupporterRefused">ใช้ไฟล์นั้นไม่ได้ {0}</sys:String>
