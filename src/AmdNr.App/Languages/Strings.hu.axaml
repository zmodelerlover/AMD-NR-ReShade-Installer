<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Hungarian">

  <!-- Magyar. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">DLSS 5 neurális renderelés Radeonon, telepítve helyetted</sys:String>
  <sys:String x:Key="Str.Games">Játékok</sys:String>
  <sys:String x:Key="Str.RemoveGame">Eltávolítás a listáról</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Kiveszi a játékot a listából, és a „Játékok keresése” is kihagyja. A mappájában egy fájlhoz sem nyúl; a Beállításokban visszahozhatod.</sys:String>
  <sys:String x:Key="Str.RemovedGame">Lekerült a listáról, és a „Játékok keresése” kihagyja: {0}. A mappájában semmi sem változott; a „Beállítások” &gt; „Figyelmen kívül hagyott játékok” alatt visszahozhatod.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">Lekerült a listáról: {0}, de a kiegészítő még telepítve van a mappájában. Hozd vissza a „Beállítások” &gt; „Figyelmen kívül hagyott játékok” alól, hogy eltávolíthasd.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Figyelmen kívül hagyott játékok</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">A játékok, amelyeket kivettél a listából. A „Játékok keresése” átugorja őket, így kimaradnak, amíg innen vissza nem hozod őket.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Nincs figyelmen kívül hagyott játék.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Vissza a listára</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">Újra a listán: {0}.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Ennek a játéknak a mappája már nem létezik: {0}, ezért csak a figyelmen kívül hagyott játékok közül került ki.</sys:String>
  <sys:String x:Key="Str.NoGames">Itt még nincs semmi. Add hozzá a mappát, ahonnan egy játék vagy emulátor fut.</sys:String>
  <sys:String x:Key="Str.PickFolder">Válaszd ki a mappát, ahonnan a játék fut</sys:String>
  <sys:String x:Key="Str.AddGameMany">Mappa átkutatása</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Válaszd ki a mappát, ahol a játékaidat tartod</sys:String>
  <sys:String x:Key="Str.AddGameNone">Nem található játéknak tűnő elem itt: „{0}”.</sys:String>
  <sys:String x:Key="Str.Preset">Útvonal</sys:String>
  <sys:String x:Key="Str.Install">Telepítés</sys:String>
  <sys:String x:Key="Str.Uninstall">Eltávolítás</sys:String>
  <sys:String x:Key="Str.OpenFolder">Mappa megnyitása</sys:String>
  <sys:String x:Key="Str.System">Ez a gép</sys:String>
  <sys:String x:Key="Str.Gpu">Videokártya</sys:String>
  <sys:String x:Key="Str.Driver">Illesztőprogram</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 futtatókörnyezet</sys:String>
  <sys:String x:Key="Str.HipMissing">Az amdhip64_7.dll nem található. RX 7000 és RX 9000 esetén egy friss Adrenalin illesztőprogram tartalmazza; az RX 6000 (RDNA2) kártyákhoz az AMD HIP SDK 7.2 kell. A HIP 6 nem elég.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Ez nem tűnik Radeonnak. A hálózat csak RDNA2-n, RDNA3-on és RDNA4-en fut.</sys:String>
  <sys:String x:Key="Str.Ready">Kész</sys:String>
  <sys:String x:Key="Str.Payloads">Fájlok</sys:String>
  <sys:String x:Key="Str.Downloading">Letöltés</sys:String>
  <sys:String x:Key="Str.Verifying">A meglévők ellenőrzése…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Letöltve és ellenőrizve.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">A közzétett letöltési lista nem olvasható, ezért az alkalmazással együtt szállított példány van használatban.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">A letöltési lista nem olvasható. Ellenőrizd a kapcsolatot, és próbáld újra.</sys:String>
  <sys:String x:Key="Str.Language">Nyelv</sys:String>
  <sys:String x:Key="Str.UpdateWorking">A frissítés letöltése…</sys:String>
  <sys:String x:Key="Str.Dismiss">Most nem</sys:String>
  <sys:String x:Key="Str.LogSaved">A teljes napló az alkalmazás mellé került.</sys:String>
  <sys:String x:Key="Str.Working">Folyamatban…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">A játéklista nem olvasható. Mellette megmaradt ezen a néven: {0}, és új lista indult.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Még írás folyik egy játék mappájába. Néhány másodperc; zárd be az ablakot, ha végzett.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Ez ingyenes. Ha fizettél érte, átvertek.</sys:String>
  <sys:String x:Key="Str.FreeBody">Ebből senki nem árul semmit — sem a telepítőt, sem a kiegészítőt, sem a futtatókörnyezetet, sem a súlyokat. Ha pénzt kértek tőled érte, egy „kulcsért” vagy egy „pro verzióért”, kérd vissza a pénzed: amit eladtak neked, az ezen az oldalon ingyen megvan.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Nyílt forráskódú, és az is marad: olvasd, módosítsd, építsd meg a saját változatodat, add oda a barátaidnak. Egyet kérünk: senki ne csináljon belőle fizetős változatot.</sys:String>
  <sys:String x:Key="Str.SupportSection">Támogatás</sys:String>
  <sys:String x:Key="Str.SupportNote">önkéntes, és semmit nem old fel</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Egy egyszeri kávé.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">A projekt brazil gyűjtése.</sys:String>
  <sys:String x:Key="Str.SupportRail">AMD-NR támogatása</sys:String>
  <sys:String x:Key="Str.SupportTitle">Tartsd életben az AMD-NR-t</sys:String>
  <sys:String x:Key="Str.SupportBody">Ez a projekt csak a használói támogatásából él. Két ember, két videokártya és délutánnyi munka: se cég, se szponzor. Itt minden ingyenes, és az is marad. A támogatás semmit sem old fel; a munkát viszi tovább.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">Brazíliában vagy? A Vakinha Pixet, kártyát vagy boletót fogad.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — danielblnc munkája</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Maga a hálózat, és az oka annak, hogy mindez létezik: ennek köszönhetően indult el egyáltalán a DLSS 5 neurális renderelése Radeonon. A futtatókörnyezet és a súlyok, amelyeket ez az alkalmazás letölt, az ő munkája, nem a miénk. Köszönjük, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — a kiegészítő</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Ami a hálózatot a ReShade-en keresztül a játékba köti: a kiegészítő, amelyet ez telepít, és a kiadások, amelyek közül választhatsz. MIT licenc, a telepítőtől külön tárolóban.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — itt van mindenki</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Új buildek, mi melyik játékban működik, és hol kérdezz, ha valami elromlik.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Köszönet</sys:String>
  <sys:String x:Key="Str.Scan">Játékok keresése</sys:String>
  <sys:String x:Key="Str.Scanning">Steam, Epic, GOG, EA, Ubisoft, Battle.net és Xbox beolvasása…</sys:String>
  <sys:String x:Key="Str.Search">Játékok keresése…</sys:String>
  <sys:String x:Key="Str.Settings">Beállítások</sys:String>
  <sys:String x:Key="Str.WillDownload">A fájlok telepítéskor töltődnek le és ellenőrződnek.</sys:String>
  <sys:String x:Key="Str.NoRoute">Semmihez, amivel ez a játék renderel, nincs útvonal: a kiegészítő D3D11-en, D3D12-n, Vulkanon és OpenGL-en működik, 32 bites játékoknál pedig D3D8-on, D3D9-en és D3D11-en. Egy 32 bites OpenGL-es, egy 64 bites D3D9-es játéknak és egy szoftveres renderelőnek nincs.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Ez a játék futhat ezen is: {1}. Állítsd be a saját grafikai beállításaiban ezt: {0} — ez az itt kiválasztott útvonal, más API-n a kiegészítő egy másik játékot lát.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Ez egy Unreal játék: add hozzá az indítási beállításaihoz: -{0}</sys:String>
  <sys:String x:Key="Str.CheckWiki">Nézd meg ezt a játékot a PCGamingWikin</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Még nincsenek játékok</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Nincs találat</sys:String>
  <sys:String x:Key="Str.NoMatch">A listában egy játék sem felel meg ennek: „{0}”.</sys:String>
  <sys:String x:Key="Str.ScanningShort">Keresés…</sys:String>
  <sys:String x:Key="Str.ScanDone">A keresés kész: {0} játék található, ebből {1} új.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Telepítve</sys:String>
  <sys:String x:Key="Str.Close">Bezárás</sys:String>
  <sys:String x:Key="Str.CloseHint">Bezárás (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">A játék futtatható fájlja</sys:String>
  <sys:String x:Key="Str.ExeChoose">Kiválasztás…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Az észlelt használata</sys:String>
  <sys:String x:Key="Str.ExeNone">Ebben a mappában nincs futtatható fájl.</sys:String>
  <sys:String x:Key="Str.ExeNote">Az útvonal ebből a fájlból derül ki. Ha a bitszám rossznak tűnik (egy indító a gyökérben, a játék a Bin64-ben), mutass a helyes .exe-re.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Ezt a fájlt te választottad, így az észlelés nem változtat rajta, újrakeresés után sem.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Ez a fájl nincs a játék mappájában.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Ez nem olyan Windows futtatható fájl, amit be lehet olvasni.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Ez az útvonal ilyen játékokhoz való: {0}, a fenti futtatható fájl viszont ez: {1}. Semmi nem állít meg — lehet, hogy az észlelés rossz fájlt olvasott —, de ha a jót olvasta, ez nem fog betöltődni.</sys:String>
  <sys:String x:Key="Str.VersionSection">Kiegészítő verziója</sys:String>
  <sys:String x:Key="Str.ProxySection">A ReShade betöltési neve</sys:String>
  <sys:String x:Key="Str.ProxyNote">Az automatikus a dxgi.dll-t használja, amely minden Direct3D-t kiszolgál. Csak akkor változtasd, ha a játék nem hajlandó betölteni.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">Az OptiScaler betöltési neve</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">Az automatikus azt a nevet használja, amelyet az OptiScaler wiki elsőként ad meg ehhez a játékhoz, ha nincs ilyen, az itt már használtat, különben a dxgi.dll-t. Válaszd a winmm.dll-t, ha meg akarod tartani egy másik program dxgi.dll-jét.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatikus</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatikus (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Minden letöltése most</sys:String>
  <sys:String x:Key="Str.ClearCache">Gyorsítótár ürítése</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Törli a letöltött fájlokat, a borítókat és a verziólistát. A játékokba telepített dolgokhoz nem nyúl; a következő telepítés újra letölti, amire szüksége van.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Ürítés</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Minden, ami benne van, a következő telepítéskor újra letöltődik.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">A gyorsítótár marad, ahogy van.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Gyorsítótár kiürítve — felszabadult: {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Már minden megvolt, és minden bájt átment az ellenőrzésen.</sys:String>
  <sys:String x:Key="Str.VersionShipped">mellékelt</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">A verzió, amellyel ez a telepítő megjelent.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">A GitHubon lévő v{0} kiadásból, a hash-ei alapján ellenőrizve.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler verziója</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} a GitHub-kiadásából, minden fájl a hash-e alapján ellenőrizve.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Tartalmazza az lmxxf súlyokat (kb. 590 MB, csak RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">A mochizukit is hozhatja: lásd „NR futtatókörnyezet”.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR futtatókörnyezet</sys:String>
  <sys:String x:Key="Str.DanielVersion">danielblnc verzió</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">Ajánlott</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">Instabil</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">A danielblnc runtime melyik verziója kerül ebbe a játékba. RX 9000 kártyákon a 0.4.3 az ajánlott: az újabbak lefagyasztottak rajtuk játékokat. A többi kártya a legújabbat kapja.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: a mochizuki (mochizuki0323 Vulkan-portja, kb. 141 MB) is települ, és ez futtatja a hálózatot. danielblnc runtime-ja mellette marad: a kiegészítő paneljén az NR runtime alatt választható. Minden játék első indítása legfeljebb egy percig fordítja a hálózatot.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: egy új telepítés az lmxxf-et futtatja, a mochizuki (kb. 141 MB) pedig danielblnc runtime-ja mellé kerül. Másikat az OptiScaler Neural lapján, az NR runtime alatt választhatsz, utána indítsd újra a játékot.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Válassz telepítési útvonalat</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Az alkalmazás nem tudta megállapítani, milyen grafikus API-val renderel ez a játék: {0}, ezért nem választ helyetted útvonalat. Az OptiScaler az olyan D3D12-es játékhoz való, amelynek beállításaiban van DLSS, FSR vagy XeSS; a ReShade, D3D11-en vagy D3D12-n, minden máshoz. A telepítés vár, amíg választasz.</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">Az alkalmazás nem tudta megállapítani, milyen grafikus API-val fut a(z) {0}, ezért nem választ helyetted utat. Az OptiScaler 64 bites D3D9, D3D11, D3D12, Vulkan és OpenGL játékokon fut, a játék DLSS, FSR vagy XeSS felskálázójában, ha van ilyen; a ReShade a 32 bites játékokat, az emulátorokat és a D3D10-et is lefedi. A telepítés megvárja, amíg választasz.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">A grafikus API ismeretlen, így az útvonalat lent te választod ki.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc futtatókörnyezete</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Melyik futtatókörnyezet-build kerül ebbe a játékba. A kiemelt kártya van használatban.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Nyilvános kiadás ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Az alkalmazás letöltötte és ellenőrizte.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Helyi támogatói build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">A saját version.dll vagy telepítő kiválasztása…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Másik fájl kiválasztása…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Újabb a nyilvános kiadásnál, a saját version.dll-edből vagy danielblnc telepítőjéből.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">A 0.5.0 kerneleket ad az RDNA3 kártyákhoz.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">A 0.6.0 támogatja az RX 6000 (RDNA2) kártyákat, amelyekhez az AMD HIP SDK 7.2 futtatókörnyezete kell, és megszünteti a villódzást a sötét részeken és a kis fényeken.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Ez az alkalmazás soha nem tölti le és nem osztja meg. A fájlodat SHA-256 alapján ellenőrzi és megőrzi, így a többi játék nem kérdezi újra.</sys:String>
  <sys:String x:Key="Str.SupporterUse">A támogatói fájljaim használata…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Nyilvános kiadás</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">A version.dll-ed vagy a dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Bármilyen DLL vagy telepítő</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">Használatban: az alkalmazás által letöltött futtatókörnyezet.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Használatban a fájlodból: {0}.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Használatban: {0}, az ellenőrzött példány, amelyet az alkalmazás megőrzött, amikor korábban kiválasztottad.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">Ki van választva: {0}, de ezen a gépen még nincs belőle példány: válaszd ki a version.dll-edet vagy a telepítőt.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} használatához v{1} vagy újabb kiegészítő kell: válassz egyet a „Kiegészítő verziója” alatt. Addig a letöltött változat kerül fel.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} használatához OptiScaler {1} vagy újabb kell: válassz egyet az „OptiScaler verziója” alatt. Addig a letöltött változat kerül fel.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">A kiegészítő még nem tudja futtatni ezt: {0}, mert a fájllista nem tartalmazza a javítását. Addig itt a letöltött változat kerül fel; az OptiScaler útvonal úgy futtatja, ahogy van.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Ellenőrizve és megőrizve: danielblnc futtatókörnyezete, {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Ez a fájl nem használható. {0}</sys:String>
  <sys:String x:Key="Str.Checking">A mappa ellenőrzése…</sys:String>
  <sys:String x:Key="Str.StepDownload">Letöltés</sys:String>
  <sys:String x:Key="Str.StepVerify">Ellenőrzés</sys:String>
  <sys:String x:Key="Str.StepInstall">Telepítés</sys:String>
  <sys:String x:Key="Str.StepDone">Kész</sys:String>
  <sys:String x:Key="Str.Installing">Telepítés…</sys:String>
  <sys:String x:Key="Str.Removing">Eltávolítás…</sys:String>
  <sys:String x:Key="Str.InstallOk">Beállítva: {0}. Indítsd el a játékot a használatához.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Telepítve ide: {0}, {1} figyelmeztetéssel, lásd lent.</sys:String>
  <sys:String x:Key="Str.InstallFail">A telepítés nem fejeződött be ide: {0}.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Eltávolítva innen: {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Eltávolítva innen: {0}, {1} figyelmeztetéssel, lásd lent.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Nem sikerült mindent eltávolítani innen: {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">Még telepítettnek számít: {0}, mert az alkalmazás egyik fájlját nem sikerült eltávolítani. Zárd be a játékot, és távolítsd el újra.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Eltávolítva innen: {0} — a mappájában semmi sem maradt ebből az alkalmazásból.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Eltávolítva innen: {0} — csak a beállításaid maradtak: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">A beállításaidat is eltávolítod?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Minden, amit ez az alkalmazás ide telepített: {0}, eltávolítva. Ezek a beállításfájlok maradtak — ezek őrzik, amit az overlayben beállítottál:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Ezeket is eltávolítom</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">A mappa visszaáll a telepítés előtti állapotra.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Megtartom a beállításaimat</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Megmaradnak a következő telepítéshez.</sys:String>
  <sys:String x:Key="Str.ResultErrors">{0} probléma, lásd lent.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">A fájlokat nem sikerült letölteni, ezért semmi sem települt.</sys:String>
  <sys:String x:Key="Str.Folder">Mappa</sys:String>
  <sys:String x:Key="Str.GameCount">{0} játék</sys:String>
  <sys:String x:Key="Str.UnknownApi">Ismeretlen API</sys:String>
  <sys:String x:Key="Str.Location">Hely</sys:String>
  <sys:String x:Key="Str.Details">Részletek</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} sor</sys:String>
  <sys:String x:Key="Str.PreflightOk">Telepítésre kész</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Semmi sincs útban. Válassz útvonalat lent, és nyomd meg a „Telepítés” gombot.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Telepítésre kész, {0} megjegyzéssel</sys:String>
  <sys:String x:Key="Str.PreflightErr">{0} probléma található ebben a mappában</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Telepítve ebben a játékban</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Indítsd el a játékot a használatához. Telepítsd újra a fájlok frissítéséhez, vagy távolítsd el őket.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Telepítve, és frissítés érhető el</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">A játékban lévő fájlok régebbiek annál, amit ez az alkalmazás most telepít. A „Frissítés” lecseréli őket; a beállításaid maradnak.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Nyisd meg lent a „Részletek” részt, hogy lásd, mit talált.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Amire a kiegészítőnek szüksége van ettől a géptől, az alkalmazás indításakor ellenőrizve.</sys:String>
  <sys:String x:Key="Str.SystemReady">Ezen a gépen megvan minden, ami a kiegészítőnek kell</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Ebből a gépből hiányzik valami, ami a kiegészítőnek kell</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon észlelve</sys:String>
  <sys:String x:Key="Str.GpuBad">Nem Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Hiányzik</sys:String>
  <sys:String x:Key="Str.DriverHint">A grafikus illesztőprogram verziója, ahogy a Windows jelzi.</sys:String>
  <sys:String x:Key="Str.FilesHint">Egyszer töltődik le, rögzített hash alapján ellenőrződik, és minden játékhoz újrahasznosul.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Ellenőrizve</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Nincs letöltve</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Letöltés…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Letöltés: {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Nyelv, frissítések és az alkalmazás névjegye.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Minden felirat azonnal átvált; nem kell újraindítani.</sys:String>
  <sys:String x:Key="Str.DataFolder">Adatmappa</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D10/D3D11-es játék</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12-es játék</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkanos játék</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL-es játék</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D10/D3D11-es játék, 32 bites</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9-es játék, 32 bites</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8-as játék, 32 bites</sys:String>
  <sys:String x:Key="Str.Preset.X86OpenGL">OpenGL-as játék, 32 bites</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: D3D12-es játék DLSS-sel, FSR-rel vagy XeSS-szel</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Állítsd az emulátort Direct3D 11-re: ezen a renderelőn kapja a hálózat a legtöbbet — az emulátor mélységét, és a mozgást a kísérő effektusból, ha telepítve van. Figyelj a játékonkénti felülbírálásra, amely csendben felülírja a globális beállítást.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Kísérleti. A ReShade Vulkanon réteg, nem proxy DLL: a telepítés regisztrálja a Windows-felhasználódnak, és egy ReShade.ini-vel bekapcsolja az rpcs3.exe-hez. Vulkanon nincs mélység, csak szín és becsült mozgás.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">A legjobb útvonal: a D3D11 az egyetlen, ahol a játék saját mozgásvektorai a mélységével együtt eljutnak a hálózathoz. Egy D3D10-es játék is ezt az útvonalat használja, csak színnel.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Korlátozott. D3D12-n a kiegészítő megtalálja a játék mélységét, de a mozgásvektorait nem, így a hálózat színt és mélységet kap, a mozgást pedig megbecsüli. Működik, de kevesebbet várj tőle. Egy olyan játékot, amelynek beállításaiban van DLSS, FSR vagy XeSS, jobban kiszolgál az OptiScaler útvonal.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">D3D12-es játékokhoz ajánlott. A ReShade helyett az OptiScalert telepíti, amely átveszi a játék DLSS, FSR vagy XeSS felskálázóját, és azon belül futtatja a hálózatot, a játék saját mélységével és mozgásvektoraival. A játéknak kínálnia kell az egyik ilyen felskálázót, bekapcsolva a beállításaiban. A játékban nyomd meg az Insert gombot, nyisd meg a Neural lapot, és kapcsold be az Enable NR-t; a Ray Reconstructiont használó játéknál feldolgozási pontnak az „After the finished frame” kell.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Kísérleti. A ReShade Vulkanon réteg: a telepítés regisztrálja a Windows-felhasználódnak, és egy, az .exe mellé tett ReShade.ini-vel bekapcsolja ehhez a programhoz. Vulkanon nincs mélység.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Kísérleti. A Vulkannal ellentétben ez egy közönséges proxy DLL: a ReShade opengl32.dll-ként kerül a játék mellé, külön telepítő futtatása nélkül. Csak szín és becsült mozgás; a játék saját mélysége ezen az API-n elérhető, de még nincs bekötve. Egy 32 bites OpenGL-es játék a 32 bites OpenGL útvonalat használja.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Kísérleti. Egy 32 bites játék nem tudja betölteni a 64 bites futtatókörnyezetet, ezért a kiegészítő egy párként fut, amely egy adapteren osztozik a képkockákon. Telepítsd a ReShade-et kiegészítő-támogatással 32 bites dxgi.dll-ként. Egy D3D10-es játék is ezt az útvonalat használja, csak színnel.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Kísérleti. Ugyanaz a 32 bites pár, mint D3D11-nél, egy privát D3D9/D3D11 lépcsőn át. A sima D3D9 képkockánként néhány fix ezredmásodpercbe kerül; a D3D9Ex nem. Telepítsd a ReShade-et 32 bites d3d9.dll-ként.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Kísérleti. A D3D8 D3D9-re fordítódik, majd a fenti D3D9 útvonalon halad, ugyanazzal a 32 bites párral. Telepítsd a ReShade-et 32 bites d3d9.dll-ként.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86OpenGL">Kísérleti. Ugyanaz a 32 bites pár, a játék OpenGL-kontextusán belül: csak szín és becsült mozgás. Telepítse a ReShade-et 32 bites opengl32.dll-ként.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">A FiveM-nek saját csalásvédelme van: saját felelősségre, és nézd meg a szervered szabályait. Az add-on és a ReShade a FiveM.app\plugins mappába kerül, a runtime és a súlyok a játékfolyamat mellé, a data\cache\subprocess mappába. Ami már a plugins mappában van — ReShade.ini, presetek, shaderek, más add-onok, ENB — marad, ahogy van.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Üdvözlünk</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">A DLSS 5 Neural Rendering hálózat Radeon kártyákon, ReShade-en vagy OptiScaleren keresztül. Négy gyors lépés.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Ez a gép</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Fájlok</sys:String>
  <sys:String x:Key="Str.SetupStepGames">A játékaid</sys:String>
  <sys:String x:Key="Str.SetupBack">Vissza</sys:String>
  <sys:String x:Key="Str.SetupNext">Tovább</sys:String>
  <sys:String x:Key="Str.SetupFinish">Kezdés</sys:String>
  <sys:String x:Key="Str.SetupSkip">Most kihagyom</sys:String>
  <sys:String x:Key="Str.SetupStepOf">{0}. lépés / {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Két dolog akadályozhatja a kiegészítő futását, és mindkettő látszik innen. Egyik sem akadályozza a folytatást — csak azt, hogy a játékban működjön.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Ezen a gépen megvan minden, ami a kiegészítőnek kell.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Hiányzik valami. Folytathatod, és később is pótolhatod, de a játékban addig nem fog működni.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Ugyanazok a fájlok szolgálnak ki minden játékot: egyszer töltődnek le, rögzített hash alapján ellenőrződnek, és újrahasznosulnak.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Újra</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Ha kihagyod, az első telepítéskor töltődnek le.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">Az indítók csak olvasva vannak: a nézelődés semmit nem telepít és nem változtat. Mappákat később kézzel is hozzáadhatsz.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Minden játékot beolvas, hogy kiderüljön, milyen grafikus API-t használ, és ez általában helyes, de nem mindig: egy mappában lehet D3D11-es és D3D12-es futtatható fájl is, és egy játék alapból használhat egy API-t, miközben a futtatható fájlja egy régebbit is támogat. Telepítés előtt érdemes megnézni a játékot a pcgamingwiki.com oldalon — minden játékkártyán van rá közvetlen hivatkozás.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Nem található játék. A főablakban kézzel is hozzáadhatsz mappát.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">{0} játék található.</sys:String>
  <sys:String x:Key="Str.Unexpected">Váratlan hiba történt. A teljes napló elkészült.</sys:String>
  <sys:String x:Key="Str.Play">Játék</sys:String>
  <sys:String x:Key="Str.Launch">Megnyitás</sys:String>
  <sys:String x:Key="Str.Configure">Beállítás</sys:String>
  <sys:String x:Key="Str.ViewGrid">Borítórács</sys:String>
  <sys:String x:Key="Str.ViewList">Lista, mellette a játék oldalával</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Automatikus frissítés</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Ha újabb build jelenik meg, ez a játék magától frissül az alkalmazás megnyitásakor.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">{0} játék automatikusan frissült.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">{0} játék automatikusan frissült.</sys:String>
  <sys:String x:Key="Str.Rename">Átnevezés</sys:String>
  <sys:String x:Key="Str.Save">Mentés</sys:String>
  <sys:String x:Key="Str.Cancel">Mégse</sys:String>
  <sys:String x:Key="Str.ChangeCover">Borító</sys:String>
  <sys:String x:Key="Str.CoverPick">Kép kiválasztása…</sys:String>
  <sys:String x:Key="Str.CoverReset">Az online talált borító használata</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Válassz borítót ehhez a játékhoz</sys:String>
  <sys:String x:Key="Str.CoverFiles">Képek</sys:String>
  <sys:String x:Key="Str.CoverFailed">Ez a fájl nem olvasható be képként.</sys:String>
  <sys:String x:Key="Str.Customize">Testreszabás</sys:String>
  <sys:String x:Key="Str.HeroPick">Szalagkép kiválasztása…</sys:String>
  <sys:String x:Key="Str.HeroReset">Az online talált szalagkép használata</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Válassz szalagképet ehhez a játékhoz</sys:String>
  <sys:String x:Key="Str.PlayFailed">Nem sikerült elindítani. Nyisd meg a mappát, és indítsd el kézzel a futtatható fájlt.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Emulátor hozzáadása</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Emulátor hozzáadása</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Válaszd ki, melyiket, majd mutass a mappára, ahonnan fut — a futtatható fájl mappájára, nem a ROM-okéra.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Másik emulátor</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Mutass a mappára, és megmondom, mit tudok kiolvasni belőle.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Mutass a mappára: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Mutass az emulátor mappájára</sys:String>
  <sys:String x:Key="Str.EmulatorFound">Megtalálva: {0} — {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Ez nem tűnik ennek: {0} — nincs {1} abban a mappában. Így is hozzáadva — ellenőrizd az elérési utat.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Nincs benne általam ismert emulátor. A fájlok alapján hozzáadva: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">Az emulátorban</sys:String>
  <sys:String x:Key="Str.ReportTitle">Nem működik a játékban?</sys:String>
  <sys:String x:Key="Str.ReportBody">A naplókat és a játékmappa fájllistáját egy .zip fájlba csomagolja a gépeden. Semmi nem kerül elküldésre.</sys:String>
  <sys:String x:Key="Str.Report">Probléma jelentése</sys:String>
  <sys:String x:Key="Str.ReportSaved">A jelentés elmentve, a mappa megnyitva: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">A jelentést nem sikerült elkészíteni. A naplók itt vannak: {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Gyűjtés…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Nem töltődnek le a fájlok?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Összegyűjti, mivel próbálkozott minden letöltés — minden címet, a névfeloldását, a proxyt és a választ —, és most minden címet újra ellenőriz, mindezt egy .zip fájlba. Semmi nem kerül elküldésre: a fájl a gépeden marad, és ott osztod meg, ahol akarod.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Letöltési naplók</sys:String>
  <sys:String x:Key="Str.Add">Hozzáadás</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Játékok keresése egy mappában…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Egy játék mappája…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Egy emulátor…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Frissítés</sys:String>
  <sys:String x:Key="Str.GamesAway">Nem csatlakoztatott meghajtón: {0}</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">A most nem csatlakoztatott meghajtón lévő játékok megjegyezve maradnak mindazzal, amit hozzájuk választottál, és visszatérnek, amikor a meghajtó.</sys:String>
  <sys:String x:Key="Str.GameGone">Már nincs telepítve, ezért lekerült a listáról: {0}.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} játék már nincs telepítve, ezért lekerült a listáról.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} játék már nincs telepítve, ezért lekerültek a listáról.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Részletek megjelenítése</sys:String>
  <sys:String x:Key="Str.DetectedSection">Észlelve</sys:String>
  <sys:String x:Key="Str.InstallsInto">Ide települ: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">Ez a hozzáadott mappán kívül van: itt van a(z) {0}, az a build, amelyet a launcher indít. Ha másikkal játszol, fent válaszd annak a(z) {0} fájlját.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">A fájlok azt mondják meg, mihez linkel egy játék, nem azt, min fut: egy mappában lehet D3D11-es és D3D12-es futtatható fájl is. A wiki megmondja, melyiket használja a játék.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">A játék saját fájljaiból kiolvasva.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">A PCGamingWikiből és a játék fájljaiból.</sys:String>
  <sys:String x:Key="Str.InstallWith">Telepítés ezzel</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + kiegészítő</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Ajánlott</sys:String>
  <sys:String x:Key="Str.RecommendedLower">ajánlott</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">A kiegészítő a ReShade-en belül. D3D11, D3D12, Vulkan, OpenGL, 32 bites játékok és emulátorok.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Nincs ReShade útvonal ahhoz, aminek ez a játék tűnik ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">A játék DLSS, FSR vagy XeSS felskálázóján belül fut, a saját mélységével és mozgásával. A ReShade-et váltja ki.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">A játék felskálázóján belül fut (itt ezt találta: {0}). A ReShade-et váltja ki.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">64 bites D3D12-es játékokhoz készült; ez a játék ennek tűnik: {0}.</sys:String>
  <sys:String x:Key="Str.RouteOptiSummaryAll">A játék DLSS, FSR vagy XeSS felskálázójában fut, ha van ilyen, ha nincs, akkor a kész képen. 64 bites D3D9, D3D11, D3D12, Vulkan és OpenGL. A ReShade helyett.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfitAll">64 bites D3D9, D3D11, D3D12, Vulkan és OpenGL játékokhoz készült; ez a játék {0}-nak látszik.</sys:String>
  <sys:String x:Key="Str.ApiSection">Grafikus API</sys:String>
  <sys:String x:Key="Str.Group64">64 bites játékok</sys:String>
  <sys:String x:Key="Str.Group32">32 bites játékok (kísérleti)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Emulátorok</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V online</sys:String>
  <sys:String x:Key="Str.OptiAbout">A ReShade helyett az OptiScalert telepíti, amely átveszi a játék DLSS, FSR vagy XeSS felskálázóját, és azon belül futtatja a hálózatot, a játék saját mélységével és mozgásvektoraival.</sys:String>
  <sys:String x:Key="Str.InGame">A játékban</sys:String>
  <sys:String x:Key="Str.OptiStep1">Kapcsold be a DLSS-t, az FSR-t vagy az XeSS-t a játék grafikai beállításaiban.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Nyomd meg az Insert gombot, nyisd meg a Neural lapot, és kapcsold be az Enable NR-t.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Bekapcsolt Ray Reconstructionnél állítsd a feldolgozási pontot „After the finished frame” értékre.</sys:String>
  <sys:String x:Key="Str.InstallOpti">OptiScaler telepítése</sys:String>
  <sys:String x:Key="Str.Update">Frissítés</sys:String>
  <sys:String x:Key="Str.Reinstall">Újratelepítés</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Váltás OptiScalerre</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Váltás ReShade-re</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Váltasz erre: {0}?</sys:String>
  <sys:String x:Key="Str.SwitchBody">Ebben a játékban: {0}, a(z) {1} útvonal van telepítve, és a kettő nem lehet egyszerre egy mappában. Előbb a(z) {1} kerül eltávolításra, mindent visszaállítva, amit lecserélt, aztán a(z) {2} települ.</sys:String>
  <sys:String x:Key="Str.SwitchYes">{0} eltávolítása, {1} telepítése</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">A saját beállításfájljaid a helyükön maradnak.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Semmi sem változik; telepítve marad: {0}.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">Az ok a „Részletek” alatt van. Semmi sem települt.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">A fájlokat böngészővel is le lehet tölteni és átadni: „Ez a gép” &gt; „Fájlok” &gt; „Kézi letöltés”, majd „Fájlok importálása”. A Letöltések mappában lévő fájlokat magától megtalálja.</sys:String>
  <sys:String x:Key="Str.DnsRetry">DNS törlése és újrapróbálás</sys:String>
  <sys:String x:Key="Str.GameRunning">{0} fut ebből a mappából</sys:String>
  <sys:String x:Key="Str.CloseGame">{0} bezárása</sys:String>
  <sys:String x:Key="Str.CloseGameAsk">Leállítod: {0}? Ami nincs mentve, elvész. A telepítéshez és az eltávolításhoz be kell zárni: a betöltött fájlokat nem lehet lecserélni.</sys:String>
  <sys:String x:Key="Str.CleanRetry">Takarítás és újrapróbálás</sys:String>
  <sys:String x:Key="Str.CleanRetryTitle">Egy korábbi telepítés útban van</sys:String>
  <sys:String x:Key="Str.CleanRetryDetail">A nyilvántartása nem egyezik ezzel a telepítéssel. A Takarítás és újrapróbálás kiveszi az alkalmazás fájljait, megtartja a beállításokat, és újratelepít.</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">A Windows innen nem engedte törölni a DNS-gyorsítótárat. Nyiss egy parancssort, futtasd az ipconfig /flushdns parancsot, és próbáld újra.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">{0} probléma található ebben a mappában</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Telepítésre kész, {0} megjegyzéssel</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Telepítve ide: {0}, {1} figyelmeztetéssel, lásd lent.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Eltávolítva innen: {0}, {1} figyelmeztetéssel, lásd lent.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">{0} probléma, lásd lent.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Nincs letöltési lista</sys:String>
  <sys:String x:Key="Str.FailedShort">Sikertelen</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Mind a(z) {0} kész</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">{0} hiányzik · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Nem sikerült letölteni: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Kézi letöltés</sys:String>
  <sys:String x:Key="Str.ImportFiles">Fájlok importálása…</sys:String>
  <sys:String x:Key="Str.ImportHint">Válassz egy mappát a magad által letöltött fájlokkal. Mindegyiket a neve alapján ismeri fel, és csak akkor veszi át, ha egyezik a rögzített hash-sel.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Töltsd le a fájlokat magad</sys:String>
  <sys:String x:Key="Str.ManualBody">Nyisd meg az egyes hivatkozásokat böngészőben, és mentsd a fájlt bárhová: a Letöltések mappát magától átnézi, a „Fájlok importálása” pedig bármely más mappát elfogad. A neveken nem kell változtatni, és semmi nem kerül felhasználásra, ami nem egyezik a rögzített SHA-256-tal.</sys:String>
  <sys:String x:Key="Str.ImportPick">Válaszd ki a letöltött fájlokat tartalmazó mappát</sys:String>
  <sys:String x:Key="Str.ImportAll">Most minden fájl megvan és ellenőrizve.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Abban a mappában semmi sem egyezett egy szükséges fájllal.</sys:String>
  <sys:String x:Key="Str.ImportSome">Átvéve: {0}. Még hiányzik: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">Kiegészítő</sys:String>
  <sys:String x:Key="Str.Component.runtime">Neurális futtatókörnyezet és súlyok</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32 bites híd</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32 bites extrák</sys:String>
  <sys:String x:Key="Str.Component.shader">Kísérő effektus</sys:String>
  <sys:String x:Key="Str.Updates">Frissítések</sys:String>
  <sys:String x:Key="Str.UpToDate">Naprakész</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Újabb verzió keresése…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">A v{0} a legújabb verzió. Ellenőrizve: {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">Elérhető a(z) {0} verzió. Neked ez van: {1}.</sys:String>
  <sys:String x:Key="Str.HotfixLabel">v{0} gyorsjavítás {1}</sys:String>
  <sys:String x:Key="Str.HotfixShort">gyorsjavítás {0}</sys:String>
  <sys:String x:Key="Str.HotfixOut">Elérhető a(z) {1}. gyorsjavítás a v{0} verzióhoz: ennek a verziónak a javításai, nem új verzió.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">Nem sikerült ellenőrizni: a GitHub nem válaszolt. Az alkalmazás ugyanúgy működik.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Frissítés letöltése</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Letöltés a GitHubról</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Frissítések keresése</sys:String>
  <sys:String x:Key="Str.SessionSection">Legutóbbi munkamenet</sys:String>
  <sys:String x:Key="Str.SessionTip">A naplókból olvasva, amelyeket a kiegészítő és a futtatókörnyezet a játék mappájába ír. Újra beolvassa, amikor játék után visszatérsz ebbe az ablakba.</sys:String>
  <sys:String x:Key="Str.SessionRan">Az NR futott a legutóbbi munkamenetben</sys:String>
  <sys:String x:Key="Str.SessionCrashed">A játék összeomlott a legutóbbi munkamenetben</sys:String>
  <sys:String x:Key="Str.SessionFailed">Az NR nem indult el a legutóbbi munkamenetben</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">A ReShade elindult, de a kiegészítő nem töltődött be</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">A mod betöltődött, de az NR egyetlen képkockát sem dolgozott fel</sys:String>
  <sys:String x:Key="Str.SessionNever">Még nem volt munkamenet. Indítsd el egyszer a játékot, és gyere vissza: itt látszik majd, hogy futott-e az NR.</sys:String>
  <sys:String x:Key="Str.SessionFrames">Feldolgozott képkockák: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">Hálózat: {0} ms képkockánként</sys:String>
  <sys:String x:Key="Str.SessionRuntime">Futtatókörnyezet: {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">A játékban nyisd meg a ReShade overlayt a Home gombbal, és ellenőrizd, hogy az NR be van-e kapcsolva az AMD Neural Rendering panelen.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">A játékban kapcsold be a DLSS-t, az FSR-t vagy az XeSS-t, majd nyomd meg az Insert gombot, nyisd meg a Neural lapot, és kapcsold be az Enable NR-t.</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">A játék mappájában lévő ReShade.log megmondja, melyik mappában kereste a ReShade a kiegészítőket. A „Probléma jelentése” a többivel együtt becsomagolja.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">A „Probléma jelentése” ezeket a naplókat egy fájlba csomagolja, hogy megoszthasd a Discordon.</sys:String>
  <sys:String x:Key="Str.SortFilter">Rendezés és szűrés</sys:String>
  <sys:String x:Key="Str.FilterShow">Megjelenítés</sys:String>
  <sys:String x:Key="Str.FilterAll">Minden játék</sys:String>
  <sys:String x:Key="Str.FilterInstalled">Telepítve</sys:String>
  <sys:String x:Key="Str.FilterUpdates">Frissítés érhető el</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">Nincs telepítve</sys:String>
  <sys:String x:Key="Str.FilterEmulators">Emulátorok</sys:String>
  <sys:String x:Key="Str.SortBy">Rendezés</sys:String>
  <sys:String x:Key="Str.SortName">Név szerint</sys:String>
  <sys:String x:Key="Str.SortRecent">Legutóbb játszott</sys:String>
  <sys:String x:Key="Str.SortAdded">Legutóbb hozzáadott</sys:String>
  <sys:String x:Key="Str.FilterFavorites">Kedvencek</sys:String>
  <sys:String x:Key="Str.SortPinnedFirst">Elöl a kedvencek és a telepítettek</sys:String>
  <sys:String x:Key="Str.Favorite">Kedvenc</sys:String>
  <sys:String x:Key="Str.AddFavorite">Hozzáadás a kedvencekhez</sys:String>
  <sys:String x:Key="Str.RemoveFavorite">Eltávolítás a kedvencek közül</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">A listában egy játék sem felel meg ennek a szűrőnek.</sys:String>
  <sys:String x:Key="Str.WhatsNew">Újdonságok</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">Megnyitás a GitHubon</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">A kiadási jegyzeteket nem sikerült beolvasni a GitHubról. A kiadás oldalán megtalálod őket.</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">Ez a kiadás jegyzetek nélkül jelent meg.</sys:String>
  <sys:String x:Key="Str.Transfer">NR-beállítások</sys:String>
  <sys:String x:Key="Str.TransferTip">A játék NR-beállításai egy fájlban, megőrzésre vagy megosztásra, és a mód, hogy behozd valaki másét. Előbb zárd be a játékot: kilépéskor menti a beállításait.</sys:String>
  <sys:String x:Key="Str.TransferExport">Exportálás fájlba…</sys:String>
  <sys:String x:Key="Str.TransferImport">Importálás fájlból…</sys:String>
  <sys:String x:Key="Str.TransferNothing">Még nincs mit exportálni: a beállítások akkor íródnak ki először, amikor a játék a moddal fut.</sys:String>
  <sys:String x:Key="Str.TransferExported">A beállítások mentve ide: {0}.</sys:String>
  <sys:String x:Key="Str.TransferImported">A beállítások betöltve innen: {0}. A lecseréltek ide kerültek: {1}.</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">Ezek a beállítások ehhez az útvonalhoz valók: {0}, ebben a játékban viszont ez van telepítve: {1}.</sys:String>
  <sys:String x:Key="Str.TransferInvalid">Ez a fájl nem AMD-NR beállításexport.</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. Figyelj a játék tulajdonságaiban lévő játékonkénti felülbírálásra — csendben felülírja a globális beállítást, és ez a leggyakoribb oka annak, hogy hibásnak tűnik, pedig nem az.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. Itt egyáltalán nincs Direct3D, így ez az útvonal csak színt és becsült mozgást kap — mélységet nem.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">D3D12-n fut, ez a korlátozott útvonal: a kiegészítő csak a kész képkockát kapja, semmi mást. Működik, de kevesebbet várj tőle.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Vulkanon nincs mélység: csak szín és becsült mozgás.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Vulkanon nincs mélység.</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. Vulkanon nincs mélység.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Az alapértelmezett háttérrendszer a Vulkan. Vulkanon nincs mélység.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Csak Vulkan. Vulkanon nincs mélység, és maga az emulátor is korai állapotú — számíts gondokra.</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">Csak Vulkan. A kyty_emulator.exe mappáját add meg (a launcher.exe csak elindítja). Nincs mélység, és az emulátor még korai — számíts gondokra.</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">Játékban: a Home megnyitja a ReShade-et, az AMD Neural Rendering az Add-ons fülön van, vagy Ctrl+End. A FiveM-nek saját csalásvédelme van — előbb nézd meg a szerver szabályait.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. Most már az OpenGL-nek is van útvonala, de itt a Vulkan a kipróbáltabb.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">Az xemu csak OpenGL-lel renderel, így itt az OpenGL útvonal az egyetlen. Ez a legújabb útvonal, és kísérleti: szín és becsült mozgás, mélység nélkül.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. A szoftveres renderelő a CPU-n rajzol, és ott nincs mit elérnie egy kiegészítőnek, ezért az OpenGL-esnek kell lennie — ez az útvonal pedig kísérleti: szín és becsült mozgás, mélység nélkül.</sys:String>

</ResourceDictionary>
