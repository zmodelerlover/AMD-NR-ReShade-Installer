<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Arabic">

  <!-- العربية. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">العرض العصبي لـ DLSS 5 على بطاقات Radeon، مع تثبيته نيابةً عنك</sys:String>
  <sys:String x:Key="Str.Games">الألعاب</sys:String>
  <sys:String x:Key="Str.RemoveGame">إزالة من القائمة</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">تزيل اللعبة من القائمة، ويتجاهلها «البحث عن الألعاب» أيضًا. لا يُمَسّ أي ملف في مجلدها، ويمكن إعادتها من الإعدادات.</sys:String>
  <sys:String x:Key="Str.RemovedGame">أُزيلت {0} من القائمة وسيتجاهلها «البحث عن الألعاب». لم يُمَسّ شيء في مجلدها، ويمكن إعادتها من «الإعدادات &gt; الألعاب المتجاهَلة».</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">أُزيلت {0} من القائمة، لكن الإضافة ما زالت مثبّتة في مجلدها. أعِدها من «الإعدادات &gt; الألعاب المتجاهَلة» لإزالة تثبيتها.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">الألعاب المتجاهَلة</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">الألعاب التي أزلتها من القائمة. يتخطّاها «البحث عن الألعاب»، فتبقى خارج القائمة حتى تعيدها من هنا.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">لا توجد ألعاب متجاهَلة.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">إعادة إلى القائمة</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">عادت {0} إلى القائمة.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">مجلد {0} لم يعد موجودًا، لذا أُزيلت من الألعاب المتجاهَلة فقط.</sys:String>
  <sys:String x:Key="Str.NoGames">لا شيء هنا بعد. أضف المجلد الذي تعمل منه لعبة أو محاكٍ.</sys:String>
  <sys:String x:Key="Str.PickFolder">اختر المجلد الذي تعمل منه اللعبة</sys:String>
  <sys:String x:Key="Str.AddGameMany">البحث في مجلد</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">اختر المجلد الذي تحفظ فيه ألعابك</sys:String>
  <sys:String x:Key="Str.AddGameNone">لم يُعثر على شيء يشبه لعبة داخل «{0}».</sys:String>
  <sys:String x:Key="Str.Preset">طريقة التثبيت</sys:String>
  <sys:String x:Key="Str.Install">تثبيت</sys:String>
  <sys:String x:Key="Str.Uninstall">إزالة التثبيت</sys:String>
  <sys:String x:Key="Str.OpenFolder">فتح المجلد</sys:String>
  <sys:String x:Key="Str.System">هذا الجهاز</sys:String>
  <sys:String x:Key="Str.Gpu">الرسوميات</sys:String>
  <sys:String x:Key="Str.Driver">برنامج التشغيل</sys:String>
  <sys:String x:Key="Str.Hip">بيئة تشغيل HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">لم يُعثر على amdhip64_7.dll. يأتي مع برنامج تشغيل Adrenalin حديث، ولا يكفي HIP 6.</sys:String>
  <sys:String x:Key="Str.NotRadeon">لا يبدو أن هذه بطاقة Radeon. تعمل الشبكة على RDNA3 وRDNA4 فقط.</sys:String>
  <sys:String x:Key="Str.Ready">جاهز</sys:String>
  <sys:String x:Key="Str.Payloads">الملفات</sys:String>
  <sys:String x:Key="Str.Downloading">جارٍ التنزيل</sys:String>
  <sys:String x:Key="Str.Verifying">جارٍ التحقق مما هو موجود مسبقًا…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">تم التنزيل والتحقق.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">تعذّرت قراءة قائمة التنزيل المنشورة، لذا تُستخدم النسخة المرفقة بهذا التطبيق.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">تعذّرت قراءة قائمة التنزيل. تحقّق من الاتصال وحاول مرة أخرى.</sys:String>
  <sys:String x:Key="Str.Language">اللغة</sys:String>
  <sys:String x:Key="Str.UpdateWorking">جارٍ تنزيل التحديث…</sys:String>
  <sys:String x:Key="Str.Dismiss">ليس الآن</sys:String>
  <sys:String x:Key="Str.LogSaved">حُفظ السجل الكامل بجوار هذا التطبيق.</sys:String>
  <sys:String x:Key="Str.Working">جارٍ العمل…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">تعذّرت قراءة قائمة الألعاب. احتُفظ بها باسم {0} بجوارها، وبدأت قائمة جديدة.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">ما زالت الكتابة جارية في مجلد لعبة. يستغرق ذلك بضع ثوانٍ؛ أغلق النافذة بعد انتهائها.</sys:String>
  <sys:String x:Key="Str.FreeTitle">هذا مجاني. إن كنت قد دفعت مقابله، فقد تعرّضت للاحتيال.</sys:String>
  <sys:String x:Key="Str.FreeBody">لا أحد يبيع أي شيء من هذا: لا المثبّت، ولا الإضافة، ولا بيئة التشغيل، ولا الأوزان. إن طُلب منك مال مقابله، أو مقابل «مفتاح» أو «نسخة احترافية»، فاطلب استرداد أموالك: ما بِيع لك متاح في هذه الصفحة مجانًا.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">إنه مفتوح المصدر وسيبقى كذلك: اقرأه، وعدّله، وابنِ نسختك الخاصة، وشاركه مع أصدقائك. الشيء الوحيد الذي نطلبه ألّا يحوّله أحد إلى نسخة مدفوعة.</sys:String>
  <sys:String x:Key="Str.SupportSection">الدعم</sys:String>
  <sys:String x:Key="Str.SupportNote">اختياري، ولا يشتري أي شيء</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">فنجان قهوة لمرة واحدة.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">حملة جمع التبرعات البرازيلية للمشروع.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — من إعداد danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">الشبكة نفسها، والسبب في وجود كل هذا: هي ما جعل العرض العصبي لـ DLSS 5 يعمل على Radeon أصلًا. بيئة التشغيل والأوزان التي ينزّلها هذا التطبيق من عمله هو، لا من عملنا. شكرًا لك يا danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — الإضافة</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">ما يوصل تلك الشبكة باللعبة عبر ReShade: الإضافة التي يثبّتها هذا التطبيق، والإصدارات التي يتيح لك الاختيار بينها. مرخّصة بترخيص MIT، وفي مستودع منفصل عن هذا المثبّت.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — حيث يجتمع الجميع</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">الإصدارات الجديدة، وما يعمل في كل لعبة، والمكان الذي تسأل فيه حين يتعطّل شيء.</sys:String>
  <sys:String x:Key="Str.CreditsSection">الشكر والتقدير</sys:String>
  <sys:String x:Key="Str.Scan">البحث عن الألعاب</sys:String>
  <sys:String x:Key="Str.Scanning">جارٍ قراءة Steam وEpic وGOG وEA وUbisoft وBattle.net وXbox…</sys:String>
  <sys:String x:Key="Str.Search">ابحث في الألعاب…</sys:String>
  <sys:String x:Key="Str.Settings">الإعدادات</sys:String>
  <sys:String x:Key="Str.WillDownload">تُنزَّل الملفات ويُتحقَّق منها عند التثبيت.</sys:String>
  <sys:String x:Key="Str.NoRoute">لا توجد طريقة تثبيت لأيٍّ مما تستخدمه هذه اللعبة في العرض: تعمل الإضافة على D3D11 وD3D12 وVulkan وOpenGL، وعلى D3D8 وD3D9 وD3D11 للألعاب ذات 32 بت. لا توجد طريقة للعبة OpenGL ذات 32 بت، ولا للعبة D3D9 ذات 64 بت، ولا لعارض برمجي.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">يمكن تشغيل هذه اللعبة على {1}. اضبطها على {0} من إعدادات الرسوميات الخاصة بها: هذه هي الطريقة المختارة هنا، وعلى واجهة برمجية أخرى ترى الإضافة لعبةً مختلفة.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">هذه لعبة Unreal: أضف ‎-{0}‎ إلى خيارات تشغيلها.</sys:String>
  <sys:String x:Key="Str.CheckWiki">ابحث عن هذه اللعبة في PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">لا توجد ألعاب بعد</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">لا نتائج</sys:String>
  <sys:String x:Key="Str.NoMatch">لا توجد لعبة في القائمة تطابق «{0}».</sys:String>
  <sys:String x:Key="Str.ScanningShort">جارٍ البحث…</sys:String>
  <sys:String x:Key="Str.ScanDone">اكتمل البحث. الألعاب التي عُثر عليها: {0}، الجديدة منها: {1}.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">مثبّت</sys:String>
  <sys:String x:Key="Str.Close">إغلاق</sys:String>
  <sys:String x:Key="Str.CloseHint">إغلاق (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">الملف التنفيذي للعبة</sys:String>
  <sys:String x:Key="Str.ExeChoose">اختيار…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">استخدام الملف المكتشَف</sys:String>
  <sys:String x:Key="Str.ExeNone">لم يُعثر على ملف تنفيذي في هذا المجلد.</sys:String>
  <sys:String x:Key="Str.ExeNote">تُحدَّد طريقة التثبيت من هذا الملف. إن بدا عدد البتات خاطئًا (مشغّل في المجلد الرئيسي واللعبة في Bin64)، فاختر ملف ‎.exe‎ الصحيح.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">أنت من اختار هذا الملف، لذا لا يغيّره الاكتشاف، حتى بعد بحث جديد.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">هذا الملف ليس داخل مجلد هذه اللعبة.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">هذا الملف ليس ملفًا تنفيذيًا لنظام Windows يمكن قراءته.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">هذه الطريقة مخصّصة لألعاب {0}، والملف التنفيذي أعلاه {1}. لا شيء يمنعك (ربما قرأ الاكتشاف الملف الخطأ)، لكن إن كان قد قرأ الملف الصحيح فلن يُحمَّل هذا.</sys:String>
  <sys:String x:Key="Str.VersionSection">إصدار الإضافة</sys:String>
  <sys:String x:Key="Str.ProxySection">يُحمَّل ReShade باسم</sys:String>
  <sys:String x:Key="Str.ProxyNote">«تلقائي» يستخدم dxgi.dll الذي يخدم كل إصدارات Direct3D. لا تغيّره إلا إذا رفضت اللعبة تحميله.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">يُحمَّل OptiScaler باسم</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">«تلقائي» يستخدم أول اسم يحدّده ويكي OptiScaler لهذه اللعبة، وإلا فالاسم المستخدم هنا مسبقًا، وإلا فـ dxgi.dll. اختر winmm.dll للإبقاء على ملف dxgi.dll الخاص ببرنامج آخر.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">تلقائي</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">تلقائي (الويكي: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">تنزيل الكل الآن</sys:String>
  <sys:String x:Key="Str.ClearCache">مسح ذاكرة التخزين المؤقت</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">تحذف الملفات المنزّلة والأغلفة وقائمة الإصدارات. لا يُمَسّ أي شيء مثبّت في لعبة؛ يعيد التثبيت التالي تنزيل ما يحتاجه.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">امسحها</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">سيُعاد تنزيل كل ما فيها في المرة التالية التي تثبّت فيها.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">اترك ذاكرة التخزين المؤقت كما هي.</sys:String>
  <sys:String x:Key="Str.CacheCleared">أُفرغت ذاكرة التخزين المؤقت، وتحرّرت مساحة {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">كان كل شيء موجودًا مسبقًا، وتم التحقق من كل بايت للتو.</sys:String>
  <sys:String x:Key="Str.VersionShipped">مرفق</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">الإصدار الذي نُشر معه هذا المثبّت.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">من الإصدار v{0} على GitHub، ومُتحقَّق منه ببصماته.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">إصدار OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} من إصداره على GitHub، مع التحقق من كل ملف ببصمته.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">يتضمن أوزان lmxxf (نحو 590 ميغابايت، لـ RDNA4 فقط).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">يمكنه أيضًا جلب mochizuki: انظر «بيئة تشغيل NR».</sys:String>
  <sys:String x:Key="Str.MochizukiSection">بيئة تشغيل NR</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">ثبّت mochizuki أيضًا كبيئة تشغيل NR ثانية (تجريبي)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">شبكة DLSS 5 منقولة إلى Vulkan على يد mochizuki0323. لـ RDNA4 فقط: سلسلة RX 9000، وبرنامج تشغيل AMD 25.10 أو أحدث. يضيف MochizukiNrRuntime.dll ومجلد dlssnr-amd يحتوي نموذجه، بتنزيل يقارب 141 ميغابايت. تبقى danielblnc بيئة تشغيل NR: لاستخدام mochizuki، اختره من «NR runtime» في تبويب Neural في OptiScaler ثم أعد تشغيل اللعبة. عند أول تشغيل في كل لعبة تُترجَم الشبكة لبضع ثوانٍ. إن ألغيت التحديد، يزيل التثبيت التالي ما وضعه هذا التطبيق منه.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">ثبّت mochizuki أيضًا كبيئة تشغيل NR ثانية (تجريبي)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">شبكة DLSS 5 منقولة إلى Vulkan على يد mochizuki0323، ويمكن للإضافة تشغيلها بدلًا من شبكة danielblnc بدءًا من v0.6.8. لـ RDNA4 فقط: سلسلة RX 9000، وبرنامج تشغيل AMD 25.10 أو أحدث. يضيف MochizukiNrRuntime.dll ومجلد dlssnr-amd يحتوي نموذجه، بتنزيل يقارب 141 ميغابايت. لاستخدامه، اختر mochizuki (Vulkan) من «NR runtime» في لوحة الإضافة ثم أعد تشغيل اللعبة. عند أول تشغيل في كل لعبة تُترجَم الشبكة لمدة قد تصل إلى دقيقة. إن ألغيت التحديد، يزيل التثبيت التالي ما وضعه هذا التطبيق منه.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">غير متاح على هذه البطاقة ({0}): يحتاج mochizuki إلى تعليمات المصفوفات FP8 في RDNA4، أي سلسلة RX 9000.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">لم يتمكن هذا التطبيق من معرفة هذه البطاقة؛ على أي بطاقة من خارج سلسلة RX 9000 يبقى mochizuki معطّلًا داخل اللعبة.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">اختر طريقة التثبيت</sys:String>
  <sys:String x:Key="Str.PickRouteBody">لم يتمكن هذا التطبيق من معرفة واجهة الرسوميات البرمجية التي تستخدمها {0} في العرض، لذا لا يختار طريقة نيابةً عنك. OptiScaler هو المناسب للعبة D3D12 توفّر DLSS أو FSR أو XeSS في إعداداتها؛ وReShade على D3D11 أو D3D12 هو المناسب لغير ذلك. ينتظر زر «تثبيت» حتى تختار.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">واجهة الرسوميات البرمجية غير معروفة، لذا اختر الطريقة بنفسك أدناه.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">بيئة تشغيل danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">أي إصدار من بيئة التشغيل يدخل هذه اللعبة. البطاقة المميَّزة هي المستخدَمة.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">ينزّلها هذا التطبيق ويتحقق منها.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">اختر ملف version.dll أو برنامج الإعداد الخاص بي…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">اختر ملفًا آخر…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">أحدث من Public Release، من ملف version.dll الخاص بك أو من برنامج إعداد danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">يضيف 0.5.0 نوى حسابية لبطاقات RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">لا ينزّلها هذا التطبيق ولا يشاركها أبدًا. يُتحقَّق من ملفك عبر SHA-256 ويُحتفَظ به، فلا تطلبه الألعاب الأخرى مجددًا.</sys:String>
  <sys:String x:Key="Str.SupporterUse">استخدم ملفات الداعم الخاصة بي…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">ملف version.dll أو dlssnr_on_amd_setup.exe الخاص بك</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll، dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">أي ملف DLL أو برنامج إعداد</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">قيد الاستخدام: بيئة التشغيل التي ينزّلها هذا التطبيق.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">يُستخدم الإصدار {0} من ملفك.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">يُستخدم الإصدار {0}: النسخة المُتحقَّق منها التي احتفظ بها هذا التطبيق عندما اخترتها من قبل.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">الإصدار {0} مختار، لكن لا توجد منه نسخة على هذا الجهاز بعد: اختر ملف version.dll أو برنامج الإعداد الخاص بك.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">يحتاج الإصدار {0} إلى الإضافة v{1} أو أحدث: اختر واحدًا من «إصدار الإضافة». وحتى ذلك الحين يُثبَّت الإصدار المنزَّل.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">يحتاج الإصدار {0} إلى OptiScaler {1} أو أحدث: اختر واحدًا من «إصدار OptiScaler». وحتى ذلك الحين يُثبَّت الإصدار المنزَّل.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">لا تستطيع الإضافة تشغيل الإصدار {0} بعد: قائمة التنزيل لا تتضمن الرقعة الخاصة به. وإلى أن تتضمنها، يُثبَّت هنا الإصدار المنزَّل؛ أما طريقة OptiScaler فتشغّله كما هو.</sys:String>
