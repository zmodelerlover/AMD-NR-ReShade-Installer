<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.French">

  <!-- Français. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Le rendu neuronal de DLSS 5 sur Radeon, installé pour vous</sys:String>
  <sys:String x:Key="Str.Games">Jeux</sys:String>
  <sys:String x:Key="Str.RemoveGame">Retirer de la liste</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Retire le jeu de la liste, et Rechercher des jeux le laisse aussi de côté. Aucun fichier de son dossier n'est modifié ; les Paramètres permettent de le récupérer.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} a été retiré de la liste et Rechercher des jeux le laissera de côté. Rien n'a été modifié dans son dossier ; Paramètres &gt; Jeux ignorés permet de le récupérer.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} a été retiré de la liste, mais l'add-on est toujours installé dans son dossier. Récupérez-le depuis Paramètres &gt; Jeux ignorés pour le désinstaller.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Jeux ignorés</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Les jeux que vous avez retirés de la liste. Rechercher des jeux les ignore, ils restent donc de côté jusqu'à ce que vous les récupériez ici.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Aucun jeu ignoré.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Remettre dans la liste</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} est de retour dans la liste.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Le dossier de {0} n'existe plus, il a donc seulement été retiré des jeux ignorés.</sys:String>
  <sys:String x:Key="Str.NoGames">Rien pour l'instant. Ajoutez le dossier depuis lequel un jeu ou un émulateur se lance.</sys:String>
  <sys:String x:Key="Str.PickFolder">Choisissez le dossier depuis lequel le jeu se lance</sys:String>
  <sys:String x:Key="Str.AddGameMany">Rechercher dans un dossier</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Choisissez le dossier où sont rangés vos jeux</sys:String>
  <sys:String x:Key="Str.AddGameNone">Rien qui ressemble à un jeu n'a été trouvé dans « {0} ».</sys:String>
  <sys:String x:Key="Str.Preset">Méthode</sys:String>
  <sys:String x:Key="Str.Install">Installer</sys:String>
  <sys:String x:Key="Str.Uninstall">Désinstaller</sys:String>
  <sys:String x:Key="Str.OpenFolder">Ouvrir le dossier</sys:String>
  <sys:String x:Key="Str.System">Cet ordinateur</sys:String>
  <sys:String x:Key="Str.Gpu">Carte graphique</sys:String>
  <sys:String x:Key="Str.Driver">Pilote</sys:String>
  <sys:String x:Key="Str.Hip">Runtime HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll est introuvable. Un pilote Adrenalin récent l'inclut ; HIP 6 ne convient pas.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Cela ne ressemble pas à une Radeon. Le réseau ne fonctionne que sur RDNA3 et RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Prêt</sys:String>
  <sys:String x:Key="Str.Payloads">Fichiers</sys:String>
  <sys:String x:Key="Str.Downloading">Téléchargement</sys:String>
  <sys:String x:Key="Str.Verifying">Vérification de ce qui est déjà là…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Téléchargé et vérifié.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">La liste de téléchargement publiée n'a pas pu être lue, c'est donc la copie fournie avec cette application qui est utilisée.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Impossible de lire la liste de téléchargement. Vérifiez la connexion et réessayez.</sys:String>
  <sys:String x:Key="Str.Language">Langue</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Téléchargement de la mise à jour…</sys:String>
  <sys:String x:Key="Str.Dismiss">Plus tard</sys:String>
  <sys:String x:Key="Str.LogSaved">Le journal complet a été enregistré à côté de cette application.</sys:String>
  <sys:String x:Key="Str.Working">En cours…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">La liste des jeux n'a pas pu être lue. Elle a été conservée sous le nom {0} juste à côté, et une nouvelle liste a été créée.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Écriture en cours dans le dossier d'un jeu. Cela prend quelques secondes ; fermez la fenêtre une fois terminé.</sys:String>
  <sys:String x:Key="Str.FreeTitle">C'est gratuit. Si vous avez payé, vous vous êtes fait arnaquer.</sys:String>
  <sys:String x:Key="Str.FreeBody">Personne ne vend rien de tout cela : ni l'installateur, ni l'add-on, ni le runtime, ni les poids. Si on vous a fait payer, ou pour une « clé » ou une « version pro », demandez un remboursement : ce qu'on vous a vendu se trouve gratuitement sur cette page.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">C'est open source et ça le restera : lisez-le, modifiez-le, compilez votre propre version, partagez-le avec vos amis. La seule chose que nous demandons, c'est que personne n'en fasse une version payante.</sys:String>
  <sys:String x:Key="Str.SupportSection">Soutien</sys:String>
  <sys:String x:Key="Str.SupportNote">facultatif, et n'achète rien</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Un café, une seule fois.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">La cagnotte brésilienne du projet.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD, par danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Le réseau lui-même, et la raison pour laquelle tout cela existe : c'est ce qui a permis au rendu neuronal de DLSS 5 de fonctionner sur Radeon. Le runtime et les poids que télécharge cette application sont son travail, pas le nôtre. Merci, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd, l'add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Ce qui branche ce réseau sur un jeu via ReShade : l'add-on que cette application installe, et les versions entre lesquelles elle vous laisse choisir. Sous licence MIT, dans un dépôt distinct de cet installateur.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord, là où tout le monde se retrouve</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Les nouvelles versions, ce qui fonctionne dans quel jeu, et où demander de l'aide quand quelque chose ne marche pas.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Crédits</sys:String>
  <sys:String x:Key="Str.Scan">Rechercher des jeux</sys:String>
  <sys:String x:Key="Str.Scanning">Lecture de Steam, Epic, GOG, EA, Ubisoft, Battle.net et Xbox…</sys:String>
  <sys:String x:Key="Str.Search">Rechercher un jeu…</sys:String>
  <sys:String x:Key="Str.Settings">Paramètres</sys:String>
  <sys:String x:Key="Str.WillDownload">Les fichiers sont téléchargés et vérifiés lors de l'installation.</sys:String>
  <sys:String x:Key="Str.NoRoute">Rien de ce qu'utilise ce jeu pour le rendu n'a de méthode : l'add-on fonctionne en D3D11, D3D12, Vulkan et OpenGL, et en D3D8, D3D9 et D3D11 pour les jeux 32 bits. Un jeu OpenGL 32 bits, un jeu D3D9 64 bits et un rendu logiciel n'en ont aucune.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Ce jeu peut tourner en {1}. Réglez-le sur {0} dans ses propres options graphiques : c'est la méthode choisie ici, et avec une autre API l'add-on voit un jeu différent.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">C'est un jeu Unreal : ajoutez -{0} à ses options de lancement.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Chercher ce jeu sur PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Aucun jeu pour l'instant</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Aucun résultat</sys:String>
  <sys:String x:Key="Str.NoMatch">Aucun jeu de la liste ne correspond à « {0} ».</sys:String>
  <sys:String x:Key="Str.ScanningShort">Recherche…</sys:String>
  <sys:String x:Key="Str.ScanDone">Recherche terminée : {0} jeux trouvés, dont {1} nouveaux.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Installé</sys:String>
  <sys:String x:Key="Str.Close">Fermer</sys:String>
  <sys:String x:Key="Str.CloseHint">Fermer (Échap)</sys:String>
  <sys:String x:Key="Str.ExeSection">L'exécutable du jeu</sys:String>
  <sys:String x:Key="Str.ExeChoose">Choisir…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Utiliser celui détecté</sys:String>
  <sys:String x:Key="Str.ExeNone">Aucun exécutable trouvé dans ce dossier.</sys:String>
  <sys:String x:Key="Str.ExeNote">La méthode est déduite de ce fichier. Si l'architecture semble incorrecte (un lanceur à la racine et le jeu dans Bin64), choisissez le bon .exe.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Vous avez choisi ce fichier, la détection n'y touche donc pas, même après une nouvelle recherche.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Ce fichier n'est pas dans le dossier de ce jeu.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Ce fichier n'est pas un exécutable Windows lisible.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Cette méthode est prévue pour les jeux {0}, et l'exécutable ci-dessus est {1}. Rien ne vous en empêche (la détection a peut-être lu le mauvais fichier), mais si elle a lu le bon, cela ne se chargera pas.</sys:String>
  <sys:String x:Key="Str.VersionSection">Version de l'add-on</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade se charge en tant que</sys:String>
  <sys:String x:Key="Str.ProxyNote">Automatique utilise dxgi.dll, qui convient à tout Direct3D. Ne le changez que si le jeu refuse de le charger.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler se charge en tant que</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">« Automatique » utilise le premier nom que le wiki d'OptiScaler indique pour ce jeu, sinon celui déjà utilisé ici, sinon dxgi.dll. Choisissez winmm.dll pour garder le dxgi.dll d'un autre programme.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatique</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatique (wiki : {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Tout télécharger maintenant</sys:String>
  <sys:String x:Key="Str.ClearCache">Vider le cache</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Supprime les fichiers téléchargés, les jaquettes et la liste des versions. Rien de ce qui est installé dans un jeu n'est touché ; la prochaine installation retélécharge ce dont elle a besoin.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Le vider</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Tout son contenu sera retéléchargé lors de la prochaine installation.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Laisser le cache tel quel.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Cache vidé : {0} libérés.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Tout était déjà là, et chaque octet vient d'être vérifié.</sys:String>
  <sys:String x:Key="Str.VersionShipped">incluse</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">La version avec laquelle cet installateur a été publié.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Issue de la version v{0} sur GitHub, vérifiée avec ses hachages.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Version d'OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, issu de sa version sur GitHub, chaque fichier vérifié avec son hachage.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Inclut les poids de lmxxf (environ 590 Mo, RDNA4 uniquement).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Peut aussi inclure mochizuki : voir Runtime NR.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">Runtime NR</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">Installer aussi mochizuki, comme second runtime NR (expérimental)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">Le réseau de DLSS 5 porté sur Vulkan par mochizuki0323. RDNA4 uniquement : série RX 9000, pilote AMD 25.10 ou plus récent. Il ajoute MochizukiNrRuntime.dll et un dossier dlssnr-amd contenant son modèle, environ 141 Mo à télécharger. danielblnc reste le runtime NR : pour utiliser mochizuki, choisissez-le dans « NR runtime » de l'onglet Neural d'OptiScaler et redémarrez le jeu. Le premier lancement dans chaque jeu compile le réseau pendant quelques secondes. Décoché, la prochaine installation retire ce que cette application en a installé.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">Installer aussi mochizuki, comme second runtime NR (expérimental)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">Le réseau de DLSS 5 porté sur Vulkan par mochizuki0323, que l'add-on peut utiliser à la place de celui de danielblnc depuis la v0.6.8. RDNA4 uniquement : série RX 9000, pilote AMD 25.10 ou plus récent. Il ajoute MochizukiNrRuntime.dll et un dossier dlssnr-amd contenant son modèle, environ 141 Mo à télécharger. Pour l'utiliser, choisissez mochizuki (Vulkan) dans « NR runtime » du panneau de l'add-on et redémarrez le jeu. Le premier lancement dans chaque jeu compile le réseau pendant jusqu'à une minute. Décoché, la prochaine installation retire ce que cette application en a installé.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">Non proposé sur cette carte ({0}) : mochizuki a besoin des instructions matricielles FP8 de RDNA4, la série RX 9000.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">Cette application n'a pas pu identifier cette carte ; sur toute carte hors série RX 9000, mochizuki reste désactivé en jeu.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Choisissez une méthode d'installation</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Cette application n'a pas pu déterminer avec quelle API graphique {0} effectue son rendu, elle ne choisit donc pas de méthode à votre place. OptiScaler convient à un jeu D3D12 qui propose DLSS, FSR ou XeSS dans ses options ; ReShade, en D3D11 ou D3D12, convient à tous les autres. Installer attend votre choix.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">L'API graphique est inconnue, c'est donc à vous de choisir la méthode ci-dessous.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">Runtime de danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Quelle version du runtime est installée dans ce jeu. La carte mise en évidence est celle utilisée.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Téléchargée et vérifiée par cette application.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Choisir mon version.dll ou installateur…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Choisir un autre fichier…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Plus récente que la Public Release, depuis votre propre version.dll ou l'installateur de danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">La 0.5.0 ajoute des kernels pour les cartes RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Jamais téléchargée ni partagée par cette application. Votre fichier est vérifié par SHA-256 et conservé, pour que les autres jeux ne le redemandent pas.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Utiliser mes fichiers de supporter…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Votre version.dll ou dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">N'importe quelle DLL ou installateur</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">Utilisé : le runtime que télécharge cette application.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Utilisation de la {0} depuis votre fichier.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Utilisation de la {0} : la copie vérifiée que cette application a conservée lors de votre choix précédent.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">La {0} est choisie, mais il n'y en a encore aucune copie sur cet ordinateur : choisissez votre version.dll ou installateur.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">La {0} nécessite l'add-on v{1} ou plus récent : choisissez-en un dans Version de l'add-on. D'ici là, c'est la version téléchargée qui est installée.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">La {0} nécessite OptiScaler {1} ou plus récent : choisissez-en un dans Version d'OptiScaler. D'ici là, c'est la version téléchargée qui est installée.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">L'add-on ne peut pas encore utiliser la {0} : la liste de téléchargement ne contient pas son correctif. En attendant, c'est la version téléchargée qui est installée ici ; la méthode OptiScaler l'utilise telle quelle.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Vérifié et conservé : runtime {0} de danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Ce fichier ne peut pas être utilisé. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Vérification de ce dossier…</sys:String>
  <sys:String x:Key="Str.StepDownload">Télécharger</sys:String>
  <sys:String x:Key="Str.StepVerify">Vérifier</sys:String>
  <sys:String x:Key="Str.StepInstall">Installer</sys:String>
  <sys:String x:Key="Str.StepDone">Terminé</sys:String>
  <sys:String x:Key="Str.Installing">Installation…</sys:String>
  <sys:String x:Key="Str.Removing">Suppression…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} est prêt. Lancez le jeu pour l'utiliser.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Installé sur {0}, avec {1} avertissement à lire ci-dessous.</sys:String>
  <sys:String x:Key="Str.InstallFail">L'installation sur {0} n'a pas abouti.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Retiré de {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Retiré de {0}, avec {1} avertissement à lire ci-dessous.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Impossible de tout retirer de {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} est toujours considéré comme installé : un fichier de cette application n'a pas pu être supprimé. Fermez le jeu et désinstallez à nouveau.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Retiré de {0} : il ne reste rien de cette application dans son dossier.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Retiré de {0} : seuls vos réglages sont restés : {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Supprimer aussi vos réglages ?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Tout ce que cette application avait installé dans {0} a disparu. Ces fichiers de réglages sont restés ; ils contiennent ce qui a été réglé dans l'overlay :</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Les supprimer aussi</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">Le dossier redevient tel qu'il était avant l'installation.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Garder mes réglages</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Ils restent pour la prochaine installation.</sys:String>
  <sys:String x:Key="Str.ResultErrors">{0} problème, détaillé ci-dessous.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Les fichiers n'ont pas pu être téléchargés, rien n'a donc été installé.</sys:String>
  <sys:String x:Key="Str.Folder">Dossier</sys:String>
  <sys:String x:Key="Str.GameCount">{0} jeux</sys:String>
  <sys:String x:Key="Str.UnknownApi">API inconnue</sys:String>
  <sys:String x:Key="Str.Location">Emplacement</sys:String>
  <sys:String x:Key="Str.Details">Détails</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} lignes</sys:String>
  <sys:String x:Key="Str.PreflightOk">Prêt à installer</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Rien ne bloque. Choisissez une méthode ci-dessous et appuyez sur Installer.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Prêt à installer, avec {0} remarque à lire</sys:String>
  <sys:String x:Key="Str.PreflightErr">{0} problème trouvé dans ce dossier</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Installé dans ce jeu</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Lancez le jeu pour l'utiliser. Installez à nouveau pour rafraîchir les fichiers, ou désinstallez pour les retirer.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Installé, et une mise à jour est disponible</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Les fichiers de ce jeu sont plus anciens que ceux que cette application installe maintenant. Mettre à jour les remplace ; vos réglages restent.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Ouvrez Détails ci-dessous pour voir ce qui a été trouvé.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Ce dont l'add-on a besoin sur ce PC, vérifié au démarrage de l'application.</sys:String>
  <sys:String x:Key="Str.SystemReady">Ce PC a ce dont l'add-on a besoin</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Il manque à ce PC quelque chose dont l'add-on a besoin</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon détectée</sys:String>
  <sys:String x:Key="Str.GpuBad">Pas une Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Manquant</sys:String>
  <sys:String x:Key="Str.DriverHint">La version que Windows indique pour le pilote graphique.</sys:String>
  <sys:String x:Key="Str.FilesHint">Téléchargés une fois, vérifiés avec un hachage fixé, et réutilisés pour tous les jeux.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Vérifié</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Non téléchargé</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Téléchargement…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Téléchargement {0} %</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Langue, mises à jour et à propos de cette application.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Tous les textes changent immédiatement, sans redémarrage.</sys:String>
  <sys:String x:Key="Str.DataFolder">Dossier des données</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">Jeu D3D11</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">Jeu D3D12</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Jeu Vulkan</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">Jeu OpenGL</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">Jeu D3D11, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">Jeu D3D9, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">Jeu D3D8, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler : jeu D3D12 avec DLSS, FSR ou XeSS</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Réglez l'émulateur sur Direct3D 11 : c'est le rendu où le réseau reçoit le plus, la profondeur de l'émulateur et le mouvement de l'effet complémentaire quand il est installé. Attention aux réglages par jeu, qui remplacent silencieusement le réglage global.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Expérimental. Sur Vulkan, ReShade est une couche, pas une DLL proxy : l'installation l'enregistre pour votre utilisateur Windows et l'active pour rpcs3.exe avec un ReShade.ini. Pas de profondeur sur Vulkan, seulement la couleur et un mouvement estimé.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">La meilleure méthode : D3D11 est la seule où les vecteurs de mouvement du jeu lui-même parviennent au réseau, avec sa profondeur.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Dégradée. Sur D3D12, l'add-on trouve la profondeur du jeu mais pas ses vecteurs de mouvement, le réseau reçoit donc la couleur et la profondeur et estime le mouvement. Cela fonctionne ; attendez-vous à moins. Un jeu avec DLSS, FSR ou XeSS dans ses options est mieux servi par la méthode OptiScaler.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Recommandé pour les jeux D3D12. Au lieu de ReShade, cela installe OptiScaler, qui prend le contrôle du DLSS, FSR ou XeSS du jeu et y fait tourner le réseau, avec la profondeur et les vecteurs de mouvement du jeu lui-même. Le jeu doit proposer l'un de ces upscalers, activé dans ses options. En jeu, appuyez sur Inser, ouvrez l'onglet Neural et activez « Enable NR » ; un jeu avec Ray Reconstruction a besoin de « After the finished frame » comme point de traitement.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Expérimental. Sur Vulkan, ReShade est une couche : l'installation l'enregistre pour votre utilisateur Windows et l'active pour ce programme avec un ReShade.ini à côté de son .exe. Le jeu doit importer vkCreateDevice de façon statique, et il n'y a pas de profondeur sur Vulkan.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Expérimental. Contrairement à Vulkan, il s'agit ici d'une DLL proxy ordinaire : ReShade s'installe en tant qu'opengl32.dll à côté du jeu, sans lancer d'installateur séparé. Couleur et mouvement estimé seulement ; la profondeur du jeu est accessible sur cette API mais n'est pas encore branchée. Un jeu OpenGL 32 bits n'a pas de méthode.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Expérimental. Un jeu 32 bits ne peut pas charger le runtime 64 bits, l'add-on fonctionne donc comme une paire qui partage les images sur un même adaptateur. Installez ReShade avec la prise en charge des add-ons en tant que dxgi.dll 32 bits.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Expérimental. La même paire 32 bits qu'en D3D11, via une étape privée D3D9/D3D11. Le D3D9 classique coûte quelques millisecondes fixes par image ; D3D9Ex non. Installez ReShade en tant que d3d9.dll 32 bits.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Expérimental. D3D8 est traduit en D3D9 puis suit la méthode D3D9 ci-dessus, avec la même paire 32 bits. Installez ReShade en tant que d3d9.dll 32 bits.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Bienvenue</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Le réseau DLSS 5 Neural Rendering sur les cartes Radeon, via ReShade ou OptiScaler. Quatre étapes rapides.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Cet ordinateur</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Fichiers</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Vos jeux</sys:String>
  <sys:String x:Key="Str.SetupBack">Retour</sys:String>
  <sys:String x:Key="Str.SetupNext">Continuer</sys:String>
  <sys:String x:Key="Str.SetupFinish">Commencer</sys:String>
  <sys:String x:Key="Str.SetupSkip">Passer pour l'instant</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Étape {0} sur {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Deux choses empêchent l'add-on de fonctionner, et les deux sont visibles ici. Aucune ne vous empêche de continuer, seulement de le faire fonctionner en jeu.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Cet ordinateur a tout ce dont l'add-on a besoin.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Il manque quelque chose. Vous pouvez continuer et corriger cela plus tard, mais cela ne fonctionnera pas en jeu tant que ce n'est pas fait.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Les mêmes fichiers servent pour tous les jeux : téléchargés une fois, vérifiés avec un hachage fixé, et réutilisés.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Réessayer</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Si vous passez cette étape, ils seront téléchargés lors de la première installation.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">La lecture des lanceurs se fait en lecture seule : regarder n'installe ni ne modifie rien. Vous pourrez ajouter des dossiers à la main ensuite.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Chaque jeu est analysé pour déterminer l'API graphique qu'il utilise, et cette analyse est généralement juste, mais pas toujours : un même dossier peut contenir un exécutable D3D11 et un D3D12, et un jeu peut utiliser une API par défaut alors que son exécutable en prend aussi en charge une plus ancienne. Avant d'installer, il vaut la peine de vérifier le jeu sur pcgamingwiki.com ; chaque carte de jeu a un lien direct.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Aucun jeu trouvé. Vous pouvez ajouter un dossier à la main dans la fenêtre principale.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">{0} jeux trouvés.</sys:String>
  <sys:String x:Key="Str.Unexpected">Un imprévu s'est produit. Le journal complet a été enregistré.</sys:String>
  <sys:String x:Key="Str.Play">Jouer</sys:String>
  <sys:String x:Key="Str.Launch">Ouvrir</sys:String>
  <sys:String x:Key="Str.Configure">Configurer</sys:String>
  <sys:String x:Key="Str.ViewGrid">Grille de jaquettes</sys:String>
  <sys:String x:Key="Str.ViewList">Liste, avec la page du jeu à côté</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Mise à jour automatique</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Quand une nouvelle version sort, ce jeu est mis à jour automatiquement à l'ouverture de l'application.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">{0} jeu mis à jour automatiquement.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">{0} jeux mis à jour automatiquement.</sys:String>
  <sys:String x:Key="Str.Rename">Renommer</sys:String>
  <sys:String x:Key="Str.Save">Enregistrer</sys:String>
  <sys:String x:Key="Str.Cancel">Annuler</sys:String>
  <sys:String x:Key="Str.ChangeCover">Jaquette</sys:String>
  <sys:String x:Key="Str.CoverPick">Choisir une image…</sys:String>
  <sys:String x:Key="Str.CoverReset">Utiliser la jaquette trouvée en ligne</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Choisissez une jaquette pour ce jeu</sys:String>
  <sys:String x:Key="Str.CoverFiles">Images</sys:String>
  <sys:String x:Key="Str.CoverFailed">Ce fichier n'a pas pu être lu comme une image.</sys:String>
  <sys:String x:Key="Str.Customize">Personnaliser</sys:String>
  <sys:String x:Key="Str.HeroPick">Choisir une bannière…</sys:String>
  <sys:String x:Key="Str.HeroReset">Utiliser la bannière trouvée en ligne</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Choisissez une bannière pour ce jeu</sys:String>
  <sys:String x:Key="Str.PlayFailed">Impossible de le lancer. Utilisez Ouvrir le dossier et lancez l'exécutable à la main.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Ajouter un émulateur</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Ajouter un émulateur</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Choisissez lequel, puis indiquez le dossier depuis lequel il se lance : celui de l'exécutable, pas celui des ROM.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Un autre émulateur</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Indiquez le dossier et je vous dirai ce que je peux en déduire.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Indiquez le dossier de {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Indiquez le dossier de l'émulateur</sys:String>
  <sys:String x:Key="Str.EmulatorFound">{0} trouvé : {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Cela ne ressemble pas à {0} : pas de {1} dans ce dossier. Ajouté quand même ; vérifiez le chemin.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Aucun émulateur que je connais ne s'y trouve. Ajouté d'après ce que disent les fichiers : {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">Dans l'émulateur</sys:String>
  <sys:String x:Key="Str.ReportTitle">Ça ne marche pas en jeu ?</sys:String>
  <sys:String x:Key="Str.ReportBody">Regroupe les journaux et la liste du dossier du jeu dans un .zip sur votre PC. Rien n'est envoyé.</sys:String>
  <sys:String x:Key="Str.Report">Signaler un problème</sys:String>
  <sys:String x:Key="Str.ReportSaved">Rapport enregistré et dossier ouvert : {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Le rapport n'a pas pu être créé. Les journaux se trouvent dans {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Collecte…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Les fichiers ne se téléchargent pas ?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Rassemble ce que chaque téléchargement a tenté (chaque adresse, sa résolution de nom, son proxy et sa réponse) et reteste chaque adresse maintenant, le tout dans un .zip. Rien n'est envoyé : le fichier reste sur votre PC, à partager où vous voulez.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Journaux de téléchargement</sys:String>
  <sys:String x:Key="Str.Add">Ajouter</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Rechercher des jeux dans un dossier…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Le dossier d'un jeu…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Un émulateur…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Mettre à jour</sys:String>
  <sys:String x:Key="Str.GamesAway">{0} sur un disque non connecté</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Les jeux d'un disque qui n'est pas branché en ce moment restent mémorisés, avec tout ce qui a été choisi pour eux, et reviennent quand le disque revient.</sys:String>
  <sys:String x:Key="Str.GameGone">{0} n'est plus installé, il a donc quitté la liste.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} jeu n'est plus installé, il a donc quitté la liste.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} jeux ne sont plus installés, ils ont donc quitté la liste.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Afficher les détails</sys:String>
  <sys:String x:Key="Str.DetectedSection">Détecté</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Les fichiers indiquent avec quoi un jeu est lié, pas avec quoi il tourne : un même dossier peut contenir un exécutable D3D11 et un D3D12. Le wiki indique lequel le jeu utilise.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Lu dans les propres fichiers du jeu.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">D'après PCGamingWiki et les fichiers du jeu.</sys:String>
  <sys:String x:Key="Str.InstallWith">Installer avec</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + add-on</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Recommandé</sys:String>
  <sys:String x:Key="Str.RecommendedLower">recommandé</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">L'add-on dans ReShade. D3D11, D3D12, Vulkan, OpenGL, jeux 32 bits et émulateurs.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Aucune méthode ReShade pour ce qui a été détecté dans ce jeu ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Fonctionne dans le DLSS, FSR ou XeSS du jeu, avec sa propre profondeur et son propre mouvement. Remplace ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Fonctionne dans l'upscaler du jeu ({0} trouvé ici). Remplace ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Conçu pour les jeux D3D12 64 bits ; celui-ci est détecté comme {0}.</sys:String>
  <sys:String x:Key="Str.ApiSection">API graphique</sys:String>
  <sys:String x:Key="Str.Group64">Jeux 64 bits</sys:String>
  <sys:String x:Key="Str.Group32">Jeux 32 bits (expérimental)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Émulateurs</sys:String>
  <sys:String x:Key="Str.OptiAbout">Au lieu de ReShade, cela installe OptiScaler, qui prend le contrôle du DLSS, FSR ou XeSS du jeu et y fait tourner le réseau, avec la profondeur et les vecteurs de mouvement du jeu lui-même.</sys:String>
  <sys:String x:Key="Str.InGame">En jeu</sys:String>
  <sys:String x:Key="Str.OptiStep1">Activez DLSS, FSR ou XeSS dans les options graphiques du jeu.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Appuyez sur Inser, ouvrez l'onglet Neural et activez « Enable NR ».</sys:String>
  <sys:String x:Key="Str.OptiStep3">Avec Ray Reconstruction activé, réglez le point de traitement sur « After the finished frame ».</sys:String>
  <sys:String x:Key="Str.InstallOpti">Installer OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">Mettre à jour</sys:String>
  <sys:String x:Key="Str.Reinstall">Réinstaller</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Passer à OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Passer à ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Passer à {0} ?</sys:String>
  <sys:String x:Key="Str.SwitchBody">{0} a la méthode {1} installée, et les deux ne peuvent pas cohabiter dans un même dossier. {1} est d'abord retiré, en remettant tout ce qu'il avait remplacé, puis {2} est installé.</sys:String>
  <sys:String x:Key="Str.SwitchYes">Retirer {0}, installer {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Vos propres fichiers de réglages restent en place.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Rien ne change ; {0} reste installé.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">La raison se trouve dans Détails. Rien n'a été installé.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Les fichiers peuvent aussi être récupérés avec un navigateur puis fournis : Cet ordinateur &gt; Fichiers &gt; Télécharger manuellement, puis Importer des fichiers. Les fichiers de votre dossier Téléchargements sont trouvés automatiquement.</sys:String>
  <sys:String x:Key="Str.DnsRetry">Vider le DNS et réessayer</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows n'a pas voulu vider son cache DNS depuis ici. Ouvrez une invite de commandes, lancez ipconfig /flushdns et réessayez.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">{0} problèmes trouvés dans ce dossier</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Prêt à installer, avec {0} remarques à lire</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Installé sur {0}, avec {1} avertissements à lire ci-dessous.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Retiré de {0}, avec {1} avertissements à lire ci-dessous.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">{0} problèmes, détaillés ci-dessous.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Pas de liste de téléchargement</sys:String>
  <sys:String x:Key="Str.FailedShort">Échec</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Les {0} sont prêts</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">Manquants : {0} · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Impossible de télécharger : {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Télécharger manuellement</sys:String>
  <sys:String x:Key="Str.ImportFiles">Importer des fichiers…</sys:String>
  <sys:String x:Key="Str.ImportHint">Choisissez un dossier contenant des fichiers que vous avez téléchargés vous-même. Chacun est reconnu par son nom et n'est accepté que s'il correspond à son hachage fixé.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Téléchargez les fichiers vous-même</sys:String>
  <sys:String x:Key="Str.ManualBody">Ouvrez chaque lien dans un navigateur et enregistrez le fichier où vous voulez : le dossier Téléchargements est parcouru automatiquement, et Importer des fichiers accepte n'importe quel autre dossier. Inutile de renommer les fichiers, et rien qui ne correspond pas à son SHA-256 fixé n'est utilisé.</sys:String>
  <sys:String x:Key="Str.ImportPick">Choisissez le dossier contenant les fichiers téléchargés</sys:String>
  <sys:String x:Key="Str.ImportAll">Tous les fichiers sont maintenant là et vérifiés.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Rien dans ce dossier ne correspond à un fichier nécessaire.</sys:String>
  <sys:String x:Key="Str.ImportSome">Acceptés : {0}. Encore manquants : {1}.</sys:String>
