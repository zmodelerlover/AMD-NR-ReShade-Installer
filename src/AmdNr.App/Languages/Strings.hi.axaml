<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Hindi">

  <!-- हिन्दी. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Radeon पर DLSS 5 न्यूरल रेंडरिंग, आपके लिए इंस्टॉल किया हुआ</sys:String>
  <sys:String x:Key="Str.Games">गेम</sys:String>
  <sys:String x:Key="Str.RemoveGame">सूची से हटाएँ</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">गेम को सूची से हटा देता है, और “गेम खोजें” भी उसे छोड़ देगा। उसके फ़ोल्डर की किसी फ़ाइल को छुआ नहीं जाता; सेटिंग्स से उसे वापस लाया जा सकता है।</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} सूची से हट गया है और “गेम खोजें” उसे छोड़ देगा। उसके फ़ोल्डर में कुछ भी नहीं छुआ गया; “सेटिंग्स” &gt; “अनदेखे गेम” से उसे वापस लाएँ।</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} सूची से हट गया है, लेकिन ऐड-ऑन अब भी उसके फ़ोल्डर में इंस्टॉल है। उसे अनइंस्टॉल करने के लिए “सेटिंग्स” &gt; “अनदेखे गेम” से गेम वापस लाएँ।</sys:String>
  <sys:String x:Key="Str.IgnoredGames">अनदेखे गेम</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">वे गेम जिन्हें आपने सूची से हटाया। “गेम खोजें” उन्हें छोड़ देता है, इसलिए वे तब तक बाहर रहते हैं जब तक आप उन्हें यहाँ से वापस न लाएँ।</sys:String>
  <sys:String x:Key="Str.IgnoredNone">कोई अनदेखा गेम नहीं।</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">सूची में वापस लाएँ</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} फिर से सूची में है।</sys:String>
  <sys:String x:Key="Str.IgnoredGone">{0} का फ़ोल्डर अब नहीं है, इसलिए वह केवल अनदेखे गेम से हटा।</sys:String>
  <sys:String x:Key="Str.NoGames">यहाँ अभी कुछ नहीं है। वह फ़ोल्डर जोड़ें जहाँ से कोई गेम या एमुलेटर चलता है।</sys:String>
  <sys:String x:Key="Str.PickFolder">वह फ़ोल्डर चुनें जहाँ से गेम चलता है</sys:String>
  <sys:String x:Key="Str.AddGameMany">किसी फ़ोल्डर में खोजें</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">वह फ़ोल्डर चुनें जिसमें आपके गेम रखे हैं</sys:String>
  <sys:String x:Key="Str.AddGameNone">“{0}” में गेम जैसा कुछ नहीं मिला।</sys:String>
  <sys:String x:Key="Str.Preset">रूट</sys:String>
  <sys:String x:Key="Str.Install">इंस्टॉल करें</sys:String>
  <sys:String x:Key="Str.Uninstall">अनइंस्टॉल करें</sys:String>
  <sys:String x:Key="Str.OpenFolder">फ़ोल्डर खोलें</sys:String>
  <sys:String x:Key="Str.System">यह कंप्यूटर</sys:String>
  <sys:String x:Key="Str.Gpu">ग्राफ़िक्स</sys:String>
  <sys:String x:Key="Str.Driver">ड्राइवर</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 रनटाइम</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll नहीं मिला। RX 7000 और RX 9000 पर मौजूदा Adrenalin ड्राइवर इसके साथ आता है; RX 6000 (RDNA2) कार्ड को AMD का HIP SDK 7.2 चाहिए। HIP 6 से काम नहीं चलेगा।</sys:String>
  <sys:String x:Key="Str.NotRadeon">यह Radeon नहीं लगता। नेटवर्क केवल RDNA2, RDNA3 और RDNA4 पर चलता है।</sys:String>
  <sys:String x:Key="Str.Ready">तैयार</sys:String>
  <sys:String x:Key="Str.Payloads">फ़ाइलें</sys:String>
  <sys:String x:Key="Str.Downloading">डाउनलोड हो रहा है</sys:String>
  <sys:String x:Key="Str.Verifying">जो पहले से है उसकी जाँच हो रही है…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">डाउनलोड और जाँच पूरी।</sys:String>
  <sys:String x:Key="Str.ManifestLocal">प्रकाशित डाउनलोड सूची पढ़ी नहीं जा सकी, इसलिए इस ऐप के साथ आई प्रति इस्तेमाल हो रही है।</sys:String>
  <sys:String x:Key="Str.ManifestFailed">डाउनलोड सूची पढ़ी नहीं जा सकी। कनेक्शन जाँचें और फिर से कोशिश करें।</sys:String>
  <sys:String x:Key="Str.Language">भाषा</sys:String>
  <sys:String x:Key="Str.UpdateWorking">अपडेट डाउनलोड हो रहा है…</sys:String>
  <sys:String x:Key="Str.Dismiss">अभी नहीं</sys:String>
  <sys:String x:Key="Str.LogSaved">पूरा लॉग इस ऐप के बगल में लिखा गया।</sys:String>
  <sys:String x:Key="Str.Working">काम चल रहा है…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">गेम की सूची पढ़ी नहीं जा सकी। उसे बगल में {0} नाम से रखा गया है, और नई सूची शुरू की गई।</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">अभी भी गेम फ़ोल्डर में लिखा जा रहा है। इसमें कुछ सेकंड लगते हैं; पूरा होने पर विंडो बंद करें।</sys:String>
  <sys:String x:Key="Str.FreeTitle">यह मुफ़्त है। अगर आपने इसके लिए पैसे दिए, तो आपके साथ धोखा हुआ है।</sys:String>
  <sys:String x:Key="Str.FreeBody">इसमें से कुछ भी कोई नहीं बेचता — न इंस्टॉलर, न ऐड-ऑन, न रनटाइम, न वेट्स। अगर आपसे इसके लिए, किसी “की” के लिए या किसी “प्रो वर्ज़न” के लिए पैसे लिए गए, तो अपने पैसे वापस माँगें: जो आपको बेचा गया, वह इस पेज पर मुफ़्त है।</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">यह ओपन सोर्स है और ऐसा ही रहेगा: इसे पढ़ें, बदलें, अपना वर्ज़न बनाएँ, दोस्तों को दें। हम बस इतना माँगते हैं कि कोई इसे पेड वर्ज़न न बनाए।</sys:String>
  <sys:String x:Key="Str.SupportSection">सहयोग</sys:String>
  <sys:String x:Key="Str.SupportNote">वैकल्पिक, और इससे कुछ नहीं मिलता</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">एक बार की कॉफ़ी।</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">प्रोजेक्ट का ब्राज़ीलियाई फ़ंडरेज़र।</sys:String>
  <sys:String x:Key="Str.SupportRail">AMD-NR को सपोर्ट करें</sys:String>
  <sys:String x:Key="Str.SupportTitle">AMD-NR को ज़िंदा रखें</sys:String>
  <sys:String x:Key="Str.SupportBody">यह प्रोजेक्ट सिर्फ़ इस्तेमाल करने वालों के सपोर्ट से चलता है। दो लोग, दो ग्राफ़िक्स कार्ड और दोपहर भर का काम: न कोई कंपनी, न कोई स्पॉन्सर। यहाँ सब कुछ मुफ़्त है और मुफ़्त ही रहेगा। सपोर्ट से कुछ अनलॉक नहीं होता; इससे काम चलता रहता है।</sys:String>
  <sys:String x:Key="Str.SupportBrazil">ब्राज़ील में हैं? Vakinha पर Pix, कार्ड या boleto से दे सकते हैं।</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — danielblnc द्वारा</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">नेटवर्क खुद, और इस सबके होने की वजह: इसी से DLSS 5 की न्यूरल रेंडरिंग पहली बार Radeon पर चली। यह ऐप जो रनटाइम और वेट्स डाउनलोड करता है, वे उनका काम हैं, हमारा नहीं। धन्यवाद, danielblnc।</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — ऐड-ऑन</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">जो उस नेटवर्क को ReShade के ज़रिए गेम से जोड़ता है: यह ऐप जो ऐड-ऑन इंस्टॉल करता है, और वे रिलीज़ जिनमें से यह आपको चुनने देता है। MIT लाइसेंस, इस इंस्टॉलर से अलग रिपॉज़िटरी।</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — जहाँ सब हैं</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">नए बिल्ड, किस गेम में क्या चलता है, और कुछ टूटे तो कहाँ पूछें।</sys:String>
  <sys:String x:Key="Str.CreditsSection">श्रेय</sys:String>
  <sys:String x:Key="Str.Scan">गेम खोजें</sys:String>
  <sys:String x:Key="Str.Scanning">Steam, Epic, GOG, EA, Ubisoft, Battle.net और Xbox पढ़े जा रहे हैं…</sys:String>
  <sys:String x:Key="Str.Search">गेम खोजें…</sys:String>
  <sys:String x:Key="Str.Settings">सेटिंग्स</sys:String>
  <sys:String x:Key="Str.WillDownload">इंस्टॉल करते समय फ़ाइलें डाउनलोड और जाँची जाती हैं।</sys:String>
  <sys:String x:Key="Str.NoRoute">यह गेम जिससे रेंडर करता है, उसके लिए कोई रूट नहीं है: ऐड-ऑन D3D11, D3D12, Vulkan और OpenGL पर चलता है, और 32-बिट गेम के लिए D3D8, D3D9 और D3D11 पर। 32-बिट OpenGL गेम, 64-बिट D3D9 गेम और सॉफ़्टवेयर रेंडरर के लिए कोई रूट नहीं है।</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">यह गेम {1} पर चल सकता है। इसकी ग्राफ़िक्स सेटिंग्स में {0} चुनें — यही रूट यहाँ चुना गया है, और दूसरे API पर ऐड-ऑन को अलग ही गेम दिखता है।</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">यह Unreal गेम है: इसके लॉन्च विकल्पों में -{0} जोड़ें।</sys:String>
  <sys:String x:Key="Str.CheckWiki">इस गेम को PCGamingWiki पर देखें</sys:String>
  <sys:String x:Key="Str.EmptyTitle">अभी कोई गेम नहीं</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">कोई मेल नहीं</sys:String>
  <sys:String x:Key="Str.NoMatch">सूची का कोई गेम “{0}” से मेल नहीं खाता।</sys:String>
  <sys:String x:Key="Str.ScanningShort">खोज जारी…</sys:String>
  <sys:String x:Key="Str.ScanDone">खोज पूरी: {0} गेम मिले, {1} नए।</sys:String>
  <sys:String x:Key="Str.InstalledBadge">इंस्टॉल है</sys:String>
  <sys:String x:Key="Str.Close">बंद करें</sys:String>
  <sys:String x:Key="Str.CloseHint">बंद करें (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">गेम की एक्ज़ीक्यूटेबल फ़ाइल</sys:String>
  <sys:String x:Key="Str.ExeChoose">चुनें…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">पहचानी गई फ़ाइल इस्तेमाल करें</sys:String>
  <sys:String x:Key="Str.ExeNone">इस फ़ोल्डर में कोई एक्ज़ीक्यूटेबल नहीं मिली।</sys:String>
  <sys:String x:Key="Str.ExeNote">रूट इसी फ़ाइल से तय होता है। अगर बिटनेस गलत लगे (रूट में लॉन्चर, Bin64 में गेम), तो सही .exe चुनें।</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">यह फ़ाइल आपने चुनी है, इसलिए पहचान इसे नहीं बदलती, दोबारा खोजने के बाद भी नहीं।</sys:String>
  <sys:String x:Key="Str.ExeNotHere">वह फ़ाइल इस गेम के फ़ोल्डर में नहीं है।</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">वह फ़ाइल ऐसी Windows एक्ज़ीक्यूटेबल नहीं है जिसे पढ़ा जा सके।</sys:String>
  <sys:String x:Key="Str.RouteMismatch">यह रूट {0} गेम के लिए है और ऊपर की एक्ज़ीक्यूटेबल {1} है। आपको कुछ नहीं रोकता — हो सकता है पहचान ने गलत फ़ाइल पढ़ी हो — लेकिन अगर सही फ़ाइल पढ़ी है, तो यह लोड नहीं होगा।</sys:String>
  <sys:String x:Key="Str.VersionSection">ऐड-ऑन वर्ज़न</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade इस नाम से लोड होता है</sys:String>
  <sys:String x:Key="Str.ProxyNote">स्वचालित dxgi.dll इस्तेमाल करता है, जो हर Direct3D के लिए काम करता है। इसे तभी बदलें जब गेम इसे लोड करने से मना करे।</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler इस नाम से लोड होता है</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">स्वचालित वह पहला नाम इस्तेमाल करता है जो OptiScaler विकी इस गेम के लिए देता है, वरना जो यहाँ पहले से इस्तेमाल हो रहा है, वरना dxgi.dll। किसी दूसरे प्रोग्राम का dxgi.dll रखने के लिए winmm.dll चुनें।</sys:String>
  <sys:String x:Key="Str.ProxyAuto">स्वचालित</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">स्वचालित (विकी: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">सब अभी डाउनलोड करें</sys:String>
  <sys:String x:Key="Str.ClearCache">कैश साफ़ करें</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">डाउनलोड की गई फ़ाइलें, कवर और वर्ज़न सूची मिटाता है। किसी गेम में इंस्टॉल की गई चीज़ को छुआ नहीं जाता; अगला इंस्टॉल ज़रूरी चीज़ें फिर से डाउनलोड करेगा।</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">साफ़ करें</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">इसमें जो कुछ है, वह अगली बार इंस्टॉल करने पर फिर से डाउनलोड होगा।</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">कैश जैसा है वैसा रहने दें।</sys:String>
  <sys:String x:Key="Str.CacheCleared">कैश खाली किया गया — {0} खाली हुए।</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">सब कुछ पहले से मौजूद था, और हर बाइट जाँच में सही निकली।</sys:String>
  <sys:String x:Key="Str.VersionShipped">साथ आया</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">वह वर्ज़न जिसके साथ यह इंस्टॉलर प्रकाशित हुआ।</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">GitHub पर v{0} रिलीज़ से, उसके हैश से जाँचा हुआ।</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler वर्ज़न</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, उसकी GitHub रिलीज़ से, हर फ़ाइल उसके हैश से जाँची हुई।</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">इसमें lmxxf वेट्स शामिल हैं (लगभग 590 MB, केवल RDNA4)।</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">mochizuki भी ला सकता है: “NR रनटाइम” देखें।</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR रनटाइम</sys:String>
  <sys:String x:Key="Str.DanielVersion">danielblnc संस्करण</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">अनुशंसित</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">अस्थिर</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">इस गेम में danielblnc रनटाइम का कौन-सा संस्करण जाएगा। RX 9000 कार्डों पर 0.4.3 अनुशंसित है: नए संस्करणों ने इन कार्डों पर गेम फ्रीज़ किए हैं। बाकी कार्डों को सबसे नया मिलता है।</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: mochizuki (mochizuki0323 का Vulkan पोर्ट, लगभग 141 MB) भी इंस्टॉल होता है और नेटवर्क चलाता है। danielblnc का रनटाइम साथ में रहता है: ऐड-ऑन के पैनल में NR runtime से उसे चुनें। हर गेम की पहली शुरुआत में नेटवर्क एक मिनट तक कंपाइल होता है।</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: नया इंस्टॉल lmxxf चलाता है, और mochizuki (लगभग 141 MB) danielblnc के रनटाइम के साथ जाता है। OptiScaler के Neural टैब में NR runtime से दूसरा चुनें और गेम फिर से शुरू करें।</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">इंस्टॉल करने के लिए रूट चुनें</sys:String>
  <sys:String x:Key="Str.PickRouteBody">यह ऐप पता नहीं लगा सका कि {0} किस ग्राफ़िक्स API से रेंडर करता है, इसलिए यह आपके लिए रूट नहीं चुनता। OptiScaler उस D3D12 गेम के लिए है जिसकी सेटिंग्स में DLSS, FSR या XeSS है; ReShade, D3D11 या D3D12 पर, बाकी सबके लिए है। जब तक आप नहीं चुनते, इंस्टॉल रुका रहेगा।</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">यह ऐप पता नहीं लगा सका कि {0} किस ग्राफ़िक्स API से चलता है, इसलिए यह आपके लिए रास्ता नहीं चुनता। OptiScaler 64-बिट D3D9, D3D11, D3D12, Vulkan और OpenGL गेम पर चलता है, गेम में DLSS, FSR या XeSS हो तो उसके अंदर; ReShade 32-बिट गेम, एमुलेटर और D3D10 भी संभालता है। इंस्टॉल आपके चुनने तक रुकता है।</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">ग्राफ़िक्स API अज्ञात है, इसलिए रूट नीचे आपको चुनना है।</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc का रनटाइम</sys:String>
  <sys:String x:Key="Str.SupporterChoose">इस गेम में रनटाइम का कौन-सा बिल्ड जाएगा। हाइलाइट किया गया कार्ड इस्तेमाल होता है।</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">सार्वजनिक रिलीज़ ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">इस ऐप ने डाउनलोड और जाँच की।</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">लोकल सपोर्टर बिल्ड ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">मेरा version.dll या सेटअप चुनें…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">कोई दूसरी फ़ाइल चुनें…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">सार्वजनिक रिलीज़ से नया, आपके अपने version.dll या danielblnc के सेटअप से।</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 RDNA3 कार्ड के लिए कर्नेल जोड़ता है।</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 RX 6000 (RDNA2) कार्ड जोड़ता है, जिन्हें AMD का HIP SDK 7.2 रनटाइम चाहिए, और अंधेरे हिस्सों व छोटी रोशनियों में टिमटिमाहट ठीक करता है।</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">यह ऐप इसे कभी डाउनलोड या साझा नहीं करता। आपकी फ़ाइल SHA-256 से जाँची और रखी जाती है, ताकि दूसरे गेम फिर न पूछें।</sys:String>
  <sys:String x:Key="Str.SupporterUse">मेरी सपोर्टर फ़ाइलें इस्तेमाल करें…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">सार्वजनिक रिलीज़</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">आपका version.dll या dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">कोई भी DLL या सेटअप</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">इस्तेमाल में: वह रनटाइम जो यह ऐप डाउनलोड करता है।</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">आपकी फ़ाइल से {0} इस्तेमाल हो रहा है।</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">{0} इस्तेमाल हो रहा है: वह जाँची हुई प्रति जो इस ऐप ने तब रखी थी जब आपने इसे पहले चुना था।</sys:String>
  <sys:String x:Key="Str.SupporterMissing">{0} चुना गया है, लेकिन इस कंप्यूटर पर अभी उसकी कोई प्रति नहीं है: अपना version.dll या सेटअप चुनें।</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} के लिए ऐड-ऑन v{1} या नया चाहिए: “ऐड-ऑन वर्ज़न” के नीचे एक चुनें। तब तक डाउनलोड वाला इंस्टॉल होगा।</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} के लिए OptiScaler {1} या नया चाहिए: “OptiScaler वर्ज़न” के नीचे एक चुनें। तब तक डाउनलोड वाला इंस्टॉल होगा।</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">ऐड-ऑन अभी {0} नहीं चला सकता: पेलोड सूची में उसका पैच नहीं है। जब तक नहीं आता, यहाँ डाउनलोड वाला इंस्टॉल होगा; OptiScaler रूट इसे जैसा है वैसा चलाता है।</sys:String>
  <sys:String x:Key="Str.SupporterKept">जाँचा और रखा गया: danielblnc का रनटाइम {0}।</sys:String>
  <sys:String x:Key="Str.SupporterRefused">वह फ़ाइल इस्तेमाल नहीं की जा सकती। {0}</sys:String>
  <sys:String x:Key="Str.Checking">यह फ़ोल्डर जाँचा जा रहा है…</sys:String>
  <sys:String x:Key="Str.StepDownload">डाउनलोड</sys:String>
  <sys:String x:Key="Str.StepVerify">जाँच</sys:String>
  <sys:String x:Key="Str.StepInstall">इंस्टॉल</sys:String>
  <sys:String x:Key="Str.StepDone">पूरा</sys:String>
  <sys:String x:Key="Str.Installing">इंस्टॉल हो रहा है…</sys:String>
  <sys:String x:Key="Str.Removing">हटाया जा रहा है…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} तैयार है। इसे इस्तेमाल करने के लिए गेम शुरू करें।</sys:String>
  <sys:String x:Key="Str.InstallWarn">{0} पर इंस्टॉल हुआ, नीचे पढ़ने के लिए {1} चेतावनी के साथ।</sys:String>
  <sys:String x:Key="Str.InstallFail">{0} पर इंस्टॉल पूरा नहीं हुआ।</sys:String>
  <sys:String x:Key="Str.UninstallOk">{0} से हटाया गया।</sys:String>
  <sys:String x:Key="Str.UninstallWarn">{0} से हटाया गया, नीचे पढ़ने के लिए {1} चेतावनी के साथ।</sys:String>
  <sys:String x:Key="Str.UninstallFail">{0} से सब कुछ नहीं हटाया जा सका।</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} अब भी इंस्टॉल माना जा रहा है: इस ऐप की एक फ़ाइल हटाई नहीं जा सकी। गेम बंद करें और फिर से अनइंस्टॉल करें।</sys:String>
  <sys:String x:Key="Str.UninstallClean">{0} से हटाया गया — उसके फ़ोल्डर में इस ऐप का कुछ नहीं बचा।</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">{0} से हटाया गया — केवल आपकी सेटिंग्स बचीं: {1}।</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">अपनी सेटिंग्स भी हटाएँ?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">इस ऐप ने {0} में जो कुछ इंस्टॉल किया था, वह हट गया है। ये सेटिंग फ़ाइलें बची हैं — इनमें वह है जो ओवरले में सेट किया गया था:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">इन्हें भी हटाएँ</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">फ़ोल्डर इंस्टॉल से पहले जैसा हो जाता है।</sys:String>
  <sys:String x:Key="Str.SettingsKeep">मेरी सेटिंग्स रखें</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">ये अगली बार इंस्टॉल करने के लिए बनी रहेंगी।</sys:String>
  <sys:String x:Key="Str.ResultErrors">नीचे {0} समस्या दी गई है।</sys:String>
  <sys:String x:Key="Str.DownloadFailed">फ़ाइलें डाउनलोड नहीं हो सकीं, इसलिए कुछ भी इंस्टॉल नहीं हुआ।</sys:String>
  <sys:String x:Key="Str.Folder">फ़ोल्डर</sys:String>
  <sys:String x:Key="Str.GameCount">{0} गेम</sys:String>
  <sys:String x:Key="Str.UnknownApi">अज्ञात API</sys:String>
  <sys:String x:Key="Str.Location">स्थान</sys:String>
  <sys:String x:Key="Str.Details">विवरण</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} पंक्तियाँ</sys:String>
  <sys:String x:Key="Str.PreflightOk">इंस्टॉल के लिए तैयार</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">कोई रुकावट नहीं। नीचे रूट चुनें और “इंस्टॉल करें” दबाएँ।</sys:String>
  <sys:String x:Key="Str.PreflightWarn">इंस्टॉल के लिए तैयार, पढ़ने के लिए {0} नोट के साथ</sys:String>
  <sys:String x:Key="Str.PreflightErr">इस फ़ोल्डर में {0} समस्या मिली</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">इस गेम में इंस्टॉल है</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">इस्तेमाल करने के लिए गेम शुरू करें। फ़ाइलें ताज़ा करने के लिए फिर से इंस्टॉल करें, या उन्हें हटाने के लिए अनइंस्टॉल करें।</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">इंस्टॉल है, और अपडेट तैयार है</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">इस गेम की फ़ाइलें उनसे पुरानी हैं जो यह ऐप अब इंस्टॉल करता है। “अपडेट करें” उन्हें बदल देगा; आपकी सेटिंग्स बनी रहेंगी।</sys:String>
  <sys:String x:Key="Str.SeeDetails">क्या मिला, यह देखने के लिए नीचे “विवरण” खोलें।</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">ऐड-ऑन को इस कंप्यूटर से क्या चाहिए, ऐप शुरू होने पर जाँचा गया।</sys:String>
  <sys:String x:Key="Str.SystemReady">इस कंप्यूटर में ऐड-ऑन की ज़रूरत की हर चीज़ है</sys:String>
  <sys:String x:Key="Str.SystemNotReady">इस कंप्यूटर में ऐड-ऑन के लिए ज़रूरी किसी चीज़ की कमी है</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon मिला</sys:String>
  <sys:String x:Key="Str.GpuBad">Radeon नहीं है</sys:String>
  <sys:String x:Key="Str.Missing">नहीं मिला</sys:String>
  <sys:String x:Key="Str.DriverHint">ग्राफ़िक्स ड्राइवर का वह वर्ज़न जो Windows बताता है।</sys:String>
  <sys:String x:Key="Str.FilesHint">एक बार डाउनलोड, तय हैश से जाँचा हुआ, और हर गेम के लिए दोबारा इस्तेमाल।</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">जाँचा हुआ</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">डाउनलोड नहीं हुआ</sys:String>
  <sys:String x:Key="Str.DownloadingShort">डाउनलोड हो रहा है…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">डाउनलोड {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">भाषा, अपडेट और इस ऐप के बारे में।</sys:String>
  <sys:String x:Key="Str.LanguageHint">हर लेबल तुरंत बदल जाता है; रीस्टार्ट की ज़रूरत नहीं।</sys:String>
  <sys:String x:Key="Str.DataFolder">डेटा फ़ोल्डर</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D10/D3D11 गेम</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12 गेम</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan गेम</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL गेम</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D10/D3D11 गेम, 32-बिट</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9 गेम, 32-बिट</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8 गेम, 32-बिट</sys:String>
  <sys:String x:Key="Str.Preset.X86OpenGL">OpenGL गेम, 32-बिट</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: DLSS, FSR या XeSS वाला D3D12 गेम</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">एमुलेटर को Direct3D 11 पर सेट करें: इसी रेंडरर पर नेटवर्क को सबसे ज़्यादा मिलता है — एमुलेटर की डेप्थ, और साथी इफ़ेक्ट इंस्टॉल होने पर उससे मोशन। हर गेम की अलग सेटिंग पर ध्यान दें, जो चुपचाप ग्लोबल सेटिंग को बदल देती है।</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">प्रायोगिक। Vulkan पर ReShade एक लेयर है, प्रॉक्सी DLL नहीं: इंस्टॉल इसे आपके Windows यूज़र के लिए रजिस्टर करता है और ReShade.ini से rpcs3.exe के लिए चालू करता है। Vulkan पर डेप्थ नहीं, केवल रंग और अनुमानित मोशन।</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">सबसे अच्छा रूट: D3D11 ही अकेला है जहाँ गेम के अपने मोशन वेक्टर उसकी डेप्थ के साथ नेटवर्क तक पहुँचते हैं। D3D10 गेम भी यही रूट लेता है, केवल रंग के साथ।</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">सीमित। D3D12 पर ऐड-ऑन गेम की डेप्थ ढूँढ लेता है, लेकिन उसके मोशन वेक्टर नहीं, इसलिए नेटवर्क को रंग और डेप्थ मिलते हैं और मोशन का अनुमान लगाता है। यह काम करता है; इससे कम की उम्मीद रखें। जिस गेम की सेटिंग्स में DLSS, FSR या XeSS है, उसके लिए OptiScaler रूट बेहतर है।</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">D3D12 गेम के लिए सुझाया गया। ReShade की जगह यह OptiScaler इंस्टॉल करता है, जो गेम का DLSS, FSR या XeSS अपने हाथ में लेता है और उसी के अंदर नेटवर्क चलाता है, गेम की अपनी डेप्थ और मोशन वेक्टर के साथ। गेम में इनमें से कोई अपस्केलर होना चाहिए, और वह उसकी सेटिंग्स में चालू होना चाहिए। गेम में Insert दबाएँ, Neural टैब खोलें और Enable NR चालू करें; Ray Reconstruction वाले गेम में प्रोसेसिंग पॉइंट “After the finished frame” होना चाहिए।</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">प्रायोगिक। Vulkan पर ReShade एक लेयर है: इंस्टॉल इसे आपके Windows यूज़र के लिए रजिस्टर करता है और इस प्रोग्राम के .exe के बगल में ReShade.ini रखकर इसके लिए चालू करता है। Vulkan पर डेप्थ नहीं है।</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">प्रायोगिक। Vulkan के उलट यह एक सामान्य प्रॉक्सी DLL है: ReShade गेम के बगल में opengl32.dll के रूप में जाता है, अलग इंस्टॉलर चलाए बिना। केवल रंग और अनुमानित मोशन; गेम की अपनी डेप्थ इस API पर मिल सकती है, लेकिन अभी जोड़ी नहीं गई है। 32-बिट OpenGL गेम 32-बिट OpenGL रूट लेता है।</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">प्रायोगिक। 32-बिट गेम 64-बिट रनटाइम लोड नहीं कर सकता, इसलिए ऐड-ऑन एक जोड़ी के रूप में चलता है जो एक ही एडैप्टर पर फ़्रेम साझा करती है। ReShade को ऐड-ऑन सपोर्ट के साथ 32-बिट dxgi.dll के रूप में इंस्टॉल करें। D3D10 गेम भी यही रूट लेता है, केवल रंग के साथ।</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">प्रायोगिक। D3D11 वाली वही 32-बिट जोड़ी, एक निजी D3D9/D3D11 चरण के ज़रिए। साधारण D3D9 हर फ़्रेम पर कुछ तय मिलीसेकंड लेता है; D3D9Ex नहीं। ReShade को 32-बिट d3d9.dll के रूप में इंस्टॉल करें।</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">प्रायोगिक। D3D8 को D3D9 में बदला जाता है और फिर ऊपर वाला D3D9 रूट लिया जाता है, उसी 32-बिट जोड़ी के साथ। ReShade को 32-बिट d3d9.dll के रूप में इंस्टॉल करें।</sys:String>
  <sys:String x:Key="Str.PresetNote.X86OpenGL">प्रायोगिक। वही 32-बिट जोड़ी, गेम के OpenGL कॉन्टेक्स्ट के अंदर: केवल रंग और अनुमानित मोशन। ReShade को 32-बिट opengl32.dll के रूप में इंस्टॉल करें।</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM का अपना एंटी-चीट है: अपने जोखिम पर, और अपने सर्वर के नियम देख लें। ऐड-ऑन और ReShade FiveM.app\plugins में जाते हैं, रनटाइम और वेट्स गेम प्रोसेस के बगल में data\cache\subprocess में। plugins में जो पहले से है — ReShade.ini, प्रीसेट, शेडर, दूसरे ऐड-ऑन, ENB — वैसा ही रहता है।</sys:String>
  <sys:String x:Key="Str.SetupWelcome">स्वागत है</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Radeon कार्ड पर DLSS 5 Neural Rendering नेटवर्क, ReShade या OptiScaler के ज़रिए। चार आसान चरण।</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">यह कंप्यूटर</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">फ़ाइलें</sys:String>
  <sys:String x:Key="Str.SetupStepGames">आपके गेम</sys:String>
  <sys:String x:Key="Str.SetupBack">पीछे</sys:String>
  <sys:String x:Key="Str.SetupNext">जारी रखें</sys:String>
  <sys:String x:Key="Str.SetupFinish">इस्तेमाल शुरू करें</sys:String>
  <sys:String x:Key="Str.SetupSkip">अभी छोड़ें</sys:String>
  <sys:String x:Key="Str.SetupStepOf">चरण {0} / {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">दो चीज़ें ऐड-ऑन को चलने से रोक सकती हैं, और दोनों यहाँ से दिखती हैं। कोई भी आपको आगे बढ़ने से नहीं रोकती — केवल गेम के अंदर उसके काम करने से।</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">इस कंप्यूटर में ऐड-ऑन की ज़रूरत की हर चीज़ है।</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">कुछ कमी है। आप आगे बढ़कर बाद में ठीक कर सकते हैं, लेकिन तब तक यह गेम में काम नहीं करेगा।</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">वही फ़ाइलें हर गेम के काम आती हैं: एक बार डाउनलोड, तय हैश से जाँची हुई, और दोबारा इस्तेमाल।</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">फिर से कोशिश करें</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">इसे छोड़ें, और फ़ाइलें पहले इंस्टॉल पर डाउनलोड होंगी।</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">लॉन्चर केवल पढ़े जाते हैं: देखने से कुछ भी इंस्टॉल या बदला नहीं जाता। बाद में आप फ़ोल्डर खुद भी जोड़ सकते हैं।</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">हर गेम को पढ़कर पता लगाया जाता है कि वह कौन-सा ग्राफ़िक्स API इस्तेमाल करता है, और यह आम तौर पर सही होता है पर हमेशा नहीं: एक फ़ोल्डर में D3D11 और D3D12 दोनों एक्ज़ीक्यूटेबल हो सकती हैं, और कोई गेम डिफ़ॉल्ट रूप से एक API इस्तेमाल कर सकता है जबकि उसकी एक्ज़ीक्यूटेबल पुराना API भी सपोर्ट करती है। इंस्टॉल करने से पहले pcgamingwiki.com पर गेम देख लेना अच्छा है — हर गेम कार्ड पर उसका सीधा लिंक है।</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">कोई गेम नहीं मिला। आप मुख्य विंडो में फ़ोल्डर खुद जोड़ सकते हैं।</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">{0} गेम मिले।</sys:String>
  <sys:String x:Key="Str.Unexpected">कुछ अनपेक्षित हुआ। पूरा लॉग लिखा गया।</sys:String>
  <sys:String x:Key="Str.Play">खेलें</sys:String>
  <sys:String x:Key="Str.Launch">खोलें</sys:String>
  <sys:String x:Key="Str.Configure">कॉन्फ़िगर करें</sys:String>
  <sys:String x:Key="Str.ViewGrid">कवर का ग्रिड</sys:String>
  <sys:String x:Key="Str.ViewList">सूची, बगल में गेम के पेज के साथ</sys:String>
  <sys:String x:Key="Str.AutoUpdate">ऑटो-अपडेट</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">नया बिल्ड आने पर, ऐप खुलते समय यह गेम खुद अपडेट हो जाता है।</sys:String>
  <sys:String x:Key="Str.AutoUpdated">{0} गेम अपने-आप अपडेट हुआ।</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">{0} गेम अपने-आप अपडेट हुए।</sys:String>
  <sys:String x:Key="Str.Rename">नाम बदलें</sys:String>
  <sys:String x:Key="Str.Save">सेव करें</sys:String>
  <sys:String x:Key="Str.Cancel">रद्द करें</sys:String>
  <sys:String x:Key="Str.ChangeCover">कवर</sys:String>
  <sys:String x:Key="Str.CoverPick">कोई चित्र चुनें…</sys:String>
  <sys:String x:Key="Str.CoverReset">ऑनलाइन मिला कवर इस्तेमाल करें</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">इस गेम के लिए कवर चुनें</sys:String>
  <sys:String x:Key="Str.CoverFiles">चित्र</sys:String>
  <sys:String x:Key="Str.CoverFailed">वह फ़ाइल चित्र के रूप में पढ़ी नहीं जा सकी।</sys:String>
  <sys:String x:Key="Str.Customize">कस्टमाइज़ करें</sys:String>
  <sys:String x:Key="Str.HeroPick">बैनर चुनें…</sys:String>
  <sys:String x:Key="Str.HeroReset">ऑनलाइन मिला बैनर इस्तेमाल करें</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">इस गेम के लिए बैनर चुनें</sys:String>
  <sys:String x:Key="Str.PlayFailed">शुरू नहीं हो सका। फ़ोल्डर खोलें और एक्ज़ीक्यूटेबल खुद चलाएँ।</sys:String>
  <sys:String x:Key="Str.AddEmulator">एमुलेटर जोड़ें</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">एक एमुलेटर जोड़ें</sys:String>
  <sys:String x:Key="Str.EmulatorBody">कौन-सा है चुनें, फिर वह फ़ोल्डर बताएँ जहाँ से वह चलता है — एक्ज़ीक्यूटेबल वाला फ़ोल्डर, ROM वाला नहीं।</sys:String>
  <sys:String x:Key="Str.EmulatorOther">कोई दूसरा एमुलेटर</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">फ़ोल्डर बताएँ, और मैं बताऊँगा कि उससे क्या पता चलता है।</sys:String>
  <sys:String x:Key="Str.EmulatorPick">{0} का फ़ोल्डर बताएँ</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">एमुलेटर का फ़ोल्डर बताएँ</sys:String>
  <sys:String x:Key="Str.EmulatorFound">{0} मिला: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">यह {0} नहीं लगता: उस फ़ोल्डर में {1} नहीं है। फिर भी जोड़ा गया — पाथ जाँच लें।</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">इसमें मेरा जाना-पहचाना कोई एमुलेटर नहीं है। फ़ाइलें जो बताती हैं उसके आधार पर जोड़ा गया: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">एमुलेटर के अंदर</sys:String>
  <sys:String x:Key="Str.ReportTitle">गेम में काम नहीं कर रहा?</sys:String>
  <sys:String x:Key="Str.ReportBody">लॉग और गेम फ़ोल्डर की फ़ाइल सूची को आपके कंप्यूटर पर एक .zip में पैक करता है। कुछ भी भेजा नहीं जाता।</sys:String>
  <sys:String x:Key="Str.Report">समस्या रिपोर्ट करें</sys:String>
  <sys:String x:Key="Str.ReportSaved">रिपोर्ट सेव हुई और फ़ोल्डर खुला: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">रिपोर्ट नहीं बन सकी। लॉग यहाँ हैं: {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">इकट्ठा हो रहा है…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">फ़ाइलें डाउनलोड नहीं हो रहीं?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">हर डाउनलोड ने जो आज़माया वह इकट्ठा करता है — हर पता, उसका नाम-लुकअप, प्रॉक्सी और जवाब — और अभी हर पते को फिर से जाँचता है, सब एक .zip में। कुछ भी भेजा नहीं जाता: फ़ाइल आपके कंप्यूटर पर रहती है, और आप उसे जहाँ चाहें साझा करें।</sys:String>
  <sys:String x:Key="Str.DownloadReport">डाउनलोड लॉग</sys:String>
  <sys:String x:Key="Str.Add">जोड़ें</sys:String>
  <sys:String x:Key="Str.AddMenuMany">किसी फ़ोल्डर में गेम खोजें…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">एक गेम का फ़ोल्डर…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">एक एमुलेटर…</sys:String>
  <sys:String x:Key="Str.UpdateShort">अपडेट करें</sys:String>
  <sys:String x:Key="Str.GamesAway">बिना जुड़ी ड्राइव पर: {0}</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">जो ड्राइव अभी जुड़ी नहीं है, उस पर के गेम उनके लिए चुनी हर चीज़ के साथ याद रहते हैं, और ड्राइव लौटने पर लौट आते हैं।</sys:String>
  <sys:String x:Key="Str.GameGone">{0} अब इंस्टॉल नहीं है, इसलिए सूची से हट गया।</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} गेम अब इंस्टॉल नहीं है, इसलिए सूची से हट गया।</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} गेम अब इंस्टॉल नहीं हैं, इसलिए सूची से हट गए।</sys:String>
  <sys:String x:Key="Str.ShowDetails">विवरण दिखाएँ</sys:String>
  <sys:String x:Key="Str.DetectedSection">पहचाना गया</sys:String>
  <sys:String x:Key="Str.InstallsInto">यहाँ इंस्टॉल होगा: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">यह आपके जोड़े गए फ़ोल्डर के बाहर है: यहाँ {0} है, वह बिल्ड जिसे लॉन्चर चलाता है। अगर आप कोई और बिल्ड खेलते हैं, तो ऊपर उसका {0} चुनें।</sys:String>
  <sys:String x:Key="Str.CheckApiTip">फ़ाइलें बताती हैं कि गेम किससे लिंक है, न कि वह किस पर चलता है: एक फ़ोल्डर में D3D11 और D3D12 दोनों एक्ज़ीक्यूटेबल हो सकती हैं। विकी बताती है कि गेम कौन-सा इस्तेमाल करता है।</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">गेम की अपनी फ़ाइलों से पढ़ा गया।</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">PCGamingWiki और गेम की फ़ाइलों से।</sys:String>
  <sys:String x:Key="Str.InstallWith">इससे इंस्टॉल करें</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + ऐड-ऑन</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">सुझाया गया</sys:String>
  <sys:String x:Key="Str.RecommendedLower">सुझाया गया</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">ReShade के अंदर ऐड-ऑन। D3D11, D3D12, Vulkan, OpenGL, 32-बिट गेम और एमुलेटर।</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">यह गेम जैसा पढ़ा गया ({0}), उसके लिए कोई ReShade रूट नहीं।</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">गेम के DLSS, FSR या XeSS के अंदर चलता है, उसकी अपनी डेप्थ और मोशन के साथ। ReShade की जगह लेता है।</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">गेम के अपस्केलर के अंदर चलता है (यहाँ {0} मिला)। ReShade की जगह लेता है।</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">64-बिट D3D12 गेम के लिए बना है; यह गेम {0} के रूप में पढ़ा गया।</sys:String>
  <sys:String x:Key="Str.RouteOptiSummaryAll">गेम में DLSS, FSR या XeSS हो तो उसके अंदर चलता है, और न हो तो अंतिम फ़्रेम पर। 64-बिट D3D9, D3D11, D3D12, Vulkan और OpenGL। ReShade की जगह लेता है।</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfitAll">64-बिट D3D9, D3D11, D3D12, Vulkan और OpenGL गेम के लिए बना है; यह गेम {0} के रूप में पढ़ा गया।</sys:String>
  <sys:String x:Key="Str.ApiSection">ग्राफ़िक्स API</sys:String>
  <sys:String x:Key="Str.Group64">64-बिट गेम</sys:String>
  <sys:String x:Key="Str.Group32">32-बिट गेम (प्रायोगिक)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">एमुलेटर</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V ऑनलाइन</sys:String>
  <sys:String x:Key="Str.OptiAbout">ReShade की जगह यह OptiScaler इंस्टॉल करता है, जो गेम का DLSS, FSR या XeSS अपने हाथ में लेता है और उसी के अंदर नेटवर्क चलाता है, गेम की अपनी डेप्थ और मोशन वेक्टर के साथ।</sys:String>
  <sys:String x:Key="Str.InGame">गेम में</sys:String>
  <sys:String x:Key="Str.OptiStep1">गेम की ग्राफ़िक्स सेटिंग्स में DLSS, FSR या XeSS चालू करें।</sys:String>
  <sys:String x:Key="Str.OptiStep2">Insert दबाएँ, Neural टैब खोलें और Enable NR चालू करें।</sys:String>
  <sys:String x:Key="Str.OptiStep3">Ray Reconstruction चालू हो तो प्रोसेसिंग पॉइंट “After the finished frame” पर सेट करें।</sys:String>
  <sys:String x:Key="Str.InstallOpti">OptiScaler इंस्टॉल करें</sys:String>
  <sys:String x:Key="Str.Update">अपडेट करें</sys:String>
  <sys:String x:Key="Str.Reinstall">फिर से इंस्टॉल करें</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">OptiScaler पर जाएँ</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">ReShade पर जाएँ</sys:String>
  <sys:String x:Key="Str.SwitchTitle">{0} पर जाएँ?</sys:String>
  <sys:String x:Key="Str.SwitchBody">{0} में {1} रूट इंस्टॉल है, और दोनों एक ही फ़ोल्डर में एक साथ नहीं रह सकते। पहले {1} हटाया जाता है, जो कुछ उसने बदला था उसे वापस रखते हुए, और फिर {2} इंस्टॉल होता है।</sys:String>
  <sys:String x:Key="Str.SwitchYes">{0} हटाएँ, {1} इंस्टॉल करें</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">आपकी अपनी सेटिंग फ़ाइलें जहाँ हैं वहीं रहेंगी।</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">कुछ नहीं बदलता; {0} इंस्टॉल रहता है।</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">कारण “विवरण” में है। कुछ भी इंस्टॉल नहीं हुआ।</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">फ़ाइलें ब्राउज़र से भी डाउनलोड करके दी जा सकती हैं: “यह कंप्यूटर” &gt; “फ़ाइलें” &gt; “खुद डाउनलोड करें”, फिर “फ़ाइलें इम्पोर्ट करें”। आपके Downloads फ़ोल्डर की फ़ाइलें अपने-आप मिल जाती हैं।</sys:String>
  <sys:String x:Key="Str.DnsRetry">DNS साफ़ करें और फिर से कोशिश करें</sys:String>
  <sys:String x:Key="Str.GameRunning">{0} इस फ़ोल्डर से चल रहा है</sys:String>
  <sys:String x:Key="Str.CloseGame">{0} बंद करें</sys:String>
  <sys:String x:Key="Str.CloseGameAsk">{0} बंद करें? जो सहेजा नहीं गया वह खो जाएगा। इंस्टॉल और अनइंस्टॉल के लिए इसे बंद होना चाहिए: लोड की गई फ़ाइलें बदली नहीं जा सकतीं।</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows ने यहाँ से DNS कैश साफ़ नहीं करने दिया। कमांड प्रॉम्प्ट खोलें, ipconfig /flushdns चलाएँ, और फिर से कोशिश करें।</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">इस फ़ोल्डर में {0} समस्याएँ मिलीं</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">इंस्टॉल के लिए तैयार, पढ़ने के लिए {0} नोट के साथ</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">{0} पर इंस्टॉल हुआ, नीचे पढ़ने के लिए {1} चेतावनियों के साथ।</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">{0} से हटाया गया, नीचे पढ़ने के लिए {1} चेतावनियों के साथ।</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">नीचे {0} समस्याएँ दी गई हैं।</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">डाउनलोड सूची नहीं</sys:String>
  <sys:String x:Key="Str.FailedShort">विफल</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">सभी {0} तैयार</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">{0} नहीं मिले · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">डाउनलोड नहीं हो सका: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">खुद डाउनलोड करें</sys:String>
  <sys:String x:Key="Str.ImportFiles">फ़ाइलें इम्पोर्ट करें…</sys:String>
  <sys:String x:Key="Str.ImportHint">वह फ़ोल्डर चुनें जिसमें आपकी खुद डाउनलोड की गई फ़ाइलें हैं। हर फ़ाइल नाम से पहचानी जाती है और तभी ली जाती है जब वह अपने तय हैश से मेल खाए।</sys:String>
  <sys:String x:Key="Str.ManualTitle">फ़ाइलें खुद डाउनलोड करें</sys:String>
  <sys:String x:Key="Str.ManualBody">हर लिंक ब्राउज़र में खोलें और फ़ाइल कहीं भी सेव करें: Downloads फ़ोल्डर अपने-आप खोजा जाता है, और “फ़ाइलें इम्पोर्ट करें” कोई भी दूसरा फ़ोल्डर लेता है। नाम बदलने की ज़रूरत नहीं, और जो अपने तय SHA-256 से मेल नहीं खाता वह इस्तेमाल नहीं होता।</sys:String>
  <sys:String x:Key="Str.ImportPick">डाउनलोड की गई फ़ाइलों वाला फ़ोल्डर चुनें</sys:String>
  <sys:String x:Key="Str.ImportAll">हर फ़ाइल अब यहाँ है और जाँची हुई है।</sys:String>
  <sys:String x:Key="Str.ImportNothing">उस फ़ोल्डर में कुछ भी ज़रूरी फ़ाइल से मेल नहीं खाया।</sys:String>
  <sys:String x:Key="Str.ImportSome">लिया गया: {0}। अभी भी नहीं मिले: {1}।</sys:String>
  <sys:String x:Key="Str.Component.addon">ऐड-ऑन</sys:String>
  <sys:String x:Key="Str.Component.runtime">न्यूरल रनटाइम और वेट्स</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32-बिट ब्रिज</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32-बिट अतिरिक्त</sys:String>
  <sys:String x:Key="Str.Component.shader">साथी इफ़ेक्ट</sys:String>
  <sys:String x:Key="Str.Updates">अपडेट</sys:String>
  <sys:String x:Key="Str.UpToDate">अप टू डेट</sys:String>
  <sys:String x:Key="Str.UpdateChecking">नया वर्ज़न देखा जा रहा है…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0} सबसे नया वर्ज़न है। {1} बजे जाँचा गया।</sys:String>
  <sys:String x:Key="Str.UpdateOut">वर्ज़न {0} उपलब्ध है। आपके पास {1} है।</sys:String>
  <sys:String x:Key="Str.HotfixLabel">v{0} हॉटफ़िक्स {1}</sys:String>
  <sys:String x:Key="Str.HotfixShort">हॉटफ़िक्स {0}</sys:String>
  <sys:String x:Key="Str.HotfixOut">v{0} के लिए हॉटफ़िक्स {1} उपलब्ध है: इसी वर्ज़न के सुधार, कोई नया वर्ज़न नहीं।</sys:String>
  <sys:String x:Key="Str.UpdateFailed">जाँच नहीं हो सकी: GitHub ने जवाब नहीं दिया। ऐप दोनों तरह से वैसे ही काम करता है।</sys:String>
  <sys:String x:Key="Str.UpdateNow">अपडेट डाउनलोड करें</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">GitHub से डाउनलोड करें</sys:String>
  <sys:String x:Key="Str.UpdateCheck">अपडेट जाँचें</sys:String>
  <sys:String x:Key="Str.SessionSection">पिछला सेशन</sys:String>
  <sys:String x:Key="Str.SessionTip">ऐड-ऑन और रनटाइम जो लॉग गेम फ़ोल्डर में लिखते हैं, उनसे पढ़ा गया। खेलने के बाद इस विंडो पर लौटने पर फिर से पढ़ा जाता है।</sys:String>
  <sys:String x:Key="Str.SessionRan">पिछले सेशन में NR चला</sys:String>
  <sys:String x:Key="Str.SessionCrashed">पिछले सेशन में गेम क्रैश हुआ</sys:String>
  <sys:String x:Key="Str.SessionFailed">पिछले सेशन में NR शुरू नहीं हुआ</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade शुरू हुआ, लेकिन ऐड-ऑन लोड नहीं हुआ</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">मॉड लोड हुआ, लेकिन NR ने कोई फ़्रेम प्रोसेस नहीं किया</sys:String>
  <sys:String x:Key="Str.SessionNever">अभी कोई सेशन नहीं। गेम एक बार शुरू करें और लौटें: यहाँ दिखेगा कि NR चला या नहीं।</sys:String>
  <sys:String x:Key="Str.SessionFrames">प्रोसेस हुए फ़्रेम: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">नेटवर्क: {0} ms प्रति फ़्रेम</sys:String>
  <sys:String x:Key="Str.SessionRuntime">रनटाइम {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">गेम में Home से ReShade ओवरले खोलें और देखें कि AMD Neural Rendering पैनल में NR चालू है।</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">गेम में DLSS, FSR या XeSS चालू करें, फिर Insert दबाएँ, Neural टैब खोलें और Enable NR चालू करें।</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">गेम फ़ोल्डर का ReShade.log बताता है कि ReShade ने ऐड-ऑन किस फ़ोल्डर में खोजे। “समस्या रिपोर्ट करें” इसे बाकी के साथ पैक करता है।</sys:String>
  <sys:String x:Key="Str.SessionReportHint">“समस्या रिपोर्ट करें” इन लॉग को Discord पर साझा करने के लिए एक फ़ाइल में पैक करता है।</sys:String>
  <sys:String x:Key="Str.SortFilter">क्रम और फ़िल्टर</sys:String>
  <sys:String x:Key="Str.FilterShow">दिखाएँ</sys:String>
  <sys:String x:Key="Str.FilterAll">सभी गेम</sys:String>
  <sys:String x:Key="Str.FilterInstalled">इंस्टॉल किए हुए</sys:String>
  <sys:String x:Key="Str.FilterUpdates">अपडेट उपलब्ध</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">इंस्टॉल नहीं</sys:String>
  <sys:String x:Key="Str.FilterEmulators">एमुलेटर</sys:String>
  <sys:String x:Key="Str.SortBy">क्रम</sys:String>
  <sys:String x:Key="Str.SortName">नाम</sys:String>
  <sys:String x:Key="Str.SortRecent">हाल ही में खेले गए</sys:String>
  <sys:String x:Key="Str.SortAdded">हाल ही में जोड़े गए</sys:String>
  <sys:String x:Key="Str.FilterFavorites">पसंदीदा</sys:String>
  <sys:String x:Key="Str.SortPinnedFirst">पसंदीदा और इंस्टॉल किए गए पहले</sys:String>
  <sys:String x:Key="Str.Favorite">पसंदीदा</sys:String>
  <sys:String x:Key="Str.AddFavorite">पसंदीदा में जोड़ें</sys:String>
  <sys:String x:Key="Str.RemoveFavorite">पसंदीदा से हटाएँ</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">सूची का कोई गेम इस फ़िल्टर से मेल नहीं खाता।</sys:String>
  <sys:String x:Key="Str.WhatsNew">नया क्या है</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">GitHub पर खोलें</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">नोट्स GitHub से पढ़े नहीं जा सके। वे रिलीज़ पेज पर हैं।</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">यह रिलीज़ बिना नोट्स के प्रकाशित हुई।</sys:String>
  <sys:String x:Key="Str.Transfer">NR सेटिंग्स</sys:String>
  <sys:String x:Key="Str.TransferTip">इस गेम की NR सेटिंग्स एक फ़ाइल में, रखने या साझा करने के लिए, और किसी और की सेटिंग्स लाने का तरीका। पहले गेम बंद करें: वह बाहर निकलते समय अपनी सेटिंग्स सेव करता है।</sys:String>
  <sys:String x:Key="Str.TransferExport">फ़ाइल में एक्सपोर्ट करें…</sys:String>
  <sys:String x:Key="Str.TransferImport">फ़ाइल से इम्पोर्ट करें…</sys:String>
  <sys:String x:Key="Str.TransferNothing">अभी एक्सपोर्ट करने को कुछ नहीं: गेम पहली बार मॉड के साथ चलने पर सेटिंग्स लिखी जाती हैं।</sys:String>
  <sys:String x:Key="Str.TransferExported">सेटिंग्स {0} में सेव हुईं।</sys:String>
  <sys:String x:Key="Str.TransferImported">{0} की सेटिंग्स लागू हो गईं। जिन्हें उन्होंने बदला, वे {1} में रखी गईं।</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">ये सेटिंग्स {0} रूट के लिए हैं, और इस गेम में {1} इंस्टॉल है।</sys:String>
  <sys:String x:Key="Str.TransferInvalid">वह फ़ाइल AMD-NR सेटिंग्स का एक्सपोर्ट नहीं है।</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. गेम की properties में हर गेम की अलग सेटिंग पर ध्यान दें — यह चुपचाप ग्लोबल सेटिंग को बदल देती है, और यही सबसे आम वजह है कि सब ठीक होने पर भी यह खराब दिखता है।</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. यहाँ Direct3D है ही नहीं, इसलिए इस रूट को केवल रंग और अनुमानित मोशन मिलता है — डेप्थ नहीं।</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">यह D3D12 पर चलता है, जो सीमित रूट है: ऐड-ऑन को केवल तैयार फ़्रेम दिखता है और कुछ नहीं। यह काम करता है; इससे कम की उम्मीद रखें।</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Vulkan पर डेप्थ नहीं: केवल रंग और अनुमानित मोशन।</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Vulkan पर डेप्थ नहीं।</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. Vulkan पर डेप्थ नहीं।</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan डिफ़ॉल्ट बैकएंड है। Vulkan पर डेप्थ नहीं।</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">केवल Vulkan। Vulkan पर डेप्थ नहीं, और यह एमुलेटर खुद अभी शुरुआती दौर में है — दिक्कतों की उम्मीद रखें।</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">सिर्फ़ Vulkan। kyty_emulator.exe वाला फ़ोल्डर चुनें (launcher.exe सिर्फ़ उसे चलाता है)। डेप्थ नहीं है, और एमुलेटर खुद अभी शुरुआती है — दिक्कतों की उम्मीद रखें।</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">गेम में: Home से ReShade खुलता है, AMD Neural Rendering Add-ons में है, या Ctrl+End दबाएँ। FiveM का अपना एंटी-चीट है — पहले सर्वर के नियम देख लें।</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. अब OpenGL का भी रूट है, लेकिन यहाँ सबसे ज़्यादा परखा हुआ Vulkan है।</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu केवल OpenGL से रेंडर करता है, इसलिए यहाँ OpenGL रूट ही अकेला है। यह सबसे नया रूट है और प्रायोगिक है: रंग और अनुमानित मोशन, डेप्थ नहीं।</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. सॉफ़्टवेयर रेंडरर CPU पर बनाता है और वहाँ ऐड-ऑन के पहुँचने लायक कुछ नहीं है, इसलिए OpenGL वाला ही होना चाहिए — और वह रूट प्रायोगिक है: रंग और अनुमानित मोशन, डेप्थ नहीं।</sys:String>

</ResourceDictionary>
