  <sys:String x:Key="Str.Save">Speichern</sys:String>
  <sys:String x:Key="Str.Cancel">Abbrechen</sys:String>
  <sys:String x:Key="Str.ChangeCover">Cover</sys:String>
  <sys:String x:Key="Str.CoverPick">Bild auswählen…</sys:String>
  <sys:String x:Key="Str.CoverReset">Das online gefundene Cover verwenden</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Wähle ein Cover für dieses Spiel</sys:String>
  <sys:String x:Key="Str.CoverFiles">Bilder</sys:String>
  <sys:String x:Key="Str.CoverFailed">Diese Datei konnte nicht als Bild gelesen werden.</sys:String>
  <sys:String x:Key="Str.Customize">Anpassen</sys:String>
  <sys:String x:Key="Str.HeroPick">Banner auswählen…</sys:String>
  <sys:String x:Key="Str.HeroReset">Das online gefundene Banner verwenden</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Wähle ein Banner für dieses Spiel</sys:String>
  <sys:String x:Key="Str.PlayFailed">Konnte nicht gestartet werden. Nutze Ordner öffnen und starte die ausführbare Datei von Hand.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Emulator hinzufügen</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Einen Emulator hinzufügen</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Wähle, welchen, und zeig dann auf den Ordner, aus dem er startet: den mit der ausführbaren Datei, nicht den mit den ROMs.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Anderer Emulator</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Zeig auf den Ordner, und ich sage dir, was ich daraus erkennen kann.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Zeig auf den Ordner von {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Zeig auf den Ordner des Emulators</sys:String>
  <sys:String x:Key="Str.EmulatorFound">{0} gefunden: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Das sieht nicht nach {0} aus: kein {1} in diesem Ordner. Trotzdem hinzugefügt; prüfe den Pfad.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Darin ist kein Emulator, den ich kenne. Hinzugefügt nach dem, was die Dateien sagen: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">Im Emulator</sys:String>
  <sys:String x:Key="Str.ReportTitle">Funktioniert es im Spiel nicht?</sys:String>
  <sys:String x:Key="Str.ReportBody">Packt die Protokolle und die Dateiliste des Spielordners in eine .zip auf deinem PC. Es wird nichts gesendet.</sys:String>
  <sys:String x:Key="Str.Report">Problem melden</sys:String>
  <sys:String x:Key="Str.ReportSaved">Bericht gespeichert und Ordner geöffnet: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Der Bericht konnte nicht erstellt werden. Die Protokolle liegen in {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Wird gesammelt…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Dateien lassen sich nicht herunterladen?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Sammelt, was jeder Download versucht hat (jede Adresse, ihre Namensauflösung, Proxy und Antwort), und prüft jede Adresse jetzt erneut, alles in einer .zip. Es wird nichts gesendet: Die Datei bleibt auf deinem PC, damit du sie teilen kannst, wo du willst.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Download-Protokolle</sys:String>
  <sys:String x:Key="Str.Add">Hinzufügen</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Einen Ordner nach Spielen durchsuchen…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Den Ordner eines Spiels…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Einen Emulator…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Aktualisieren</sys:String>
  <sys:String x:Key="Str.GamesAway">{0} auf einem nicht verbundenen Laufwerk</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Spiele auf einem Laufwerk, das gerade nicht angeschlossen ist, bleiben gespeichert, mit allem, was für sie gewählt wurde, und kommen zurück, wenn das Laufwerk zurückkommt.</sys:String>
  <sys:String x:Key="Str.GameGone">{0} ist nicht mehr installiert und wurde daher aus der Liste entfernt.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} Spiel ist nicht mehr installiert und wurde daher aus der Liste entfernt.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} Spiele sind nicht mehr installiert und wurden daher aus der Liste entfernt.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Details anzeigen</sys:String>
  <sys:String x:Key="Str.DetectedSection">Erkannt</sys:String>
  <sys:String x:Key="Str.InstallsInto">Wird installiert in: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">Das liegt außerhalb des hinzugefügten Ordners: Dort ist {0}, der Build, den der Launcher startet. Spielst du einen anderen, wähle oben dessen {0}.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Dateien sagen, wogegen ein Spiel gelinkt ist, nicht, womit es läuft: Ein Ordner kann eine D3D11- und eine D3D12-ausführbare Datei enthalten. Das Wiki sagt, welche das Spiel nutzt.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Aus den eigenen Dateien des Spiels gelesen.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">Aus PCGamingWiki und den Dateien des Spiels.</sys:String>
  <sys:String x:Key="Str.InstallWith">Installieren mit</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + Add-on</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Empfohlen</sys:String>
  <sys:String x:Key="Str.RecommendedLower">empfohlen</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">Das Add-on in ReShade. D3D11, D3D12, Vulkan, OpenGL, 32-Bit-Spiele und Emulatoren.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Keine ReShade-Methode für das, als was dieses Spiel erkannt wird ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Läuft im DLSS, FSR oder XeSS des Spiels, mit dessen eigener Tiefe und Bewegung. Ersetzt ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Läuft im Upscaler des Spiels ({0} hier gefunden). Ersetzt ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Für 64-Bit-D3D12-Spiele gemacht; dieses wird als {0} erkannt.</sys:String>
  <sys:String x:Key="Str.RouteOptiSummaryAll">Läuft im DLSS, FSR oder XeSS des Spiels, wenn es eines hat, und sonst auf dem fertigen Bild. 64-Bit D3D9, D3D11, D3D12, Vulkan und OpenGL. Ersetzt ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfitAll">Gedacht für 64-Bit-Spiele mit D3D9, D3D11, D3D12, Vulkan und OpenGL; dieses wird als {0} erkannt.</sys:String>
  <sys:String x:Key="Str.ApiSection">Grafik-API</sys:String>
  <sys:String x:Key="Str.Group64">64-Bit-Spiele</sys:String>
  <sys:String x:Key="Str.Group32">32-Bit-Spiele (experimentell)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Emulatoren</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V online</sys:String>
  <sys:String x:Key="Str.OptiAbout">Statt ReShade wird OptiScaler installiert, das DLSS, FSR oder XeSS des Spiels übernimmt und das Netz darin ausführt, mit der eigenen Tiefe und den Bewegungsvektoren des Spiels.</sys:String>
  <sys:String x:Key="Str.InGame">Im Spiel</sys:String>
  <sys:String x:Key="Str.OptiStep1">Schalte DLSS, FSR oder XeSS in den Grafikeinstellungen des Spiels ein.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Drücke Einfg, öffne den Neural-Tab und schalte „Enable NR“ ein.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Mit eingeschalteter Ray Reconstruction stell den Verarbeitungspunkt auf „After the finished frame“.</sys:String>
  <sys:String x:Key="Str.InstallOpti">OptiScaler installieren</sys:String>
  <sys:String x:Key="Str.Update">Aktualisieren</sys:String>
  <sys:String x:Key="Str.Reinstall">Neu installieren</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Zu OptiScaler wechseln</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Zu ReShade wechseln</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Zu {0} wechseln?</sys:String>
  <sys:String x:Key="Str.SwitchBody">In {0} ist die Methode {1} installiert, und beide können nicht gleichzeitig in einem Ordner sein. Zuerst wird {1} entfernt, wobei alles, was es ersetzt hat, zurückgelegt wird, und dann wird {2} installiert.</sys:String>
  <sys:String x:Key="Str.SwitchYes">{0} entfernen, {1} installieren</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Deine eigenen Einstellungsdateien bleiben, wo sie sind.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Es wird nichts geändert; {0} bleibt installiert.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">Der Grund steht unter Details. Es wurde nichts installiert.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Die Dateien können auch mit einem Browser geholt und übergeben werden: Dieser PC &gt; Dateien &gt; Manuell herunterladen, dann Dateien importieren. Dateien in deinem Downloads-Ordner werden von selbst gefunden.</sys:String>
  <sys:String x:Key="Str.DnsRetry">DNS leeren und erneut versuchen</sys:String>
  <sys:String x:Key="Str.GameRunning">{0} läuft aus diesem Ordner</sys:String>
  <sys:String x:Key="Str.CloseGame">{0} schließen</sys:String>
  <sys:String x:Key="Str.CloseGameAsk">{0} beenden? Was nicht gespeichert ist, geht verloren. Installieren und Deinstallieren brauchen es geschlossen: geladene Dateien lassen sich nicht ersetzen.</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows ließ seinen DNS-Cache von hier aus nicht leeren. Öffne eine Eingabeaufforderung, führe ipconfig /flushdns aus und versuche es erneut.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">{0} Probleme in diesem Ordner gefunden</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Bereit zur Installation, mit {0} Hinweisen zum Lesen</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">In {0} installiert, mit {1} Warnungen, die du unten lesen solltest.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Aus {0} entfernt, mit {1} Warnungen, die du unten lesen solltest.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">{0} Probleme, unten aufgeführt.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Keine Downloadliste</sys:String>
  <sys:String x:Key="Str.FailedShort">Fehlgeschlagen</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Alle {0} bereit</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">Fehlend: {0} · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Konnte nicht heruntergeladen werden: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Manuell herunterladen</sys:String>
  <sys:String x:Key="Str.ImportFiles">Dateien importieren…</sys:String>
  <sys:String x:Key="Str.ImportHint">Wähle einen Ordner mit Dateien, die du selbst heruntergeladen hast. Jede wird an ihrem Namen erkannt und nur übernommen, wenn sie zu ihrem festgelegten Hash passt.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Die Dateien selbst herunterladen</sys:String>
  <sys:String x:Key="Str.ManualBody">Öffne jeden Link in einem Browser und speichere die Datei irgendwo: Der Downloads-Ordner wird von selbst durchsucht, und Dateien importieren nimmt jeden anderen Ordner. Umbenennen ist nicht nötig, und nichts, was nicht zu seinem festgelegten SHA-256 passt, wird verwendet.</sys:String>
  <sys:String x:Key="Str.ImportPick">Wähle den Ordner mit den heruntergeladenen Dateien</sys:String>
  <sys:String x:Key="Str.ImportAll">Alle Dateien sind jetzt da und geprüft.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Nichts in diesem Ordner passt zu einer benötigten Datei.</sys:String>
  <sys:String x:Key="Str.ImportSome">Übernommen: {0}. Fehlen noch: {1}.</sys:String>
