<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.German">

  <!-- Deutsch. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Neuronales Rendering von DLSS 5 auf Radeon, für dich installiert</sys:String>
  <sys:String x:Key="Str.Games">Spiele</sys:String>
  <sys:String x:Key="Str.RemoveGame">Aus der Liste entfernen</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Entfernt das Spiel aus der Liste, und Spiele suchen lässt es ebenfalls aus. Keine Datei in seinem Ordner wird angerührt; über die Einstellungen holst du es zurück.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} ist nicht mehr in der Liste, und Spiele suchen lässt es aus. In seinem Ordner wurde nichts angerührt; Einstellungen &gt; Ignorierte Spiele holt es zurück.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} ist nicht mehr in der Liste, aber das Add-on ist noch in seinem Ordner installiert. Hol es über Einstellungen &gt; Ignorierte Spiele zurück, um es zu deinstallieren.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Ignorierte Spiele</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Spiele, die du aus der Liste entfernt hast. Spiele suchen überspringt sie, sie bleiben also draußen, bis du sie hier zurückholst.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Keine ignorierten Spiele.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Zurück in die Liste</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} ist wieder in der Liste.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Der Ordner von {0} existiert nicht mehr, daher wurde es nur aus den ignorierten Spielen entfernt.</sys:String>
  <sys:String x:Key="Str.NoGames">Noch nichts hier. Füge den Ordner hinzu, aus dem ein Spiel oder Emulator startet.</sys:String>
  <sys:String x:Key="Str.PickFolder">Wähle den Ordner, aus dem das Spiel startet</sys:String>
  <sys:String x:Key="Str.AddGameMany">Einen Ordner durchsuchen</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Wähle den Ordner, in dem deine Spiele liegen</sys:String>
  <sys:String x:Key="Str.AddGameNone">In „{0}“ wurde nichts gefunden, das wie ein Spiel aussieht.</sys:String>
  <sys:String x:Key="Str.Preset">Methode</sys:String>
  <sys:String x:Key="Str.Install">Installieren</sys:String>
  <sys:String x:Key="Str.Uninstall">Deinstallieren</sys:String>
  <sys:String x:Key="Str.OpenFolder">Ordner öffnen</sys:String>
  <sys:String x:Key="Str.System">Dieser PC</sys:String>
  <sys:String x:Key="Str.Gpu">Grafik</sys:String>
  <sys:String x:Key="Str.Driver">Treiber</sys:String>
  <sys:String x:Key="Str.Hip">HIP-7-Runtime</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll wurde nicht gefunden. Bei RX 7000 und RX 9000 bringt ein aktueller Adrenalin-Treiber sie mit; RX-6000-Karten (RDNA2) brauchen AMDs HIP SDK 7.2. HIP 6 reicht nicht.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Das sieht nicht nach einer Radeon aus. Das Netz läuft nur auf RDNA2, RDNA3 und RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Bereit</sys:String>
  <sys:String x:Key="Str.Payloads">Dateien</sys:String>
  <sys:String x:Key="Str.Downloading">Wird heruntergeladen</sys:String>
  <sys:String x:Key="Str.Verifying">Vorhandenes wird geprüft…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Heruntergeladen und geprüft.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Die veröffentlichte Downloadliste konnte nicht gelesen werden, daher wird die Kopie verwendet, die mit dieser App kommt.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Die Downloadliste konnte nicht gelesen werden. Prüfe die Verbindung und versuche es erneut.</sys:String>
  <sys:String x:Key="Str.Language">Sprache</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Update wird heruntergeladen…</sys:String>
  <sys:String x:Key="Str.Dismiss">Nicht jetzt</sys:String>
  <sys:String x:Key="Str.LogSaved">Das vollständige Protokoll wurde neben dieser App gespeichert.</sys:String>
  <sys:String x:Key="Str.Working">Wird ausgeführt…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Die Spieleliste konnte nicht gelesen werden. Sie wurde als {0} daneben aufbewahrt, und eine neue Liste wurde angelegt.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Es wird noch in einen Spielordner geschrieben. Das dauert ein paar Sekunden; schließe das Fenster, wenn es fertig ist.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Das ist kostenlos. Wenn du dafür bezahlt hast, wurdest du betrogen.</sys:String>
  <sys:String x:Key="Str.FreeBody">Niemand verkauft irgendetwas davon: weder den Installer noch das Add-on, die Runtime oder die Gewichte. Wenn dir dafür Geld abgenommen wurde, oder für einen „Schlüssel“ oder eine „Pro-Version“, fordere dein Geld zurück: Was man dir verkauft hat, gibt es auf dieser Seite umsonst.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Es ist Open Source und bleibt es auch: Lies es, ändere es, bau deine eigene Version, gib es an Freunde weiter. Wir bitten nur um eines: dass niemand eine kostenpflichtige Version daraus macht.</sys:String>
  <sys:String x:Key="Str.SupportSection">Unterstützen</sys:String>
  <sys:String x:Key="Str.SupportNote">freiwillig, und du kaufst damit nichts</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Ein einmaliger Kaffee.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">Die brasilianische Spendenaktion des Projekts.</sys:String>
  <sys:String x:Key="Str.SupportRail">AMD-NR unterstützen</sys:String>
  <sys:String x:Key="Str.SupportTitle">Halte AMD-NR am Leben</sys:String>
  <sys:String x:Key="Str.SupportBody">Dieses Projekt lebt nur von der Unterstützung derer, die es nutzen. Es sind zwei Personen, zwei Grafikkarten und Nachmittage voller Arbeit: keine Firma, kein Sponsor. Alles hier ist kostenlos und bleibt es. Unterstützung schaltet nichts frei; sie hält die Arbeit am Laufen.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">In Brasilien? Die Vakinha nimmt Pix, Karte oder Boleto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD, von danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Das Netz selbst und der Grund, warum es all das überhaupt gibt: Damit lief das neuronale Rendering von DLSS 5 zum ersten Mal auf Radeon. Die Runtime und die Gewichte, die diese App herunterlädt, sind seine Arbeit, nicht unsere. Danke, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd, das Add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Das, was dieses Netz über ReShade mit einem Spiel verbindet: das Add-on, das diese App installiert, und die Versionen, zwischen denen du wählen kannst. MIT-lizenziert und ein eigenes Repository, getrennt von diesem Installer.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord, wo alle sind</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Neue Versionen, was in welchem Spiel funktioniert und wo du fragen kannst, wenn etwas nicht klappt.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Mitwirkende</sys:String>
  <sys:String x:Key="Str.Scan">Spiele suchen</sys:String>
  <sys:String x:Key="Str.Scanning">Steam, Epic, GOG, EA, Ubisoft, Battle.net und Xbox werden gelesen…</sys:String>
  <sys:String x:Key="Str.Search">Spiele durchsuchen…</sys:String>
  <sys:String x:Key="Str.Settings">Einstellungen</sys:String>
  <sys:String x:Key="Str.WillDownload">Die Dateien werden beim Installieren heruntergeladen und geprüft.</sys:String>
  <sys:String x:Key="Str.NoRoute">Für nichts, womit dieses Spiel rendert, gibt es eine Methode: Das Add-on funktioniert mit D3D11, D3D12, Vulkan und OpenGL, und bei 32-Bit-Spielen mit D3D8, D3D9 und D3D11. Ein 32-Bit-OpenGL-Spiel, ein 64-Bit-D3D9-Spiel und ein Software-Renderer haben keine.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Dieses Spiel kann mit {1} laufen. Stell es in seinen eigenen Grafikeinstellungen auf {0}: Das ist die hier gewählte Methode, und mit einer anderen API sieht das Add-on ein anderes Spiel.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Das ist ein Unreal-Spiel: Füge -{0} zu seinen Startoptionen hinzu.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Dieses Spiel auf PCGamingWiki nachschlagen</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Noch keine Spiele</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Keine Treffer</sys:String>
  <sys:String x:Key="Str.NoMatch">Kein Spiel in der Liste passt zu „{0}“.</sys:String>
  <sys:String x:Key="Str.ScanningShort">Suche läuft…</sys:String>
  <sys:String x:Key="Str.ScanDone">Suche abgeschlossen: {0} Spiele gefunden, {1} neu.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Installiert</sys:String>
  <sys:String x:Key="Str.Close">Schließen</sys:String>
  <sys:String x:Key="Str.CloseHint">Schließen (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">Die ausführbare Datei des Spiels</sys:String>
  <sys:String x:Key="Str.ExeChoose">Auswählen…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Die erkannte verwenden</sys:String>
  <sys:String x:Key="Str.ExeNone">In diesem Ordner wurde keine ausführbare Datei gefunden.</sys:String>
  <sys:String x:Key="Str.ExeNote">Die Methode wird aus dieser Datei abgeleitet. Wenn die Bitbreite falsch aussieht (ein Launcher im Hauptordner, das Spiel in Bin64), wähle die richtige .exe.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Du hast diese Datei gewählt, deshalb lässt die Erkennung sie in Ruhe, auch nach einer neuen Suche.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Diese Datei liegt nicht im Ordner dieses Spiels.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Diese Datei ist keine lesbare ausführbare Windows-Datei.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Diese Methode ist für {0}-Spiele, und die ausführbare Datei oben ist {1}. Nichts hindert dich daran (vielleicht hat die Erkennung die falsche Datei gelesen), aber wenn sie die richtige gelesen hat, wird das nicht laden.</sys:String>
  <sys:String x:Key="Str.VersionSection">Add-on-Version</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade lädt als</sys:String>
  <sys:String x:Key="Str.ProxyNote">Automatisch verwendet dxgi.dll, das für jedes Direct3D taugt. Ändere es nur, wenn das Spiel sich weigert, es zu laden.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler lädt als</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">„Automatisch“ nimmt den ersten Namen, den das OptiScaler-Wiki für dieses Spiel nennt, sonst den hier bereits verwendeten, sonst dxgi.dll. Wähle winmm.dll, um die dxgi.dll eines anderen Programms zu behalten.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatisch</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatisch (Wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Jetzt alles herunterladen</sys:String>
  <sys:String x:Key="Str.ClearCache">Cache leeren</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Löscht die heruntergeladenen Dateien, die Cover und die Versionsliste. Nichts, was in einem Spiel installiert ist, wird angerührt; die nächste Installation lädt herunter, was sie braucht.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Leeren</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Alles darin wird bei der nächsten Installation erneut heruntergeladen.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Den Cache so lassen, wie er ist.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Cache geleert: {0} freigegeben.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Alles war schon da, und jedes Byte wurde gerade geprüft.</sys:String>
  <sys:String x:Key="Str.VersionShipped">mitgeliefert</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">Die Version, mit der dieser Installer veröffentlicht wurde.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Aus dem Release v{0} auf GitHub, anhand seiner Hashes geprüft.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler-Version</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, aus seinem GitHub-Release, jede Datei anhand ihres Hashs geprüft.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Enthält die Gewichte von lmxxf (etwa 590 MB, nur RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Kann auch mochizuki mitbringen: siehe NR-Runtime.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR-Runtime</sys:String>
  <sys:String x:Key="Str.DanielVersion">danielblnc-Version</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">Empfohlen</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">Instabil</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">Welche Version von danielblncs Runtime in dieses Spiel kommt. Auf RX-9000-Karten ist 0.4.3 empfohlen: Die neueren haben dort Spiele einfrieren lassen. Andere Karten erhalten die neueste.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: mochizuki (mochizuki0323s Vulkan-Port, etwa 141 MB) wird mit installiert und führt das Netz aus. danielblncs Runtime bleibt daneben: wähle sie unter NR runtime im Panel des Add-ons. Der erste Start jedes Spiels kompiliert das Netz bis zu einer Minute lang.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: Eine neue Installation führt lmxxf aus, und mochizuki (etwa 141 MB) kommt neben danielblncs Runtime. Wähle unter NR runtime im Neural-Tab von OptiScaler eine andere und starte das Spiel neu.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Wähle eine Installationsmethode</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Diese App konnte nicht erkennen, mit welcher Grafik-API {0} rendert, deshalb wählt sie keine Methode für dich. OptiScaler ist die richtige für ein D3D12-Spiel, das DLSS, FSR oder XeSS in seinen Einstellungen anbietet; ReShade, auf D3D11 oder D3D12, ist die richtige für alle anderen. Installieren wartet, bis du wählst.</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">Diese App konnte nicht erkennen, mit welcher Grafik-API {0} läuft, und wählt daher keinen Weg für dich. OptiScaler läuft in 64-Bit-Spielen mit D3D9, D3D11, D3D12, Vulkan und OpenGL, im DLSS, FSR oder XeSS des Spiels, wenn es eines hat; ReShade deckt zusätzlich 32-Bit-Spiele, Emulatoren und D3D10 ab. Die Installation wartet, bis du wählst.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">Die Grafik-API ist unbekannt, daher wählst du die Methode unten selbst.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">Runtime von danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Welche Runtime-Version in dieses Spiel kommt. Die hervorgehobene Karte ist die verwendete.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Von dieser App heruntergeladen und geprüft.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Meine version.dll oder mein Setup auswählen…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Andere Datei auswählen…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Neuer als die Public Release, aus deiner eigenen version.dll oder dem Setup von danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 bringt Kernels für RDNA3-Karten.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 unterstützt RX-6000-Karten (RDNA2), die die HIP-SDK-7.2-Laufzeit von AMD brauchen, und behebt das Flackern in dunklen Bereichen und bei kleinen Lichtern.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Wird von dieser App nie heruntergeladen oder weitergegeben. Deine Datei wird per SHA-256 geprüft und aufbewahrt, damit andere Spiele nicht erneut danach fragen.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Meine Supporter-Dateien verwenden…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Deine version.dll oder dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Beliebige DLL oder Setup</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">In Verwendung: die Runtime, die diese App herunterlädt.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Verwendet {0} aus deiner Datei.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Verwendet {0}: die geprüfte Kopie, die diese App aufbewahrt hat, als du sie zuvor gewählt hast.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">{0} ist gewählt, aber auf diesem PC gibt es noch keine Kopie davon: Wähle deine version.dll oder dein Setup.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} braucht das Add-on v{1} oder neuer: Wähle eines unter Add-on-Version. Bis dahin wird der Download installiert.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} braucht OptiScaler {1} oder neuer: Wähle eines unter OptiScaler-Version. Bis dahin wird der Download installiert.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">Das Add-on kann {0} noch nicht ausführen: Die Downloadliste enthält den Patch dafür nicht. Bis dahin wird hier der Download installiert; die OptiScaler-Methode führt sie unverändert aus.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Geprüft und aufbewahrt: Runtime {0} von danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Diese Datei kann nicht verwendet werden. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Dieser Ordner wird geprüft…</sys:String>
  <sys:String x:Key="Str.StepDownload">Herunterladen</sys:String>
  <sys:String x:Key="Str.StepVerify">Prüfen</sys:String>
  <sys:String x:Key="Str.StepInstall">Installieren</sys:String>
  <sys:String x:Key="Str.StepDone">Fertig</sys:String>
  <sys:String x:Key="Str.Installing">Wird installiert…</sys:String>
  <sys:String x:Key="Str.Removing">Wird entfernt…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} ist eingerichtet. Starte das Spiel, um es zu nutzen.</sys:String>
  <sys:String x:Key="Str.InstallWarn">In {0} installiert, mit {1} Warnung, die du unten lesen solltest.</sys:String>
  <sys:String x:Key="Str.InstallFail">Die Installation in {0} wurde nicht abgeschlossen.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Aus {0} entfernt.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Aus {0} entfernt, mit {1} Warnung, die du unten lesen solltest.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Es konnte nicht alles aus {0} entfernt werden.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} gilt weiterhin als installiert: Eine Datei dieser App konnte nicht entfernt werden. Schließe das Spiel und deinstalliere erneut.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Aus {0} entfernt: Von dieser App ist nichts mehr in seinem Ordner.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Aus {0} entfernt: Nur deine Einstellungen sind geblieben: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Auch deine Einstellungen entfernen?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Alles, was diese App in {0} installiert hat, ist weg. Diese Einstellungsdateien sind geblieben; sie enthalten, was im Overlay eingestellt wurde:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Auch diese entfernen</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">Der Ordner wird wieder so, wie er vor der Installation war.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Meine Einstellungen behalten</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Sie bleiben für die nächste Installation.</sys:String>
  <sys:String x:Key="Str.ResultErrors">{0} Problem, unten aufgeführt.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Die Dateien konnten nicht heruntergeladen werden, daher wurde nichts installiert.</sys:String>
  <sys:String x:Key="Str.Folder">Ordner</sys:String>
  <sys:String x:Key="Str.GameCount">{0} Spiele</sys:String>
  <sys:String x:Key="Str.UnknownApi">Unbekannte API</sys:String>
  <sys:String x:Key="Str.Location">Speicherort</sys:String>
  <sys:String x:Key="Str.Details">Details</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} Zeilen</sys:String>
  <sys:String x:Key="Str.PreflightOk">Bereit zur Installation</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Nichts steht im Weg. Wähle unten eine Methode und klicke auf Installieren.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Bereit zur Installation, mit {0} Hinweis zum Lesen</sys:String>
  <sys:String x:Key="Str.PreflightErr">{0} Problem in diesem Ordner gefunden</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">In diesem Spiel installiert</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Starte das Spiel, um es zu nutzen. Installiere erneut, um die Dateien aufzufrischen, oder deinstalliere, um sie zu entfernen.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Installiert, und ein Update ist verfügbar</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Die Dateien in diesem Spiel sind älter als die, die diese App jetzt installiert. Aktualisieren ersetzt sie; deine Einstellungen bleiben.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Öffne unten Details, um zu sehen, was gefunden wurde.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Was das Add-on von diesem PC braucht, geprüft beim Start der App.</sys:String>
  <sys:String x:Key="Str.SystemReady">Dieser PC hat, was das Add-on braucht</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Diesem PC fehlt etwas, das das Add-on braucht</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon erkannt</sys:String>
  <sys:String x:Key="Str.GpuBad">Keine Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Fehlt</sys:String>
  <sys:String x:Key="Str.DriverHint">Die Version, die Windows für den Grafiktreiber meldet.</sys:String>
  <sys:String x:Key="Str.FilesHint">Einmal heruntergeladen, anhand eines festgelegten Hashs geprüft und für jedes Spiel wiederverwendet.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Geprüft</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Nicht heruntergeladen</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Wird heruntergeladen…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Wird heruntergeladen: {0} %</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Sprache, Updates und Infos zu dieser App.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Alle Texte wechseln sofort, ohne Neustart.</sys:String>
  <sys:String x:Key="Str.DataFolder">Datenordner</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D10/D3D11-Spiel</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12-Spiel</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan-Spiel</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL-Spiel</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D10/D3D11-Spiel, 32 Bit</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9-Spiel, 32 Bit</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8-Spiel, 32 Bit</sys:String>
  <sys:String x:Key="Str.Preset.X86OpenGL">OpenGL-Spiel, 32 Bit</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: D3D12-Spiel mit DLSS, FSR oder XeSS</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Stell den Emulator auf Direct3D 11: Mit diesem Renderer bekommt das Netz am meisten, die Tiefe des Emulators und die Bewegung aus dem Begleiteffekt, wenn er installiert ist. Achte auf spielspezifische Einstellungen, die die globale Einstellung stillschweigend überschreiben.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Experimentell. Unter Vulkan ist ReShade ein Layer, keine Proxy-DLL: Die Installation registriert ihn für deinen Windows-Benutzer und aktiviert ihn für rpcs3.exe mit einer ReShade.ini. Keine Tiefe unter Vulkan, nur Farbe und geschätzte Bewegung.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">Die beste Methode: D3D11 ist die einzige, bei der die eigenen Bewegungsvektoren des Spiels zusammen mit seiner Tiefe beim Netz ankommen. Ein D3D10-Spiel nutzt diese Methode auch, nur mit Farbe.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Eingeschränkt. Unter D3D12 findet das Add-on die Tiefe des Spiels, aber nicht seine Bewegungsvektoren, daher bekommt das Netz Farbe und Tiefe und schätzt die Bewegung. Es funktioniert; erwarte weniger davon. Ein Spiel mit DLSS, FSR oder XeSS in seinen Einstellungen ist mit der OptiScaler-Methode besser bedient.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Empfohlen für D3D12-Spiele. Statt ReShade wird OptiScaler installiert, das DLSS, FSR oder XeSS des Spiels übernimmt und das Netz darin ausführt, mit der eigenen Tiefe und den Bewegungsvektoren des Spiels. Das Spiel muss einen dieser Upscaler anbieten, in seinen Einstellungen eingeschaltet. Drücke im Spiel Einfg, öffne den Neural-Tab und schalte „Enable NR“ ein; ein Spiel mit Ray Reconstruction braucht „After the finished frame“ als Verarbeitungspunkt.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Experimentell. Unter Vulkan ist ReShade ein Layer: Die Installation registriert ihn für deinen Windows-Benutzer und aktiviert ihn für dieses Programm mit einer ReShade.ini neben seiner .exe. Unter Vulkan gibt es keine Tiefe.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Experimentell. Anders als bei Vulkan ist das hier eine gewöhnliche Proxy-DLL: ReShade kommt als opengl32.dll neben das Spiel, ohne separates Setup. Nur Farbe und geschätzte Bewegung; die Tiefe des Spiels ist über diese API erreichbar, aber noch nicht angebunden. Ein 32-Bit-OpenGL-Spiel nutzt die 32-Bit-OpenGL-Methode.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Experimentell. Ein 32-Bit-Spiel kann die 64-Bit-Runtime nicht laden, daher läuft das Add-on als Paar, das Bilder auf einem Adapter teilt. Installiere ReShade mit Add-on-Unterstützung als 32-Bit-dxgi.dll. Ein D3D10-Spiel nutzt diese Methode auch, nur mit Farbe.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Experimentell. Dasselbe 32-Bit-Paar wie bei D3D11, über eine private D3D9/D3D11-Stufe. Normales D3D9 kostet pro Bild ein paar feste Millisekunden; D3D9Ex nicht. Installiere ReShade als 32-Bit-d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Experimentell. D3D8 wird in D3D9 übersetzt und nimmt dann die D3D9-Methode oben, mit demselben 32-Bit-Paar. Installiere ReShade als 32-Bit-d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86OpenGL">Experimentell. Dasselbe 32-Bit-Paar, im OpenGL-Kontext des Spiels: nur Farbe und geschätzte Bewegung. ReShade als 32-Bit-opengl32.dll installieren.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM hat einen eigenen Anti-Cheat: auf eigenes Risiko, und prüfe die Regeln deines Servers. Das Add-on und ReShade kommen nach FiveM.app\plugins, Runtime und Gewichte neben den Spielprozess in data\cache\subprocess. Was du schon in plugins hast — ReShade.ini, Presets, Shader, andere Add-ons, ENB — bleibt, wie es ist.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Willkommen</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Das Netz von DLSS 5 Neural Rendering auf Radeon-Karten, über ReShade oder OptiScaler. Vier kurze Schritte.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Dieser PC</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Dateien</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Deine Spiele</sys:String>
  <sys:String x:Key="Str.SetupBack">Zurück</sys:String>
  <sys:String x:Key="Str.SetupNext">Weiter</sys:String>
  <sys:String x:Key="Str.SetupFinish">Loslegen</sys:String>
  <sys:String x:Key="Str.SetupSkip">Vorerst überspringen</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Schritt {0} von {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Zwei Dinge verhindern, dass das Add-on läuft, und beide sind von hier aus sichtbar. Keines davon hindert dich am Weitermachen, nur daran, dass es im Spiel funktioniert.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Dieser PC hat alles, was das Add-on braucht.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Etwas fehlt. Du kannst weitermachen und es später beheben, aber im Spiel funktioniert es erst, wenn du das getan hast.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Dieselben Dateien dienen jedem Spiel: einmal heruntergeladen, anhand eines festgelegten Hashs geprüft und wiederverwendet.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Erneut versuchen</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Überspringst du das, werden sie bei der ersten Installation heruntergeladen.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">Das Lesen der Launcher ist rein lesend: Durch das Nachsehen wird nichts installiert oder geändert. Ordner kannst du danach von Hand hinzufügen.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Jedes Spiel wird analysiert, um herauszufinden, welche Grafik-API es nutzt, und das stimmt meistens, aber nicht immer: Ein Ordner kann eine D3D11- und eine D3D12-ausführbare Datei enthalten, und ein Spiel kann standardmäßig eine API nutzen, während seine ausführbare Datei auch eine ältere unterstützt. Vor dem Installieren lohnt es sich, das Spiel auf pcgamingwiki.com nachzuschlagen; jede Spielkarte hat einen direkten Link dorthin.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Keine Spiele gefunden. Im Hauptfenster kannst du einen Ordner von Hand hinzufügen.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">{0} Spiele gefunden.</sys:String>
  <sys:String x:Key="Str.Unexpected">Etwas Unerwartetes ist passiert. Das vollständige Protokoll wurde gespeichert.</sys:String>
  <sys:String x:Key="Str.Play">Spielen</sys:String>
  <sys:String x:Key="Str.Launch">Öffnen</sys:String>
  <sys:String x:Key="Str.Configure">Einrichten</sys:String>
  <sys:String x:Key="Str.ViewGrid">Raster mit Covern</sys:String>
  <sys:String x:Key="Str.ViewList">Liste, mit der Seite des Spiels daneben</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Automatisch aktualisieren</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Wenn eine neuere Version erscheint, wird dieses Spiel beim Öffnen der App von selbst aktualisiert.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">{0} Spiel automatisch aktualisiert.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">{0} Spiele automatisch aktualisiert.</sys:String>
