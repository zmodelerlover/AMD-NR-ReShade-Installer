<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Spanish">

  <!-- Español. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Renderizado neuronal de DLSS 5 en Radeon, instalado por ti</sys:String>
  <sys:String x:Key="Str.Games">Juegos</sys:String>
  <sys:String x:Key="Str.RemoveGame">Quitar de la lista</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Quita el juego de la lista, y Buscar juegos también lo deja fuera. No se toca ningún archivo de su carpeta; lo recuperas desde Configuración.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} salió de la lista y Buscar juegos lo dejará fuera. No se tocó nada en su carpeta; Configuración &gt; Juegos ignorados lo recupera.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} salió de la lista, pero el add-on sigue instalado en su carpeta. Recupéralo en Configuración &gt; Juegos ignorados para desinstalarlo.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Juegos ignorados</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Juegos que quitaste de la lista. Buscar juegos los pasa por alto, así que quedan fuera hasta que los recuperes aquí.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">No hay juegos ignorados.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Volver a la lista</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">{0} volvió a la lista.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">La carpeta de {0} ya no existe, así que solo salió de los juegos ignorados.</sys:String>
  <sys:String x:Key="Str.NoGames">Todavía no hay nada. Añade la carpeta desde la que se ejecuta un juego o un emulador.</sys:String>
  <sys:String x:Key="Str.PickFolder">Elige la carpeta desde la que se ejecuta el juego</sys:String>
  <sys:String x:Key="Str.AddGameMany">Buscar en una carpeta</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Elige la carpeta donde guardas tus juegos</sys:String>
  <sys:String x:Key="Str.AddGameNone">No se encontró nada que parezca un juego en "{0}".</sys:String>
  <sys:String x:Key="Str.Preset">Método</sys:String>
  <sys:String x:Key="Str.Install">Instalar</sys:String>
  <sys:String x:Key="Str.Uninstall">Desinstalar</sys:String>
  <sys:String x:Key="Str.OpenFolder">Abrir carpeta</sys:String>
  <sys:String x:Key="Str.System">Este equipo</sys:String>
  <sys:String x:Key="Str.Gpu">Gráficos</sys:String>
  <sys:String x:Key="Str.Driver">Controlador</sys:String>
  <sys:String x:Key="Str.Hip">Runtime HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">No se encontró amdhip64_7.dll. Un controlador Adrenalin actual lo incluye; HIP 6 no sirve.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Esto no parece una Radeon. La red solo funciona en RDNA3 y RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Listo</sys:String>
  <sys:String x:Key="Str.Payloads">Archivos</sys:String>
  <sys:String x:Key="Str.Downloading">Descargando</sys:String>
  <sys:String x:Key="Str.Verifying">Verificando lo que ya está aquí…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Descargado y verificado.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">No se pudo leer la lista de descargas publicada, así que se usa la copia que viene con esta app.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">No se pudo leer la lista de descargas. Revisa la conexión e inténtalo de nuevo.</sys:String>
  <sys:String x:Key="Str.Language">Idioma</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Descargando la actualización…</sys:String>
  <sys:String x:Key="Str.Dismiss">Ahora no</sys:String>
  <sys:String x:Key="Str.LogSaved">El registro completo se guardó junto a esta app.</sys:String>
  <sys:String x:Key="Str.Working">Trabajando…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">No se pudo leer la lista de juegos. Se guardó como {0} a su lado y se empezó una lista nueva.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Todavía se está escribiendo en la carpeta de un juego. Tarda unos segundos; cierra la ventana cuando termine.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Esto es gratis. Si pagaste por ello, te estafaron.</sys:String>
  <sys:String x:Key="Str.FreeBody">Nadie vende nada de esto: ni el instalador, ni el add-on, ni el runtime, ni los pesos. Si te cobraron por ello, o por una "clave" o una "versión pro", pide que te devuelvan el dinero: lo que te vendieron está en esta página gratis.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Es de código abierto y lo seguirá siendo: léelo, modifícalo, compila tu propia versión, pásaselo a tus amigos. Lo único que pedimos es que nadie lo convierta en una versión de pago.</sys:String>
  <sys:String x:Key="Str.SupportSection">Apoyo</sys:String>
  <sys:String x:Key="Str.SupportNote">opcional, y no compra nada</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Un café, una sola vez.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">La colecta brasileña del proyecto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD, de danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">La red en sí, y la razón de que todo esto exista: es lo que consiguió que el renderizado neuronal de DLSS 5 funcionara en Radeon. El runtime y los pesos que descarga esta app son trabajo suyo, no nuestro. Gracias, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd, el add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Lo que conecta esa red a un juego a través de ReShade: el add-on que instala esta app y las versiones entre las que te deja elegir. Con licencia MIT, y en un repositorio distinto al de este instalador.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord, donde está todo el mundo</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Versiones nuevas, qué funciona en cada juego y dónde preguntar cuando algo falla.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Créditos</sys:String>
  <sys:String x:Key="Str.Scan">Buscar juegos</sys:String>
  <sys:String x:Key="Str.Scanning">Leyendo Steam, Epic, GOG, EA, Ubisoft, Battle.net y Xbox…</sys:String>
  <sys:String x:Key="Str.Search">Buscar juegos…</sys:String>
  <sys:String x:Key="Str.Settings">Configuración</sys:String>
  <sys:String x:Key="Str.WillDownload">Los archivos se descargan y verifican al instalar.</sys:String>
  <sys:String x:Key="Str.NoRoute">Nada de lo que usa este juego para renderizar tiene un método: el add-on funciona en D3D11, D3D12, Vulkan y OpenGL, y en D3D8, D3D9 y D3D11 para juegos de 32 bits. Un juego OpenGL de 32 bits, uno D3D9 de 64 bits y un renderizador por software no tienen ninguno.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Este juego puede ejecutarse en {1}. Cámbialo a {0} en sus propias opciones gráficas: ese es el método elegido aquí, y con otra API el add-on ve un juego distinto.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Es un juego de Unreal: añade -{0} a sus opciones de inicio.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Buscar este juego en PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Todavía no hay juegos</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Sin resultados</sys:String>
  <sys:String x:Key="Str.NoMatch">Ningún juego de la lista coincide con "{0}".</sys:String>
  <sys:String x:Key="Str.ScanningShort">Buscando…</sys:String>
  <sys:String x:Key="Str.ScanDone">Búsqueda terminada: {0} juegos encontrados, {1} nuevos.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Instalado</sys:String>
  <sys:String x:Key="Str.Close">Cerrar</sys:String>
  <sys:String x:Key="Str.CloseHint">Cerrar (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">El ejecutable del juego</sys:String>
  <sys:String x:Key="Str.ExeChoose">Elegir…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Usar el detectado</sys:String>
  <sys:String x:Key="Str.ExeNone">No se encontró ningún ejecutable en esta carpeta.</sys:String>
  <sys:String x:Key="Str.ExeNote">El método se deduce de este archivo. Si la arquitectura parece incorrecta (un lanzador en la raíz y el juego en Bin64), elige el .exe correcto.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Elegiste este archivo, así que la detección no lo cambia, ni siquiera tras una nueva búsqueda.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Ese archivo no está dentro de la carpeta de este juego.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Ese archivo no es un ejecutable de Windows que se pueda leer.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Este método es para juegos {0} y el ejecutable de arriba es {1}. Nada te lo impide (puede que la detección leyera el archivo equivocado), pero si leyó el correcto, esto no cargará.</sys:String>
  <sys:String x:Key="Str.VersionSection">Versión del add-on</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade se carga como</sys:String>
  <sys:String x:Key="Str.ProxyNote">Automático usa dxgi.dll, que sirve para todo Direct3D. Cámbialo solo si el juego se niega a cargarlo.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler se carga como</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">«Automático» usa el primer nombre que la wiki de OptiScaler indica para este juego; si no hay, el que ya se usa aquí; y si tampoco, dxgi.dll. Elige winmm.dll para conservar el dxgi.dll de otro programa.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automático</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automático (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Descargar todo ahora</sys:String>
  <sys:String x:Key="Str.ClearCache">Vaciar la caché</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Borra los archivos descargados, las portadas y la lista de versiones. No se toca nada instalado en un juego; la próxima instalación vuelve a descargar lo que necesite.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Vaciarla</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Todo lo que contiene se volverá a descargar la próxima vez que instales.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Dejar la caché como está.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Caché vaciada: {0} liberados.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Todo ya estaba aquí, y cada byte se acaba de verificar.</sys:String>
  <sys:String x:Key="Str.VersionShipped">incluida</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">La versión con la que se publicó este instalador.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">De la versión v{0} en GitHub, verificada con sus hashes.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Versión de OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, de su versión en GitHub, con cada archivo verificado por su hash.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Incluye los pesos de lmxxf (unos 590 MB, solo RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">También puede incluir mochizuki: consulta Runtime de NR.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">Runtime de NR</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">Instalar también mochizuki, como segundo runtime de NR (experimental)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">La red de DLSS 5 portada a Vulkan por mochizuki0323. Solo RDNA4: serie RX 9000, controlador AMD 25.10 o posterior. Añade MochizukiNrRuntime.dll y una carpeta dlssnr-amd con su modelo, unos 141 MB de descarga. danielblnc sigue siendo el runtime de NR: para usar mochizuki, elígelo en "NR runtime" en la pestaña Neural de OptiScaler y reinicia el juego. El primer arranque en cada juego compila la red durante unos segundos. Si lo desmarcas, la próxima instalación quita lo que esta app puso de él.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">Instalar también mochizuki, como segundo runtime de NR (experimental)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">La red de DLSS 5 portada a Vulkan por mochizuki0323, que el add-on puede usar en lugar de la de danielblnc desde la v0.6.8. Solo RDNA4: serie RX 9000, controlador AMD 25.10 o posterior. Añade MochizukiNrRuntime.dll y una carpeta dlssnr-amd con su modelo, unos 141 MB de descarga. Para usarlo, elige mochizuki (Vulkan) en "NR runtime" en el panel del add-on y reinicia el juego. El primer arranque en cada juego compila la red durante hasta un minuto. Si lo desmarcas, la próxima instalación quita lo que esta app puso de él.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">No disponible en esta tarjeta ({0}): mochizuki necesita las instrucciones de matrices FP8 de RDNA4, la serie RX 9000.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">Esta app no pudo saber qué tarjeta es esta; en cualquier tarjeta que no sea de la serie RX 9000, mochizuki queda desactivado en el juego.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Elige un método de instalación</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Esta app no pudo saber con qué API gráfica renderiza {0}, así que no elige un método por ti. OptiScaler es el indicado para un juego D3D12 que ofrece DLSS, FSR o XeSS en sus opciones; ReShade, en D3D11 o D3D12, es el indicado para cualquier otro. Instalar espera hasta que elijas.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">La API gráfica es desconocida, así que el método lo eliges tú abajo.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">Runtime de danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Qué versión del runtime entra en este juego. La tarjeta resaltada es la que se usa.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Public Release ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Descargada y verificada por esta app.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Local Supporter Build ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Elegir mi version.dll o instalador…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Elegir otro archivo…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Más nueva que la Public Release, desde tu propio version.dll o el instalador de danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">La 0.5.0 añade kernels para tarjetas RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Esta app nunca la descarga ni la comparte. Tu archivo se verifica por SHA-256 y se guarda, para que otros juegos no lo vuelvan a pedir.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Usar mis archivos de supporter…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Public Release</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Tu version.dll o dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Cualquier DLL o instalador</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">En uso: el runtime que descarga esta app.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Usando la {0} de tu archivo.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Usando la {0}: la copia verificada que esta app guardó cuando la elegiste antes.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">La {0} está elegida, pero todavía no hay una copia en este equipo: elige tu version.dll o instalador.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">La {0} necesita el add-on v{1} o posterior: elige uno en Versión del add-on. Hasta entonces se instala la descarga.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">La {0} necesita OptiScaler {1} o posterior: elige uno en Versión de OptiScaler. Hasta entonces se instala la descarga.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">El add-on todavía no puede usar la {0}: la lista de descargas no incluye su parche. Hasta que lo incluya, aquí se instala la descarga; el método OptiScaler la usa tal cual.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Verificado y guardado: runtime {0} de danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Ese archivo no sirve. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Revisando esta carpeta…</sys:String>
