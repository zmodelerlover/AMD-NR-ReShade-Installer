  <sys:String x:Key="Str.InstallWarn">Instalado en {0}, con {1} advertencia para leer abajo.</sys:String>
  <sys:String x:Key="Str.InstallFail">La instalación en {0} no terminó.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Quitado de {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Quitado de {0}, con {1} advertencia para leer abajo.</sys:String>
  <sys:String x:Key="Str.UninstallFail">No se pudo quitar todo de {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} sigue contando como instalado: no se pudo quitar un archivo de esta app. Cierra el juego y desinstala de nuevo.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Quitado de {0}: no queda nada de esta app en su carpeta.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Quitado de {0}: solo se quedaron tus ajustes: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">¿Quitar también tus ajustes?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Todo lo que esta app instaló en {0} ya no está. Estos archivos de ajustes se quedaron; guardan lo que configuraste en el overlay:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Quitarlos también</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">La carpeta vuelve a quedar como antes de la instalación.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Conservar mis ajustes</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Se quedan para la próxima vez que instales.</sys:String>
