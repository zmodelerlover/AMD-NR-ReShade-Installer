  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">Puente de 32 bits</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">Extras de 32 bits</sys:String>
  <sys:String x:Key="Str.Component.shader">Efecto complementario</sys:String>
  <sys:String x:Key="Str.Updates">Actualizaciones</sys:String>
  <sys:String x:Key="Str.UpToDate">Al día</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Buscando una versión más nueva…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">La v{0} es la versión más nueva. Comprobado a las {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">La versión {0} está disponible. Tienes la {1}.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">No se pudo comprobar: GitHub no respondió. La app funciona igual de todos modos.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Descargar actualización</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Descargar de GitHub</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Buscar actualizaciones</sys:String>
  <sys:String x:Key="Str.SessionSection">Última sesión</sys:String>
  <sys:String x:Key="Str.SessionTip">Se lee de los logs que el add-on y el runtime escriben en la carpeta del juego. Se vuelve a leer cuando regresas a esta ventana después de jugar.</sys:String>
  <sys:String x:Key="Str.SessionRan">NR funcionó en la última sesión</sys:String>
  <sys:String x:Key="Str.SessionCrashed">El juego se cerró por un fallo en la última sesión</sys:String>
  <sys:String x:Key="Str.SessionFailed">NR no se inició en la última sesión</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade se inició, pero el add-on no se cargó</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">El mod se cargó, pero NR no procesó ningún fotograma</sys:String>
  <sys:String x:Key="Str.SessionNever">Todavía no hay sesiones. Abre el juego una vez y vuelve: aquí verás si NR funcionó.</sys:String>
  <sys:String x:Key="Str.SessionFrames">Fotogramas procesados: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">Red: {0} ms por fotograma</sys:String>
  <sys:String x:Key="Str.SessionRuntime">Runtime {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">En el juego, abre el overlay de ReShade con Inicio (Home) y comprueba que NR está activado en el panel AMD Neural Rendering.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">En el juego, activa DLSS, FSR o XeSS; luego pulsa Insert, abre la pestaña Neural y activa «Enable NR».</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">El ReShade.log de la carpeta del juego dice en qué carpeta buscó ReShade los add-ons. «Informar de un problema» lo reúne con todo lo demás.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">«Informar de un problema» reúne estos logs en un solo archivo para compartirlo en Discord.</sys:String>
  <sys:String x:Key="Str.SortFilter">Ordenar y filtrar</sys:String>
  <sys:String x:Key="Str.FilterShow">Mostrar</sys:String>
  <sys:String x:Key="Str.FilterAll">Todos los juegos</sys:String>
  <sys:String x:Key="Str.FilterInstalled">Instalados</sys:String>
  <sys:String x:Key="Str.FilterUpdates">Con actualización</sys:String>
