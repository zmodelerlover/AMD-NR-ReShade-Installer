  <sys:String x:Key="Str.OpenFolder">Abrir a pasta</sys:String>

  <sys:String x:Key="Str.System">Esta máquina</sys:String>
  <sys:String x:Key="Str.Gpu">Placa de vídeo</sys:String>
  <sys:String x:Key="Str.Driver">Driver</sys:String>
  <sys:String x:Key="Str.Hip">Runtime HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll não foi encontrada. Um Adrenalin atual traz ela; HIP 6 não serve.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Isto não parece uma Radeon. A rede roda só em RDNA3 e RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Pronto</sys:String>

  <sys:String x:Key="Str.Payloads">Arquivos</sys:String>
  <sys:String x:Key="Str.Downloading">Baixando</sys:String>
  <sys:String x:Key="Str.Verifying">Conferindo o que já está aqui…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Baixado e conferido.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Usando a lista que vem junto com o app: o site não respondeu.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Não deu pra ler a lista de downloads. Confira a conexão e tente de novo.</sys:String>

  <sys:String x:Key="Str.Language">Idioma</sys:String>
  <sys:String x:Key="Str.UpdateAvailable">Saiu uma versão nova</sys:String>
  <sys:String x:Key="Str.OpenReleases">Abrir a página de releases</sys:String>
  <sys:String x:Key="Str.Dismiss">Agora não</sys:String>

  <sys:String x:Key="Str.LogSaved">O log completo foi gravado ao lado deste app.</sys:String>
  <sys:String x:Key="Str.Working">Trabalhando…</sys:String>
  <sys:String x:Key="Str.FreeTitle">Isto é de graça. Se você pagou por isto, estão te enganando.</sys:String>
  <sys:String x:Key="Str.FreeBody">Ninguém vende nada disto — nem este instalador, nem o add-on, nem a runtime, nem os pesos. Todo arquivo vem dos links abaixo, sem custo, e vai continuar assim. Se alguém te cobrou por isto, ou por uma "chave", ou por uma "versão pro", peça seu dinheiro de volta: o que te venderam está nesta página de graça.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — do danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">A rede em si, e o motivo de tudo isto existir: foi o projeto dele que fez o neural rendering do DLSS 5 rodar em Radeon. A runtime e os 141 MB de pesos que este app baixa são trabalho dele, não nosso — tira isso e não sobra nada pra rodar. Obrigado, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — o add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">O que liga essa rede ao jogo através do ReShade: as rotas D3D11, D3D12 e Vulkan, a ponte 32-bit pros jogos antigos, o overlay e a tecla de atalho. Licença MIT, código aberto.</sys:String>
  <sys:String x:Key="Str.CreditInstallerTitle">AMD-NR ReShade Installer — este programa</sys:String>
  <sys:String x:Key="Str.CreditInstallerBody">Acha seus jogos, descobre qual API gráfica cada um usa, baixa cada arquivo e confere contra um hash fixo antes de escrever qualquer coisa. Desinstalar devolve a pasta como estava. Licença MIT, código aberto.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — onde o pessoal está</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Onde o projeto é discutido: builds novas, o que funciona em qual jogo, e os logs que o pessoal manda quando algo quebra. Abre aí se você travou, ou se quiser ajudar a testar.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Créditos</sys:String>

  <sys:String x:Key="Str.Scan">Procurar jogos</sys:String>
  <sys:String x:Key="Str.Scanning">Lendo Steam, Epic, GOG, EA, Ubisoft, Battle.net e Xbox…</sys:String>
  <sys:String x:Key="Str.Found">encontrados</sys:String>
  <sys:String x:Key="Str.Added">novos</sys:String>
  <sys:String x:Key="Str.FirstScanHint">Lista vazia. Procurar jogos lê seus launchers; olhar não muda nada.</sys:String>
  <sys:String x:Key="Str.Search">Buscar jogos…</sys:String>
  <sys:String x:Key="Str.Settings">Configurações</sys:String>
  <sys:String x:Key="Str.NotDownloaded">ainda não baixado</sys:String>
  <sys:String x:Key="Str.WillDownload">Os arquivos são baixados e conferidos na hora de instalar.</sys:String>
  <sys:String x:Key="Str.NoRoute">Nada com que este jogo renderiza tem rota: o add-on funciona em D3D11, D3D12 e Vulkan, e em D3D8, D3D9 e D3D11 nos jogos 32-bit. OpenGL não tem.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Este jogo roda em {1}. Coloque em {0} nas configurações gráficas dele -- é a rota escolhida aqui, e em outra API o add-on vê outro jogo.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">É um jogo Unreal: adicione -{0} nas opções de inicialização.</sys:String>
  <!-- Feedback e layout -->
  <sys:String x:Key="Str.EmptyTitle">Nenhum jogo ainda</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Nada encontrado</sys:String>
  <sys:String x:Key="Str.NoMatch">Nenhum jogo da lista bate com "{0}".</sys:String>
  <sys:String x:Key="Str.ScanningShort">Procurando…</sys:String>
  <sys:String x:Key="Str.ScanDone">Busca concluída: {0} jogos encontrados, {1} novos.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Instalado</sys:String>
  <sys:String x:Key="Str.Close">Fechar</sys:String>
  <sys:String x:Key="Str.CloseHint">Fechar (Esc)</sys:String>
