<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Portuguese">

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">DLSS 5 neural rendering em Radeon, instalado pra você</sys:String>

  <sys:String x:Key="Str.Games">Jogos</sys:String>
  <sys:String x:Key="Str.AddGame">Adicionar um jogo…</sys:String>
  <sys:String x:Key="Str.RemoveGame">Tirar da lista</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Tira a linha da lista. Nenhum arquivo da pasta do jogo é tocado.</sys:String>
  <sys:String x:Key="Str.RemovedGame">{0} saiu da lista. Nada na pasta dele foi tocado.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">{0} saiu da lista, mas o add-on continua instalado na pasta dele. Adicione a pasta de volta se quiser desinstalar.</sys:String>
  <sys:String x:Key="Str.NoGames">Nada aqui ainda. Adicione a pasta de onde o jogo ou o emulador roda.</sys:String>
  <sys:String x:Key="Str.PickFolder">Escolha a pasta de onde o jogo roda</sys:String>
  <sys:String x:Key="Str.AddGameTitle">Adicionar jogos</sys:String>
  <sys:String x:Key="Str.AddGameBody">Ou um jogo só, ou tudo que estiver numa pasta onde você guarda jogos.</sys:String>
  <sys:String x:Key="Str.AddGameMany">Procurar numa pasta</sys:String>
  <sys:String x:Key="Str.AddGameManyBody">Aponte a pasta onde seus jogos ficam — um HD de Games, uma biblioteca copiada de outra máquina — e todos os jogos dentro dela entram de uma vez. Só leitura: olhar não instala nem muda nada.</sys:String>
  <sys:String x:Key="Str.AddGameOne">Adicionar um jogo</sys:String>
  <sys:String x:Key="Str.AddGameOneBody">Aponte direto a pasta de onde aquele jogo roda.</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Escolha a pasta onde você guarda os jogos</sys:String>
  <sys:String x:Key="Str.AddGameNone">Nada com cara de jogo foi encontrado em "{0}".</sys:String>

  <sys:String x:Key="Str.Preset">Rota</sys:String>
  <sys:String x:Key="Str.Install">Instalar</sys:String>
  <sys:String x:Key="Str.Uninstall">Desinstalar</sys:String>
  <sys:String x:Key="Str.Recheck">Conferir de novo</sys:String>
  <sys:String x:Key="Str.OpenFolder">Abrir a pasta</sys:String>

  <sys:String x:Key="Str.System">Esta máquina</sys:String>
  <sys:String x:Key="Str.Gpu">Placa de vídeo</sys:String>
  <sys:String x:Key="Str.Driver">Driver</sys:String>
  <sys:String x:Key="Str.Hip">Runtime HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll não foi encontrada. Um Adrenalin atual traz ela; HIP 6 não serve.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Isto não parece uma Radeon. A rede roda só em RDNA3 e RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Pronto</sys:String>

  <sys:String x:Key="Str.Payloads">Arquivos</sys:String>
  <sys:String x:Key="Str.Downloading">Baixando</sys:String>
  <sys:String x:Key="Str.Verifying">Conferindo o que já está aqui…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Baixado e conferido.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Não deu para ler a lista publicada, então está em uso a cópia que vem com este app.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Não deu pra ler a lista de downloads. Confira a conexão e tente de novo.</sys:String>

  <sys:String x:Key="Str.Language">Idioma</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Baixando a atualização…</sys:String>
  <sys:String x:Key="Str.Dismiss">Agora não</sys:String>

  <sys:String x:Key="Str.LogSaved">O log completo foi gravado ao lado deste app.</sys:String>
  <sys:String x:Key="Str.Working">Trabalhando…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Não deu pra ler a lista de jogos. Ela foi guardada como {0} ao lado, e uma lista nova começou.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Ainda gravando na pasta de um jogo. Leva alguns segundos; feche a janela quando terminar.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Isto é de graça. Se você pagou por isto, estão te enganando.</sys:String>
  <sys:String x:Key="Str.FreeBody">Ninguém vende nada disto — nem o instalador, nem o add-on, nem a runtime, nem os pesos. Se te cobraram por isto, ou por uma "chave", ou por uma "versão pro", peça seu dinheiro de volta: o que te venderam está nesta página de graça.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">É open source e vai continuar sendo: leia, modifique, compile a sua versão, passe pros amigos. A única coisa que a gente pede é que ninguém transforme numa versão paga.</sys:String>
  <sys:String x:Key="Str.SupportSection">Apoiar</sys:String>
  <sys:String x:Key="Str.SupportNote">opcional, e não compra nada</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Um café avulso.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">A vaquinha do projeto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — do danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">A rede em si, e o motivo de tudo isto existir: foi ele que fez o neural rendering do DLSS 5 rodar em Radeon. A runtime e os pesos que este app baixa são trabalho dele, não nosso. Obrigado, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — o add-on</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">O que liga essa rede ao jogo pelo ReShade: o add-on que isto instala, e as releases entre as quais isto te deixa escolher. Licença MIT, e um repositório separado deste instalador.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — onde o pessoal está</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Builds novas, o que funciona em qual jogo, e onde perguntar quando algo quebra.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Créditos</sys:String>

  <sys:String x:Key="Str.Scan">Procurar jogos</sys:String>
  <sys:String x:Key="Str.Scanning">Lendo Steam, Epic, GOG, EA, Ubisoft, Battle.net e Xbox…</sys:String>
  <sys:String x:Key="Str.Found">encontrados</sys:String>
  <sys:String x:Key="Str.Added">novos</sys:String>
  <sys:String x:Key="Str.FirstScanHint">Lista vazia. Procurar jogos lê seus launchers; olhar não muda nada.</sys:String>
  <sys:String x:Key="Str.Search">Buscar jogos…</sys:String>
  <sys:String x:Key="Str.Settings">Configurações</sys:String>
  <sys:String x:Key="Str.NotDownloaded">ainda não baixado</sys:String>
  <sys:String x:Key="Str.WillDownload">Os arquivos são baixados e conferidos na hora de instalar.</sys:String>
  <sys:String x:Key="Str.NoRoute">Nada com que este jogo renderiza tem rota: o add-on funciona em D3D11, D3D12, Vulkan e OpenGL, e em D3D8, D3D9 e D3D11 nos jogos 32-bit. Jogo OpenGL 32-bit, D3D9 64-bit e renderizador por software não têm.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Este jogo roda em {1}. Coloque em {0} nas configurações gráficas dele — é a rota escolhida aqui, e em outra API o add-on vê outro jogo.</sys:String>
  <sys:String x:Key="Str.CheckApiTitle">Confira a API antes de instalar</sys:String>
  <sys:String x:Key="Str.CheckApiBody">{0} foi lido dos arquivos deste jogo, e arquivo diz contra o que foi ligado, não em que o jogo roda. Uma pasta pode ter um executável D3D11 e um D3D12; um jogo pode abrir em D3D10 a partir de um executável que também faz D3D9. As duas respostas são verdade e só uma delas é a rota certa — e rota errada instala perfeitinho e depois não faz nada no jogo.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Procurar este jogo no PCGamingWiki</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">É um jogo Unreal: adicione -{0} nas opções de inicialização.</sys:String>
  <!-- Feedback e layout -->
  <sys:String x:Key="Str.EmptyTitle">Nenhum jogo ainda</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Nada encontrado</sys:String>
  <sys:String x:Key="Str.NoMatch">Nenhum jogo da lista bate com "{0}".</sys:String>
  <sys:String x:Key="Str.ScanningShort">Procurando…</sys:String>
  <sys:String x:Key="Str.ScanDone">Busca concluída: {0} jogos encontrados, {1} novos.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Instalado</sys:String>
  <sys:String x:Key="Str.UpdateBadge">Tem atualização</sys:String>
  <sys:String x:Key="Str.Close">Fechar</sys:String>
  <sys:String x:Key="Str.CloseHint">Fechar (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">O executável do jogo</sys:String>
  <sys:String x:Key="Str.ExeChoose">Escolher…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Usar o detectado</sys:String>
  <sys:String x:Key="Str.ExeNone">Nenhum executável encontrado nesta pasta.</sys:String>
  <sys:String x:Key="Str.ExeNote">A largura e a API são lidas deste arquivo, e as rotas abaixo seguem dele. Um jogo que deixa um lançador pequeno na raiz e a coisa real em Bin64 é o caso que isto erra — se o número de bits aqui não for o que você espera, aponte para o arquivo certo.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Você escolheu este arquivo, então a detecção não mexe nele — nem depois de um re-scan.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Esse arquivo não está dentro da pasta deste jogo.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Esse arquivo não é um executável do Windows que dê para ler.</sys:String>
  <sys:String x:Key="Str.RouteSection">Rota</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Esta rota é para jogos {0} e o executável acima é {1}. Nada impede você — a detecção pode ter lido o arquivo errado — mas se ela leu o certo, isto não vai carregar.</sys:String>
  <sys:String x:Key="Str.VersionSection">Versão do add-on</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade carrega como</sys:String>
  <sys:String x:Key="Str.ProxyNote">Automático escolhe dxgi.dll, que serve todo Direct3D. Troque só quando um jogo se recusar a carregar esse — alguns carregam d3d12.dll e mais nada.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler carrega como</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">Automático escolhe dxgi.dll. Escolha winmm.dll quando o dxgi.dll precisa continuar sendo de outro programa, como um ReShade que você quer manter.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automático</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Baixar tudo agora</sys:String>
  <sys:String x:Key="Str.ClearCache">Limpar o cache</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Apaga os arquivos baixados, as capas e a lista de versões. Nada instalado em jogo é tocado; a próxima instalação baixa de novo o que precisar.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Pode limpar</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Tudo que está nele é baixado de novo na próxima instalação.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Deixar o cache como está.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Cache esvaziado — {0} liberados.</sys:String>
  <sys:String x:Key="Str.PayloadsAllReady">{0} de {1} componentes prontos — {2} no cache</sys:String>
  <sys:String x:Key="Str.PayloadsMissing">{0} de {1} componentes prontos — faltam {2} para baixar</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Já estava tudo aí, e cada byte acabou de ser conferido.</sys:String>
  <sys:String x:Key="Str.VersionShipped">que acompanha o instalador</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">A versão com que este instalador foi publicado.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Vem do release v{0} no GitHub, conferida contra os hashes que aquele release publica.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Versão do OptiScaler</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0}, do release no GitHub. Cada arquivo dele é conferido contra o hash que a lista do payload dá a ele.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Instala também os pesos do runtime lmxxf, cerca de 590 MB, que só placas RDNA4 usam.</sys:String>
  <sys:String x:Key="Str.WhatHappens">O que vai acontecer</sys:String>
  <sys:String x:Key="Str.Checking">Conferindo esta pasta…</sys:String>
  <sys:String x:Key="Str.StepDownload">Baixar</sys:String>
  <sys:String x:Key="Str.StepVerify">Conferir</sys:String>
  <sys:String x:Key="Str.StepInstall">Instalar</sys:String>
  <sys:String x:Key="Str.StepDone">Pronto</sys:String>
  <sys:String x:Key="Str.Installing">Instalando…</sys:String>
  <sys:String x:Key="Str.Removing">Removendo…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} está pronto. É só abrir o jogo.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Instalado em {0}, com {1} aviso para ler abaixo.</sys:String>
  <sys:String x:Key="Str.InstallFail">A instalação em {0} não terminou.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Removido de {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Removido de {0}, com {1} aviso para ler abaixo.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">{0} ainda conta como instalado: arquivos que mudaram depois da instalação foram deixados no lugar.</sys:String>
  <sys:String x:Key="Str.UninstallLeftTitle">Alguns arquivos ficaram no lugar</sys:String>
  <sys:String x:Key="Str.UninstallLeftBody">Arquivos em {0} não são os que este instalador escreveu — mudaram depois da instalação, então o desinstalar preferiu mantê-los a apagar o trabalho de outra pessoa. É por isso que o jogo continua aparecendo como instalado. A lista está em Detalhes.</sys:String>
  <sys:String x:Key="Str.UninstallForce">Tirar mesmo assim</sys:String>
  <sys:String x:Key="Str.UninstallForceBody">Apaga esses arquivos e devolve o que eles substituíram. O seu dlss5-neural.ini fica de qualquer jeito.</sys:String>
  <sys:String x:Key="Str.UninstallKeep">Deixar como está</sys:String>
  <sys:String x:Key="Str.UninstallKeepBody">Nada mais é tocado, e o jogo segue contando como instalado.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Não deu pra remover tudo de {0}.</sys:String>
  <sys:String x:Key="Str.ResultErrors">{0} problema listado abaixo.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Não deu pra baixar os arquivos, então nada foi instalado.</sys:String>
  <sys:String x:Key="Str.Folder">Pasta</sys:String>
  <!-- Second layout pass -->
  <sys:String x:Key="Str.GameCount">{0} jogos</sys:String>
  <sys:String x:Key="Str.UnknownApi">API desconhecida</sys:String>
  <sys:String x:Key="Str.Location">Local</sys:String>
  <sys:String x:Key="Str.Details">Detalhes</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} linhas</sys:String>
  <sys:String x:Key="Str.PreflightOk">Pronto pra instalar</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Nada no caminho. Escolha a rota abaixo e clique em Instalar.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Pronto para instalar, com {0} aviso para ler</sys:String>
  <sys:String x:Key="Str.PreflightErr">{0} problema encontrado nesta pasta</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Instalado neste jogo</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Abra o jogo pra usar. Instale de novo pra atualizar os arquivos, ou desinstale pra removê-los.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Instalado, e tem atualização</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Os arquivos deste jogo são mais antigos que os que o app instala agora. Atualizar troca eles; suas configurações ficam.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Abra Detalhes abaixo pra ver o que foi encontrado.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">O que o add-on precisa deste PC, conferido quando o app abre.</sys:String>
  <sys:String x:Key="Str.SystemReady">Este PC tem o que o add-on precisa</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Falta algo neste PC que o add-on precisa</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon detectada</sys:String>
  <sys:String x:Key="Str.GpuBad">Não é uma Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Não encontrado</sys:String>
  <sys:String x:Key="Str.DriverHint">A versão que o Windows informa para o driver de vídeo.</sys:String>
  <sys:String x:Key="Str.FilesHint">Baixados uma vez, conferidos contra um hash fixo e reaproveitados em todos os jogos.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Verificado</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Não baixado</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Idioma, atualizações e sobre este app.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Todos os textos mudam na hora, sem reiniciar.</sys:String>
  <sys:String x:Key="Str.DataFolder">Pasta de dados</sys:String>
  <!-- Routes: the names and notes Core carries in English, said in this language. -->
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">Jogo D3D11</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">Jogo D3D12</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Jogo Vulkan</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">Jogo OpenGL</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">Jogo D3D11, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">Jogo D3D9, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">Jogo D3D8, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: jogo D3D12 com DLSS, FSR ou XeSS</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Deixe o emulador em Direct3D 11: é o único renderizador cuja profundidade chega na rede. Cuidado com a configuração por jogo, que passa por cima da global sem avisar.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Experimental. No Vulkan o ReShade entra como camada global, não como DLL de proxy: rode o instalador dele no rpcs3.exe e escolha Vulkan. Sem profundidade no Vulkan, só cor e movimento estimado.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">A melhor rota: o D3D11 é a única em que a profundidade e os vetores de movimento do próprio jogo chegam na rede.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Rota limitada. No D3D12 o add-on só enxerga o quadro pronto, então a rede recebe a cor e chuta o resto. Funciona, mas espere menos. Um jogo com DLSS, FSR ou XeSS nas configurações fica melhor na rota OptiScaler.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Recomendada para jogos D3D12. Em vez do ReShade, instala o OptiScaler, que assume o DLSS, FSR ou XeSS do jogo e roda a rede dentro dele, com a profundidade e os vetores de movimento do próprio jogo. O jogo precisa oferecer um desses upscalers, ligado nas configurações. No jogo, aperte Insert, abra a aba Neural e ligue Enable NR; num jogo com Ray Reconstruction, escolha "After the finished frame" como ponto de processamento.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Experimental. No Vulkan o ReShade entra como camada global: rode o instalador dele no .exe do jogo e escolha Vulkan. O jogo precisa importar vkCreateDevice de forma estática, e não há profundidade no Vulkan.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Experimental. Diferente do Vulkan, esta é uma DLL proxy comum: o ReShade entra como opengl32.dll ao lado do jogo, sem rodar instalador separado. Só cor e movimento estimado; a profundidade do próprio jogo é alcançável nesta API, mas ainda não está ligada. Jogo OpenGL de 32 bits não tem rota.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Experimental. Um jogo de 32 bits não carrega o runtime de 64 bits, então o add-on roda em dupla, dividindo os quadros na mesma placa. Instale o ReShade com suporte a add-on como dxgi.dll de 32 bits.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Experimental. A mesma dupla de 32 bits do D3D11, passando por um estágio D3D9/D3D11 interno. O D3D9 comum custa alguns milissegundos fixos por quadro; o D3D9Ex não. Instale o ReShade como d3d9.dll de 32 bits.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Experimental. O D3D8 é traduzido para D3D9 e segue a rota do D3D9 acima, com a mesma dupla de 32 bits. Instale o ReShade como d3d9.dll de 32 bits.</sys:String>

  <!-- First run -->
  <sys:String x:Key="Str.SetupTitle">Primeiros passos</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Bem-vindo</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">A rede DLSS 5 Neural Rendering em placas Radeon, pelo ReShade ou pelo OptiScaler. Quatro passos rápidos.</sys:String>
  <sys:String x:Key="Str.SetupStepLanguage">Idioma</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Esta máquina</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Arquivos</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Seus jogos</sys:String>
  <sys:String x:Key="Str.SetupBack">Voltar</sys:String>
  <sys:String x:Key="Str.SetupNext">Continuar</sys:String>
  <sys:String x:Key="Str.SetupFinish">Começar a usar</sys:String>
  <sys:String x:Key="Str.SetupSkip">Pular por enquanto</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Passo {0} de {1}</sys:String>

  <sys:String x:Key="Str.SetupMachineBody">Duas coisas fazem o add-on não rodar, e as duas dá pra ver daqui. Nenhuma delas impede de continuar — só de funcionar dentro do jogo.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Esta máquina tem tudo que o add-on precisa.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Falta algo. Dá pra continuar e resolver depois, mas dentro do jogo não vai funcionar até resolver.</sys:String>

  <sys:String x:Key="Str.SetupFilesBody">São os mesmos arquivos pra todos os jogos: baixados uma vez, conferidos contra um hash fixo e reaproveitados.</sys:String>
  <sys:String x:Key="Str.SetupFilesCheck">Conferindo o que já está aqui…</sys:String>
  <sys:String x:Key="Str.SetupFilesAllReady">Todos os arquivos estão aqui e conferidos.</sys:String>
  <sys:String x:Key="Str.SetupFilesMissing">{0} de {1} componentes ainda faltam.</sys:String>
  <sys:String x:Key="Str.SetupFilesDownload">Baixar tudo agora</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Tentar de novo</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Se pular, eles são baixados na primeira instalação.</sys:String>
  <sys:String x:Key="Str.SetupFilesOffline">Não deu pra ler a lista de downloads — provavelmente sem internet. Dá pra continuar: o app tenta de novo quando você instalar.</sys:String>

  <sys:String x:Key="Str.SetupGamesBody">Ler os launchers é só leitura: nada é instalado nem alterado por olhar. Você pode adicionar pastas à mão depois.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Cada jogo é lido pra descobrir qual API gráfica ele usa, e essa leitura costuma acertar, mas não sempre: uma pasta pode ter um executável D3D11 e um D3D12, e um jogo pode abrir numa API enquanto o executável também aceita uma mais antiga. Antes de instalar, vale conferir o jogo no pcgamingwiki.com — cada jogo tem um link direto pra lá.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Nenhum jogo encontrado. Dá pra adicionar a pasta à mão na janela principal.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">{0} jogos encontrados.</sys:String>
  <sys:String x:Key="Str.SetupDoneBody">Tudo pronto. A janela principal abre com a sua biblioteca.</sys:String>

  <sys:String x:Key="Str.Unexpected">Algo inesperado aconteceu. O log completo foi gravado.</sys:String>


  <!-- Play and emulators -->
  <sys:String x:Key="Str.Play">Jogar</sys:String>
  <sys:String x:Key="Str.Launch">Abrir</sys:String>
  <sys:String x:Key="Str.PlayFailed">Não deu pra abrir. Use Abrir a pasta e rode o executável à mão.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Adicionar emulador</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Adicionar um emulador</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Escolha qual, e aponte a pasta de onde ele roda — a mesma pasta do executável, não a pasta das ROMs.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Outro emulador</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Aponte a pasta e eu digo o que consigo prever dela.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Aponte a pasta do {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Aponte a pasta do emulador</sys:String>
  <sys:String x:Key="Str.EmulatorFound">{0} encontrado: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Isto não parece o {0}: não achei {1} nessa pasta. Adicionei assim mesmo — confira o caminho.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Não reconheci nenhum emulador conhecido aí. Adicionei pela leitura dos arquivos: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">Dentro do emulador</sys:String>


  <!-- Emulator guidance: the sentence that names the setting which actually decides the route.
       Core carries these in English (it has no resources), so the translation lives here. -->
  <sys:String x:Key="Str.Emulator.pcsx2">Configurações &gt; Gráficos &gt; Renderizador: Direct3D 11. Cuidado com a configuração por jogo, nas propriedades do jogo: ela passa por cima da global sem avisar, e é o jeito mais comum disto parecer quebrado sem estar.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Configurações &gt; GPU &gt; Renderizador: Vulkan. Aqui não existe Direct3D nenhum, então esta rota recebe só cor e movimento estimado — sem profundidade.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Configurações &gt; Gráficos &gt; Renderizador: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Gráficos &gt; Geral &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Configurações &gt; Gráficos &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Configurações &gt; Gráficos &gt; API gráfica: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">Ele roda em D3D12, que é a rota degradada: o add-on só enxerga o quadro pronto. Funciona, mas espere menos.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Sem profundidade no Vulkan: só cor e movimento estimado.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Sem profundidade no Vulkan.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan é o backend padrão. Sem profundidade no Vulkan.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Só Vulkan. Sem profundidade, e o emulador em si é recente — espere problemas.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. OpenGL também tem rota agora, mas a do Vulkan é a rodada.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">O xemu renderiza só em OpenGL, então a rota de OpenGL é a única que existe aqui. É a mais nova das rotas e é experimental: cor e movimento estimado, sem profundidade.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. O renderizador por software desenha na CPU e não há o que um add-on alcance ali, então tem que ser o OpenGL — e essa rota é experimental: cor e movimento estimado, sem profundidade.</sys:String>


  <!-- Problem report -->
  <sys:String x:Key="Str.ReportTitle">Não funcionou no jogo?</sys:String>
  <sys:String x:Key="Str.ReportBody">Junta os logs, o que há na pasta do jogo e o que o ReShade escreveu num .zip. Nada é enviado: o arquivo fica no seu PC pra você mandar onde quiser.</sys:String>
  <sys:String x:Key="Str.Report">Reportar um problema</sys:String>
  <sys:String x:Key="Str.ReportSaved">Relatório salvo e a pasta foi aberta: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Não deu pra montar o relatório. Os logs estão em {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Juntando…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Os arquivos não baixam?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Junta o que cada download tentou — cada endereço, a consulta de nome, o proxy e a resposta — e testa cada endereço de novo agora, num .zip. Nada é enviado: o arquivo fica no seu PC pra você mandar onde quiser.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Logs de download</sys:String>

  <!-- The sheet's two routes, the files panel, updates. -->
  <sys:String x:Key="Str.Add">Adicionar</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Procurar jogos numa pasta…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Pasta de um jogo…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Um emulador…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Atualizar</sys:String>
  <sys:String x:Key="Str.GamesAway">{0} num disco desconectado</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Jogos num disco que não está conectado agora continuam lembrados, com tudo o que foi escolhido para eles, e voltam quando o disco voltar.</sys:String>
  <sys:String x:Key="Str.GameGone">{0} não está mais instalado e saiu da lista.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} jogo não está mais instalado e saiu da lista.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">{0} jogos não estão mais instalados e saíram da lista.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Ver os detalhes</sys:String>
  <sys:String x:Key="Str.DetectedSection">Detectado</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Os arquivos dizem com o que o jogo se liga, não no que ele roda: uma pasta pode ter um executável D3D11 e um D3D12. A wiki diz qual o jogo usa.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Lido dos arquivos do próprio jogo.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">Da PCGamingWiki e dos arquivos do jogo.</sys:String>
  <sys:String x:Key="Str.InstallWith">Instalar com</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + add-on</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Recomendado</sys:String>
  <sys:String x:Key="Str.RecommendedLower">recomendado</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">O add-on dentro do ReShade. D3D11, D3D12, Vulkan, OpenGL, jogos 32-bit e emuladores.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Não há rota ReShade para o que este jogo usa ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Roda dentro do DLSS, FSR ou XeSS do jogo, com a profundidade e o movimento dele. Substitui o ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Roda dentro do upscaler do jogo ({0} encontrado aqui). Substitui o ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Feito para jogos D3D12 de 64 bits; este aparece como {0}.</sys:String>
  <sys:String x:Key="Str.ApiSection">API gráfica</sys:String>
  <sys:String x:Key="Str.Group64">Jogos 64-bit</sys:String>
  <sys:String x:Key="Str.Group32">Jogos 32-bit (experimental)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Emuladores</sys:String>
  <sys:String x:Key="Str.OptiAbout">No lugar do ReShade, instala o OptiScaler, que assume o DLSS, FSR ou XeSS do jogo e roda a rede dentro dele, com a profundidade e os vetores de movimento do próprio jogo.</sys:String>
  <sys:String x:Key="Str.InGame">No jogo</sys:String>
  <sys:String x:Key="Str.OptiStep1">Ligue DLSS, FSR ou XeSS nas opções gráficas do jogo.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Aperte Insert, abra a aba Neural e ligue Enable NR.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Com Ray Reconstruction ligado, ponha o ponto de processamento em "After the finished frame".</sys:String>
  <sys:String x:Key="Str.InstallOpti">Instalar OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">Atualizar</sys:String>
  <sys:String x:Key="Str.Reinstall">Reinstalar</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Trocar para OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Trocar para ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Trocar para {0}?</sys:String>
  <sys:String x:Key="Str.SwitchBody">{0} está com a rota {1} instalada, e as duas não cabem na mesma pasta. Primeiro o {1} é removido, devolvendo o que ele tinha substituído, e depois o {2} é instalado.</sys:String>
  <sys:String x:Key="Str.SwitchYes">Remover {0}, instalar {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Seus arquivos de configuração ficam onde estão.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Nada muda; o {0} continua instalado.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">O motivo está em Detalhes. Nada foi instalado.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Os arquivos também podem ser baixados pelo navegador e entregues ao app: Esta máquina &gt; Arquivos &gt; Baixar manualmente, depois Importar arquivos. Arquivos na pasta Downloads são encontrados sozinhos.</sys:String>
  <sys:String x:Key="Str.DnsRetry">Limpar o DNS e tentar de novo</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">O Windows não deixou limpar o cache de DNS daqui. Abra o Prompt de Comando, rode ipconfig /flushdns e tente de novo.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">{0} problemas encontrados nesta pasta</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Pronto para instalar, com {0} avisos para ler</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Instalado em {0}, com {1} avisos para ler abaixo.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Removido de {0}, com {1} avisos para ler abaixo.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">{0} problemas listados abaixo.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Sem lista de download</sys:String>
  <sys:String x:Key="Str.FailedShort">Falhou</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Todos os {0} prontos</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">{0} faltando · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Não foi possível baixar: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Baixar manualmente</sys:String>
  <sys:String x:Key="Str.ImportFiles">Importar arquivos…</sys:String>
  <sys:String x:Key="Str.ImportHint">Escolha uma pasta com arquivos que você mesmo baixou. Cada um é encontrado pelo nome e só é aceito se bater com o hash fixado.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Baixe os arquivos você mesmo</sys:String>
  <sys:String x:Key="Str.ManualBody">Abra cada link no navegador e salve o arquivo onde quiser: a pasta Downloads é vasculhada sozinha, e Importar arquivos aceita qualquer outra pasta. Não precisa renomear nada, e nada que não bata com o SHA-256 fixado é usado.</sys:String>
  <sys:String x:Key="Str.ImportPick">Escolha a pasta com os arquivos que você baixou</sys:String>
  <sys:String x:Key="Str.ImportAll">Todos os arquivos estão aqui e verificados.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Nada naquela pasta bate com um arquivo necessário.</sys:String>
  <sys:String x:Key="Str.ImportSome">Aceitos: {0}. Ainda faltando: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">Add-on</sys:String>
  <sys:String x:Key="Str.Component.runtime">Runtime neural e pesos</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">Ponte 32-bit</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">Extras 32-bit</sys:String>
  <sys:String x:Key="Str.Component.shader">Efeito companheiro</sys:String>
  <sys:String x:Key="Str.Updates">Atualizações</sys:String>
  <sys:String x:Key="Str.UpToDate">Atualizado</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Procurando uma versão mais nova…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">A v{0} é a versão mais nova. Verificado às {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">A versão {0} está disponível. Você tem a {1}.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">Não deu para verificar: o GitHub não respondeu. O app funciona igual.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Baixar atualização</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Baixar no GitHub</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Procurar atualizações</sys:String>

</ResourceDictionary>
