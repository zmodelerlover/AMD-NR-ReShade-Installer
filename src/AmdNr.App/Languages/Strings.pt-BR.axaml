  <sys:String x:Key="Str.StepVerify">Conferir</sys:String>
  <sys:String x:Key="Str.StepInstall">Instalar</sys:String>
  <sys:String x:Key="Str.StepDone">Pronto</sys:String>
  <sys:String x:Key="Str.Installing">Instalando…</sys:String>
  <sys:String x:Key="Str.Removing">Removendo…</sys:String>
  <sys:String x:Key="Str.InstallOk">{0} está pronto. É só abrir o jogo.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Instalado em {0}, com {1} aviso(s) pra ler abaixo.</sys:String>
  <sys:String x:Key="Str.InstallFail">A instalação em {0} não terminou.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Removido de {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Removido de {0}, com {1} aviso(s) pra ler abaixo.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Não deu pra remover tudo de {0}.</sys:String>
  <sys:String x:Key="Str.ResultErrors">{0} problema(s) listado(s) abaixo.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Não deu pra baixar os arquivos, então nada foi instalado.</sys:String>
  <sys:String x:Key="Str.Folder">Pasta</sys:String>
  <!-- Second layout pass -->
  <sys:String x:Key="Str.GameCount">{0} jogos</sys:String>
  <sys:String x:Key="Str.UnknownApi">API desconhecida</sys:String>
  <sys:String x:Key="Str.Location">Local</sys:String>
  <sys:String x:Key="Str.Details">Detalhes</sys:String>
  <sys:String x:Key="Str.DetailsCount">{0} linhas</sys:String>
  <sys:String x:Key="Str.PreflightOk">Pronto pra instalar</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Nada no caminho. Escolha a rota abaixo e clique em Instalar.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Pronto pra instalar, com {0} aviso(s) pra ler</sys:String>
  <sys:String x:Key="Str.PreflightErr">{0} problema(s) encontrado(s) nesta pasta</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Instalado neste jogo</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Abra o jogo pra usar. Instale de novo pra atualizar os arquivos, ou desinstale pra removê-los.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Abra Detalhes abaixo pra ver o que foi encontrado.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">O que o add-on precisa deste PC, conferido quando o app abre.</sys:String>
  <sys:String x:Key="Str.SystemReady">Este PC tem o que o add-on precisa</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Falta algo neste PC que o add-on precisa</sys:String>
  <sys:String x:Key="Str.GpuOk">Radeon detectada</sys:String>
  <sys:String x:Key="Str.GpuBad">Não é uma Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Não encontrado</sys:String>
  <sys:String x:Key="Str.DriverHint">A versão que o Windows informa para o driver de vídeo.</sys:String>
  <sys:String x:Key="Str.FilesHint">Baixados uma vez, conferidos contra um hash fixo e reaproveitados em todos os jogos.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Verificado</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Não baixado</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Idioma, e onde este app guarda os arquivos dele.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Todos os textos mudam na hora, sem reiniciar.</sys:String>
  <sys:String x:Key="Str.DataFolder">Pasta de dados</sys:String>
  <!-- Routes: the names and notes Core carries in English, said in this language. -->
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">Jogo D3D11</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">Jogo D3D12</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Jogo Vulkan</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">Jogo D3D11, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">Jogo D3D9, 32 bits</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">Jogo D3D8, 32 bits</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Deixe o emulador em Direct3D 11: é o único renderizador cuja profundidade chega na rede. Cuidado com a configuração por jogo, que passa por cima da global sem avisar.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Experimental. No Vulkan o ReShade entra como camada global, não como DLL de proxy: rode o instalador dele no rpcs3.exe e escolha Vulkan. Sem profundidade no Vulkan, só cor e movimento estimado.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">A melhor rota: o D3D11 é a única em que a profundidade e os vetores de movimento do próprio jogo chegam na rede.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Rota limitada. No D3D12 o add-on só enxerga o quadro pronto, então a rede recebe a cor e chuta o resto. Funciona, mas espere menos.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Experimental. No Vulkan o ReShade entra como camada global: rode o instalador dele no .exe do jogo e escolha Vulkan. O jogo precisa importar vkCreateDevice de forma estática, e não há profundidade no Vulkan.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Experimental. Um jogo de 32 bits não carrega o runtime de 64 bits, então o add-on roda em dupla, dividindo os quadros na mesma placa. Instale o ReShade com suporte a add-on como dxgi.dll de 32 bits.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Experimental. A mesma dupla de 32 bits do D3D11, passando por um estágio D3D9/D3D11 interno. O D3D9 comum custa alguns milissegundos fixos por quadro; o D3D9Ex não. Instale o ReShade como d3d9.dll de 32 bits.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Experimental. O D3D8 é traduzido para D3D9 e segue a rota do D3D9 acima, com a mesma dupla de 32 bits. Instale o ReShade como d3d9.dll de 32 bits.</sys:String>

  <!-- First run -->
  <sys:String x:Key="Str.SetupTitle">Primeiros passos</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Bem-vindo</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Este app instala a rede de Neural Rendering do DLSS 5 em placas Radeon, através do ReShade. Ele baixa tudo sozinho e confere cada arquivo por hash. São quatro passos rápidos.</sys:String>
  <sys:String x:Key="Str.SetupStepLanguage">Idioma</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Esta máquina</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Arquivos</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Seus jogos</sys:String>
  <sys:String x:Key="Str.SetupBack">Voltar</sys:String>
  <sys:String x:Key="Str.SetupNext">Continuar</sys:String>
  <sys:String x:Key="Str.SetupFinish">Começar a usar</sys:String>
  <sys:String x:Key="Str.SetupSkip">Pular por enquanto</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Passo {0} de {1}</sys:String>

  <sys:String x:Key="Str.SetupMachineBody">Duas coisas fazem o add-on não rodar, e as duas dá pra ver daqui. Nenhuma delas impede de continuar — só de funcionar dentro do jogo.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Esta máquina tem tudo que o add-on precisa.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Falta algo. Dá pra continuar e resolver depois, mas dentro do jogo não vai funcionar até resolver.</sys:String>

  <sys:String x:Key="Str.SetupFilesBody">São os mesmos arquivos pra todos os jogos: baixados uma vez, conferidos contra um hash fixo e reaproveitados. Cerca de 165 MB no total.</sys:String>
  <sys:String x:Key="Str.SetupFilesCheck">Conferindo o que já está aqui…</sys:String>
  <sys:String x:Key="Str.SetupFilesAllReady">Todos os arquivos estão aqui e conferidos.</sys:String>
  <sys:String x:Key="Str.SetupFilesMissing">{0} de {1} componentes ainda faltam.</sys:String>
  <sys:String x:Key="Str.SetupFilesDownload">Baixar tudo agora</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Tentar de novo</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Se pular, eles são baixados na primeira instalação.</sys:String>
  <sys:String x:Key="Str.SetupFilesOffline">Não deu pra ler a lista de downloads — provavelmente sem internet. Dá pra continuar: o app tenta de novo quando você instalar.</sys:String>

  <sys:String x:Key="Str.SetupGamesBody">Ler os launchers é só leitura: nada é instalado nem alterado por olhar. Você pode adicionar pastas à mão depois.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Nenhum jogo encontrado. Dá pra adicionar a pasta à mão na janela principal.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">{0} jogos encontrados.</sys:String>
  <sys:String x:Key="Str.SetupDoneBody">Tudo pronto. A janela principal abre com a sua biblioteca.</sys:String>

  <sys:String x:Key="Str.Unexpected">Algo inesperado aconteceu. O log completo foi gravado.</sys:String>


  <!-- Play and emulators -->
  <sys:String x:Key="Str.Play">Jogar</sys:String>
  <sys:String x:Key="Str.Launch">Abrir</sys:String>
  <sys:String x:Key="Str.PlayFailed">Não deu pra abrir. Use Abrir a pasta e rode o executável à mão.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Adicionar emulador</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Adicionar um emulador</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Escolha qual, e aponte a pasta de onde ele roda — a mesma pasta do executável, não a pasta das ROMs.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Outro emulador</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Aponte a pasta e eu digo o que consigo prever dela.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Aponte a pasta do {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Aponte a pasta do emulador</sys:String>
  <sys:String x:Key="Str.EmulatorFound">{0} encontrado: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Isto não parece o {0}: não achei {1} nessa pasta. Adicionei assim mesmo — confira o caminho.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Não reconheci nenhum emulador conhecido aí. Adicionei pela leitura dos arquivos: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">Dentro do emulador</sys:String>
  <sys:String x:Key="Str.OpenLog">Ver o log desta instalação</sys:String>


  <!-- Emulator guidance: the sentence that names the setting which actually decides the route.
       Core carries these in English (it has no resources), so the translation lives here. -->
  <sys:String x:Key="Str.Emulator.pcsx2">Configurações &gt; Gráficos &gt; Renderizador: Direct3D 11. Cuidado com a configuração por jogo, nas propriedades do jogo: ela passa por cima da global sem avisar, e é o jeito mais comum disto parecer quebrado sem estar.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Configurações &gt; GPU &gt; Renderizador: Vulkan. Aqui não existe Direct3D nenhum, então esta rota recebe só cor e movimento estimado — sem profundidade.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Configurações &gt; Gráficos &gt; Renderizador: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Gráficos &gt; Geral &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Configurações &gt; Gráficos &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Configurações &gt; Gráficos &gt; API gráfica: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">Ele roda em D3D12, que é a rota degradada: o add-on só enxerga o quadro pronto. Funciona, mas espere menos.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Sem profundidade no Vulkan: só cor e movimento estimado.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Sem profundidade no Vulkan.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan é o backend padrão. Sem profundidade no Vulkan.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Só Vulkan. Sem profundidade, e o emulador em si é recente — espere problemas.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. No OpenGL não existe rota nenhuma, então este tem que ser trocado.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">O xemu renderiza em OpenGL, e este add-on não tem rota pra OpenGL. Nada aqui vai funcionar enquanto ele não ganhar outro backend.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">O melonDS renderiza em OpenGL ou por software, e este add-on não tem rota pra nenhum dos dois.</sys:String>


  <!-- Problem report -->
  <sys:String x:Key="Str.ReportTitle">Não funcionou no jogo?</sys:String>
  <sys:String x:Key="Str.ReportBody">Junta os logs, o que há na pasta do jogo e o que o ReShade escreveu num .zip. Nada é enviado: o arquivo fica no seu PC pra você mandar onde quiser.</sys:String>
  <sys:String x:Key="Str.Report">Reportar um problema</sys:String>
  <sys:String x:Key="Str.ReportSaved">Relatório salvo e a pasta foi aberta: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Não deu pra montar o relatório. Os logs estão em {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Juntando…</sys:String>

</ResourceDictionary>
