<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Polish">

  <!-- Polski. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">Neuronowe renderowanie DLSS 5 na Radeonie, zainstalowane za Ciebie</sys:String>
  <sys:String x:Key="Str.Games">Gry</sys:String>
  <sys:String x:Key="Str.RemoveGame">Usuń z listy</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Usuwa grę z listy, a „Skanuj gry” też ją pominie. Żaden plik w jej folderze nie zostaje ruszony; można ją przywrócić w Ustawieniach.</sys:String>
  <sys:String x:Key="Str.RemovedGame">Gra {0} zniknęła z listy, a „Skanuj gry” będzie ją pomijać. Nic w jej folderze nie zostało ruszone; przywrócisz ją w „Ustawienia” &gt; „Ignorowane gry”.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">Gra {0} zniknęła z listy, ale dodatek nadal jest zainstalowany w jej folderze. Przywróć ją w „Ustawienia” &gt; „Ignorowane gry”, aby go odinstalować.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Ignorowane gry</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Gry usunięte przez Ciebie z listy. „Skanuj gry” je pomija, więc pozostaną poza listą, dopóki ich tu nie przywrócisz.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Brak ignorowanych gier.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Przywróć na listę</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">Gra {0} wróciła na listę.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Folder gry {0} już nie istnieje, więc gra zniknęła tylko z listy ignorowanych.</sys:String>
  <sys:String x:Key="Str.NoGames">Na razie nic tu nie ma. Dodaj folder, z którego uruchamia się gra lub emulator.</sys:String>
  <sys:String x:Key="Str.PickFolder">Wybierz folder, z którego uruchamia się gra</sys:String>
  <sys:String x:Key="Str.AddGameMany">Przeszukaj folder</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Wybierz folder, w którym trzymasz gry</sys:String>
  <sys:String x:Key="Str.AddGameNone">W „{0}” nie znaleziono niczego, co wyglądałoby na grę.</sys:String>
  <sys:String x:Key="Str.Preset">Ścieżka</sys:String>
  <sys:String x:Key="Str.Install">Zainstaluj</sys:String>
  <sys:String x:Key="Str.Uninstall">Odinstaluj</sys:String>
  <sys:String x:Key="Str.OpenFolder">Otwórz folder</sys:String>
  <sys:String x:Key="Str.System">Ten komputer</sys:String>
  <sys:String x:Key="Str.Gpu">Karta graficzna</sys:String>
  <sys:String x:Key="Str.Driver">Sterownik</sys:String>
  <sys:String x:Key="Str.Hip">Środowisko HIP 7</sys:String>
  <sys:String x:Key="Str.HipMissing">Nie znaleziono amdhip64_7.dll. Na RX 7000 i RX 9000 dostarcza go aktualny sterownik Adrenalin; karty RX 6000 (RDNA2) potrzebują HIP SDK 7.2 od AMD. HIP 6 nie wystarczy.</sys:String>
  <sys:String x:Key="Str.NotRadeon">To nie wygląda na Radeona. Sieć działa tylko na RDNA2, RDNA3 i RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Gotowe</sys:String>
  <sys:String x:Key="Str.Payloads">Pliki</sys:String>
  <sys:String x:Key="Str.Downloading">Pobieranie</sys:String>
  <sys:String x:Key="Str.Verifying">Sprawdzanie tego, co już jest…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Pobrane i sprawdzone.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Nie udało się odczytać opublikowanej listy pobierania, więc używana jest kopia dołączona do aplikacji.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Nie udało się odczytać listy pobierania. Sprawdź połączenie i spróbuj ponownie.</sys:String>
  <sys:String x:Key="Str.Language">Język</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Pobieranie aktualizacji…</sys:String>
  <sys:String x:Key="Str.Dismiss">Nie teraz</sys:String>
  <sys:String x:Key="Str.LogSaved">Pełny log zapisano obok aplikacji.</sys:String>
  <sys:String x:Key="Str.Working">Pracuję…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Nie udało się odczytać listy gier. Zachowano ją obok jako {0} i rozpoczęto nową listę.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Trwa zapis do folderu gry. To potrwa kilka sekund; zamknij okno, gdy się skończy.</sys:String>
  <sys:String x:Key="Str.FreeTitle">To jest darmowe. Jeśli za to zapłaciłeś, ktoś Cię oszukał.</sys:String>
  <sys:String x:Key="Str.FreeBody">Nikt nie sprzedaje niczego z tego — ani instalatora, ani dodatku, ani runtime’u, ani wag. Jeśli pobrano od Ciebie opłatę za to, za „klucz” albo za „wersję pro”, żądaj zwrotu pieniędzy: to, co Ci sprzedano, jest na tej stronie za darmo.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">To jest open source i tak zostanie: czytaj kod, zmieniaj go, zbuduj własną wersję, daj ją znajomym. Prosimy tylko o jedno: niech nikt nie robi z tego płatnej wersji.</sys:String>
  <sys:String x:Key="Str.SupportSection">Wsparcie</sys:String>
  <sys:String x:Key="Str.SupportNote">dobrowolne i niczego nie odblokowuje</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Jednorazowa kawa.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">Brazylijska zbiórka projektu.</sys:String>
  <sys:String x:Key="Str.SupportRail">Wesprzyj AMD-NR</sys:String>
  <sys:String x:Key="Str.SupportTitle">Utrzymaj AMD-NR przy życiu</sys:String>
  <sys:String x:Key="Str.SupportBody">Ten projekt żyje tylko dzięki wsparciu osób, które z niego korzystają. To dwie osoby, dwie karty graficzne i popołudnia pracy: bez firmy i sponsora. Wszystko tu jest darmowe i takie zostanie. Wsparcie niczego nie odblokowuje; pozwala pracować dalej.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">Jesteś w Brazylii? Vakinha przyjmuje Pix, kartę lub boleto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — autor: danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Sama sieć i powód, dla którego to wszystko istnieje: to dzięki niej neuronowe renderowanie DLSS 5 w ogóle ruszyło na Radeonie. Runtime i wagi pobierane przez tę aplikację to jego praca, nie nasza. Dziękujemy, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — dodatek</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">To, co łączy tę sieć z grą przez ReShade: dodatek, który ta aplikacja instaluje, i wydania, spośród których możesz wybierać. Licencja MIT, osobne repozytorium niż ten instalator.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — tam są wszyscy</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Nowe wersje, co działa w której grze i gdzie pytać, gdy coś się zepsuje.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Podziękowania</sys:String>
  <sys:String x:Key="Str.Scan">Skanuj gry</sys:String>
  <sys:String x:Key="Str.Scanning">Odczytywanie Steam, Epic, GOG, EA, Ubisoft, Battle.net i Xbox…</sys:String>
  <sys:String x:Key="Str.Search">Szukaj gier…</sys:String>
  <sys:String x:Key="Str.Settings">Ustawienia</sys:String>
  <sys:String x:Key="Str.WillDownload">Pliki zostaną pobrane i sprawdzone podczas instalacji.</sys:String>
  <sys:String x:Key="Str.NoRoute">Żadne API, którego używa ta gra, nie ma ścieżki: dodatek działa na D3D11, D3D12, Vulkanie i OpenGL, a w grach 32-bitowych na D3D8, D3D9 i D3D11. 32-bitowa gra na OpenGL, 64-bitowa na D3D9 i renderer programowy nie mają żadnej.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Ta gra może działać na {1}. Ustaw w jej ustawieniach graficznych {0} — to ścieżka wybrana tutaj, a na innym API dodatek widzi zupełnie inną grę.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">To gra na Unrealu: dodaj -{0} do jej opcji uruchamiania.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Sprawdź tę grę na PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Brak gier</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Brak wyników</sys:String>
  <sys:String x:Key="Str.NoMatch">Żadna gra na liście nie pasuje do „{0}”.</sys:String>
  <sys:String x:Key="Str.ScanningShort">Skanowanie…</sys:String>
  <sys:String x:Key="Str.ScanDone">Skanowanie zakończone. Znalezione gry: {0}, nowe: {1}.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Zainstalowane</sys:String>
  <sys:String x:Key="Str.Close">Zamknij</sys:String>
  <sys:String x:Key="Str.CloseHint">Zamknij (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">Plik wykonywalny gry</sys:String>
  <sys:String x:Key="Str.ExeChoose">Wybierz…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Użyj wykrytego</sys:String>
  <sys:String x:Key="Str.ExeNone">W tym folderze nie ma pliku wykonywalnego.</sys:String>
  <sys:String x:Key="Str.ExeNote">Ścieżka jest ustalana na podstawie tego pliku. Jeśli bitowość wygląda na złą (launcher w katalogu głównym, gra w Bin64), wskaż właściwy .exe.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Ten plik wybrałeś sam, więc wykrywanie go nie zmienia, nawet po ponownym skanowaniu.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Ten plik nie leży w folderze tej gry.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">To nie jest plik wykonywalny Windows, który da się odczytać.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Ta ścieżka jest dla gier {0}, a powyższy plik wykonywalny to {1}. Nic Cię nie zatrzymuje — wykrywanie mogło odczytać zły plik — ale jeśli odczytało właściwy, to się nie załaduje.</sys:String>
  <sys:String x:Key="Str.VersionSection">Wersja dodatku</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade ładuje się jako</sys:String>
  <sys:String x:Key="Str.ProxyNote">Tryb automatyczny używa dxgi.dll, który obsługuje każdy Direct3D. Zmień to tylko wtedy, gdy gra nie chce go załadować.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler ładuje się jako</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">Tryb automatyczny używa pierwszej nazwy, jaką wiki OptiScalera podaje dla tej gry, w przeciwnym razie tej, która jest już tu używana, a w ostateczności dxgi.dll. Wybierz winmm.dll, aby zachować dxgi.dll innego programu.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatycznie</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatycznie (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Pobierz wszystko teraz</sys:String>
  <sys:String x:Key="Str.ClearCache">Wyczyść pamięć podręczną</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Usuwa pobrane pliki, okładki i listę wersji. Nic zainstalowanego w grach nie zostaje ruszone; następna instalacja pobierze ponownie to, czego potrzebuje.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Wyczyść</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Wszystko zostanie pobrane ponownie przy następnej instalacji.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Zostaw pamięć podręczną bez zmian.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Pamięć podręczna wyczyszczona — zwolniono {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Wszystko już było na miejscu i każdy bajt się zgadza.</sys:String>
  <sys:String x:Key="Str.VersionShipped">dołączona</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">Wersja, z którą wydano ten instalator.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Z wydania v{0} na GitHubie, sprawdzona według jego sum kontrolnych.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">Wersja OptiScalera</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} z wydania na GitHubie, każdy plik sprawdzony według jego sumy kontrolnej.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Zawiera wagi lmxxf (około 590 MB, tylko RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Może też dołączyć mochizuki: zobacz „Runtime NR”.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">Runtime NR</sys:String>
  <sys:String x:Key="Str.DanielVersion">Wersja danielblnc</sys:String>
  <sys:String x:Key="Str.RuntimeRecommended">Zalecana</sys:String>
  <sys:String x:Key="Str.RuntimeUnstable">Niestabilna</sys:String>
  <sys:String x:Key="Str.DanielVersionTip">Która wersja runtime'u danielblnc trafia do tej gry. Na kartach RX 9000 zalecana jest 0.4.3: nowsze zawieszały na nich gry. Inne karty dostają najnowszą.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Addon">RX 9000: mochizuki (port Vulkan od mochizuki0323, około 141 MB) też jest instalowany i uruchamia sieć. Runtime danielblnc zostaje obok: wybierz go w NR runtime w panelu dodatku. Pierwsze uruchomienie każdej gry kompiluje sieć do minuty.</sys:String>
  <sys:String x:Key="Str.RuntimeRdna4Opti">RX 9000: nowa instalacja uruchamia lmxxf, a mochizuki (około 141 MB) trafia obok runtime'u danielblnc. Wybierz inny w NR runtime w zakładce Neural OptiScalera i uruchom grę ponownie.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Wybierz ścieżkę instalacji</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Aplikacja nie ustaliła, jakiego API graficznego używa {0}, więc nie wybiera ścieżki za Ciebie. OptiScaler jest dla gry na D3D12, która ma w ustawieniach DLSS, FSR lub XeSS; ReShade, na D3D11 lub D3D12, jest dla każdej innej. Instalacja poczeka, aż wybierzesz.</sys:String>
  <sys:String x:Key="Str.PickRouteBodyAll">Ta aplikacja nie rozpoznała, z jakiego API graficznego korzysta {0}, więc nie wybiera za ciebie ścieżki. OptiScaler działa w 64-bitowych grach D3D9, D3D11, D3D12, Vulkan i OpenGL, wewnątrz DLSS, FSR lub XeSS gry, gdy ją ma; ReShade obejmuje też gry 32-bitowe, emulatory i D3D10. Instalacja czeka na twój wybór.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">API graficzne jest nieznane, więc ścieżkę wybierasz poniżej.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">Runtime danielblnc</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Która wersja runtime’u trafi do tej gry. Używana jest wyróżniona karta.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Wydanie publiczne ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Pobrane i sprawdzone przez tę aplikację.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Lokalna wersja dla wspierających ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Wybierz mój version.dll lub instalator…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Wybierz inny plik…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Nowsza niż wydanie publiczne, z Twojego version.dll lub instalatora danielblnc.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 dodaje kernele dla kart RDNA3.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.6.0">0.6.0 dodaje karty RX 6000 (RDNA2), które wymagają środowiska HIP SDK 7.2 od AMD, i usuwa migotanie w ciemnych miejscach i na małych światłach.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Ta aplikacja nigdy go nie pobiera ani nie udostępnia. Twój plik jest sprawdzany przez SHA-256 i zachowywany, więc inne gry nie pytają ponownie.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Użyj moich plików dla wspierających…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Wydanie publiczne</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Twój version.dll lub dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Dowolna biblioteka DLL lub instalator</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">W użyciu: runtime pobierany przez tę aplikację.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Używany {0} z Twojego pliku.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Używany {0}: sprawdzona kopia zachowana, gdy wybrałeś go wcześniej.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">Wybrano {0}, ale na tym komputerze nie ma jeszcze jego kopii: wybierz swój version.dll lub instalator.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} wymaga dodatku v{1} lub nowszego: wybierz go w „Wersja dodatku”. Do tego czasu instalowana jest wersja do pobrania.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} wymaga OptiScalera {1} lub nowszego: wybierz go w „Wersja OptiScalera”. Do tego czasu instalowana jest wersja do pobrania.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">Dodatek nie może jeszcze uruchomić {0}: lista plików nie zawiera jego poprawki. Do tego czasu instalowana jest tu wersja do pobrania; ścieżka OptiScaler uruchamia go bez zmian.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Sprawdzony i zachowany: runtime danielblnc {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Tego pliku nie można użyć. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Sprawdzanie folderu…</sys:String>
  <sys:String x:Key="Str.StepDownload">Pobieranie</sys:String>
  <sys:String x:Key="Str.StepVerify">Sprawdzanie</sys:String>
  <sys:String x:Key="Str.StepInstall">Instalacja</sys:String>
  <sys:String x:Key="Str.StepDone">Gotowe</sys:String>
  <sys:String x:Key="Str.Installing">Instalowanie…</sys:String>
  <sys:String x:Key="Str.Removing">Usuwanie…</sys:String>
  <sys:String x:Key="Str.InstallOk">Gra {0} jest gotowa. Uruchom ją, aby z tego korzystać.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Zainstalowano w grze {0}; poniżej jest {1} ostrzeżenie do przeczytania.</sys:String>
  <sys:String x:Key="Str.InstallFail">Instalacja w grze {0} nie została ukończona.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Usunięto z gry {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Usunięto z gry {0}; poniżej jest {1} ostrzeżenie do przeczytania.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Nie udało się usunąć wszystkiego z gry {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">Gra {0} nadal liczy się jako zainstalowana: nie udało się usunąć jednego z plików tej aplikacji. Zamknij grę i odinstaluj ponownie.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Usunięto z gry {0} — w jej folderze nie zostało nic z tej aplikacji.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Usunięto z gry {0} — zostały tylko Twoje ustawienia: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Usunąć też ustawienia?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Wszystko, co ta aplikacja zainstalowała w grze {0}, zostało usunięte. Zostały te pliki ustawień — przechowują to, co ustawiono w nakładce:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Usuń je też</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">Folder wróci do stanu sprzed instalacji.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Zachowaj ustawienia</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Zostaną na następną instalację.</sys:String>
  <sys:String x:Key="Str.ResultErrors">Poniżej opisano {0} problem.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Nie udało się pobrać plików, więc nic nie zostało zainstalowane.</sys:String>
  <sys:String x:Key="Str.Folder">Folder</sys:String>
  <sys:String x:Key="Str.GameCount">Gry: {0}</sys:String>
  <sys:String x:Key="Str.UnknownApi">Nieznane API</sys:String>
  <sys:String x:Key="Str.Location">Lokalizacja</sys:String>
  <sys:String x:Key="Str.Details">Szczegóły</sys:String>
  <sys:String x:Key="Str.DetailsCount">Wiersze: {0}</sys:String>
  <sys:String x:Key="Str.PreflightOk">Gotowe do instalacji</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Nic nie stoi na przeszkodzie. Wybierz ścieżkę poniżej i naciśnij „Zainstaluj”.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Gotowe do instalacji; {0} uwaga do przeczytania</sys:String>
  <sys:String x:Key="Str.PreflightErr">W tym folderze znaleziono {0} problem</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Zainstalowane w tej grze</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Uruchom grę, aby z tego korzystać. Zainstaluj ponownie, aby odświeżyć pliki, lub odinstaluj, aby je usunąć.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Zainstalowane, dostępna aktualizacja</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Pliki w tej grze są starsze niż te, które ta aplikacja instaluje teraz. „Aktualizuj” je podmieni; Twoje ustawienia zostaną.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Otwórz „Szczegóły” poniżej, aby zobaczyć, co znaleziono.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Czego dodatek potrzebuje od tego komputera, sprawdzane przy starcie aplikacji.</sys:String>
  <sys:String x:Key="Str.SystemReady">Ten komputer ma wszystko, czego potrzebuje dodatek</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Temu komputerowi brakuje czegoś, czego potrzebuje dodatek</sys:String>
  <sys:String x:Key="Str.GpuOk">Wykryto Radeona</sys:String>
  <sys:String x:Key="Str.GpuBad">To nie jest Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Brak</sys:String>
  <sys:String x:Key="Str.DriverHint">Wersja sterownika graficznego podawana przez Windows.</sys:String>
  <sys:String x:Key="Str.FilesHint">Pobierane raz, sprawdzane według ustalonej sumy kontrolnej i używane ponownie w każdej grze.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Sprawdzone</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Nie pobrano</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Pobieranie…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Pobieranie {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Język, aktualizacje i informacje o aplikacji.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Wszystkie napisy zmieniają się od razu; restart nie jest potrzebny.</sys:String>
  <sys:String x:Key="Str.DataFolder">Folder danych</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">Gra D3D10/D3D11</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">Gra D3D12</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Gra Vulkan</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">Gra OpenGL</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">Gra D3D10/D3D11, 32-bitowa</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">Gra D3D9, 32-bitowa</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">Gra D3D8, 32-bitowa</sys:String>
  <sys:String x:Key="Str.Preset.X86OpenGL">Gra OpenGL, 32-bitowa</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: gra D3D12 z DLSS, FSR lub XeSS</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Ustaw w emulatorze Direct3D 11: to renderer, w którym sieć dostaje najwięcej — głębię z emulatora i ruch z efektu towarzyszącego, gdy jest zainstalowany. Uważaj na ustawienia dla konkretnej gry, które po cichu nadpisują globalne.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Eksperymentalne. ReShade na Vulkanie to warstwa, nie biblioteka proxy: instalacja rejestruje ją dla Twojego użytkownika Windows i włącza dla rpcs3.exe przez ReShade.ini. Na Vulkanie nie ma głębi, tylko kolor i szacowany ruch.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">Najlepsza ścieżka: D3D11 to jedyne API, w którym do sieci trafiają własne wektory ruchu gry razem z jej głębią. Gra D3D10 też idzie tą ścieżką, tylko z kolorem.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Ograniczona. Na D3D12 dodatek znajduje głębię gry, ale nie jej wektory ruchu, więc sieć dostaje kolor i głębię, a ruch szacuje. Działa, ale spodziewaj się mniej. Grę z DLSS, FSR lub XeSS w ustawieniach lepiej obsłuży ścieżka OptiScaler.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Zalecana dla gier D3D12. Zamiast ReShade instaluje OptiScalera, który przejmuje DLSS, FSR lub XeSS gry i uruchamia sieć w jego wnętrzu, z własną głębią i wektorami ruchu gry. Gra musi oferować jeden z tych upscalerów, włączony w jej ustawieniach. W grze naciśnij Insert, otwórz kartę Neural i włącz Enable NR; gra z Ray Reconstruction wymaga punktu przetwarzania „After the finished frame”.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Eksperymentalne. ReShade na Vulkanie to warstwa: instalacja rejestruje ją dla Twojego użytkownika Windows i włącza dla tego programu przez ReShade.ini obok jego .exe. Na Vulkanie nie ma głębi.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Eksperymentalne. W przeciwieństwie do Vulkana to zwykła biblioteka proxy: ReShade trafia obok gry jako opengl32.dll, bez uruchamiania osobnego instalatora. Tylko kolor i szacowany ruch; głębia gry jest na tym API dostępna, ale jeszcze niepodłączona. 32-bitowa gra na OpenGL idzie 32-bitową ścieżką OpenGL.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Eksperymentalne. Gra 32-bitowa nie może załadować 64-bitowego runtime’u, więc dodatek działa jako para współdzieląca klatki na jednej karcie. Zainstaluj ReShade z obsługą dodatków jako 32-bitowy dxgi.dll. Gra D3D10 też idzie tą ścieżką, tylko z kolorem.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Eksperymentalne. Ta sama 32-bitowa para co przy D3D11, przez prywatny etap D3D9/D3D11. Zwykły D3D9 kosztuje stałe kilka milisekund na klatkę; D3D9Ex nie. Zainstaluj ReShade jako 32-bitowy d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Eksperymentalne. D3D8 jest tłumaczony na D3D9 i idzie dalej ścieżką D3D9 powyżej, z tą samą 32-bitową parą. Zainstaluj ReShade jako 32-bitowy d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86OpenGL">Eksperymentalne. Ta sama 32-bitowa para, w kontekście OpenGL gry: tylko kolor i szacowany ruch. Zainstaluj ReShade jako 32-bitową opengl32.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM ma własny anti-cheat: na własne ryzyko, i sprawdź zasady swojego serwera. Dodatek i ReShade trafiają do FiveM.app\plugins, runtime i wagi obok procesu gry w data\cache\subprocess. To, co już masz w plugins — ReShade.ini, presety, shadery, inne dodatki, ENB — zostaje bez zmian.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Witaj</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">Sieć DLSS 5 Neural Rendering na kartach Radeon, przez ReShade lub OptiScalera. Cztery szybkie kroki.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Ten komputer</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Pliki</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Twoje gry</sys:String>
  <sys:String x:Key="Str.SetupBack">Wstecz</sys:String>
  <sys:String x:Key="Str.SetupNext">Dalej</sys:String>
  <sys:String x:Key="Str.SetupFinish">Zacznij korzystać</sys:String>
  <sys:String x:Key="Str.SetupSkip">Na razie pomiń</sys:String>
  <sys:String x:Key="Str.SetupStepOf">Krok {0} z {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Dwie rzeczy mogą uniemożliwić działanie dodatku i obie widać stąd. Żadna nie blokuje dalszych kroków — tylko działanie w grze.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Ten komputer ma wszystko, czego potrzebuje dodatek.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Czegoś brakuje. Możesz kontynuować i naprawić to później, ale w grze nie zadziała, dopóki tego nie zrobisz.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Te same pliki służą każdej grze: pobierane raz, sprawdzane według ustalonej sumy kontrolnej i używane ponownie.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Spróbuj ponownie</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Pomiń to, a pliki zostaną pobrane przy pierwszej instalacji.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">Launchery są tylko odczytywane: samo przeglądanie niczego nie instaluje ani nie zmienia. Foldery możesz potem dodać ręcznie.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Każda gra jest odczytywana, aby ustalić, jakiego API graficznego używa, i zwykle wynik jest trafny, ale nie zawsze: jeden folder może zawierać plik wykonywalny D3D11 i D3D12, a gra może domyślnie używać jednego API, choć jej plik obsługuje też starsze. Przed instalacją warto sprawdzić grę na pcgamingwiki.com — każda karta gry ma do niej bezpośredni link.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Nie znaleziono gier. Folder możesz dodać ręcznie w głównym oknie.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">Znalezione gry: {0}.</sys:String>
  <sys:String x:Key="Str.Unexpected">Stało się coś nieoczekiwanego. Zapisano pełny log.</sys:String>
  <sys:String x:Key="Str.Play">Graj</sys:String>
  <sys:String x:Key="Str.Launch">Otwórz</sys:String>
  <sys:String x:Key="Str.Configure">Konfiguruj</sys:String>
  <sys:String x:Key="Str.ViewGrid">Siatka okładek</sys:String>
  <sys:String x:Key="Str.ViewList">Lista, ze stroną gry obok</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Automatyczna aktualizacja</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Gdy pojawi się nowsza wersja, ta gra zaktualizuje się sama przy otwarciu aplikacji.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">Automatycznie zaktualizowano {0} grę.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">Automatycznie zaktualizowane gry: {0}.</sys:String>
  <sys:String x:Key="Str.Rename">Zmień nazwę</sys:String>
  <sys:String x:Key="Str.Save">Zapisz</sys:String>
  <sys:String x:Key="Str.Cancel">Anuluj</sys:String>
  <sys:String x:Key="Str.ChangeCover">Okładka</sys:String>
  <sys:String x:Key="Str.CoverPick">Wybierz obraz…</sys:String>
  <sys:String x:Key="Str.CoverChange">Zmień okładkę…</sys:String>
  <sys:String x:Key="Str.CoverReset">Użyj okładki znalezionej w sieci</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Wybierz okładkę dla tej gry</sys:String>
  <sys:String x:Key="Str.CoverFiles">Obrazy</sys:String>
  <sys:String x:Key="Str.CoverFailed">Nie udało się odczytać tego pliku jako obrazu.</sys:String>
  <sys:String x:Key="Str.Customize">Dostosuj</sys:String>
  <sys:String x:Key="Str.HeroPick">Wybierz baner…</sys:String>
  <sys:String x:Key="Str.HeroReset">Użyj banera znalezionego w sieci</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Wybierz baner dla tej gry</sys:String>
  <sys:String x:Key="Str.PlayFailed">Nie udało się uruchomić. Otwórz folder i uruchom plik wykonywalny ręcznie.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Dodaj emulator</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Dodaj emulator</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Wybierz który, a potem wskaż folder, z którego się uruchamia — folder z plikiem wykonywalnym, nie ten z ROM-ami.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Inny emulator</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Wskaż folder, a powiem, co da się z niego wyczytać.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Wskaż folder {0}</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Wskaż folder emulatora</sys:String>
  <sys:String x:Key="Str.EmulatorFound">Znaleziono {0}: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">To nie wygląda na {0}: w tym folderze nie ma {1}. Dodano mimo to — sprawdź ścieżkę.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Nie ma tu żadnego znanego mi emulatora. Dodano na podstawie tego, co mówią pliki: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">W emulatorze</sys:String>
  <sys:String x:Key="Str.ReportTitle">Nie działa w grze?</sys:String>
  <sys:String x:Key="Str.ReportBody">Pakuje logi i listę plików folderu gry do pliku .zip na Twoim komputerze. Nic nie jest wysyłane.</sys:String>
  <sys:String x:Key="Str.Report">Zgłoś problem</sys:String>
  <sys:String x:Key="Str.ReportSaved">Raport zapisany, folder otwarty: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Nie udało się utworzyć raportu. Logi są w {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Zbieranie…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Pliki się nie pobierają?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Zbiera to, czego próbowało każde pobieranie — każdy adres, jego rozwiązanie nazwy, proxy i odpowiedź — i ponownie sprawdza każdy adres, wszystko w jednym pliku .zip. Nic nie jest wysyłane: plik zostaje na Twoim komputerze, a Ty udostępniasz go, gdzie chcesz.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Logi pobierania</sys:String>
  <sys:String x:Key="Str.Add">Dodaj</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Przeszukaj folder w poszukiwaniu gier…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Folder jednej gry…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Emulator…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Aktualizuj</sys:String>
  <sys:String x:Key="Str.GamesAway">Na niepodłączonym dysku: {0}</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Gry na dysku, który nie jest teraz podłączony, są zapamiętane razem ze wszystkim, co dla nich wybrano, i wrócą, gdy dysk wróci.</sys:String>
  <sys:String x:Key="Str.GameGone">Gra {0} nie jest już zainstalowana, więc zniknęła z listy.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} gra nie jest już zainstalowana, więc zniknęła z listy.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">Gry, które nie są już zainstalowane i zniknęły z listy: {0}.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Pokaż szczegóły</sys:String>
  <sys:String x:Key="Str.DetectedSection">Wykryto</sys:String>
  <sys:String x:Key="Str.InstallsInto">Instaluje do: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">To poza dodanym folderem: tu jest {0}, kompilacja, którą uruchamia launcher. Jeśli grasz na innej, wybierz powyżej jej {0}.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Pliki mówią, z czym gra jest linkowana, a nie na czym działa: jeden folder może zawierać plik wykonywalny D3D11 i D3D12. Wiki mówi, którego gra używa.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Odczytane z własnych plików gry.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">Z PCGamingWiki i plików gry.</sys:String>
  <sys:String x:Key="Str.InstallWith">Zainstaluj przez</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + dodatek</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Zalecane</sys:String>
  <sys:String x:Key="Str.RecommendedLower">zalecane</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">Dodatek wewnątrz ReShade. D3D11, D3D12, Vulkan, OpenGL, gry 32-bitowe i emulatory.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Brak ścieżki ReShade dla tego, co odczytano w tej grze ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Działa wewnątrz DLSS, FSR lub XeSS gry, z jej własną głębią i ruchem. Zastępuje ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Działa wewnątrz upscalera gry (znaleziono tu {0}). Zastępuje ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Przeznaczone dla 64-bitowych gier D3D12; ta gra wygląda na {0}.</sys:String>
  <sys:String x:Key="Str.RouteOptiSummaryAll">Działa wewnątrz DLSS, FSR lub XeSS gry, gdy ją ma, a gdy nie ma — na gotowym obrazie. 64-bitowe D3D9, D3D11, D3D12, Vulkan i OpenGL. Zastępuje ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfitAll">Przeznaczone dla 64-bitowych gier D3D9, D3D11, D3D12, Vulkan i OpenGL; ta gra wygląda na {0}.</sys:String>
  <sys:String x:Key="Str.ApiSection">API graficzne</sys:String>
  <sys:String x:Key="Str.Group64">Gry 64-bitowe</sys:String>
  <sys:String x:Key="Str.Group32">Gry 32-bitowe (eksperymentalne)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Emulatory</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V online</sys:String>
  <sys:String x:Key="Str.OptiAbout">Zamiast ReShade instaluje OptiScalera, który przejmuje DLSS, FSR lub XeSS gry i uruchamia sieć w jego wnętrzu, z własną głębią i wektorami ruchu gry.</sys:String>
  <sys:String x:Key="Str.InGame">W grze</sys:String>
  <sys:String x:Key="Str.OptiStep1">Włącz DLSS, FSR lub XeSS w ustawieniach graficznych gry.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Naciśnij Insert, otwórz kartę Neural i włącz Enable NR.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Przy włączonym Ray Reconstruction ustaw punkt przetwarzania na „After the finished frame”.</sys:String>
  <sys:String x:Key="Str.InstallOpti">Zainstaluj OptiScalera</sys:String>
  <sys:String x:Key="Str.Update">Aktualizuj</sys:String>
  <sys:String x:Key="Str.Reinstall">Zainstaluj ponownie</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Przełącz na OptiScalera</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Przełącz na ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Przełączyć na {0}?</sys:String>
  <sys:String x:Key="Str.SwitchBody">Gra {0} ma zainstalowaną ścieżkę {1}, a obie nie mogą być naraz w jednym folderze. Najpierw {1} zostanie usunięty, z przywróceniem wszystkiego, co zastąpił, a potem zostanie zainstalowany {2}.</sys:String>
  <sys:String x:Key="Str.SwitchYes">Usuń {0}, zainstaluj {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Twoje pliki ustawień zostaną na miejscu.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Nic się nie zmieni; {0} pozostanie zainstalowany.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">Przyczyna jest w „Szczegółach”. Nic nie zostało zainstalowane.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Pliki można też pobrać przeglądarką i przekazać aplikacji: „Ten komputer” &gt; „Pliki” &gt; „Pobierz ręcznie”, a potem „Importuj pliki”. Pliki w folderze Pobrane zostaną znalezione same.</sys:String>
  <sys:String x:Key="Str.DnsRetry">Wyczyść DNS i spróbuj ponownie</sys:String>
  <sys:String x:Key="Str.GameRunning">{0} działa z tego folderu</sys:String>
  <sys:String x:Key="Str.CloseGame">Zamknij {0}</sys:String>
  <sys:String x:Key="Str.CloseGameAsk">Zakończyć {0}? Wszystko, co nie zostało zapisane, przepadnie. Instalacja i odinstalowanie wymagają zamknięcia: nie da się podmienić plików, które wczytał.</sys:String>
  <sys:String x:Key="Str.CleanRetry">Wyczyść i spróbuj ponownie</sys:String>
  <sys:String x:Key="Str.CleanRetryTitle">Przeszkadza wcześniejsza instalacja</sys:String>
  <sys:String x:Key="Str.CleanRetryDetail">Jej zapis nie pasuje do tej instalacji. Wyczyść i spróbuj ponownie usuwa pliki tej aplikacji, zachowuje ustawienia i instaluje od nowa.</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows nie pozwolił stąd wyczyścić pamięci podręcznej DNS. Otwórz wiersz polecenia, uruchom ipconfig /flushdns i spróbuj ponownie.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">Problemy znalezione w tym folderze: {0}</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Gotowe do instalacji; uwagi do przeczytania: {0}</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Zainstalowano w grze {0}; ostrzeżenia do przeczytania poniżej: {1}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Usunięto z gry {0}; ostrzeżenia do przeczytania poniżej: {1}.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">Problemy opisane poniżej: {0}.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Brak listy pobierania</sys:String>
  <sys:String x:Key="Str.FailedShort">Niepowodzenie</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Gotowe wszystkie ({0})</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">Brakuje: {0} · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Nie udało się pobrać: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Pobierz ręcznie</sys:String>
  <sys:String x:Key="Str.ImportFiles">Importuj pliki…</sys:String>
  <sys:String x:Key="Str.ImportHint">Wybierz folder z plikami pobranymi samodzielnie. Każdy plik jest rozpoznawany po nazwie i przyjmowany tylko wtedy, gdy zgadza się z ustaloną sumą kontrolną.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Pobierz pliki samodzielnie</sys:String>
  <sys:String x:Key="Str.ManualBody">Otwórz każdy link w przeglądarce i zapisz plik gdziekolwiek: folder Pobrane jest przeszukiwany sam, a „Importuj pliki” przyjmie każdy inny folder. Nazw nie trzeba zmieniać, a nic, co nie zgadza się z ustaloną sumą SHA-256, nie zostanie użyte.</sys:String>
  <sys:String x:Key="Str.ImportPick">Wybierz folder z pobranymi plikami</sys:String>
  <sys:String x:Key="Str.ImportAll">Wszystkie pliki są już na miejscu i sprawdzone.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Nic w tym folderze nie pasuje do potrzebnych plików.</sys:String>
  <sys:String x:Key="Str.ImportSome">Przyjęto: {0}. Nadal brakuje: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">Dodatek</sys:String>
  <sys:String x:Key="Str.Component.runtime">Runtime neuronowy i wagi</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">Most 32-bitowy</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">Dodatki 32-bitowe</sys:String>
  <sys:String x:Key="Str.Component.shader">Efekt towarzyszący</sys:String>
  <sys:String x:Key="Str.Updates">Aktualizacje</sys:String>
  <sys:String x:Key="Str.UpToDate">Aktualne</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Sprawdzanie, czy jest nowsza wersja…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0} to najnowsza wersja. Sprawdzono o {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">Dostępna jest wersja {0}. Masz {1}.</sys:String>
  <sys:String x:Key="Str.HotfixLabel">v{0} poprawka {1}</sys:String>
  <sys:String x:Key="Str.HotfixShort">poprawka {0}</sys:String>
  <sys:String x:Key="Str.HotfixOut">Dostępna jest poprawka {1} do v{0}: naprawy tej wersji, nie nowa wersja.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">Nie udało się sprawdzić: GitHub nie odpowiedział. Aplikacja działa tak samo.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Pobierz aktualizację</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Pobierz z GitHuba</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Sprawdź aktualizacje</sys:String>
  <sys:String x:Key="Str.SessionSection">Ostatnia sesja</sys:String>
  <sys:String x:Key="Str.SessionTip">Odczytane z logów, które dodatek i runtime zapisują w folderze gry. Odczytywane ponownie, gdy wracasz do tego okna po grze.</sys:String>
  <sys:String x:Key="Str.SessionRan">NR działał w ostatniej sesji</sys:String>
  <sys:String x:Key="Str.SessionCrashed">Gra uległa awarii w ostatniej sesji</sys:String>
  <sys:String x:Key="Str.SessionFailed">NR nie uruchomił się w ostatniej sesji</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade się uruchomił, ale dodatek się nie załadował</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">Mod się załadował, ale NR nie przetworzył żadnej klatki</sys:String>
  <sys:String x:Key="Str.SessionNever">Jeszcze nie było sesji. Uruchom grę raz i wróć: tu pojawi się informacja, czy NR działał.</sys:String>
  <sys:String x:Key="Str.SessionFrames">Przetworzone klatki: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">Sieć: {0} ms na klatkę</sys:String>
  <sys:String x:Key="Str.SessionRuntime">Runtime {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">W grze otwórz nakładkę ReShade klawiszem Home i sprawdź, czy NR jest włączony w panelu AMD Neural Rendering.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">W grze włącz DLSS, FSR lub XeSS, potem naciśnij Insert, otwórz kartę Neural i włącz Enable NR.</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">ReShade.log w folderze gry mówi, w którym folderze ReShade szukał dodatków. „Zgłoś problem” spakuje go z resztą.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">„Zgłoś problem” pakuje te logi w jeden plik do udostępnienia na Discordzie.</sys:String>
  <sys:String x:Key="Str.SortFilter">Sortuj i filtruj</sys:String>
  <sys:String x:Key="Str.FilterShow">Pokaż</sys:String>
  <sys:String x:Key="Str.FilterAll">Wszystkie gry</sys:String>
  <sys:String x:Key="Str.FilterInstalled">Zainstalowane</sys:String>
  <sys:String x:Key="Str.FilterUpdates">Dostępna aktualizacja</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">Niezainstalowane</sys:String>
  <sys:String x:Key="Str.FilterEmulators">Emulatory</sys:String>
  <sys:String x:Key="Str.SortBy">Sortuj według</sys:String>
  <sys:String x:Key="Str.SortName">Nazwa</sys:String>
  <sys:String x:Key="Str.SortRecent">Ostatnio grane</sys:String>
  <sys:String x:Key="Str.SortAdded">Ostatnio dodane</sys:String>
  <sys:String x:Key="Str.FilterFavorites">Ulubione</sys:String>
  <sys:String x:Key="Str.SortPinnedFirst">Najpierw ulubione i zainstalowane</sys:String>
  <sys:String x:Key="Str.Favorite">Ulubiona</sys:String>
  <sys:String x:Key="Str.AddFavorite">Dodaj do ulubionych</sys:String>
  <sys:String x:Key="Str.RemoveFavorite">Usuń z ulubionych</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">Żadna gra na liście nie pasuje do tego filtra.</sys:String>
  <sys:String x:Key="Str.WhatsNew">Co nowego</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">Otwórz na GitHubie</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">Nie udało się odczytać informacji z GitHuba. Są na stronie wydania.</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">To wydanie opublikowano bez opisu zmian.</sys:String>
  <sys:String x:Key="Str.Transfer">Ustawienia NR</sys:String>
  <sys:String x:Key="Str.TransferTip">Ustawienia NR tej gry w jednym pliku, do zachowania lub udostępnienia, oraz sposób na wczytanie cudzych. Najpierw zamknij grę: zapisuje ustawienia przy wyjściu.</sys:String>
  <sys:String x:Key="Str.TransferExport">Eksportuj do pliku…</sys:String>
  <sys:String x:Key="Str.TransferImport">Importuj z pliku…</sys:String>
  <sys:String x:Key="Str.TransferNothing">Na razie nie ma czego eksportować: ustawienia zapisują się przy pierwszym uruchomieniu gry z modem.</sys:String>
  <sys:String x:Key="Str.TransferExported">Ustawienia zapisano w {0}.</sys:String>
  <sys:String x:Key="Str.TransferImported">Ustawienia z {0} są wczytane. Zastąpione ustawienia zachowano w {1}.</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">Te ustawienia są dla ścieżki {0}, a w tej grze zainstalowano {1}.</sys:String>
  <sys:String x:Key="Str.TransferInvalid">Ten plik nie jest eksportem ustawień AMD-NR.</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. Uważaj na ustawienia dla konkretnej gry we właściwościach gry: po cichu nadpisują globalne i to najczęstszy powód, dla którego wygląda to na zepsute, choć nie jest.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. Nie ma tu w ogóle Direct3D, więc ta ścieżka dostaje tylko kolor i szacowany ruch — bez głębi.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">Działa na D3D12, czyli na ograniczonej ścieżce: dodatek dostaje gotową klatkę i nic więcej. Działa, ale spodziewaj się mniej.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Na Vulkanie nie ma głębi: tylko kolor i szacowany ruch.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Na Vulkanie nie ma głębi.</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. Na Vulkanie nie ma głębi.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan jest domyślnym backendem. Na Vulkanie nie ma głębi.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Tylko Vulkan. Na Vulkanie nie ma głębi, a sam emulator jest na wczesnym etapie — spodziewaj się problemów.</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">Tylko Vulkan. Wskaż folder kyty_emulator.exe (launcher.exe tylko go uruchamia). Bez głębi, a sam emulator jest jeszcze wczesny — spodziewaj się problemów.</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">W grze: Home otwiera ReShade, a AMD Neural Rendering jest w Add-ons, albo Ctrl+End. FiveM ma własny anti-cheat — najpierw sprawdź zasady serwera.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. OpenGL też ma już ścieżkę, ale to Vulkan jest tu najlepiej sprawdzony.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu renderuje wyłącznie przez OpenGL, więc ścieżka OpenGL jest tu jedyna. To najnowsza ze ścieżek i jest eksperymentalna: kolor i szacowany ruch, bez głębi.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. Renderer programowy rysuje na CPU i dodatek nie ma tam do czego się dostać, więc musi to być OpenGL — a ta ścieżka jest eksperymentalna: kolor i szacowany ruch, bez głębi.</sys:String>

</ResourceDictionary>
