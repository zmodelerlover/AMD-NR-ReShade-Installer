<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="AmdNr.App.Languages.Lithuanian">

  <!-- Lietuvių. The same keys as Strings.en.axaml, in its order. -->

  <sys:String x:Key="Str.AppTitle">AMD-NR ReShade Installer</sys:String>
  <sys:String x:Key="Str.Subtitle">DLSS 5 neuroninis atvaizdavimas Radeon kortose, įdiegtas už jus</sys:String>
  <sys:String x:Key="Str.Games">Žaidimai</sys:String>
  <sys:String x:Key="Str.RemoveGame">Pašalinti iš sąrašo</sys:String>
  <sys:String x:Key="Str.RemoveGameHint">Išima žaidimą iš sąrašo, ir „Ieškoti žaidimų“ jį taip pat praleis. Jo aplanke neliečiamas joks failas; grąžinti galima nustatymuose.</sys:String>
  <sys:String x:Key="Str.RemovedGame">Žaidimas {0} išimtas iš sąrašo, ir „Ieškoti žaidimų“ jį praleis. Jo aplanke niekas nepaliesta; grąžinti galima skiltyje „Nustatymai“ &gt; „Nepaisomi žaidimai“.</sys:String>
  <sys:String x:Key="Str.RemovedGameInstalled">Žaidimas {0} išimtas iš sąrašo, bet priedas vis dar įdiegtas jo aplanke. Grąžinkite jį iš „Nustatymai“ &gt; „Nepaisomi žaidimai“, kad galėtumėte jį pašalinti.</sys:String>
  <sys:String x:Key="Str.IgnoredGames">Nepaisomi žaidimai</sys:String>
  <sys:String x:Key="Str.IgnoredGamesHint">Žaidimai, kuriuos išėmėte iš sąrašo. „Ieškoti žaidimų“ juos praleidžia, todėl jie lieka už sąrašo ribų, kol jų čia negrąžinsite.</sys:String>
  <sys:String x:Key="Str.IgnoredNone">Nepaisomų žaidimų nėra.</sys:String>
  <sys:String x:Key="Str.IgnoredRestore">Grąžinti į sąrašą</sys:String>
  <sys:String x:Key="Str.IgnoredRestored">Žaidimas {0} vėl sąraše.</sys:String>
  <sys:String x:Key="Str.IgnoredGone">Žaidimo {0} aplanko nebėra, todėl jis tik išimtas iš nepaisomų žaidimų.</sys:String>
  <sys:String x:Key="Str.NoGames">Kol kas čia nieko nėra. Pridėkite aplanką, iš kurio paleidžiamas žaidimas ar emuliatorius.</sys:String>
  <sys:String x:Key="Str.PickFolder">Pasirinkite aplanką, iš kurio paleidžiamas žaidimas</sys:String>
  <sys:String x:Key="Str.AddGameMany">Ieškoti aplanke</sys:String>
  <sys:String x:Key="Str.AddGamePickLibrary">Pasirinkite aplanką, kuriame laikote žaidimus</sys:String>
  <sys:String x:Key="Str.AddGameNone">Aplanke „{0}“ nerasta nieko, kas atrodytų kaip žaidimas.</sys:String>
  <sys:String x:Key="Str.Preset">Maršrutas</sys:String>
  <sys:String x:Key="Str.Install">Įdiegti</sys:String>
  <sys:String x:Key="Str.Uninstall">Pašalinti</sys:String>
  <sys:String x:Key="Str.OpenFolder">Atidaryti aplanką</sys:String>
  <sys:String x:Key="Str.System">Šis kompiuteris</sys:String>
  <sys:String x:Key="Str.Gpu">Vaizdo plokštė</sys:String>
  <sys:String x:Key="Str.Driver">Tvarkyklė</sys:String>
  <sys:String x:Key="Str.Hip">HIP 7 vykdymo aplinka</sys:String>
  <sys:String x:Key="Str.HipMissing">amdhip64_7.dll nerastas. Jį pateikia naujausia Adrenalin tvarkyklė; HIP 6 netinka.</sys:String>
  <sys:String x:Key="Str.NotRadeon">Tai neatrodo kaip Radeon. Tinklas veikia tik su RDNA3 ir RDNA4.</sys:String>
  <sys:String x:Key="Str.Ready">Paruošta</sys:String>
  <sys:String x:Key="Str.Payloads">Failai</sys:String>
  <sys:String x:Key="Str.Downloading">Atsisiunčiama</sys:String>
  <sys:String x:Key="Str.Verifying">Tikrinama, kas jau yra…</sys:String>
  <sys:String x:Key="Str.PayloadsReady">Atsisiųsta ir patikrinta.</sys:String>
  <sys:String x:Key="Str.ManifestLocal">Nepavyko perskaityti paskelbto atsisiuntimų sąrašo, todėl naudojama su programa pateikta kopija.</sys:String>
  <sys:String x:Key="Str.ManifestFailed">Nepavyko perskaityti atsisiuntimų sąrašo. Patikrinkite ryšį ir bandykite dar kartą.</sys:String>
  <sys:String x:Key="Str.Language">Kalba</sys:String>
  <sys:String x:Key="Str.UpdateWorking">Atsisiunčiamas naujinys…</sys:String>
  <sys:String x:Key="Str.Dismiss">Ne dabar</sys:String>
  <sys:String x:Key="Str.LogSaved">Visas žurnalas įrašytas šalia programos.</sys:String>
  <sys:String x:Key="Str.Working">Vykdoma…</sys:String>
  <sys:String x:Key="Str.GamesUnreadable">Nepavyko perskaityti žaidimų sąrašo. Jis išsaugotas šalia kaip {0}, ir pradėtas naujas sąrašas.</sys:String>
  <sys:String x:Key="Str.CloseWhileBusy">Vis dar rašoma į žaidimo aplanką. Tai užtrunka kelias sekundes; uždarykite langą, kai baigsis.</sys:String>
  <sys:String x:Key="Str.FreeTitle">Tai nemokama. Jei už tai sumokėjote, jus apgavo.</sys:String>
  <sys:String x:Key="Str.FreeBody">Niekas iš to nieko neparduoda — nei diegimo programos, nei priedo, nei vykdymo aplinkos, nei svorių. Jei iš jūsų paėmė pinigus už tai, už „raktą“ ar „pro versiją“, reikalaukite juos grąžinti: tai, ką jums pardavė, šiame puslapyje yra nemokamai.</sys:String>
  <sys:String x:Key="Str.OpenSourceBody">Tai atvirasis kodas, ir toks jis liks: skaitykite, keiskite, susikurkite savo versiją, dalinkitės su draugais. Prašome tik vieno: kad niekas iš to nedarytų mokamos versijos.</sys:String>
  <sys:String x:Key="Str.SupportSection">Parama</sys:String>
  <sys:String x:Key="Str.SupportNote">neprivaloma ir nieko neatrakina</sys:String>
  <sys:String x:Key="Str.SupportKofiTitle">Ko-fi</sys:String>
  <sys:String x:Key="Str.SupportKofiBody">Vienkartinė kava.</sys:String>
  <sys:String x:Key="Str.SupportVakinhaTitle">Vakinha</sys:String>
  <sys:String x:Key="Str.SupportVakinhaBody">Projekto lėšų rinkimas Brazilijoje.</sys:String>
  <sys:String x:Key="Str.SupportRail">Paremti AMD-NR</sys:String>
  <sys:String x:Key="Str.SupportTitle">Išlaikykite AMD-NR gyvą</sys:String>
  <sys:String x:Key="Str.SupportBody">Šis projektas gyvuoja tik jo naudotojų parama. Tai du žmonės, dvi vaizdo plokštės ir darbo popietės: jokios įmonės, jokio rėmėjo. Viskas čia nemokama ir tokia liks. Parama nieko neatrakina; ji leidžia darbui tęstis.</sys:String>
  <sys:String x:Key="Str.SupportBrazil">Esate Brazilijoje? Vakinha priima Pix, kortelę arba boleto.</sys:String>
  <sys:String x:Key="Str.CreditRuntimeTitle">DLSS-NR-on-AMD — danielblnc</sys:String>
  <sys:String x:Key="Str.CreditRuntimeBody">Pats tinklas ir priežastis, kodėl visa tai egzistuoja: būtent jis apskritai paleido DLSS 5 neuroninį atvaizdavimą Radeon kortose. Vykdymo aplinka ir svoriai, kuriuos atsisiunčia ši programa, yra jo darbas, ne mūsų. Ačiū, danielblnc.</sys:String>
  <sys:String x:Key="Str.CreditAddonTitle">dlss5-neural-amd — priedas</sys:String>
  <sys:String x:Key="Str.CreditAddonBody">Tai, kas per ReShade prijungia tinklą prie žaidimo: priedas, kurį įdiegia ši programa, ir leidimai, iš kurių ji leidžia rinktis. MIT licencija, atskira saugykla nuo šios diegimo programos.</sys:String>
  <sys:String x:Key="Str.CreditDiscordTitle">Discord — čia visi</sys:String>
  <sys:String x:Key="Str.CreditDiscordBody">Nauji leidimai, kas veikia kuriame žaidime ir kur klausti, kai kas nors sugenda.</sys:String>
  <sys:String x:Key="Str.CreditsSection">Padėkos</sys:String>
  <sys:String x:Key="Str.Scan">Ieškoti žaidimų</sys:String>
  <sys:String x:Key="Str.Scanning">Skaitoma Steam, Epic, GOG, EA, Ubisoft, Battle.net ir Xbox…</sys:String>
  <sys:String x:Key="Str.Search">Ieškoti žaidimų…</sys:String>
  <sys:String x:Key="Str.Settings">Nustatymai</sys:String>
  <sys:String x:Key="Str.WillDownload">Failai atsisiunčiami ir patikrinami diegiant.</sys:String>
  <sys:String x:Key="Str.NoRoute">Niekam, kuo šis žaidimas atvaizduoja, nėra maršruto: priedas veikia su D3D11, D3D12, Vulkan ir OpenGL, o 32 bitų žaidimuose su D3D8, D3D9 ir D3D11. 32 bitų OpenGL žaidimas, 64 bitų D3D9 žaidimas ir programinis atvaizduoklis jo neturi.</sys:String>
  <sys:String x:Key="Str.SwitchRenderer">Šis žaidimas gali veikti su {1}. Jo grafikos nustatymuose pasirinkite {0} — tai čia pasirinktas maršrutas, o su kita API priedas mato kitą žaidimą.</sys:String>
  <sys:String x:Key="Str.SwitchRendererUnreal">Tai Unreal žaidimas: pridėkite -{0} prie jo paleidimo parinkčių.</sys:String>
  <sys:String x:Key="Str.CheckWiki">Rasti šį žaidimą PCGamingWiki</sys:String>
  <sys:String x:Key="Str.EmptyTitle">Žaidimų dar nėra</sys:String>
  <sys:String x:Key="Str.NoMatchTitle">Nieko nerasta</sys:String>
  <sys:String x:Key="Str.NoMatch">Nė vienas sąrašo žaidimas neatitinka „{0}“.</sys:String>
  <sys:String x:Key="Str.ScanningShort">Ieškoma…</sys:String>
  <sys:String x:Key="Str.ScanDone">Paieška baigta. Rasta žaidimų: {0}, naujų: {1}.</sys:String>
  <sys:String x:Key="Str.InstalledBadge">Įdiegta</sys:String>
  <sys:String x:Key="Str.Close">Uždaryti</sys:String>
  <sys:String x:Key="Str.CloseHint">Uždaryti (Esc)</sys:String>
  <sys:String x:Key="Str.ExeSection">Žaidimo vykdomasis failas</sys:String>
  <sys:String x:Key="Str.ExeChoose">Pasirinkti…</sys:String>
  <sys:String x:Key="Str.ExeUseDetected">Naudoti aptiktą</sys:String>
  <sys:String x:Key="Str.ExeNone">Šiame aplanke vykdomojo failo nerasta.</sys:String>
  <sys:String x:Key="Str.ExeNote">Maršrutas nustatomas pagal šį failą. Jei bitų skaičius atrodo neteisingas (paleidiklis šakniniame aplanke, žaidimas Bin64), nurodykite tinkamą .exe.</sys:String>
  <sys:String x:Key="Str.ExeNoteChosen">Šį failą pasirinkote patys, todėl aptikimas jo nekeičia, net ir po pakartotinės paieškos.</sys:String>
  <sys:String x:Key="Str.ExeNotHere">Šis failas nėra šio žaidimo aplanke.</sys:String>
  <sys:String x:Key="Str.ExeUnreadable">Šis failas nėra Windows vykdomasis failas, kurį būtų galima perskaityti.</sys:String>
  <sys:String x:Key="Str.RouteMismatch">Šis maršrutas skirtas {0} žaidimams, o aukščiau esantis vykdomasis failas yra {1}. Niekas jūsų nestabdo — aptikimas galėjo perskaityti ne tą failą, — bet jei perskaitė tinkamą, tai neįsikels.</sys:String>
  <sys:String x:Key="Str.VersionSection">Priedo versija</sys:String>
  <sys:String x:Key="Str.ProxySection">ReShade įkeliamas kaip</sys:String>
  <sys:String x:Key="Str.ProxyNote">Automatiškai naudojamas dxgi.dll, aptarnaujantis bet kurį Direct3D. Keiskite tik tada, jei žaidimas atsisako jį įkelti.</sys:String>
  <sys:String x:Key="Str.ProxySectionOpti">OptiScaler įkeliamas kaip</sys:String>
  <sys:String x:Key="Str.ProxyNoteOpti">Automatiškai naudojamas pirmasis pavadinimas, kurį OptiScaler wiki nurodo šiam žaidimui, kitaip čia jau naudojamas, kitaip dxgi.dll. Pasirinkite winmm.dll, kad išlaikytumėte kitos programos dxgi.dll.</sys:String>
  <sys:String x:Key="Str.ProxyAuto">Automatiškai</sys:String>
  <sys:String x:Key="Str.ProxyAutoWiki">Automatiškai (wiki: {0})</sys:String>
  <sys:String x:Key="Str.PrefetchAll">Atsisiųsti viską dabar</sys:String>
  <sys:String x:Key="Str.ClearCache">Išvalyti podėlį</sys:String>
  <sys:String x:Key="Str.ClearCacheBody">Ištrina atsisiųstus failus, viršelius ir versijų sąrašą. Niekas, kas įdiegta žaidimuose, neliečiama; kitas diegimas vėl atsisiųs, ko reikia.</sys:String>
  <sys:String x:Key="Str.ClearCacheYes">Išvalyti</sys:String>
  <sys:String x:Key="Str.ClearCacheYesBody">Viskas, kas jame yra, bus atsisiųsta iš naujo kito diegimo metu.</sys:String>
  <sys:String x:Key="Str.ClearCacheNoBody">Palikti podėlį, koks yra.</sys:String>
  <sys:String x:Key="Str.CacheCleared">Podėlis išvalytas — atlaisvinta {0}.</sys:String>
  <sys:String x:Key="Str.PayloadsAlreadyThere">Viskas jau buvo vietoje, ir kiekvienas baitas ką tik praėjo patikrą.</sys:String>
  <sys:String x:Key="Str.VersionShipped">pridėta</sys:String>
  <sys:String x:Key="Str.VersionNoteShipped">Versija, su kuria išleista ši diegimo programa.</sys:String>
  <sys:String x:Key="Str.VersionNoteRelease">Iš GitHub leidimo v{0}, patikrinta pagal jo maišos reikšmes.</sys:String>
  <sys:String x:Key="Str.VersionSectionOpti">OptiScaler versija</sys:String>
  <sys:String x:Key="Str.VersionNoteOpti">OptiScaler {0} iš jo GitHub leidimo, kiekvienas failas patikrintas pagal maišos reikšmę.</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiLmxxf">Apima lmxxf svorius (apie 590 MB, tik RDNA4).</sys:String>
  <sys:String x:Key="Str.VersionNoteOptiMochizuki">Gali atnešti ir mochizuki: žr. „NR vykdymo aplinka“.</sys:String>
  <sys:String x:Key="Str.MochizukiSection">NR vykdymo aplinka</sys:String>
  <sys:String x:Key="Str.MochizukiCheck">Įdiegti ir mochizuki kaip antrą NR vykdymo aplinką (eksperimentinė)</sys:String>
  <sys:String x:Key="Str.MochizukiNote">DLSS 5 tinklas, kurį į Vulkan perkėlė mochizuki0323. Tik RDNA4: RX 9000 serija, AMD tvarkyklė 25.10 ar naujesnė. Prideda MochizukiNrRuntime.dll ir aplanką dlssnr-amd su modeliu, apie 141 MB atsisiuntimo. NR vykdymo aplinka lieka danielblnc: norėdami naudoti mochizuki, pasirinkite jį „NR runtime“ OptiScaler skirtuke Neural ir paleiskite žaidimą iš naujo. Pirmą kartą paleidus kiekviename žaidime tinklas kelias sekundes kompiliuojamas. Nepažymėjus kitas diegimas pašalins tai, ką ši programa iš jo įdiegė.</sys:String>
  <sys:String x:Key="Str.MochizukiCheckAddon">Įdiegti ir mochizuki kaip antrą NR vykdymo aplinką (eksperimentinė)</sys:String>
  <sys:String x:Key="Str.MochizukiNoteAddon">DLSS 5 tinklas, kurį į Vulkan perkėlė mochizuki0323 ir kurį priedas nuo v0.6.8 gali paleisti vietoj danielblnc tinklo. Tik RDNA4: RX 9000 serija, AMD tvarkyklė 25.10 ar naujesnė. Prideda MochizukiNrRuntime.dll ir aplanką dlssnr-amd su modeliu, apie 141 MB atsisiuntimo. Norėdami jį naudoti, priedo skydelyje „NR runtime“ pasirinkite mochizuki (Vulkan) ir paleiskite žaidimą iš naujo. Pirmą kartą paleidus kiekviename žaidime tinklas kompiliuojamas iki minutės. Nepažymėjus kitas diegimas pašalins tai, ką ši programa iš jo įdiegė.</sys:String>
  <sys:String x:Key="Str.MochizukiNotRdna4">Šiai kortai nesiūloma ({0}): mochizuki reikia RDNA4, t. y. RX 9000 serijos, FP8 matricų instrukcijų.</sys:String>
  <sys:String x:Key="Str.MochizukiUnknownGpu">Programa negalėjo nustatyti, kokia tai korta; su bet kuo, kas nėra RX 9000 serija, mochizuki žaidime liks išjungtas.</sys:String>
  <sys:String x:Key="Str.PickRouteTitle">Pasirinkite diegimo maršrutą</sys:String>
  <sys:String x:Key="Str.PickRouteBody">Programa negalėjo nustatyti, kokia grafikos API atvaizduoja {0}, todėl maršruto už jus nepasirenka. OptiScaler skirtas D3D12 žaidimui, kurio nustatymuose yra DLSS, FSR arba XeSS; ReShade, su D3D11 arba D3D12, skirtas visiems kitiems. Diegimas palauks, kol pasirinksite.</sys:String>
  <sys:String x:Key="Str.PickRouteDetail">Grafikos API nežinoma, todėl maršrutą pasirenkate patys žemiau.</sys:String>
  <sys:String x:Key="Str.SupporterTitle">danielblnc vykdymo aplinka</sys:String>
  <sys:String x:Key="Str.SupporterChoose">Kuri vykdymo aplinkos versija bus įdiegta į šį žaidimą. Naudojama paryškinta kortelė.</sys:String>
  <sys:String x:Key="Str.SupporterDownloadTitle">Viešas leidimas ({0})</sys:String>
  <sys:String x:Key="Str.SupporterDownloadBody">Atsisiųsta ir patikrinta šios programos.</sys:String>
  <sys:String x:Key="Str.SupporterBuildTitle">Vietinė rėmėjų versija ({0})</sys:String>
  <sys:String x:Key="Str.SupporterPick">Pasirinkti mano version.dll arba diegimo programą…</sys:String>
  <sys:String x:Key="Str.SupporterPickOther">Pasirinkti kitą failą…</sys:String>
  <sys:String x:Key="Str.SupporterPitch">Naujesnė nei viešas leidimas, iš jūsų version.dll arba danielblnc diegimo programos.</sys:String>
  <sys:String x:Key="Str.SupporterPitch.0.5.0">0.5.0 prideda branduolius RDNA3 kortoms.</sys:String>
  <sys:String x:Key="Str.SupporterNotDistributed">Ši programa niekada jo neatsisiunčia ir neplatina. Jūsų failas patikrinamas pagal SHA-256 ir išsaugomas, todėl kiti žaidimai nebeklaus.</sys:String>
  <sys:String x:Key="Str.SupporterUse">Naudoti mano rėmėjo failus…</sys:String>
  <sys:String x:Key="Str.SupporterUseDownload">Viešas leidimas</sys:String>
  <sys:String x:Key="Str.SupporterPickTitle">Jūsų version.dll arba dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterFiles">version.dll, dlssnr_on_amd_setup.exe</sys:String>
  <sys:String x:Key="Str.SupporterAnyFile">Bet kuris DLL ar diegimo programa</sys:String>
  <sys:String x:Key="Str.SupporterUsingDownload">Naudojama: šios programos atsisiunčiama vykdymo aplinka.</sys:String>
  <sys:String x:Key="Str.SupporterUsingFile">Naudojama {0} iš jūsų failo.</sys:String>
  <sys:String x:Key="Str.SupporterUsingKept">Naudojama {0}: patikrinta kopija, kurią programa išsaugojo, kai ją pasirinkote anksčiau.</sys:String>
  <sys:String x:Key="Str.SupporterMissing">Pasirinkta {0}, bet šiame kompiuteryje jos kopijos dar nėra: pasirinkite savo version.dll arba diegimo programą.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsAddon">{0} reikia v{1} ar naujesnio priedo: pasirinkite jį skiltyje „Priedo versija“. Iki tol diegiama atsisiunčiama versija.</sys:String>
  <sys:String x:Key="Str.SupporterNeedsOpti">{0} reikia OptiScaler {1} ar naujesnio: pasirinkite jį skiltyje „OptiScaler versija“. Iki tol diegiama atsisiunčiama versija.</sys:String>
  <sys:String x:Key="Str.SupporterNoPatch">Priedas dar negali paleisti {0}: failų sąraše nėra jos pataisos. Kol nebus, čia diegiama atsisiunčiama versija; OptiScaler maršrutas ją paleidžia tokią, kokia yra.</sys:String>
  <sys:String x:Key="Str.SupporterKept">Patikrinta ir išsaugota: danielblnc vykdymo aplinka {0}.</sys:String>
  <sys:String x:Key="Str.SupporterRefused">Šio failo naudoti negalima. {0}</sys:String>
  <sys:String x:Key="Str.Checking">Tikrinamas šis aplankas…</sys:String>
  <sys:String x:Key="Str.StepDownload">Atsisiuntimas</sys:String>
  <sys:String x:Key="Str.StepVerify">Patikra</sys:String>
  <sys:String x:Key="Str.StepInstall">Diegimas</sys:String>
  <sys:String x:Key="Str.StepDone">Atlikta</sys:String>
  <sys:String x:Key="Str.Installing">Diegiama…</sys:String>
  <sys:String x:Key="Str.Removing">Šalinama…</sys:String>
  <sys:String x:Key="Str.InstallOk">Žaidimas {0} paruoštas. Paleiskite jį, kad galėtumėte naudoti.</sys:String>
  <sys:String x:Key="Str.InstallWarn">Įdiegta į žaidimą {0}; žemiau yra {1} įspėjimas.</sys:String>
  <sys:String x:Key="Str.InstallFail">Diegimas į žaidimą {0} nebaigtas.</sys:String>
  <sys:String x:Key="Str.UninstallOk">Pašalinta iš žaidimo {0}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn">Pašalinta iš žaidimo {0}; žemiau yra {1} įspėjimas.</sys:String>
  <sys:String x:Key="Str.UninstallFail">Nepavyko visko pašalinti iš žaidimo {0}.</sys:String>
  <sys:String x:Key="Str.UninstallLeft">Žaidimas {0} vis dar laikomas įdiegtu: nepavyko pašalinti vieno šios programos failo. Uždarykite žaidimą ir pašalinkite dar kartą.</sys:String>
  <sys:String x:Key="Str.UninstallClean">Pašalinta iš žaidimo {0} — jo aplanke neliko nieko iš šios programos.</sys:String>
  <sys:String x:Key="Str.UninstallKeptSettings">Pašalinta iš žaidimo {0} — liko tik jūsų nustatymai: {1}.</sys:String>
  <sys:String x:Key="Str.SettingsLeftTitle">Pašalinti ir nustatymus?</sys:String>
  <sys:String x:Key="Str.SettingsLeftBody">Viskas, ką ši programa įdiegė į žaidimą {0}, pašalinta. Šie nustatymų failai liko — juose yra tai, kas buvo nustatyta perdangoje:</sys:String>
  <sys:String x:Key="Str.SettingsRemove">Pašalinti ir juos</sys:String>
  <sys:String x:Key="Str.SettingsRemoveBody">Aplankas grįžta į būseną, buvusią prieš diegimą.</sys:String>
  <sys:String x:Key="Str.SettingsKeep">Palikti mano nustatymus</sys:String>
  <sys:String x:Key="Str.SettingsKeepBody">Jie liks kitam diegimui.</sys:String>
  <sys:String x:Key="Str.ResultErrors">Žemiau aprašyta {0} problema.</sys:String>
  <sys:String x:Key="Str.DownloadFailed">Nepavyko atsisiųsti failų, todėl niekas neįdiegta.</sys:String>
  <sys:String x:Key="Str.Folder">Aplankas</sys:String>
  <sys:String x:Key="Str.GameCount">Žaidimų: {0}</sys:String>
  <sys:String x:Key="Str.UnknownApi">Nežinoma API</sys:String>
  <sys:String x:Key="Str.Location">Vieta</sys:String>
  <sys:String x:Key="Str.Details">Išsami informacija</sys:String>
  <sys:String x:Key="Str.DetailsCount">Eilučių: {0}</sys:String>
  <sys:String x:Key="Str.PreflightOk">Paruošta diegti</sys:String>
  <sys:String x:Key="Str.PreflightOkDetail">Niekas netrukdo. Pasirinkite maršrutą žemiau ir spustelėkite „Įdiegti“.</sys:String>
  <sys:String x:Key="Str.PreflightWarn">Paruošta diegti; yra {0} pastaba</sys:String>
  <sys:String x:Key="Str.PreflightErr">Šiame aplanke rasta {0} problema</sys:String>
  <sys:String x:Key="Str.PreflightInstalled">Įdiegta šiame žaidime</sys:String>
  <sys:String x:Key="Str.PreflightInstalledDetail">Paleiskite žaidimą, kad galėtumėte naudoti. Įdiekite dar kartą, kad atnaujintumėte failus, arba pašalinkite, kad juos ištrintumėte.</sys:String>
  <sys:String x:Key="Str.PreflightOutdated">Įdiegta, ir yra naujinys</sys:String>
  <sys:String x:Key="Str.PreflightOutdatedDetail">Šio žaidimo failai senesni nei tie, kuriuos ši programa diegia dabar. „Atnaujinti“ juos pakeis; jūsų nustatymai liks.</sys:String>
  <sys:String x:Key="Str.SeeDetails">Atverkite „Išsami informacija“ žemiau, kad pamatytumėte, kas rasta.</sys:String>
  <sys:String x:Key="Str.SystemSubtitle">Ko priedui reikia iš šio kompiuterio; tikrinama paleidžiant programą.</sys:String>
  <sys:String x:Key="Str.SystemReady">Šis kompiuteris turi viską, ko reikia priedui</sys:String>
  <sys:String x:Key="Str.SystemNotReady">Šiam kompiuteriui trūksta kažko, ko reikia priedui</sys:String>
  <sys:String x:Key="Str.GpuOk">Aptikta Radeon</sys:String>
  <sys:String x:Key="Str.GpuBad">Ne Radeon</sys:String>
  <sys:String x:Key="Str.Missing">Trūksta</sys:String>
  <sys:String x:Key="Str.DriverHint">Vaizdo tvarkyklės versija, kurią nurodo Windows.</sys:String>
  <sys:String x:Key="Str.FilesHint">Atsisiunčiami vieną kartą, patikrinami pagal fiksuotą maišos reikšmę ir naudojami kiekvienam žaidimui.</sys:String>
  <sys:String x:Key="Str.PayloadReadyShort">Patikrinta</sys:String>
  <sys:String x:Key="Str.NotDownloadedShort">Neatsisiųsta</sys:String>
  <sys:String x:Key="Str.DownloadingShort">Atsisiunčiama…</sys:String>
  <sys:String x:Key="Str.DownloadingPercent">Atsisiunčiama {0}%</sys:String>
  <sys:String x:Key="Str.SettingsSubtitle">Kalba, naujiniai ir apie šią programą.</sys:String>
  <sys:String x:Key="Str.LanguageHint">Visi užrašai pasikeičia iš karto; paleisti iš naujo nereikia.</sys:String>
  <sys:String x:Key="Str.DataFolder">Duomenų aplankas</sys:String>
  <sys:String x:Key="Str.Preset.Pcsx2">PCSX2</sys:String>
  <sys:String x:Key="Str.Preset.Rpcs3">RPCS3</sys:String>
  <sys:String x:Key="Str.Preset.Dx11">D3D11 žaidimas</sys:String>
  <sys:String x:Key="Str.Preset.Dx12">D3D12 žaidimas</sys:String>
  <sys:String x:Key="Str.Preset.Vulkan">Vulkan žaidimas</sys:String>
  <sys:String x:Key="Str.Preset.OpenGL">OpenGL žaidimas</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx11">D3D11 žaidimas, 32 bitų</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx9">D3D9 žaidimas, 32 bitų</sys:String>
  <sys:String x:Key="Str.Preset.X86Dx8">D3D8 žaidimas, 32 bitų</sys:String>
  <sys:String x:Key="Str.Preset.OptiScaler">OptiScaler: D3D12 žaidimas su DLSS, FSR arba XeSS</sys:String>
  <sys:String x:Key="Str.PresetNote.Pcsx2">Emuliatoriuje nustatykite Direct3D 11: su šiuo atvaizduokliu tinklas gauna daugiausia — emuliatoriaus gylį ir judesį iš lydinčiojo efekto, kai jis įdiegtas. Atkreipkite dėmesį į atskiro žaidimo nustatymus, kurie tyliai perrašo bendruosius.</sys:String>
  <sys:String x:Key="Str.PresetNote.Rpcs3">Eksperimentinis. ReShade su Vulkan yra sluoksnis, o ne tarpinis DLL: diegimas jį užregistruoja jūsų Windows naudotojui ir įjungia rpcs3.exe per ReShade.ini. Su Vulkan gylio nėra, tik spalva ir įvertintas judesys.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx11">Geriausias maršrutas: D3D11 — vienintelis, kur paties žaidimo judesio vektoriai pasiekia tinklą kartu su jo gyliu.</sys:String>
  <sys:String x:Key="Str.PresetNote.Dx12">Ribotas. Su D3D12 priedas randa žaidimo gylį, bet ne jo judesio vektorius, todėl tinklas gauna spalvą ir gylį, o judesį įvertina. Veikia, bet tikėkitės mažiau. Žaidimui, kurio nustatymuose yra DLSS, FSR arba XeSS, geriau tinka OptiScaler maršrutas.</sys:String>
  <sys:String x:Key="Str.PresetNote.OptiScaler">Rekomenduojama D3D12 žaidimams. Vietoj ReShade įdiegia OptiScaler, kuris perima žaidimo DLSS, FSR arba XeSS ir paleidžia tinklą jo viduje, su paties žaidimo gyliu ir judesio vektoriais. Žaidimas turi siūlyti vieną iš šių didinimo priemonių, įjungtą nustatymuose. Žaidime paspauskite Insert, atverkite skirtuką Neural ir įjunkite Enable NR; žaidimui su Ray Reconstruction apdorojimo taškas turi būti „After the finished frame“.</sys:String>
  <sys:String x:Key="Str.PresetNote.Vulkan">Eksperimentinis. ReShade su Vulkan yra sluoksnis: diegimas jį užregistruoja jūsų Windows naudotojui ir įjungia šiai programai per ReShade.ini šalia jos .exe. Su Vulkan gylio nėra.</sys:String>
  <sys:String x:Key="Str.PresetNote.OpenGL">Eksperimentinis. Kitaip nei Vulkan, tai įprastas tarpinis DLL: ReShade įdedamas šalia žaidimo kaip opengl32.dll, nepaleidžiant atskiros diegimo programos. Tik spalva ir įvertintas judesys; paties žaidimo gylis su šia API pasiekiamas, bet dar neprijungtas. 32 bitų OpenGL žaidimas maršruto neturi.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx11">Eksperimentinis. 32 bitų žaidimas negali įkelti 64 bitų vykdymo aplinkos, todėl priedas veikia kaip pora, dalijanti kadrus viename adapteryje. Įdiekite ReShade su priedų palaikymu kaip 32 bitų dxgi.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx9">Eksperimentinis. Ta pati 32 bitų pora kaip su D3D11, per privatų D3D9/D3D11 etapą. Paprastas D3D9 kainuoja kelias fiksuotas milisekundes kadrui; D3D9Ex — ne. Įdiekite ReShade kaip 32 bitų d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.X86Dx8">Eksperimentinis. D3D8 verčiamas į D3D9 ir toliau eina aukščiau esančiu D3D9 maršrutu, su ta pačia 32 bitų pora. Įdiekite ReShade kaip 32 bitų d3d9.dll.</sys:String>
  <sys:String x:Key="Str.PresetNote.FiveM">FiveM turi savo apsaugą nuo sukčiavimo: savo rizika, ir pasitikrinkite serverio taisykles. Priedas ir ReShade dedami į FiveM.app\plugins, vykdymo biblioteka ir svoriai – šalia žaidimo proceso į data\cache\subprocess. Kas jau yra plugins aplanke – ReShade.ini, nustatymai, šešėliavimo programos, kiti priedai, ENB – lieka nepakeista.</sys:String>
  <sys:String x:Key="Str.SetupWelcome">Sveiki</sys:String>
  <sys:String x:Key="Str.SetupWelcomeBody">DLSS 5 Neural Rendering tinklas Radeon kortose, per ReShade arba OptiScaler. Keturi greiti žingsniai.</sys:String>
  <sys:String x:Key="Str.SetupStepMachine">Šis kompiuteris</sys:String>
  <sys:String x:Key="Str.SetupStepFiles">Failai</sys:String>
  <sys:String x:Key="Str.SetupStepGames">Jūsų žaidimai</sys:String>
  <sys:String x:Key="Str.SetupBack">Atgal</sys:String>
  <sys:String x:Key="Str.SetupNext">Tęsti</sys:String>
  <sys:String x:Key="Str.SetupFinish">Pradėti naudoti</sys:String>
  <sys:String x:Key="Str.SetupSkip">Kol kas praleisti</sys:String>
  <sys:String x:Key="Str.SetupStepOf">{0} žingsnis iš {1}</sys:String>
  <sys:String x:Key="Str.SetupMachineBody">Du dalykai gali sutrukdyti priedui veikti, ir abu matyti iš čia. Nė vienas netrukdo tęsti — tik veikti žaidime.</sys:String>
  <sys:String x:Key="Str.SetupMachineOk">Šis kompiuteris turi viską, ko reikia priedui.</sys:String>
  <sys:String x:Key="Str.SetupMachineBad">Kažko trūksta. Galite tęsti ir sutvarkyti vėliau, bet žaidime neveiks, kol to nepadarysite.</sys:String>
  <sys:String x:Key="Str.SetupFilesBody">Tie patys failai tarnauja kiekvienam žaidimui: atsisiunčiami vieną kartą, patikrinami pagal fiksuotą maišos reikšmę ir naudojami pakartotinai.</sys:String>
  <sys:String x:Key="Str.SetupFilesRetry">Bandyti dar kartą</sys:String>
  <sys:String x:Key="Str.SetupFilesLater">Praleiskite, ir jie bus atsisiųsti pirmojo diegimo metu.</sys:String>
  <sys:String x:Key="Str.SetupGamesBody">Paleidikliai tik skaitomi: peržiūrint niekas neįdiegiama ir nekeičiama. Aplankus vėliau galite pridėti ranka.</sys:String>
  <sys:String x:Key="Str.SetupGamesApi">Kiekvienas žaidimas perskaitomas, kad būtų nustatyta, kokią grafikos API jis naudoja, ir paprastai tai teisinga, bet ne visada: viename aplanke gali būti D3D11 ir D3D12 vykdomasis failas, o žaidimas pagal numatytuosius nustatymus gali naudoti vieną API, nors jo failas palaiko ir senesnę. Prieš diegiant verta patikrinti žaidimą pcgamingwiki.com — kiekvienoje žaidimo kortelėje yra tiesioginė nuoroda.</sys:String>
  <sys:String x:Key="Str.SetupGamesNone">Žaidimų nerasta. Aplanką galite pridėti ranka pagrindiniame lange.</sys:String>
  <sys:String x:Key="Str.SetupGamesFound">Rasta žaidimų: {0}.</sys:String>
  <sys:String x:Key="Str.Unexpected">Įvyko kažkas netikėto. Visas žurnalas įrašytas.</sys:String>
  <sys:String x:Key="Str.Play">Žaisti</sys:String>
  <sys:String x:Key="Str.Launch">Atidaryti</sys:String>
  <sys:String x:Key="Str.Configure">Konfigūruoti</sys:String>
  <sys:String x:Key="Str.ViewGrid">Viršelių tinklelis</sys:String>
  <sys:String x:Key="Str.ViewList">Sąrašas su žaidimo puslapiu šalia</sys:String>
  <sys:String x:Key="Str.AutoUpdate">Automatinis atnaujinimas</sys:String>
  <sys:String x:Key="Str.AutoUpdateTip">Kai išeina naujesnė versija, šis žaidimas atsinaujina pats, kai atidaroma programa.</sys:String>
  <sys:String x:Key="Str.AutoUpdated">Automatiškai atnaujintas {0} žaidimas.</sys:String>
  <sys:String x:Key="Str.AutoUpdated.Many">Automatiškai atnaujinta žaidimų: {0}.</sys:String>
  <sys:String x:Key="Str.Rename">Pervadinti</sys:String>
  <sys:String x:Key="Str.Save">Įrašyti</sys:String>
  <sys:String x:Key="Str.Cancel">Atšaukti</sys:String>
  <sys:String x:Key="Str.ChangeCover">Viršelis</sys:String>
  <sys:String x:Key="Str.CoverPick">Pasirinkti paveikslėlį…</sys:String>
  <sys:String x:Key="Str.CoverReset">Naudoti internete rastą viršelį</sys:String>
  <sys:String x:Key="Str.CoverPickTitle">Pasirinkite šio žaidimo viršelį</sys:String>
  <sys:String x:Key="Str.CoverFiles">Paveikslėliai</sys:String>
  <sys:String x:Key="Str.CoverFailed">Šio failo nepavyko perskaityti kaip paveikslėlio.</sys:String>
  <sys:String x:Key="Str.Customize">Tinkinti</sys:String>
  <sys:String x:Key="Str.HeroPick">Pasirinkti reklamjuostę…</sys:String>
  <sys:String x:Key="Str.HeroReset">Naudoti internete rastą reklamjuostę</sys:String>
  <sys:String x:Key="Str.HeroPickTitle">Pasirinkite šio žaidimo reklamjuostę</sys:String>
  <sys:String x:Key="Str.PlayFailed">Nepavyko paleisti. Atidarykite aplanką ir paleiskite vykdomąjį failą ranka.</sys:String>
  <sys:String x:Key="Str.AddEmulator">Pridėti emuliatorių</sys:String>
  <sys:String x:Key="Str.EmulatorTitle">Pridėti emuliatorių</sys:String>
  <sys:String x:Key="Str.EmulatorBody">Pasirinkite kurį, tada nurodykite aplanką, iš kurio jis paleidžiamas — aplanką su vykdomuoju failu, ne tą su ROM.</sys:String>
  <sys:String x:Key="Str.EmulatorOther">Kitas emuliatorius</sys:String>
  <sys:String x:Key="Str.EmulatorOtherBody">Nurodykite aplanką, ir pasakysiu, ką galiu iš jo nustatyti.</sys:String>
  <sys:String x:Key="Str.EmulatorPick">Nurodykite {0} aplanką</sys:String>
  <sys:String x:Key="Str.EmulatorPickOther">Nurodykite emuliatoriaus aplanką</sys:String>
  <sys:String x:Key="Str.EmulatorFound">Rastas {0}: {1}</sys:String>
  <sys:String x:Key="Str.EmulatorWrong">Tai neatrodo kaip {0}: tame aplanke nėra {1}. Vis tiek pridėta — patikrinkite kelią.</sys:String>
  <sys:String x:Key="Str.EmulatorUnknown">Čia nėra jokio man žinomo emuliatoriaus. Pridėta pagal tai, ką sako failai: {0}</sys:String>
  <sys:String x:Key="Str.EmulatorSetting">Emuliatoriuje</sys:String>
  <sys:String x:Key="Str.ReportTitle">Neveikia žaidime?</sys:String>
  <sys:String x:Key="Str.ReportBody">Supakuoja žurnalus ir žaidimo aplanko failų sąrašą į .zip jūsų kompiuteryje. Niekas nesiunčiama.</sys:String>
  <sys:String x:Key="Str.Report">Pranešti apie problemą</sys:String>
  <sys:String x:Key="Str.ReportSaved">Ataskaita išsaugota ir aplankas atidarytas: {0}</sys:String>
  <sys:String x:Key="Str.ReportFailed">Nepavyko sukurti ataskaitos. Žurnalai yra čia: {0}</sys:String>
  <sys:String x:Key="Str.ReportWorking">Renkama…</sys:String>
  <sys:String x:Key="Str.DownloadReportTitle">Failai neatsisiunčia?</sys:String>
  <sys:String x:Key="Str.DownloadReportBody">Surenka, ką bandė kiekvienas atsisiuntimas — kiekvieną adresą, jo vardo užklausą, tarpinį serverį ir atsakymą, — ir dabar dar kartą patikrina kiekvieną adresą, viską į vieną .zip. Niekas nesiunčiama: failas lieka jūsų kompiuteryje, ir juo dalinatės, kur norite.</sys:String>
  <sys:String x:Key="Str.DownloadReport">Atsisiuntimų žurnalai</sys:String>
  <sys:String x:Key="Str.Add">Pridėti</sys:String>
  <sys:String x:Key="Str.AddMenuMany">Ieškoti žaidimų aplanke…</sys:String>
  <sys:String x:Key="Str.AddMenuOne">Vieno žaidimo aplankas…</sys:String>
  <sys:String x:Key="Str.AddMenuEmulator">Emuliatorius…</sys:String>
  <sys:String x:Key="Str.UpdateShort">Atnaujinti</sys:String>
  <sys:String x:Key="Str.GamesAway">Neprijungtame diske: {0}</sys:String>
  <sys:String x:Key="Str.GamesAwayHint">Žaidimai diske, kuris dabar neprijungtas, lieka įsiminti su viskuo, kas jiems pasirinkta, ir sugrįžta, kai sugrįžta diskas.</sys:String>
  <sys:String x:Key="Str.GameGone">Žaidimas {0} nebeįdiegtas, todėl pašalintas iš sąrašo.</sys:String>
  <sys:String x:Key="Str.GamesGone">{0} žaidimas nebeįdiegtas, todėl pašalintas iš sąrašo.</sys:String>
  <sys:String x:Key="Str.GamesGone.Many">Nebeįdiegti ir iš sąrašo pašalinti žaidimai: {0}.</sys:String>
  <sys:String x:Key="Str.ShowDetails">Rodyti išsamią informaciją</sys:String>
  <sys:String x:Key="Str.DetectedSection">Aptikta</sys:String>
  <sys:String x:Key="Str.InstallsInto">Diegiama į: {0}</sys:String>
  <sys:String x:Key="Str.InstallsElsewhere">Tai už pridėto aplanko ribų: čia yra {0} – versija, kurią paleidžia paleidyklė. Jei žaidžiate kitą, viršuje pasirinkite jos {0}.</sys:String>
  <sys:String x:Key="Str.CheckApiTip">Failai rodo, su kuo žaidimas susietas, o ne su kuo jis veikia: viename aplanke gali būti D3D11 ir D3D12 vykdomasis failas. Wiki nurodo, kurią naudoja žaidimas.</sys:String>
  <sys:String x:Key="Str.DetectedFromFiles">Perskaityta iš paties žaidimo failų.</sys:String>
  <sys:String x:Key="Str.DetectedFromWiki">Iš PCGamingWiki ir žaidimo failų.</sys:String>
  <sys:String x:Key="Str.InstallWith">Įdiegti per</sys:String>
  <sys:String x:Key="Str.RouteReShade">ReShade + priedas</sys:String>
  <sys:String x:Key="Str.RouteOpti">OptiScaler</sys:String>
  <sys:String x:Key="Str.Recommended">Rekomenduojama</sys:String>
  <sys:String x:Key="Str.RecommendedLower">rekomenduojama</sys:String>
  <sys:String x:Key="Str.RouteReShadeSummary">Priedas ReShade viduje. D3D11, D3D12, Vulkan, OpenGL, 32 bitų žaidimai ir emuliatoriai.</sys:String>
  <sys:String x:Key="Str.RouteReShadeMisfit">Nėra ReShade maršruto tam, kuo atpažintas šis žaidimas ({0}).</sys:String>
  <sys:String x:Key="Str.RouteOptiSummary">Veikia žaidimo DLSS, FSR arba XeSS viduje, su jo paties gyliu ir judesiu. Pakeičia ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiFound">Veikia žaidimo didinimo priemonės viduje (čia rasta {0}). Pakeičia ReShade.</sys:String>
  <sys:String x:Key="Str.RouteOptiMisfit">Sukurta 64 bitų D3D12 žaidimams; šis atpažintas kaip {0}.</sys:String>
  <sys:String x:Key="Str.ApiSection">Grafikos API</sys:String>
  <sys:String x:Key="Str.Group64">64 bitų žaidimai</sys:String>
  <sys:String x:Key="Str.Group32">32 bitų žaidimai (eksperimentiniai)</sys:String>
  <sys:String x:Key="Str.GroupEmulators">Emuliatoriai</sys:String>
  <sys:String x:Key="Str.GroupFiveM">GTA V online</sys:String>
  <sys:String x:Key="Str.OptiAbout">Vietoj ReShade įdiegia OptiScaler, kuris perima žaidimo DLSS, FSR arba XeSS ir paleidžia tinklą jo viduje, su paties žaidimo gyliu ir judesio vektoriais.</sys:String>
  <sys:String x:Key="Str.InGame">Žaidime</sys:String>
  <sys:String x:Key="Str.OptiStep1">Įjunkite DLSS, FSR arba XeSS žaidimo grafikos nustatymuose.</sys:String>
  <sys:String x:Key="Str.OptiStep2">Paspauskite Insert, atverkite skirtuką Neural ir įjunkite Enable NR.</sys:String>
  <sys:String x:Key="Str.OptiStep3">Jei įjungtas Ray Reconstruction, apdorojimo tašką nustatykite į „After the finished frame“.</sys:String>
  <sys:String x:Key="Str.InstallOpti">Įdiegti OptiScaler</sys:String>
  <sys:String x:Key="Str.Update">Atnaujinti</sys:String>
  <sys:String x:Key="Str.Reinstall">Įdiegti iš naujo</sys:String>
  <sys:String x:Key="Str.SwitchToOpti">Pereiti prie OptiScaler</sys:String>
  <sys:String x:Key="Str.SwitchToReShade">Pereiti prie ReShade</sys:String>
  <sys:String x:Key="Str.SwitchTitle">Pereiti prie {0}?</sys:String>
  <sys:String x:Key="Str.SwitchBody">Žaidime {0} įdiegtas {1} maršrutas, o abu negali būti viename aplanke vienu metu. Pirmiausia pašalinamas {1}, grąžinant viską, ką jis pakeitė, tada įdiegiamas {2}.</sys:String>
  <sys:String x:Key="Str.SwitchYes">Pašalinti {0}, įdiegti {1}</sys:String>
  <sys:String x:Key="Str.SwitchYesBody">Jūsų nustatymų failai lieka savo vietose.</sys:String>
  <sys:String x:Key="Str.SwitchNoBody">Niekas nekeičiama; {0} lieka įdiegtas.</sys:String>
  <sys:String x:Key="Str.DownloadFailedDetail">Priežastis — skiltyje „Išsami informacija“. Niekas neįdiegta.</sys:String>
  <sys:String x:Key="Str.DownloadFailedHelp">Failus taip pat galima atsisiųsti naršykle ir perduoti programai: „Šis kompiuteris“ &gt; „Failai“ &gt; „Atsisiųsti ranka“, tada „Importuoti failus“. Failai aplanke „Atsisiuntimai“ randami patys.</sys:String>
  <sys:String x:Key="Str.DnsRetry">Išvalyti DNS ir bandyti dar kartą</sys:String>
  <sys:String x:Key="Str.DnsFlushFailed">Windows neleido iš čia išvalyti DNS podėlio. Atverkite komandų eilutę, paleiskite ipconfig /flushdns ir bandykite dar kartą.</sys:String>
  <sys:String x:Key="Str.PreflightErr.Many">Šiame aplanke rasta problemų: {0}</sys:String>
  <sys:String x:Key="Str.PreflightWarn.Many">Paruošta diegti; pastabų: {0}</sys:String>
  <sys:String x:Key="Str.InstallWarn.Many">Įdiegta į žaidimą {0}; įspėjimų žemiau: {1}.</sys:String>
  <sys:String x:Key="Str.UninstallWarn.Many">Pašalinta iš žaidimo {0}; įspėjimų žemiau: {1}.</sys:String>
  <sys:String x:Key="Str.ResultErrors.Many">Problemų žemiau: {0}.</sys:String>
  <sys:String x:Key="Str.ManifestFailedShort">Nėra atsisiuntimų sąrašo</sys:String>
  <sys:String x:Key="Str.FailedShort">Nepavyko</sys:String>
  <sys:String x:Key="Str.PayloadsAllReadyShort">Visi paruošti ({0})</sys:String>
  <sys:String x:Key="Str.PayloadsMissingShort">Trūksta: {0} · {1}</sys:String>
  <sys:String x:Key="Str.DownloadFailedOne">Nepavyko atsisiųsti: {0}</sys:String>
  <sys:String x:Key="Str.ManualDownload">Atsisiųsti ranka</sys:String>
  <sys:String x:Key="Str.ImportFiles">Importuoti failus…</sys:String>
  <sys:String x:Key="Str.ImportHint">Pasirinkite aplanką su failais, kuriuos atsisiuntėte patys. Kiekvienas atpažįstamas pagal pavadinimą ir paimamas tik tada, jei atitinka fiksuotą maišos reikšmę.</sys:String>
  <sys:String x:Key="Str.ManualTitle">Atsisiųskite failus patys</sys:String>
  <sys:String x:Key="Str.ManualBody">Atverkite kiekvieną nuorodą naršyklėje ir įrašykite failą bet kur: aplankas „Atsisiuntimai“ peržiūrimas pats, o „Importuoti failus“ priima bet kurį kitą aplanką. Pavadinimų keisti nereikia, ir nenaudojama niekas, kas neatitinka fiksuoto SHA-256.</sys:String>
  <sys:String x:Key="Str.ImportPick">Pasirinkite aplanką su atsisiųstais failais</sys:String>
  <sys:String x:Key="Str.ImportAll">Visi failai dabar vietoje ir patikrinti.</sys:String>
  <sys:String x:Key="Str.ImportNothing">Niekas tame aplanke neatitiko reikalingo failo.</sys:String>
  <sys:String x:Key="Str.ImportSome">Paimta: {0}. Dar trūksta: {1}.</sys:String>
  <sys:String x:Key="Str.Component.addon">Priedas</sys:String>
  <sys:String x:Key="Str.Component.runtime">Neuroninė vykdymo aplinka ir svoriai</sys:String>
  <sys:String x:Key="Str.Component.reshade">ReShade</sys:String>
  <sys:String x:Key="Str.Component.bridge">32 bitų tiltas</sys:String>
  <sys:String x:Key="Str.Component.x86-extras">32 bitų priedai</sys:String>
  <sys:String x:Key="Str.Component.shader">Lydintysis efektas</sys:String>
  <sys:String x:Key="Str.Updates">Naujiniai</sys:String>
  <sys:String x:Key="Str.UpToDate">Naujausia</sys:String>
  <sys:String x:Key="Str.UpdateChecking">Ieškoma naujesnės versijos…</sys:String>
  <sys:String x:Key="Str.UpdateLatest">v{0} yra naujausia versija. Patikrinta {1}.</sys:String>
  <sys:String x:Key="Str.UpdateOut">Yra versija {0}. Jūs turite {1}.</sys:String>
  <sys:String x:Key="Str.UpdateFailed">Nepavyko patikrinti: GitHub neatsakė. Programa veikia taip pat.</sys:String>
  <sys:String x:Key="Str.UpdateNow">Atsisiųsti naujinį</sys:String>
  <sys:String x:Key="Str.UpdateOnGitHub">Atsisiųsti iš GitHub</sys:String>
  <sys:String x:Key="Str.UpdateCheck">Ieškoti naujinių</sys:String>
  <sys:String x:Key="Str.SessionSection">Paskutinė sesija</sys:String>
  <sys:String x:Key="Str.SessionTip">Perskaityta iš žurnalų, kuriuos priedas ir vykdymo aplinka rašo žaidimo aplanke. Perskaitoma iš naujo, kai po žaidimo grįžtate į šį langą.</sys:String>
  <sys:String x:Key="Str.SessionRan">NR veikė paskutinėje sesijoje</sys:String>
  <sys:String x:Key="Str.SessionCrashed">Žaidimas nulūžo paskutinėje sesijoje</sys:String>
  <sys:String x:Key="Str.SessionFailed">NR nepasileido paskutinėje sesijoje</sys:String>
  <sys:String x:Key="Str.SessionNotLoaded">ReShade pasileido, bet priedas neįsikėlė</sys:String>
  <sys:String x:Key="Str.SessionNoFrames">Modifikacija įsikėlė, bet NR neapdorojo nė vieno kadro</sys:String>
  <sys:String x:Key="Str.SessionNever">Sesijų dar nebuvo. Vieną kartą paleiskite žaidimą ir grįžkite: čia bus matyti, ar NR veikė.</sys:String>
  <sys:String x:Key="Str.SessionFrames">Apdorota kadrų: {0}</sys:String>
  <sys:String x:Key="Str.SessionGpu">Tinklas: {0} ms kadrui</sys:String>
  <sys:String x:Key="Str.SessionRuntime">Vykdymo aplinka {0}</sys:String>
  <sys:String x:Key="Str.SessionNoFramesReShade">Žaidime atverkite ReShade perdangą klavišu Home ir patikrinkite, ar NR įjungtas AMD Neural Rendering skydelyje.</sys:String>
  <sys:String x:Key="Str.SessionNoFramesOpti">Žaidime įjunkite DLSS, FSR arba XeSS, tada paspauskite Insert, atverkite skirtuką Neural ir įjunkite Enable NR.</sys:String>
  <sys:String x:Key="Str.SessionNotLoadedHint">ReShade.log žaidimo aplanke nurodo, kuriame aplanke ReShade ieškojo priedų. „Pranešti apie problemą“ jį supakuoja su kitais.</sys:String>
  <sys:String x:Key="Str.SessionReportHint">„Pranešti apie problemą“ supakuoja šiuos žurnalus į vieną failą, kuriuo galima pasidalinti Discord.</sys:String>
  <sys:String x:Key="Str.SortFilter">Rikiuoti ir filtruoti</sys:String>
  <sys:String x:Key="Str.FilterShow">Rodyti</sys:String>
  <sys:String x:Key="Str.FilterAll">Visi žaidimai</sys:String>
  <sys:String x:Key="Str.FilterInstalled">Įdiegti</sys:String>
  <sys:String x:Key="Str.FilterUpdates">Yra naujinys</sys:String>
  <sys:String x:Key="Str.FilterNotInstalled">Neįdiegti</sys:String>
  <sys:String x:Key="Str.FilterEmulators">Emuliatoriai</sys:String>
  <sys:String x:Key="Str.SortBy">Rikiuoti pagal</sys:String>
  <sys:String x:Key="Str.SortName">Pavadinimas</sys:String>
  <sys:String x:Key="Str.SortRecent">Neseniai žaisti</sys:String>
  <sys:String x:Key="Str.SortAdded">Neseniai pridėti</sys:String>
  <sys:String x:Key="Str.NoFilterMatch">Nė vienas sąrašo žaidimas neatitinka šio filtro.</sys:String>
  <sys:String x:Key="Str.WhatsNew">Kas naujo</sys:String>
  <sys:String x:Key="Str.WhatsNewOnGitHub">Atidaryti GitHub</sys:String>
  <sys:String x:Key="Str.WhatsNewFailed">Nepavyko perskaityti pastabų iš GitHub. Jos yra leidimo puslapyje.</sys:String>
  <sys:String x:Key="Str.WhatsNewNone">Šis leidimas paskelbtas be pastabų.</sys:String>
  <sys:String x:Key="Str.Transfer">NR nustatymai</sys:String>
  <sys:String x:Key="Str.TransferTip">Šio žaidimo NR nustatymai viename faile, išsaugoti arba pasidalinti, ir būdas įkelti kieno nors kito. Pirmiausia uždarykite žaidimą: jis įrašo nustatymus išeidamas.</sys:String>
  <sys:String x:Key="Str.TransferExport">Eksportuoti į failą…</sys:String>
  <sys:String x:Key="Str.TransferImport">Importuoti iš failo…</sys:String>
  <sys:String x:Key="Str.TransferNothing">Kol kas nėra ką eksportuoti: nustatymai įrašomi pirmą kartą paleidus žaidimą su modifikacija.</sys:String>
  <sys:String x:Key="Str.TransferExported">Nustatymai įrašyti į {0}.</sys:String>
  <sys:String x:Key="Str.TransferImported">Nustatymai iš {0} pritaikyti. Pakeisti nustatymai išsaugoti {1}.</sys:String>
  <sys:String x:Key="Str.TransferWrongRoute">Šie nustatymai skirti {0} maršrutui, o šiame žaidime įdiegtas {1}.</sys:String>
  <sys:String x:Key="Str.TransferInvalid">Šis failas nėra AMD-NR nustatymų eksportas.</sys:String>
  <sys:String x:Key="Str.Emulator.pcsx2">Settings &gt; Graphics &gt; Renderer: Direct3D 11. Atkreipkite dėmesį į atskiro žaidimo nustatymus žaidimo savybėse — jie tyliai perrašo bendruosius ir dažniausiai dėl jų atrodo, kad kažkas sugedo, nors taip nėra.</sys:String>
  <sys:String x:Key="Str.Emulator.rpcs3">Settings &gt; GPU &gt; Renderer: Vulkan. Čia visai nėra Direct3D, todėl šis maršrutas gauna tik spalvą ir įvertintą judesį — be gylio.</sys:String>
  <sys:String x:Key="Str.Emulator.duckstation">Settings &gt; Graphics &gt; Renderer: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.dolphin">Graphics &gt; General &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.ppsspp">Settings &gt; Graphics &gt; Backend: Direct3D 11.</sys:String>
  <sys:String x:Key="Str.Emulator.flycast">Settings &gt; Graphics &gt; Graphics API: DirectX 11.</sys:String>
  <sys:String x:Key="Str.Emulator.xenia">Veikia su D3D12, t. y. ribotu maršrutu: priedas mato tik baigtą kadrą ir nieko daugiau. Veikia, bet tikėkitės mažiau.</sys:String>
  <sys:String x:Key="Str.Emulator.cemu">Options &gt; General settings &gt; Graphics &gt; Graphics API: Vulkan. Su Vulkan gylio nėra: tik spalva ir įvertintas judesys.</sys:String>
  <sys:String x:Key="Str.Emulator.ryujinx">Options &gt; Settings &gt; Graphics &gt; Graphics Backend: Vulkan. Su Vulkan gylio nėra.</sys:String>
  <sys:String x:Key="Str.Emulator.yuzu">Emulation &gt; Configure &gt; Graphics &gt; API: Vulkan. Su Vulkan gylio nėra.</sys:String>
  <sys:String x:Key="Str.Emulator.vita3k">Vulkan yra numatytoji posistemė. Su Vulkan gylio nėra.</sys:String>
  <sys:String x:Key="Str.Emulator.shadps4">Tik Vulkan. Su Vulkan gylio nėra, o pats emuliatorius dar ankstyvos stadijos — tikėkitės problemų.</sys:String>
  <sys:String x:Key="Str.Emulator.kyty">Tik Vulkan. Nurodykite kyty_emulator.exe aplanką (launcher.exe jį tik paleidžia). Gylio nėra, o pats emuliatorius dar ankstyvas – tikėkitės problemų.</sys:String>
  <sys:String x:Key="Str.Emulator.fivem">Žaidime: Home atveria ReShade, AMD Neural Rendering yra Add-ons skiltyje, arba Ctrl+End. FiveM turi savo apsaugą nuo sukčiavimo – pirma pasitikrinkite serverio taisykles.</sys:String>
  <sys:String x:Key="Str.Emulator.azahar">Emulation &gt; Configure &gt; Graphics &gt; Graphics API: Vulkan. Dabar maršrutą turi ir OpenGL, bet čia labiausiai išbandytas Vulkan.</sys:String>
  <sys:String x:Key="Str.Emulator.xemu">xemu atvaizduoja tik su OpenGL, todėl OpenGL maršrutas čia vienintelis. Tai naujausias maršrutas, ir jis eksperimentinis: spalva ir įvertintas judesys, be gylio.</sys:String>
  <sys:String x:Key="Str.Emulator.melonds">Emu settings &gt; Video &gt; 3D renderer: OpenGL. Programinis atvaizduoklis piešia procesoriumi, ir ten priedui nėra ko pasiekti, todėl reikia OpenGL — o šis maršrutas eksperimentinis: spalva ir įvertintas judesys, be gylio.</sys:String>

</ResourceDictionary>
