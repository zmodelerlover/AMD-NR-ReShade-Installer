<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore reads every NuGet.config from the drive root down, and a machine-wide one left behind by
  a Visual Studio install can name a fallback package folder that is not on the machine doing the
  build: "Microsoft.VisualStudio.FallbackLocation.config" points at D:\visual3\NuGetPackages here,
  a drive this repository has nothing to do with, and restore then fails with NU1301 before it has
  read a single package reference.

  Clearing both lists makes the restore depend on nothing but nuget.org, which is what the build
  actually needs and what CI already has.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
